
{% block title %}Certificat de Propriété - {{ terrain.nomTerrain }} — AgroFlow{% endblock %}

{% block stylesheets %}
<style>
    @page {
        margin: 0;
    }
    body {
        margin: 0;
        padding: 0;
        font-family: 'DejaVu Sans', Arial, sans-serif;
    }
    .pdf-container {
        padding: 50px 45px;
        line-height: 1.7;
        color: #333;
        background: #fff;
    }
    .header {
        text-align: center;
        margin-bottom: 50px;
    }
    .header h1 {
        color: #2D5A27;
        font-size: 32px;
        margin: 0 0 10px 0;
        font-weight: 700;
    }
    .header p {
        color: #555;
        font-size: 17px;
        margin: 0;
    }
    hr {
        border: none;
        border-top: 4px solid #2D5A27;
        width: 65%;
        margin: 25px auto 0;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 40px;
        font-size: 15.5px;
    }
    td {
        padding: 14px 0;
    }
    .label {
        width: 38%;
        font-weight: 600;
        color: #2D5A27;
    }
    .content {
        font-weight: 600;
    }
    .legal {
        margin-top: 40px;
        font-size: 14.5px;
        line-height: 1.6;
    }
    .signature {
        margin-top: 80px;
        text-align: center;
        color: #555;
        font-size: 14px;
    }
</style>
{% endblock %}

{% block body %}
<div class="pdf-container">

    <!-- En-tête -->
    <div class="header">
        <h1>CERTIFICAT DE PROPRIÉTÉ</h1>
        <p>AgroFlow — Plateforme de Gestion Agricole</p>
        <hr>
    </div>

    <!-- Attestation -->
    <div style="margin-bottom: 35px; font-size: 16px;">
        <p><strong>Le présent certificat atteste que :</strong></p>
    </div>

    <!-- Tableau des informations -->
    <table>
        <tr>
            <td class="label">Nom du terrain :</td>
            <td class="content">{{ terrain.nomTerrain }}</td>
        </tr>
        <tr>
            <td class="label">Surface :</td>
            <td class="content">{{ terrain.surface }} hectares</td>
        </tr>
        <tr>
            <td class="label">Localisation :</td>
            <td class="content">{{ terrain.localisation }}</td>
        </tr>
        <tr>
            <td class="label">Type de sol :</td>
            <td class="content">{{ terrain.typeSol }}</td>
        </tr>
        <tr>
            <td class="label">pH du sol :</td>
            <td class="content">{{ terrain.pH is defined and terrain.pH is not null ? terrain.pH : 'Non renseigné' }}</td>
        </tr>
        <tr>
            <td class="label">Propriétaire :</td>
            <td class="content">
                {{ app.user ? (app.user.prenom ?? app.user.nom ?? app.user.email ?? 'Agriculteur') : 'Utilisateur connecté' }}
            </td>
        </tr>
    </table>

    <!-- Mention légale -->
    <p class="legal">
        Ce certificat est délivré à titre informatif le 
        <strong>{{ dateEmission|date('d/m/Y à H:i') }}</strong>.<br>
        Il ne se substitue pas à un titre foncier officiel délivré par les autorités compétentes 
        (équivalent en Tunisie).
    </p>

    <!-- Signature -->
    <div class="signature">
        <p style="margin-bottom: 30px;">Document généré automatiquement par <strong>AgroFlow</strong></p>
        
        <p style="margin: 0 0 8px 0;">
            <strong>Le Responsable AgroFlow</strong>
        </p>
        <p style="font-size: 13px; color: #777;">
            {{ dateEmission|date('d/m/Y') }}
        </p>
    </div>

</div>
{% endblock %}