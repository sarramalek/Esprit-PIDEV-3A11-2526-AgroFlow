{% extends 'base_ouvrier.html.twig' %}

{% block title %}Mes participations - AgroFlow{% endblock %}

{% block stylesheets %}
<style>
    .prt-page { max-width: 1100px; margin: 0 auto; }

    .prt-header {
        display: flex; align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
    }
    .prt-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 28px; color: #1B3A20; margin: 0 0 4px;
    }
    .prt-header p { color: #7a9070; font-size: 14px; margin: 0; }

    .btn-back {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 18px; border-radius: 10px;
        border: 1.5px solid #2D5A27; background: transparent;
        color: #2D5A27; font-size: 13px; font-weight: 600;
        text-decoration: none; transition: all 0.2s;
    }
    .btn-back:hover { background: #2D5A27; color: white; }

    .prt-stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 14px; margin-bottom: 28px;
    }
    .stat-card {
        background: white; border-radius: 14px;
        padding: 18px 20px; border-left: 4px solid transparent;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .stat-card .stat-num { font-size: 32px; font-weight: 700; line-height: 1; margin-bottom: 5px; }
    .stat-card .stat-label { font-size: 12px; color: #999; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
    .stat-card.total  { border-color: #2D5A27; } .stat-card.total  .stat-num { color: #2D5A27; }
    .stat-card.ok     { border-color: #27ae60; } .stat-card.ok     .stat-num { color: #27ae60; }
    .stat-card.wait   { border-color: #f39c12; } .stat-card.wait   .stat-num { color: #f39c12; }
    .stat-card.cancel { border-color: #e74c3c; } .stat-card.cancel .stat-num { color: #e74c3c; }

    .prt-filters {
        background: white; border-radius: 14px;
        padding: 20px 24px; margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }
    .prt-filters .filter-title {
        font-size: 12px; font-weight: 600; color: #aaa;
        text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 14px;
    }
    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1.5fr 1fr 1fr auto;
        gap: 12px; align-items: end;
    }
    .filter-field label { display: block; font-size: 11px; color: #999; margin-bottom: 5px; font-weight: 500; }
    .filter-field input,
    .filter-field select {
        width: 100%; border: 1.5px solid #e8e8e8; border-radius: 9px;
        padding: 9px 12px; font-size: 13px; color: #2C3E50;
        background: #fafafa; outline: none; transition: border 0.2s;
        font-family: 'DM Sans', sans-serif;
    }
    .filter-field input:focus,
    .filter-field select:focus { border-color: #4A8C3F; background: white; }

    .btn-filter {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 10px 18px; border-radius: 9px;
        background: #2D5A27; color: white; border: none;
        font-size: 13px; font-weight: 600; cursor: pointer;
        transition: background 0.2s; font-family: 'DM Sans', sans-serif;
        white-space: nowrap;
    }
    .btn-filter:hover { background: #1B3A20; }

    .btn-reset {
        font-size: 12px; color: #aaa; text-decoration: none;
        display: inline-flex; align-items: center; gap: 5px;
        margin-top: 10px; transition: color 0.2s;
    }
    .btn-reset:hover { color: #555; }

    .prt-table-wrap {
        background: white; border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden;
    }
    .prt-table-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 24px; border-bottom: 1.5px solid #f0f0f0;
    }
    .prt-table-header span { font-size: 13px; color: #999; }
    .prt-table-header strong { color: #2D5A27; }

    table.prt-table { width: 100%; border-collapse: collapse; }
    table.prt-table thead th {
        padding: 12px 20px; text-align: left;
        font-size: 11px; font-weight: 600; color: #aaa;
        text-transform: uppercase; letter-spacing: 0.07em;
        background: #fafdf8; border-bottom: 1.5px solid #f0f0f0;
    }
    table.prt-table tbody tr { border-bottom: 1px solid #f5f5f5; transition: background 0.15s; }
    table.prt-table tbody tr:last-child { border-bottom: none; }
    table.prt-table tbody tr:hover { background: #fafdf8; }
    table.prt-table tbody td { padding: 14px 20px; font-size: 13px; color: #2C3E50; vertical-align: middle; }

    .badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 20px;
        font-size: 11px; font-weight: 700;
    }
    .badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.6; }
    .badge-inscrit  { background: #FFF9C4; color: #b7860c; }
    .badge-confirme { background: #E8F5E9; color: #2E7D32; }
    .badge-annule   { background: #FFEBEE; color: #C62828; }

    .presence-yes { color: #27ae60; font-weight: 600; font-size: 13px; }
    .presence-no  { color: #bbb; font-size: 13px; }

    .action-wrap { display: flex; align-items: center; gap: 8px; }
    .btn-edit {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 13px; border-radius: 8px;
        background: #FFF8E1; border: 1.5px solid #f0c040;
        color: #b7860c; font-size: 12px; font-weight: 600;
        text-decoration: none; transition: all 0.2s;
    }
    .btn-edit:hover { background: #fef08a; }
    .btn-cancel {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 13px; border-radius: 8px;
        background: #FFEBEE; border: 1.5px solid #f5a7a7;
        color: #C62828; font-size: 12px; font-weight: 600;
        cursor: pointer; font-family: 'DM Sans', sans-serif;
        transition: all 0.2s; border: none;
    }
    .btn-cancel:hover { background: #fbd5d5; }

    .empty-state { padding: 60px 24px; text-align: center; color: #bbb; }
    .empty-state i { font-size: 40px; margin-bottom: 14px; color: #ddd; display: block; }
    .empty-state p { font-size: 14px; }

    @media (max-width: 768px) {
        .prt-stats { grid-template-columns: repeat(2, 1fr); }
        .filter-grid { grid-template-columns: 1fr 1fr; }
        table.prt-table thead { display: none; }
        table.prt-table tbody td { display: block; padding: 6px 16px; }
        table.prt-table tbody td:first-child { padding-top: 14px; font-weight: 600; }
        table.prt-table tbody td:last-child  { padding-bottom: 14px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="prt-page">

    <div class="prt-header">
        <div>
            <h1><i class="fa fa-ticket" style="font-size:22px;margin-right:10px;color:#4A8C3F;"></i>Mes participations</h1>
            <p>Suivez et gérez vos inscriptions aux événements agricoles</p>
        </div>
        <a href="{{ path('ouvrier_evenement_index') }}" class="btn-back">
            <i class="fa fa-calendar-days"></i> Voir les événements
        </a>
    </div>

    <div class="prt-stats">
        <div class="stat-card total">
            <div class="stat-num">{{ total }}</div>
            <div class="stat-label">Total inscriptions</div>
        </div>
        <div class="stat-card ok">
            <div class="stat-num">{{ confirme }}</div>
            <div class="stat-label">Confirmées</div>
        </div>
        <div class="stat-card wait">
            <div class="stat-num">{{ inscrit }}</div>
            <div class="stat-label">En attente</div>
        </div>
        <div class="stat-card cancel">
            <div class="stat-num">{{ annule }}</div>
            <div class="stat-label">Annulées</div>
        </div>
    </div>

    <div class="prt-filters">
        <div class="filter-title"><i class="fa fa-sliders" style="margin-right:6px;"></i>Filtres</div>
        <form method="GET" action="{{ path('ouvrier_participation_index') }}">
            <div class="filter-grid">
                <div class="filter-field">
                    <label>Rechercher par événement</label>
                    <input type="text" name="search" value="{{ search }}" placeholder="Nom de l'événement…">
                </div>
                <div class="filter-field">
                    <label>Date d'inscription</label>
                    <input type="date" name="dateInscription" value="{{ dateInscriptionFiltre }}">
                </div>
                <div class="filter-field">
                    <label>Statut</label>
                    <select name="statut">
                        <option value="">Tous</option>
                        <option value="Inscrit"  {% if statutFiltre == 'Inscrit'  %}selected{% endif %}>Inscrit</option>
                        <option value="Confirmé" {% if statutFiltre == 'Confirmé' %}selected{% endif %}>Confirmé</option>
                        <option value="Annulé"   {% if statutFiltre == 'Annulé'   %}selected{% endif %}>Annulé</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label>Présence</label>
                    <select name="presence">
                        <option value="">Toutes</option>
                        <option value="Oui" {% if presenceFiltre == 'Oui' %}selected{% endif %}>Oui</option>
                        <option value="Non" {% if presenceFiltre == 'Non' %}selected{% endif %}>Non</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn-filter">
                        <i class="fa fa-magnifying-glass"></i> Filtrer
                    </button>
                </div>
            </div>
            {% if search or dateInscriptionFiltre or statutFiltre or presenceFiltre %}
            <div>
                <a href="{{ path('ouvrier_participation_index') }}" class="btn-reset">
                    <i class="fa fa-xmark"></i> Réinitialiser les filtres
                </a>
            </div>
            {% endif %}
        </form>
    </div>

    <div class="prt-table-wrap">
        <div class="prt-table-header">
            <span><strong>{{ total }}</strong> participation{{ total > 1 ? 's' : '' }} trouvée{{ total > 1 ? 's' : '' }}</span>
        </div>

        {% if participations is empty %}
            <div class="empty-state">
                <i class="fa fa-calendar-xmark"></i>
                <p>Aucune participation trouvée.<br>
                <a href="{{ path('ouvrier_evenement_index') }}" style="color:#2D5A27;font-weight:600;">Parcourir les événements disponibles →</a></p>
            </div>
        {% else %}
        <table class="prt-table">
            <thead>
                <tr>
                    <th>Événement</th>
                    <th>Date d'inscription</th>
                    <th>Statut</th>
                    <th>Présence</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in participations %}
                <tr>
                    <td>
                        <div style="font-weight:600;color:#1B3A20;">{{ p.evenement.titre }}</div>
                        <div style="font-size:12px;color:#aaa;margin-top:2px;">
                            <i class="fa fa-calendar" style="margin-right:4px;"></i>
                            {{ p.evenement.dateDebut|date('d/m/Y') }}
                            {% if p.evenement.lieu %}
                                &nbsp;·&nbsp;<i class="fa fa-location-dot" style="margin-right:3px;"></i>{{ p.evenement.lieu }}
                            {% endif %}
                        </div>
                    </td>
                    <td>{{ p.dateInscription|date('d/m/Y') }}</td>
                    <td>
                        {% set s = p.statutParticipation %}
                        <span class="badge badge-{{ s|lower|replace({'é':'e','è':'e'}) }}">{{ s }}</span>
                    </td>
                    <td>
                        {% if p.presence %}
                            <span class="presence-yes"><i class="fa fa-circle-check"></i> Oui</span>
                        {% else %}
                            <span class="presence-no"><i class="fa fa-circle-xmark"></i> Non</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if p.statutParticipation != 'Annulé' %}
                        <div class="action-wrap">
                            <a href="{{ path('ouvrier_participation_modifier', {id: p.idParticipation}) }}" class="btn-edit">
                                <i class="fa fa-pen"></i> Modifier
                            </a>
                            <form method="POST" action="{{ path('ouvrier_participation_annuler', {id: p.idParticipation}) }}" style="margin:0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('annuler_' ~ p.idParticipation) }}">
                                <button type="submit" class="btn-cancel"
                                        onclick="return confirm('Annuler votre participation à cet événement ?')">
                                    <i class="fa fa-ban"></i> Annuler
                                </button>
                            </form>
                        </div>
                        {% else %}
                            <span style="font-size:12px;color:#ccc;font-style:italic;">Annulée</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

</div>
{% endblock %}
