{% extends 'base_agriculteur.html.twig' %}

{% block title %}AgroFlow - Statistiques Animaux{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('especeChart').getContext('2d');
            
            // Préparation des données depuis Twig
            const stats = {{ stats|json_encode|raw }};
            const labels = stats.map(s => s.espece);
            const data = stats.map(s => s.total);

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nombre d\'animaux',
                        data: data,
                        backgroundColor: [
                            '#2D5A27', // Vert Foncé
                            '#3498db', // Bleu
                            '#e74c3c', // Rouge
                            '#f1c40f', // Jaune
                            '#9b59b6', // Violet
                            '#e67e22'  // Orange
                        ],
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 25,
                                font: { size: 14, weight: 'bold', family: 'Arial' },
                                usePointStyle: true
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        });
    </script>
{% endblock %}

{% block body %}
<div style="padding: 10px;">
    <!-- Header : Breadcrumb -->
    <div style="margin-bottom: 25px; color: #666; font-size: 14px;">
        <span>Gestion</span> <i class="fa fa-chevron-right" style="font-size: 10px; margin: 0 5px;"></i> 
        <span>Animaux</span> <i class="fa fa-chevron-right" style="font-size: 10px; margin: 0 5px;"></i> 
        <strong style="color: #2C3E50;">Vue Analytique</strong>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 400px; gap: 30px;">
        
        <!-- Carte : Graphique -->
        <div style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 40px; text-align: center;">
            <h3 style="margin: 0 0 40px 0; color: #2C3E50; font-size: 22px; font-weight: 800;">Répartition par Espèce</h3>
            <div style="height: 400px; position: relative;">
                <canvas id="especeChart"></canvas>
            </div>
        </div>

        <!-- Carte : Légende & Totaux -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <div style="background: #2D5A27; padding: 30px; border-radius: 20px; color: white; box-shadow: 0 10px 20px rgba(45, 90, 39, 0.2);">
                <i class="fa fa-layer-group" style="font-size: 30px; margin-bottom: 15px; opacity: 0.8;"></i>
                <h4 style="margin: 0; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8;">Total Global</h4>
                {% set totalAnimaux = 0 %}
                {% for s in stats %}{% set totalAnimaux = totalAnimaux + s.total %}{% endfor %}
                <h2 style="margin: 5px 0 0 0; font-size: 40px; font-weight: 800;">{{ totalAnimaux }}</h2>
            </div>

            <div style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 25px; flex: 1;">
                <h4 style="color: #2C3E50; margin: 0 0 20px 0; border-bottom: 1px solid #EEE; padding-bottom: 15px;">Détails du Cheptel</h4>
                {% for s in stats %}
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid #F8F9FA;">
                        <span style="font-weight: 700; color: #555;">{{ s.espece }}</span>
                        <span style="background: #F1F3F5; padding: 4px 12px; border-radius: 8px; font-weight: 800; color: #2D5A27;">{{ s.total }}</span>
                    </div>
                {% endfor %}
                <div style="margin-top: 25px;">
                    <a href="{{ path('app_animaux_index') }}" style="display: block; text-align: center; color: #7f8c8d; text-decoration: none; font-weight: 700; font-size: 14px;">
                        <i class="fa fa-arrow-left"></i> Retour au Tableau
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
