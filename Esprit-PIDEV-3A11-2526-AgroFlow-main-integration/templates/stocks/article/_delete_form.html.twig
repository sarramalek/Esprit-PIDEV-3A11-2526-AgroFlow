<form method="post" action="{{ path('app_article_delete', {'id': article.id}) }}" onsubmit="return confirm('Voulez-vous supprimer cet article ?');" style="margin: 0; padding: 0;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
    <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer; display: flex; align-items: center; justify-content: center;">
        <i class="fas fa-trash-can" style="color: #D32F2F; font-size: 14px;"></i>
    </button>
</form>