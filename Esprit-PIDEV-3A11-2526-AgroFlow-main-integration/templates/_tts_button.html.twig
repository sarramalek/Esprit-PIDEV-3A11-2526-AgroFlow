{# Text-to-Speech Floating Button #}
<!-- Floating TTS Button Container -->
<div id="tts-global-wrapper" style="position: fixed !important; bottom: 20px !important; right: 20px !important; z-index: 2147483647 !important; pointer-events: auto !important;">
    <button id="tts-trigger" style="
        width: 70px !important;
        height: 70px !important;
        border-radius: 50% !important;
        background-color: #2D5A27 !important;
        border: 4px solid #FCF8E6 !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4) !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        color: white !important;
        padding: 0 !important;
        margin: 0 !important;
        outline: none !important;
        transition: transform 0.2s, background-color 0.2s !important;
    " title="Lire la sélection (Surlignez du texte puis cliquez ici)"
    onmouseover="this.style.transform='scale(1.1)'"
    onmouseout="this.style.transform='scale(1)'">
        <i class="fas fa-volume-up" id="tts-icon" style="font-size: 24px !important;"></i>
        <span id="tts-fallback-label" style="font-size: 10px !important; font-weight: bold !important; margin-left: 2px !important; display: none;">AUDIO</span>
    </button>
</div>

<script>
    (function() {
        console.log("TTS DEBUG: Script starting...");
        
        function initTTS() {
            const btn = document.getElementById('tts-trigger');
            const icon = document.getElementById('tts-icon');
            
            if (!btn) return;
            
            let synth = window.speechSynthesis;
            let currentUtterance = null;

            // Fonction pour arrêter la lecture
            function stopSpeaking() {
                synth.cancel();
                btn.style.backgroundColor = '#2D5A27';
                icon.className = 'fas fa-volume-up';
                btn.title = "Lire la sélection";
                console.log("TTS DEBUG: Stop speaking.");
            }

            btn.onclick = function(e) {
                e.preventDefault();
                console.log("TTS DEBUG: Button clicked.");

                // Si on parle déjà, on arrête
                if (synth.speaking) {
                    stopSpeaking();
                    return;
                }

                // Récupérer le texte sélectionné
                let text = '';
                const selection = window.getSelection();
                if (selection && selection.toString().trim().length > 0) {
                    text = selection.toString().trim();
                }

                // Si aucun texte n'est sélectionné, on cherche le contenu principal mais de façon plus ciblée
                if (!text) {
                    // On essaie de lire juste le titre ou le premier paragraphe pour éviter de tout lire
                    const mainTitle = document.querySelector('h1, h2, .topbar-title');
                    if (mainTitle) {
                        text = mainTitle.innerText;
                    } else {
                        alert("Surlignez d'abord le texte que vous souhaitez écouter !");
                        return;
                    }
                }

                if (text) {
                    console.log("TTS DEBUG: Preparing to speak " + text.length + " characters.");
                    
                    // Toujours annuler avant de commencer
                    synth.cancel();

                    currentUtterance = new SpeechSynthesisUtterance(text);
                    currentUtterance.lang = 'fr-FR';
                    currentUtterance.rate = 1.0;
                    currentUtterance.pitch = 1.0;

                    currentUtterance.onstart = () => {
                        console.log("TTS DEBUG: Speech started.");
                        btn.style.backgroundColor = '#E74C3C'; // Passage au rouge (Stop)
                        icon.className = 'fas fa-stop';
                        btn.title = "Arrêter la lecture";
                    };

                    currentUtterance.onend = () => {
                        console.log("TTS DEBUG: Speech ended.");
                        btn.style.backgroundColor = '#2D5A27';
                        icon.className = 'fas fa-volume-up';
                        btn.title = "Lire la sélection";
                    };

                    currentUtterance.onerror = (event) => {
                        console.error("TTS DEBUG: Speech error", event);
                        stopSpeaking();
                    };

                    synth.speak(currentUtterance);
                }
            };
            
            // Sécurité : arrêter si l'utilisateur quitte la page
            window.onbeforeunload = function() {
                synth.cancel();
            };
        }

        // Initialisation
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTTS);
        } else {
            initTTS();
        }
    })();
</script>
