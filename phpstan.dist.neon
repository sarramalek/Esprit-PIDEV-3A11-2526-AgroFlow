parameters:
    level: 6
    paths:
        - src

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # ─── Arrays sans value type ───────────────────────────────────────────
        - '#has parameter .* with no value type specified in iterable type array#'
        - '#return type has no value type specified in iterable type array#'

        # ─── Propriétés never read ────────────────────────────────────────────
        - '#Property App\\Controller\\Materiels\\ChatbotController::\$geminiApiKey is never read#'
        - '#Property App\\Controller\\Materiels\\MaintenancesController::\$chatbotService is never read#'

        # ─── Nullsafe inutiles ────────────────────────────────────────────────
        - '#Using nullsafe (property|method) call on non-nullable#'
        - '#Using nullsafe property access "\?->." on left side of \?\? is unnecessary#'

        # ─── Comparaisons toujours vraies ─────────────────────────────────────
        - '#Strict comparison using !== between .* and .* will always evaluate to true#'

        # ─── is_numeric / is_int / is_string redondants ───────────────────────
        - '#Call to function is_numeric\(\) with int will always evaluate to true#'
        - '#Call to function is_int\(\) with int will always evaluate to true#'
        - '#Call to function is_string\(\) with \*NEVER\* will always evaluate to true#'

        # ─── method_exists redondants ─────────────────────────────────────────
        - '#Call to function method_exists\(\) with .* will always evaluate to true#'

        # ─── Méthode privée appelée de l'extérieur ────────────────────────────
        - '#Call to private method getFallbackRecommendation\(\)#'

        # ─── Expression non nullable ──────────────────────────────────────────
        - '#Expression on left side of \?\? is not nullable#'

        # ─── empty() toujours falsy ───────────────────────────────────────────
        - '#Variable \$recommandation in empty\(\) always exists and is always falsy#'

        # ─── Doctrine mapping mismatch ────────────────────────────────────────
        - '#Property App\\Entity\\Materiels\\Machine::.*type mapping mismatch#'
        - '#Property App\\Entity\\Materiels\\Maintenance::.*type mapping mismatch#'

        # ─── Forms generics manquants ─────────────────────────────────────────
        - '#Class App\\Form\\Materiels\\(Machine|Maintenance)Type extends generic class.*but does not specify its types#'