{% extends 'base_agriculteur.html.twig' %}

{% block title %}Journal des Flux - AgroFlow{% endblock %}

{% block body %}
{# Fond jaune crème global pour toute la page #}
<div class="dash-wrapper" style="padding: 30px; font-family: 'DM Sans', sans-serif; background-color: transparent !important;">

    {# --- EN-TÊTE --- #}
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:40px;">
        <div>
            <span style="color: #2D5A27; font-weight: 800; text-transform: uppercase; font-size: 11px; letter-spacing: 2px;">HISTORIQUE</span>
            <h2 style="margin:5px 0 0; color:#1a2a19; font-size:32px; font-weight: 800; letter-spacing: -1px;">
                <i class="fa fa-clock-rotate-left" style="color: #2D5A27; margin-right: 12px;"></i>Journal des Flux
            </h2>
            <p style="margin:5px 0 0; color:#6c757d; font-size: 15px;">Suivi détaillé des entrées et sorties de votre inventaire</p>
        </div>
        <div style="display: flex; gap: 12px;">
             <a href="{{ path('app_mouvement_export_pdf', app.request.query.all) }}" class="btn-export-pdf">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
            <a href="{{ path('agri_produits') }}" class="btn-back-stock">
                <i class="fa fa-arrow-left"></i> Retour au stock
            </a>
        </div>
    </div>

    {# --- BARRE DE FILTRES (Carte Blanche) --- #}
    <div class="agro-card-white" style="margin-bottom: 25px;">
        <form method="GET" action="{{ path('app_mouvement_index') }}" style="display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end; padding: 20px;">
            
            <div style="flex: 1; min-width: 200px;">
                <label class="label-style">PRODUIT</label>
                <select name="article" class="form-select-modern">
                    <option value="">Tous les produits</option>
                    {% for art in articles %}
                        <option value="{{ art.id }}" {{ currentArticle == art.id ? 'selected' : '' }}>{{ art.nom }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="width: 180px;">
                <label class="label-style">DEPUIS LE</label>
                <input type="date" name="date_debut" value="{{ currentDebut }}" class="form-input-modern">
            </div>

            <div style="width: 180px;">
                <label class="label-style">JUSQU'AU</label>
                <input type="date" name="date_fin" value="{{ currentFin }}" class="form-input-modern">
            </div>

            <button type="submit" class="btn-filter-main">
                Filtrer
            </button>
        </form>
    </div>

    {# --- TABLEAU (Carte Blanche) --- #}
    <div class="agro-card-white" style="overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <th class="th-style">DATE & HEURE</th>
                    <th class="th-style">PRODUIT CONCERNÉ</th>
                    <th class="th-style">OUVRIER</th>
                    <th class="th-style">TYPE D'OPÉRATION</th>
                    <th class="th-style">QUANTITÉ FLUX</th>
                    <th class="th-style">NOTES / MOTIF</th>
                </tr>
            </thead>
            <tbody>
            {% for mouvement in mouvements %}
                <tr class="row-hover">
                    <td style="padding: 18px 25px; color: #6c757d; font-size: 14px;">
                        <i class="fa fa-calendar-alt" style="margin-right: 8px; color: #cbd5e0;"></i>
                        {{ mouvement.dateMouvement|date('d/m/Y H:i') }}
                    </td>
                    <td style="padding: 18px 25px;">
                        <span style="font-weight: 700; color: #1a2a19;">{{ mouvement.article.nom }}</span>
                    </td>
                    <td style="padding: 18px 25px; color: #4a5568; font-weight: 700;">
                        {{ mouvement.user.prenom|default('') }} {{ mouvement.user.nom|default('') }}
                    </td>
                    <td style="padding: 18px 25px;">
                        {% if mouvement.type == 'ENTREE' %}
                            <span class="badge-custom badge-entree">ENTRÉE</span>
                        {% else %}
                            <span class="badge-custom badge-sortie">SORTIE</span>
                        {% endif %}
                    </td>
                    <td style="padding: 18px 25px;">
                        <span style="font-weight: 800; color: #2d3748;">
                            {{ mouvement.type == 'SORTIE' ? '-' : '+' }} {{ mouvement.quantite }} {{ mouvement.article.uniteMesure }}
                        </span>
                    </td>
                    <td style="padding: 18px 25px; color: #a0aec0; font-style: italic; font-size: 13px;">
                        {{ mouvement.motif|default('—') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align:center; padding:60px; color: #a0aec0;">
                        Aucun mouvement enregistré.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Carte blanche avec ombre légère comme sur ton image */
    .agro-card-white {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.02);
    }

    /* Styles des textes */
    .label-style { font-size: 10px; font-weight: 800; color: #94a3b8; letter-spacing: 0.5px; margin-bottom: 8px; display: block; }
    .th-style { padding: 15px 25px; text-align: left; font-size: 11px; color: #94a3b8; font-weight: 700; }
    
    /* Formulaires */
    .form-select-modern, .form-input-modern {
        width: 100%; padding: 10px 15px; border-radius: 8px; border: 1px solid #e2e8f0; 
        font-size: 14px; font-weight: 600; color: #1a2a19; outline: none;
    }

    /* Boutons */
    .btn-filter-main {
        background: #2D5A27; color: white; border: none; padding: 11px 25px; border-radius: 8px;
        font-weight: 700; cursor: pointer; transition: 0.2s;
    }
    .btn-filter-main:hover { background: #1e3d1a; }

    .btn-back-stock {
        background: #1a2a19; color: white; padding: 10px 20px; border-radius: 8px;
        text-decoration: none; font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;
    }

    .btn-export-pdf {
        background: white; color: #1a2a19; padding: 10px 20px; border-radius: 8px;
        text-decoration: none; font-weight: 700; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 8px;
    }

    /* Badges */
    .badge-custom {
        padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 800;
    }
    .badge-entree { background: #f0fff4; color: #2D5A27; border: 1px solid #c6f6d5; }
    .badge-sortie { background: #fff5f5; color: #e53e3e; border: 1px solid #fed7d7; }

    .row-hover { transition: 0.2s; border-bottom: 1px solid #f8fafc; }
    .row-hover:hover { background-color: #f8fafc; }
</style>
{% endblock %}