{# Pas d'extends ici car c'est une vue partielle chargée en AJAX #}
<div style="padding: 40px; font-family: 'DM Sans', sans-serif;">
    
    {# --- EN-TÊTE --- #}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 35px;">
        <div>
            <h6 style="text-transform: uppercase; color: #2D5A27; font-weight: 800; letter-spacing: 1px; font-size: 12px; margin: 0;">Analytique Temps Réel</h6>
            <h1 style="color: #1a1a1a; font-size: 32px; font-weight: 800; margin-top: 5px; letter-spacing: -1px;">Rotation des Flux</h1>
        </div>
        
        {# Filtrage par date compact #}
        <form onsubmit="updateStats(event)" id="dateFilterForm" style="display: flex; align-items: center; background: white; padding: 8px 15px; border-radius: 50px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #eee;">
            <div style="padding: 0 15px; border-right: 1px solid #eee;">
                <small style="color: #aaa; display: block; font-size: 9px; font-weight: 800;">DÉBUT</small>
                <input type="date" name="debut" value="{{ dateDebut }}" style="border:0; font-size: 13px; font-weight: 600; outline:none;">
            </div>
            <div style="padding: 0 15px;">
                <small style="color: #aaa; display: block; font-size: 9px; font-weight: 800;">FIN</small>
                <input type="date" name="fin" value="{{ dateFin }}" style="border:0; font-size: 13px; font-weight: 600; outline:none;">
            </div>
            <button type="submit" style="background: #1a1a1a; color: white; border: none; width: 35px; height: 35px; border-radius: 50%; cursor: pointer;">
                <i class="fa fa-sync-alt" style="font-size: 12px;"></i>
            </button>
        </form>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 25px; margin-bottom: 30px;">
        {# --- GRAPHIQUE --- #}
        <div style="background: white; border-radius: 25px; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                <h5 style="margin: 0; font-weight: 800; color: #2c3e50;">Performance des Catégories</h5>
                <div style="font-size: 11px; font-weight: 700;">
                    <span style="margin-right: 15px;"><i class="fa fa-circle" style="color: #A8D5BA;"></i> ENTRÉES</span>
                    <span><i class="fa fa-circle" style="color: #2D5A27;"></i> SORTIES</span>
                </div>
            </div>
            <div style="height: 300px; position: relative;">
                {{ render_chart(chart) }}
            </div>
        </div>

        {# --- CONSEIL AGRO --- #}
        <div style="background: #2D5A27; border-radius: 25px; padding: 25px; color: white; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="background: rgba(255,255,255,0.2); width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa fa-lightbulb" style="font-size: 20px;"></i>
                </div>
                <h5 style="font-weight: 800; margin-bottom: 15px;">Aide à la décision</h5>
                <p id="agro-advice" style="font-size: 14px; line-height: 1.6; opacity: 0.9; margin: 0;">
                    Analyse des indicateurs en cours...
                </p>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 15px; border-radius: 15px; margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 10px; font-weight: 800; text-transform: uppercase;">Statut Global</span>
                <span id="global-status-badge" style="background: #fff; color: #2D5A27; padding: 5px 12px; border-radius: 8px; font-size: 11px; font-weight: 800;">Optimal</span>
            </div>
        </div>
    </div>

    {# --- TABLEAU --- #}
    <div style="background: white; border-radius: 25px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.03);">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #fafafa; border-bottom: 1px solid #eee;">
                    <th style="padding: 18px 25px; text-align: left; font-size: 11px; color: #aaa; letter-spacing: 1px;">CATÉGORIE</th>
                    <th style="padding: 18px 25px; text-align: left; font-size: 11px; color: #aaa; letter-spacing: 1px;">FLUX (E/S)</th>
                    <th style="padding: 18px 25px; text-align: left; font-size: 11px; color: #aaa; letter-spacing: 1px;">INDICE ROTATION</th>
                    <th style="padding: 18px 25px; text-align: right; font-size: 11px; color: #aaa; letter-spacing: 1px;">ÉTAT</th>
                </tr>
            </thead>
            <tbody>
                {% for s in stats %}
                <tr style="border-bottom: 1px solid #f8f8f8;">
                    <td style="padding: 20px 25px; font-weight: 700; color: #1a1a1a;">{{ s.categorie.nom }}</td>
                    <td style="padding: 20px 25px;">
                        <span style="color: #48bb78; font-weight: 700; font-size: 13px;">+{{ s.entrees }}</span>
                        <span style="color: #cbd5e0; margin: 0 5px;">/</span>
                        <span style="color: #f56565; font-weight: 700; font-size: 13px;">-{{ s.sorties }}</span>
                    </td>
                    <td style="padding: 20px 25px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div style="flex-grow: 1; height: 6px; background: #eee; border-radius: 10px; width: 100px;">
                                {% set progress = (s.indice * 100) > 100 ? 100 : (s.indice * 100) %}
                                <div style="width: {{ progress }}%; height: 100%; background: {{ s.indice > 0.7 ? '#f56565' : '#2D5A27' }}; border-radius: 10px;"></div>
                            </div>
                            <span style="font-size: 12px; font-weight: 800; color: #666;">{{ s.indice }}</span>
                        </div>
                    </td>
                    <td style="padding: 20px 25px; text-align: right;">
                        {% if s.indice > 0.7 %}
                            <span style="background: #FFF5F5; color: #E53E3E; padding: 5px 12px; border-radius: 8px; font-size: 10px; font-weight: 800; border: 1px solid #FEB2B2;">CRITIQUE</span>
                        {% elseif s.indice < 0.1 %}
                            <span style="background: #F7FAFC; color: #A0AEC0; padding: 5px 12px; border-radius: 8px; font-size: 10px; font-weight: 800; border: 1px solid #E2E8F0;">DORMANT</span>
                        {% else %}
                            <span style="background: #F0FFF4; color: #38A169; padding: 5px 12px; border-radius: 8px; font-size: 10px; font-weight: 800; border: 1px solid #C6F6D5;">SAIN</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
// Conseil Agro-dynamique
function renderAdvice() {
    const adviceBox = document.getElementById('agro-advice');
    const badge = document.getElementById('global-status-badge');
    const criticals = [{% for s in stats %}{% if s.indice > 0.7 %}'{{ s.categorie.nom|e('js') }}',{% endif %}{% endfor %}];

    if (criticals.length > 0) {
        adviceBox.innerHTML = "Alerte : La rotation pour <strong>" + criticals[0] + "</strong> est trop rapide. Risque de rupture de stock imminent.";
        badge.innerHTML = "Rupture Possible";
        badge.style.background = "#fff";
        badge.style.color = "#E53E3E";
    } else {
        adviceBox.innerHTML = "Bravo ! Vos flux sont parfaitement équilibrés. Le rythme de sortie actuel permet une gestion saine sans surstockage.";
        badge.innerHTML = "Flux Sain";
    }
}

// Fonction pour filtrer sans fermer la modal
function updateStats(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const params = new URLSearchParams(formData);
    openStatsModal('{{ path("app_mouvement_rotation") }}?' + params.toString());
}

renderAdvice();
</script>