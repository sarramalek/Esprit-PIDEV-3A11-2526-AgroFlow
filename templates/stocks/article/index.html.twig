<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
// ── SMART SCAN AVEC CAMÉRA LIVE ──────────────────────────────────────────
let webcamStream = null;

async function openCameraModal() {
    const modal = document.getElementById('cameraModal');
    const video = document.getElementById('webcamVideo');
    modal.style.display = 'flex';

    try {
        // Demander une résolution précise pour améliorer l'OCR
        webcamStream = await navigator.mediaDevices.getUserMedia({ 
            video: { 
                facingMode: "environment",
                width: { ideal: 1920 },
                height: { ideal: 1080 }
            } 
        });
        video.srcObject = webcamStream;
        
        // Attendre que la vidéo soit prête
        video.onloadedmetadata = () => {
            video.play();
        };
    } catch (err) {
        console.error("Erreur caméra:", err);
        alert("Accès caméra refusé ou non supporté. Vérifiez vos paramètres.");
        closeCameraModal();
    }
}

function closeCameraModal() {
    if (webcamStream) {
        webcamStream.getTracks().forEach(track => track.stop());
        webcamStream = null;
    }
    document.getElementById('cameraModal').style.display = 'none';
}

function capturePhoto() {
    const video = document.getElementById('webcamVideo');
    const canvas = document.getElementById('captureCanvas');
    
    if (!video.videoWidth) {
        alert("La caméra n'est pas encore prête.");
        return;
    }

    const context = canvas.getContext('2d');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    
    // Dessiner l'image actuelle de la vidéo sur le canvas
    context.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    // Convertir en Blob haute qualité
    canvas.toBlob((blob) => {
        if (blob) {
            console.log("Photo capturée avec succès, envoi à l'IA...");
            closeCameraModal();
            analyzeImage(blob);
        } else {
            alert("Erreur lors de la capture de l'image.");
        }
    }, 'image/jpeg', 0.95);
}

async function handleSmartScan(event) {
    const file = event.target.files[0];
    if (!file) return;
    analyzeImage(file);
}

async function analyzeImage(imageSource) {
    document.getElementById('smartScanLoadingModal').style.display = 'flex';

    const formData = new FormData();
    // Symfony a besoin d'un nom de fichier pour traiter le blob comme un UploadedFile
    const filename = imageSource instanceof File ? imageSource.name : 'capture.jpg';
    formData.append('image', imageSource, filename);

    try {
        const response = await fetch("{{ path('api_vision_analyze') }}", {
            method: 'POST',
            body: formData
        });

        const data = await response.json();
        document.getElementById('smartScanLoadingModal').style.display = 'none';
        
        if (response.ok) {
            if (data.matchType === 'exact') {
                window.location.href = "{{ path('app_mouvement_index') }}?article=" + data.articleId;
            } else {
                openAddProductModal();
                setTimeout(() => {
                    const form = document.querySelector('#addProductModal form');
                    if (form) {
                        const nomInput = form.querySelector('input[name*="[nom]"]');
                        if (nomInput && data.suggestedName) nomInput.value = data.suggestedName;
                        const catSelect = form.querySelector('select[name*="[categorie]"]');
                        if (catSelect && data.categoryId) catSelect.value = data.categoryId;
                    }
                }, 600);
            }
        } else {
            alert("❌ IA : " + (data.error || "Identification impossible."));
        }
    } catch (e) {
        console.error("Erreur Fetch IA:", e);
        document.getElementById('smartScanLoadingModal').style.display = 'none';
        alert("Erreur de communication avec le serveur.");
    }
}

async function traduireEtLire(texte, langDest, ttsLang) {
    if (langDest === 'fr') {
        lireDescriptionBase(texte, ttsLang);
        return;
    }
    
    try {
        const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=fr&tl=${langDest}&dt=t&q=${encodeURIComponent(texte)}`;
        const response = await fetch(url);
        const data = await response.json();
        
        let translatedText = '';
        if (data && data[0]) {
            data[0].forEach(chunk => {
                if (chunk[0]) translatedText += chunk[0];
            });
        }
        
        lireDescriptionBase(translatedText || texte, ttsLang);
    } catch (e) {
        console.error("Erreur de traduction:", e);
        lireDescriptionBase(texte, ttsLang);
    }
}

function lireDescriptionBase(texte, langue) {
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const message = new SpeechSynthesisUtterance(texte);
        message.lang = langue; 
        message.pitch = 1;
        message.rate = 0.9;
        window.speechSynthesis.speak(message);
    } else {
        alert("Désolé, votre navigateur ne supporte pas la synthèse vocale.");
    }
}
</script>
