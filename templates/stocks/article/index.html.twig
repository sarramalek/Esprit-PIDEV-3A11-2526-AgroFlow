// --- LOGIQUE FOURNISSEUR D'URGENCE (LEAFLET + GEOLOCATION) ---
let mapInitialized = false;
let emergencyMap = null;
let supplierLayerGroup = null;

window.currentArticleQueries = [];

function getQueriesForArticle(articleName, categoryName) {
    let name = articleName.toLowerCase();
    let cat = categoryName.toLowerCase();

    // Mapping intelligent selon le nom et la catÃ©gorie
    if (name.includes('viande') || name.includes('meat') || name.includes('poulet') || cat.includes('viande') || cat.includes('animal')) {
        return ["boucherie", "supermarchÃ©", "marchÃ©"];
    }
    if (name.includes('tomate') || name.includes('lÃ©gume') || name.includes('fruit') || cat.includes('lÃ©gume') || cat.includes('fruit')) {
        return ["marchÃ© aux lÃ©gumes", "primeur", "marchÃ©", "supermarchÃ©"];
    }
    if (name.includes('pain') || name.includes('blÃ©') || name.includes('farine') || cat.includes('cÃ©rÃ©ale')) {
        return ["boulangerie", "moulin", "supermarchÃ©"];
    }
    if (name.includes('lait') || name.includes('fromage') || cat.includes('laitier')) {
        return ["fromagerie", "laiterie", "supermarchÃ©"];
    }
    if (name.includes('semence') || name.includes('graine') || name.includes('engrais') || name.includes('pesticide') || cat.includes('intrant') || cat.includes('semence')) {
        return ["pÃ©piniÃ¨re", "agriculture", "jardinerie"];
    }
    if (name.includes('tracteur') || cat.includes('matÃ©riel') || cat.includes('machine') || cat.includes('outil')) {
        return ["matÃ©riel agricole", "quincaillerie"];
    }

    // Recherche par dÃ©faut
    return [articleName, "marchÃ©", "supermarchÃ©", "agriculture"];
}

function openEmergencyModalForArticle(articleName, categoryName) {
    document.getElementById('emergencySupplierModal').style.display = 'flex';
    document.getElementById('emergencyModalText').innerHTML = `Vous cherchez l'article <strong>${articleName}</strong>. Voici les endroits Ã  proximitÃ© oÃ¹ vous pourriez le trouver :`;
    
    window.currentArticleQueries = getQueriesForArticle(articleName, categoryName);
    
    setTimeout(initEmergencyMap, 300);
}

function initEmergencyMap() {
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                const userLat = position.coords.latitude;
                const userLon = position.coords.longitude;
                loadMapAndSuppliers(userLat, userLon);
            },
            (error) => {
                console.error("Erreur de gÃ©olocalisation:", error);
                document.getElementById('supplierLoading').innerHTML = "<span style='color:red;'>Impossible d'obtenir votre position. Veuillez activer la gÃ©olocalisation.</span>";
            }
        );
    } else {
        document.getElementById('supplierLoading').innerHTML = "<span style='color:red;'>La gÃ©olocalisation n'est pas supportÃ©e par votre navigateur.</span>";
    }
}

function loadMapAndSuppliers(lat, lon) {
    if (!mapInitialized) {
        emergencyMap = L.map('emergencyMap').setView([lat, lon], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: 'Â© OpenStreetMap'
        }).addTo(emergencyMap);

        // Marker for user (Farm)
        const userIcon = L.icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        });

        L.marker([lat, lon], {icon: userIcon}).addTo(emergencyMap)
            .bindPopup('<b>Votre Position</b>').openPopup();

        supplierLayerGroup = L.layerGroup().addTo(emergencyMap);
        mapInitialized = true;
    } else {
        // Clear previous suppliers if the modal is opened for another article
        supplierLayerGroup.clearLayers();
    }

    const listContainer = document.getElementById('supplierList');
    listContainer.innerHTML = "<p style='text-align:center;'><i class='fa fa-spinner fa-spin'></i> Recherche de lieux de vente...</p>";
    
    let queryIndex = 0;
    const queries = window.currentArticleQueries;

    function executeSearch() {
        if (queryIndex >= queries.length) {
            listContainer.innerHTML = "<p style='padding:10px; color:#666;'>Aucun fournisseur spÃ©cifique trouvÃ© Ã  proximitÃ© immÃ©diate.</p>";
            return;
        }

        const query = queries[queryIndex];
        
        fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=15&lat=${lat}&lon=${lon}`)
        .then(res => res.json())
        .then(data => {
            if (data.length === 0) {
                queryIndex++;
                executeSearch();
                return;
            }
            
            listContainer.innerHTML = "";
            let bounds = [];
            bounds.push([lat, lon]);

            // Sort by distance locally just to be sure
            data.forEach(supp => {
                supp.distance = calculateDistance(lat, lon, parseFloat(supp.lat), parseFloat(supp.lon));
            });
            data.sort((a, b) => a.distance - b.distance);

            data.forEach(supp => {
                const suppLat = parseFloat(supp.lat);
                const suppLon = parseFloat(supp.lon);
                const name = supp.name || supp.display_name.split(',')[0];
                const distance = supp.distance;
                
                const marker = L.marker([suppLat, suppLon]).bindPopup(`<b>${name}</b><br>Distance: ${distance.toFixed(2)} km`);
                supplierLayerGroup.addLayer(marker);
                    
                bounds.push([suppLat, suppLon]);

                const item = document.createElement('div');
                item.style.padding = "10px";
                item.style.borderBottom = "1px solid #eee";
                item.innerHTML = `<strong><i class="fa fa-store" style="color: #2D5A27; margin-right: 8px;"></i> ${name}</strong> <span style="float:right; font-weight:bold; color:#e74c3c;">${distance.toFixed(2)} km</span>`;
                listContainer.appendChild(item);
            });
            
            emergencyMap.fitBounds(bounds);
        })
        .catch(err => {
            console.error("Erreur Nominatim:", err);
            queryIndex++;
            executeSearch(); // Fallback on next query on error
        });
    }

    executeSearch();
}

function calculateDistance(lat1, lon1, lat2, lon2) {
    const R = 6371; // km
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = 
        Math.sin(dLat/2) * Math.sin(dLat/2) +
        Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
        Math.sin(dLon/2) * Math.sin(dLon/2); 
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); 
    return R * c;
}

