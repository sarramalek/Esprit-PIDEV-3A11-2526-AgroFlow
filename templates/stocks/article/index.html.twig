{% extends 'base_agriculteur.html.twig' %}


{% block title %}Gestion des Articles - AgroFlow{% endblock %}

{% block body %}
<div class="dash-wrapper" style="padding: 30px; background-color: #f8f9fa;">
    
    {# --- EN-TÊTE DYNAMIQUE --- #}
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <div>
            <h2 style="margin:0; color:#1a2a19; font-size:28px; font-weight: 800; letter-spacing: -0.5px;">
                <i class="fa fa-boxes-stacked" style="color: #2D5A27; margin-right: 10px;"></i>Gestion des Articles
            </h2>
            <p style="margin:5px 0 0; color:#6c757d; font-size:15px;">Suivi en temps réel de votre inventaire agricole</p>
        </div>
        <a href="{{ path('app_article_new') }}" class="badge badge-green" style="text-decoration:none; padding: 12px 20px; font-size: 14px; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(45, 90, 39, 0.2);">
            <i class="fa fa-plus-circle"></i> Nouveau Produit
        </a>
    </div>

    {# --- CONTENEUR DU TABLEAU --- #}
    <div class="card" style="background: white; border: none; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); overflow: hidden;">
        <div style="padding: 20px 25px; border-bottom: 1px solid #f1f1f1; background: #fff;">
            <h3 style="margin:0; font-size: 16px; color: #444; font-weight: 600;">Liste des produits disponibles</h3>
        </div>

        <table class="users-table" style="width: 100%; border-collapse: separate; border-spacing: 0;">
            <thead style="background-color: #fcfdfc;">
                <tr>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase;">Référence</th>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase;">Désignation</th>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase;">Catégorie</th>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase;">État du Stock</th>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase;">Unité</th>
                    <th style="padding: 15px 25px; color: #888; font-size: 12px; text-transform: uppercase; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for article in articles %}
                <tr style="transition: all 0.2s ease;">
                    <td style="padding: 18px 25px;">
                        <span style="font-family: 'Courier New', monospace; background: #f0f0f0; padding: 4px 8px; border-radius: 6px; font-size: 13px; color: #666;">
                            #{{ article.id }}
                        </span>
                    </td>
                    <td style="padding: 18px 25px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 40px; height: 40px; background: #EAF3DE; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #2D5A27;">
                                <i class="fa fa-seedling"></i>
                            </div>
                            <span style="font-weight: 600; color: #2C3E50; font-size: 15px;">{{ article.nom }}</span>
                        </div>
                    </td>
                    <td style="padding: 18px 25px;">
                        <span class="badge badge-blue" style="border-radius: 20px; padding: 5px 12px; font-weight: 500;">
                            <i class="fa fa-tag" style="font-size: 10px; margin-right: 5px;"></i>
                            {{ article.categorie ? article.categorie.nom : 'Non classé' }}
                        </span>
                    </td>
                    <td style="padding: 18px 25px;">
                        {% if article.quantiteEnStock > article.seuilAlerte %}
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <span style="font-weight: 700; color: #2D5A27; font-size: 16px;">{{ article.quantiteEnStock }}</span>
                                <span style="font-size: 11px; color: #2ecc71; text-transform: uppercase; font-weight: bold;">Optimal</span>
                            </div>
                        {% elseif article.quantiteEnStock > 0 %}
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <span style="font-weight: 700; color: #d35400; font-size: 16px;">{{ article.quantiteEnStock }}</span>
                                <span style="font-size: 11px; color: #e67e22; text-transform: uppercase; font-weight: bold;">Seuil atteint</span>
                            </div>
                        {% else %}
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                                <span style="font-weight: 700; color: #c0392b; font-size: 16px;">0</span>
                                <span style="font-size: 11px; color: #e74c3c; text-transform: uppercase; font-weight: bold;">Rupture</span>
                            </div>
                        {% endif %}
                    </td>
                    <td style="padding: 18px 25px;">
                        <span style="color: #7f8c8d; font-weight: 500;">{{ article.uniteMesure }}</span>
                    </td>
                    <td style="padding: 18px 25px;">
                        <div style="display: flex; justify-content: center; gap: 8px;">
                            <a href="{{ path('app_article_edit', {'id': article.id}) }}" 
                               style="height: 35px; width: 35px; background: #eef2f7; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #185FA5; text-decoration: none; transition: 0.3s;">
                                <i class="fa fa-pen-to-square"></i>
                            </a>
                            <div style="height: 35px; width: 35px; background: #fdeaea; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                {{ include('stocks/article/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" style="text-align:center; padding:60px;">
                        <i class="fa fa-folder-open" style="font-size: 40px; color: #eee; display: block; margin-bottom: 10px;"></i>
                        <span style="color:#999; font-style: italic;">Aucun article trouvé dans l'inventaire.</span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Effet de survol sur les lignes */
    .users-table tbody tr:hover {
        background-color: #f9fff9 !important;
        transform: scale(1.002);
    }
    
    /* On enlève les bordures par défaut du bouton delete s'il y en a */
    .users-table form button {
        background: transparent !important;
        border: none !important;
        color: #A32D2D !important;
        padding: 0 !important;
        cursor: pointer;
    }
</style>
{% endblock %}