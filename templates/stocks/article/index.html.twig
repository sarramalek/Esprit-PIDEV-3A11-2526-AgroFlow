<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
async function handleSmartScan(event) {
    const file = event.target.files[0];
    if (!file) return;

    // Afficher le chargement
    document.getElementById('smartScanLoadingModal').style.display = 'flex';

    const formData = new FormData();
    formData.append('image', file);

    try {
        const response = await fetch("{{ path('api_vision_analyze') }}", {
            method: 'POST',
            body: formData
        });

        const data = await response.json();
        document.getElementById('smartScanLoadingModal').style.display = 'none';
        event.target.value = ''; // Reset input

        if (response.ok) {
            if (data.matchType === 'exact') {
                // Redirection directe vers les mouvements
                window.location.href = "{{ path('app_mouvement_index') }}?article=" + data.articleId;
            } else {
                // Saisie Augmentée : Ouvrir la modale et pré-remplir
                openAddProductModal();
                
                setTimeout(() => {
                    const form = document.querySelector('#addProductModal form');
                    if (form) {
                        // Pré-remplir le Nom
                        const nomInput = form.querySelector('input[name*="[nom]"]');
                        if (nomInput && data.suggestedName) {
                            nomInput.value = data.suggestedName;
                            nomInput.style.backgroundColor = '#fff9db'; // Surbrillance jaune pour montrer que c'est de l'IA
                        }

                        // Pré-remplir la Catégorie
                        const catSelect = form.querySelector('select[name*="[categorie]"]');
                        if (catSelect && data.categoryId) {
                            catSelect.value = data.categoryId;
                            catSelect.style.backgroundColor = '#fff9db';
                        }
                    }
                }, 600);
            }
        } else {
            alert("❌ Erreur IA : " + (data.error || "Impossible d'identifier l'image."));
        }
    } catch (e) {
        console.error(e);
        document.getElementById('smartScanLoadingModal').style.display = 'none';
        alert("Une erreur de connexion est survenue.");
    }
}

async function traduireEtLire(texte, langDest, ttsLang) {
    if (langDest === 'fr') {
        lireDescriptionBase(texte, ttsLang);
        return;
    }
    
    try {
        const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=fr&tl=${langDest}&dt=t&q=${encodeURIComponent(texte)}`;
        const response = await fetch(url);
        const data = await response.json();
        
        let translatedText = '';
        if (data && data[0]) {
            data[0].forEach(chunk => {
                if (chunk[0]) translatedText += chunk[0];
            });
        }
        
        lireDescriptionBase(translatedText || texte, ttsLang);
    } catch (e) {
        console.error("Erreur de traduction:", e);
        lireDescriptionBase(texte, ttsLang);
    }
}

function lireDescriptionBase(texte, langue) {
    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const message = new SpeechSynthesisUtterance(texte);
        message.lang = langue; 
        message.pitch = 1;
        message.rate = 0.9;
        window.speechSynthesis.speak(message);
    } else {
        alert("Désolé, votre navigateur ne supporte pas la synthèse vocale.");
    }
}
</script>
