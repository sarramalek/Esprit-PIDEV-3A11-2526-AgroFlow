{% extends 'base_agriculteur.html.twig' %}


{% block title %}Gestion Stock - {{ article.nom }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Mouvement de stock : {{ article.nom }}</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Stock actuel :</strong> {{ article.quantiteEnStock }} {{ article.uniteMesure }}
            </div>

            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-4">{{ form_row(form.type) }}</div>
                    <div class="col-md-4">{{ form_row(form.quantite) }}</div>
                    <div class="col-md-4">{{ form_row(form.motif) }}</div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> Valider le mouvement
                    </button>
                    <a href="{{ path('agri_produits') }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}