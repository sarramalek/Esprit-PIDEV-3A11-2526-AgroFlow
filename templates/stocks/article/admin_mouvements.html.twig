{% extends 'base_admin.html.twig' %}

{% block title %}Historique des Mouvements - AgroFlow{% endblock %}

{% block body %}
<div class="dash-wrapper" style="padding: 30px; font-family: 'DM Sans', sans-serif;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; flex-wrap:wrap; gap:14px;">
        <div>
            <h2 style="margin:0; color:#1a2a19; font-size:28px; font-weight: 800; letter-spacing: -0.5px;">
                <i class="fa fa-history" style="color: #2D5A27; margin-right: 10px;"></i>Historique des Mouvements
            </h2>
            <p style="margin:5px 0 0; color:#6c757d; font-size:15px;">Suivi complet des entrées et sorties de stock.</p>
        </div>

        <div style="display: flex; gap: 10px;">
            <a href="{{ path('admin_stock_pdf', {type: 'mouvements', q: searchTerm}) }}" class="btn-primary-action" style="background: #2c3e50;">
                <i class="fa fa-file-pdf"></i> Exporter cet historique
            </a>
            <a href="{{ path('admin_stock_index') }}" class="btn-primary-action" style="background: #6c757d;">
                <i class="fa fa-arrow-left"></i> Retour aux Produits
            </a>
        </div>
    </div>

    {# --- BARRE DE RECHERCHE --- #}
    <div style="background: white; padding: 20px; border-radius: 12px; margin-bottom: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
        <form method="get" style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px; position: relative;">
                <i class="fa fa-search" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
                <input type="text" name="q" value="{{ searchTerm }}" placeholder="Rechercher par produit ou agriculteur..." 
                       style="width: 100%; padding: 12px 12px 12px 45px; border: 1px solid #E2E8F0; border-radius: 8px; outline: none;">
            </div>
            <button type="submit" style="background: #2D5A27; color: white; padding: 12px 25px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Rechercher
            </button>
            {% if searchTerm %}
                <a href="{{ path('admin_stock_mouvements') }}" style="color: #6c757d; text-decoration: none; font-size: 14px;">Réinitialiser</a>
            {% endif %}
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead style="background-color: #f8f9fa;">
                <tr>
                    <th>Date</th>
                    <th>Article</th>
                    <th>Type</th>
                    <th>Quantité</th>
                    <th>Agriculteur / Admin</th>
                    <th>Motif</th>
                </tr>
            </thead>
            <tbody>
                {% for m in mouvements %}
                    <tr>
                        <td>
                            <div style="font-weight: 600;">{{ m.dateMouvement|date('d/m/Y') }}</div>
                            <small style="color: #999;">{{ m.dateMouvement|date('H:i') }}</small>
                        </td>
                        <td>
                            <div style="font-weight: 700; color: #2D5A27;">{{ m.article.nom }}</div>
                            <small>{{ m.article.categorie ? m.article.categorie.nom : '-' }}</small>
                        </td>
                        <td>
                            <span class="badge {{ m.type == 'ENTREE' ? 'badge-success' : 'badge-danger' }}" 
                                  style="padding: 6px 12px; border-radius: 6px; font-size: 11px;">
                                {{ m.type }}
                            </span>
                        </td>
                        <td>
                            <div style="font-size: 16px; font-weight: 700;">
                                {{ m.type == 'SORTIE' ? '-' : '+' }}{{ m.quantite }}
                                <small style="font-weight: 400;">{{ m.article.uniteMesure }}</small>
                            </div>
                        </td>
                        <td>
                            {% if m.user %}
                                <div style="font-size: 13px; font-weight: 600;">{{ m.user.nom }} {{ m.user.prenom }}</div>
                                <small style="color: #999;">CIN: {{ m.user.cin }}</small>
                            {% else %}
                                <span style="color: #ccc;">Système</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="max-width: 200px; font-size: 13px; color: #666; font-style: italic;">
                                {{ m.motif ?: 'Aucun motif' }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center" style="padding: 50px; color: #999;">
                            <i class="fa fa-history" style="font-size: 40px; display: block; margin-bottom: 10px; opacity: 0.2;"></i>
                            Aucun mouvement enregistré.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
.badge-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
.badge-danger { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
.btn-primary-action {
    background: linear-gradient(135deg, #2D5A27, #4CAF50);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}
.btn-primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(45, 90, 39, 0.3);
    color: white;
}
.table-responsive {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    overflow: hidden;
}
.table th {
    border-top: none;
    font-weight: 600;
    color: #2D5A27;
    padding: 15px;
}
.table td {
    padding: 15px;
    vertical-align: middle;
}
</style>
{% endblock %}
