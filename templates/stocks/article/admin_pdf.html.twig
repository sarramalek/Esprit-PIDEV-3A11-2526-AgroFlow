<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Export Stock - AgroFlow</title>
    <style>
        body { font-family: Arial, sans-serif; font-size: 12px; color: #333; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #2D5A27; padding-bottom: 10px; }
        .header h1 { color: #2D5A27; margin: 0; }
        .info { margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th { background-color: #2D5A27; color: white; padding: 10px; text-align: left; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        .footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 10px; color: #777; }
        .badge { padding: 3px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }
        .badge-entree { background-color: #d4edda; color: #155724; }
        .badge-sortie { background-color: #f8d7da; color: #721c24; }
    </style>
</head>
<body>
    <div class="header">
        <h1>AgroFlow - Rapport de Stock</h1>
        <p>Généré le {{ "now"|date("d/m/Y H:i") }}</p>
    </div>

    <div class="info">
        <p><strong>Type de rapport :</strong> {{ type|capitalize }}</p>
        {% if agriculteur and agriculteur != 'all' %}
            <p><strong>Propriétaire :</strong> CIN {{ agriculteur }}</p>
        {% else %}
            <p><strong>Propriétaire :</strong> Tous les agriculteurs</p>
        {% endif %}
    </div>

    <table>
        <thead>
            {% if type == 'articles' %}
                <tr>
                    <th>Article</th>
                    <th>Catégorie</th>
                    <th>Stock Actuel</th>
                    <th>Prix Unitaire</th>
                    <th>Valeur Totale</th>
                </tr>
            {% else %}
                <tr>
                    <th>Date</th>
                    <th>Article</th>
                    <th>Type</th>
                    <th>Quantité</th>
                    <th>Motif</th>
                </tr>
            {% endif %}
        </thead>
        <tbody>
            {% for item in results %}
                {% if type == 'articles' %}
                    <tr>
                        <td>{{ item.nom }}</td>
                        <td>{{ item.categorie ? item.categorie.nom : '-' }}</td>
                        <td>{{ item.quantiteEnStock }} {{ item.uniteMesure }}</td>
                        <td>{{ item.prixUnitaire|number_format(3, ',', ' ') }} TND</td>
                        <td>{{ (item.quantiteEnStock * item.prixUnitaire)|number_format(3, ',', ' ') }} TND</td>
                    </tr>
                {% else %}
                    <tr>
                        <td>{{ item.dateMouvement|date("d/m/Y H:i") }}</td>
                        <td>{{ item.article.nom }}</td>
                        <td>
                            <span class="badge {{ item.type == 'ENTREE' ? 'badge-entree' : 'badge-sortie' }}">
                                {{ item.type }}
                            </span>
                        </td>
                        <td>{{ item.quantite }}</td>
                        <td>{{ item.motif }}</td>
                    </tr>
                {% endif %}
            {% else %}
                <tr>
                    <td colspan="5" style="text-align: center;">Aucune donnée trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        AgroFlow - Système de Gestion Agricole Intelligent - &copy; {{ "now"|date("Y") }}
    </div>
</body>
</html>
