<div class="agro-form-container" style="max-width: 100%; background: white;">
    {{ form_start(form, {'action': path('app_article_edit', {'id': article.id}), 'method': 'POST', 'attr': {'id': 'edit-product-form'}}) }}
        <div class="agro-form-body" style="padding: 20px;">
            
            {# --- DESIGNATION --- #}
            <div style="margin-bottom: 20px;">
                <label class="form-label-modern"><i class="fa fa-tag"></i> Désignation</label>
                {{ form_widget(form.nom, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: Pommes de terre'}}) }}
                <div class="form-error-message">{{ form_errors(form.nom) }}</div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                {# --- CATEGORIE --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-layer-group"></i> Catégorie</label>
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-input-modern'}}) }}
                    <div class="form-error-message">{{ form_errors(form.categorie) }}</div>
                </div>

                {# --- UNITE --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-balance-scale"></i> Unité de mesure</label>
                    {{ form_widget(form.unite_mesure, {'attr': {'class': 'form-input-modern'}}) }}
                    <div class="form-error-message">{{ form_errors(form.unite_mesure) }}</div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                {# --- DEVISE --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-coins"></i> Devise d'achat</label>
                    {{ form_widget(form.devise, {'attr': {'class': 'form-input-modern'}}) }}
                </div>

                {# --- PRIX ACHAT --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-wallet"></i> Prix d'achat original</label>
                    {{ form_widget(form.prix_achat_devise, {'attr': {'class': 'form-input-modern'}}) }}
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                {# --- PRIX TND --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-calculator"></i> Prix Unitaire (TND)</label>
                    {{ form_widget(form.prix_unitaire, {'attr': {'class': 'form-input-modern', 'readonly': 'readonly', 'style': 'background:#f8fafc;'}}) }}
                    <small style="font-size: 10px; color: #7f8c8d;">* Automatique via taux de change</small>
                </div>

                {# --- SEUIL --- #}
                <div>
                    <label class="form-label-modern"><i class="fa fa-bell"></i> Seuil d'alerte</label>
                    {{ form_widget(form.seuil_alerte, {'attr': {'class': 'form-input-modern'}}) }}
                    <div class="form-error-message">{{ form_errors(form.seuil_alerte) }}</div>
                </div>
            </div>

            {# Champ caché ou lecture seule si nécessaire pour la cohérence #}
            {% if form.quantite_en_stock is defined %}
            <div style="opacity: 0.7; margin-top: 10px;">
                <label class="form-label-modern"><i class="fa fa-warehouse"></i> Stock actuel (Lecture seule)</label>
                {{ form_widget(form.quantite_en_stock, {'attr': {'class': 'form-input-modern', 'readonly': 'readonly'}}) }}
            </div>
            {% endif %}
        </div>

        <div style="background: #f8fafc; padding: 20px; display: flex; justify-content: flex-end; gap: 12px; border-radius: 0 0 20px 20px;">
            <button type="button" class="btn-cancel-modern" onclick="closeEditProductModal()">Annuler</button>
            <button type="submit" class="btn-primary-action" style="background: #2D5A27 !important;">
                <i class="fa fa-check-circle"></i> Enregistrer les modifications
            </button>
        </div>
    {{ form_end(form) }}
</div>

<script>
(function() {
    const form = document.getElementById('edit-product-form');
    const deviseSelect = form.querySelector('[name*="[devise]"]');
    const prixAchatInput = form.querySelector('[name*="[prix_achat_devise]"]');
    const prixUnitaireInput = form.querySelector('[name*="[prix_unitaire]"]');
    
    const rates = { 'EUR': 3.385, 'USD': 3.120, 'GBP': 3.920, 'DZD': 0.023, 'MAD': 0.312, 'TND': 1 };

    function updatePreview() {
        const amount = parseFloat(prixAchatInput.value) || 0;
        const currency = deviseSelect.value;
        
        if (currency === 'TND') {
            prixUnitaireInput.readOnly = false;
            prixUnitaireInput.style.background = "white";
        } else {
            const estimation = amount * (rates[currency] || 1);
            prixUnitaireInput.value = estimation.toFixed(3);
            prixUnitaireInput.style.background = "#f1f5f9";
            prixUnitaireInput.readOnly = true;
        }
    }

    if (deviseSelect && prixAchatInput) {
        deviseSelect.addEventListener('change', updatePreview);
        prixAchatInput.addEventListener('input', updatePreview);
        updatePreview(); // Init au chargement
    }
})();
</script>

<style>
    .form-label-modern {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #4A5568;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .form-input-modern {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #E2E8F0;
        border-radius: 10px;
        transition: all 0.3s ease;
        font-family: 'DM Sans', sans-serif;
    }
    .form-input-modern:focus {
        border-color: #2D5A27;
        outline: none;
        box-shadow: 0 0 0 3px rgba(45, 90, 39, 0.1);
    }
    .form-error-message ul {
        margin: 5px 0 0 0;
        padding: 0;
        list-style: none;
        color: #e74c3c;
        font-size: 12px;
        font-weight: 600;
    }
    .btn-cancel-modern {
        padding: 10px 20px;
        border-radius: 10px;
        border: 1px solid #CBD5E0;
        background: white;
        color: #4A5568;
        font-weight: 600;
        cursor: pointer;
    }
</style>