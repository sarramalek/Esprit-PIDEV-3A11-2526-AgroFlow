{% extends 'base_agriculteur.html.twig' %}

{% block title %}QR Code - {{ article.nom }} - AgroFlow{% endblock %}

{% block body %}
<div class="dash-wrapper" style="padding: 30px; font-family: 'DM Sans', sans-serif; background-color: transparent !important;">
    
    {# --- EN-TÊTE --- #}
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <div>
            <h2 style="margin:0; color:#1a2a19; font-size:28px; font-weight: 800; letter-spacing: -0.5px;">
                <i class="fa fa-qrcode" style="color: #2D5A27; margin-right: 10px;"></i>QR Code - {{ article.nom }}
            </h2>
            <p style="margin:5px 0 0; color:#6c757d; font-size:15px;">Code QR unique pour identifier cet article</p>
        </div>
        
        <div style="display: flex; gap: 10px;">
            <a href="{{ path('agri_produits') }}" class="btn-secondary-action">
                <i class="fa fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ downloadUrl }}" class="btn-primary-action" target="_blank">
                <i class="fa fa-download"></i> Télécharger PNG
            </a>
        </div>
    </div>

    {# --- CONTENU PRINCIPAL --- #}
    <div style="display: flex; gap: 40px; align-items: flex-start;">
        
        {# --- QR CODE --- #}
        <div style="flex: 1; max-width: 400px;">
            <div class="main-card-table" style="padding: 30px; text-align: center;">
                <h3 style="margin-bottom: 20px; color: #2D5A27;">Code QR de l'article</h3>
                <div style="background: white; padding: 20px; border-radius: 12px; border: 2px solid #e1e1e1;">
                    <img src="{{ qrCodeUrl }}" alt="QR Code pour {{ article.nom }}" style="max-width: 100%; height: auto;">
                </div>
                <p style="margin-top: 15px; font-size: 12px; color: #666;">
                    Scannez ce code pour accéder directement à la fiche de l'article
                </p>
            </div>
        </div>

        {# --- INFORMATIONS --- #}
        <div style="flex: 1; max-width: 400px;">
            <div class="main-card-table" style="padding: 30px;">
                <h3 style="margin-bottom: 20px; color: #2D5A27;">Informations de l'article</h3>
                
                <div style="display: grid; gap: 15px;">
                    <div style="display: flex; justify-content: space-between; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                        <strong style="color: #2D5A27;">Nom:</strong>
                        <span>{{ article.nom }}</span>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                        <strong style="color: #2D5A27;">Catégorie:</strong>
                        <span>{{ article.categorie ? article.categorie.nom : 'Non classé' }}</span>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                        <strong style="color: #2D5A27;">Prix unitaire:</strong>
                        <span>{{ article.prixUnitaire|number_format(2, '.', ' ') }} DT</span>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                        <strong style="color: #2D5A27;">Stock actuel:</strong>
                        <span>{{ article.quantiteEnStock }} unités</span>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; padding: 10px; background: #f8f9fa; border-radius: 8px;">
                        <strong style="color: #2D5A27;">ID Article:</strong>
                        <span>#{{ article.id }}</span>
                    </div>
                </div>

                <div style="margin-top: 25px; padding: 15px; background: #e8f5e8; border-radius: 8px; border-left: 4px solid #2D5A27;">
                    <h4 style="margin: 0 0 10px 0; color: #2D5A27; font-size: 14px;">
                        <i class="fa fa-lightbulb"></i> Comment utiliser ce QR Code ?
                    </h4>
                    <ul style="margin: 0; padding-left: 20px; font-size: 13px; color: #555;">
                        <li>Imprimez ce code et collez-le sur l'emballage ou l'étagère</li>
                        <li>Scannez-le avec votre téléphone pour accéder rapidement à la fiche</li>
                        <li>Idéal pour les inventaires physiques et les sorties de stock</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {# --- ACTIONS SUPPLÉMENTAIRES --- #}
    <div style="margin-top: 30px; display: flex; gap: 15px; justify-content: center;">
        <button onclick="window.print()" class="btn-secondary-action" style="padding: 12px 24px;">
            <i class="fa fa-print"></i> Imprimer le QR Code
        </button>
        <a href="{{ path('article_show', {'id': article.id}) }}" class="btn-primary-action" style="padding: 12px 24px;">
            <i class="fa fa-eye"></i> Voir la fiche complète
        </a>
    </div>
</div>

<style>
    @media print {
        body * { visibility: hidden; }
        .dash-wrapper, .dash-wrapper * { visibility: visible; }
        .dash-wrapper { position: absolute; left: 0; top: 0; width: 100%; }
        .btn-primary-action, .btn-secondary-action { display: none !important; }
    }
    
    .btn-primary-action { background: #2D5A27; color: white; border: none; padding: 12px 24px; border-radius: 10px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
    .btn-secondary-action { background: #eef2f7; color: #444; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; }
    .main-card-table { background: white; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); overflow: hidden; }
</style>

{% endblock %}