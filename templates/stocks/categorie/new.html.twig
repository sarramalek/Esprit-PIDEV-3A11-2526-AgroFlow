{% extends 'base_agriculteur.html.twig' %}

{% block title %}Nouvelle Catégorie - AgroFlow{% endblock %}

{% block body %}
{# On enlève le fond gris ici en mettant background: transparent #}
<div style="padding: 40px; background-color: transparent; min-height: 100vh;">
    
    {# Bouton Retour aligné à droite comme sur ton screen #}
    <div style="display: flex; justify-content: flex-end; margin-bottom: 20px; max-width: 800px; margin-left: auto; margin-right: auto;">
        <a href="{{ path('agri_categories') }}" style="text-decoration: none; color: #555; background: white; padding: 10px 20px; border-radius: 10px; border: 1px solid #EEE; font-size: 14px; font-weight: 600;">
            <i class="fa fa-arrow-left"></i> Retour
        </a>
    </div>

    {# Le Box Blanc (Card) #}
    <div style="width: 100%; max-width: 800px; background: white; padding: 40px; border-radius: 25px; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 10px 30px rgba(0,0,0,0.02); margin: 0 auto;">
        
        <div style="margin-bottom: 30px;">
            <h2 style="margin: 0; color: #1a2a19; font-size: 26px; font-weight: 800;">
               <i class="fa fa-tag" style="color: #2D5A27; margin-right: 10px;"></i> Nouvelle Catégorie
            </h2>
            <hr style="border: 0; border-top: 1px solid #F0F0F0; margin-top: 20px;">
        </div>

        {{ form_start(form, {'attr': {'id': 'category-form'}}) }}
            
            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="font-weight: 700; color: #666; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Nom de la catégorie</label>
                    <span id="msg-nom" style="font-size: 11px; font-weight: 700;"></span>
                </div>
                {{ form_widget(form.nom, {
                    'attr': {
                        'style': 'width: 100%; padding: 15px; border-radius: 12px; border: 1px solid #DDD; outline: none; transition: all 0.3s; font-size: 15px;',
                        'placeholder': 'ex: Engrais Azoté'
                    }
                }) }}
                <div style="color: #dc3545; font-size: 12px; margin-top: 5px; font-weight: 600;">
                    {{ form_errors(form.nom) }}
                </div>
            </div>

            <div style="margin-bottom: 30px;">
                <label style="display: block; font-weight: 700; color: #666; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Description</label>
                {{ form_widget(form.description, {
                    'attr': {
                        'style': 'width: 100%; padding: 15px; border-radius: 12px; border: 1px solid #DDD; outline: none; transition: all 0.3s; min-height: 120px; font-size: 15px;',
                        'placeholder': 'Détails sur la catégorie...'
                    }
                }) }}
            </div>

            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" id="btn-submit" style="background: #1a1a1a; color: white; border: none; padding: 15px 40px; border-radius: 12px; font-weight: 700; font-size: 15px; cursor: pointer; transition: all 0.3s;">
                    Enregistrer la catégorie
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
    input:focus, textarea:focus {
        border-color: #2D5A27 !important;
        box-shadow: 0 0 0 4px rgba(45, 90, 39, 0.1) !important;
    }
    #btn-submit:hover {
        background: #2D5A27 !important;
        transform: translateY(-2px);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const inputNom = document.querySelector('[name*="[nom]"]');
    const msgNom = document.getElementById('msg-nom');
    const btnSubmit = document.getElementById('btn-submit');

    inputNom.addEventListener('input', function() {
        const val = inputNom.value.trim();
        if (val.length === 0) {
            msgNom.textContent = "Obligatoire";
            msgNom.style.color = "#dc3545";
            inputNom.style.borderColor = "#dc3545";
        } else if (val.length < 3) {
            msgNom.textContent = "Trop court";
            msgNom.style.color = "#e67e22";
            inputNom.style.borderColor = "#e67e22";
        } else {
            msgNom.textContent = "Valide ✓";
            msgNom.style.color = "#2D5A27";
            inputNom.style.borderColor = "#2D5A27";
        }
    });
});
</script>
{% endblock %}