<div style="padding: 30px;">
    <div style="margin-bottom: 25px;">
        <span style="color: #2D5A27; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;">Édition</span>
        <h2 style="margin: 5px 0 0; color: #1a1a1a; font-size: 24px; font-weight: 800;">Modifier la Catégorie</h2>
    </div>

{{ form_start(form, {
    'attr': {'id': 'category-form'},
    'action': path('agri_categories_edit', {'id': categorie.id})
}) }}        <div style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <label style="font-weight: 700; color: #444; font-size: 13px;">Nom de la catégorie</label>
                <span id="msg-nom-edit" style="font-size: 11px; font-weight: 700; color: #2D5A27;">Valide ✓</span>
            </div>
            {{ form_widget(form.nom, {'attr': {
                'class': 'agro-input',
                'style': 'width:100%; padding:14px; border-radius:12px; border:1px solid #2D5A27; outline:none; transition:0.3s; box-sizing:border-box;'
            }}) }}
        </div>

        <div style="margin-bottom: 25px;">
            <label style="display:block; font-weight: 700; color: #444; font-size: 13px; margin-bottom: 8px;">Description</label>
            {{ form_widget(form.description, {'attr': {
                'class': 'agro-input',
                'style': 'width:100%; padding:14px; border-radius:12px; border:1px solid #ddd; outline:none; min-height:100px; box-sizing:border-box;'
            }}) }}
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end; border-top: 1px solid #eee; padding-top: 20px;">
            <button type="button" onclick="closeCategoryModal()" style="padding:12px 20px; border-radius:10px; border:none; background:#eee; color:#666; font-weight:600; cursor:pointer;">Annuler</button>
            <button type="submit" style="padding:12px 25px; border-radius:10px; border:none; background:#1a1a1a; color:white; font-weight:700; cursor:pointer; transition:0.3s;" onmouseover="this.style.background='#2D5A27'" onmouseout="this.style.background='#1a1a1a'">
                Mettre à jour
            </button>
        </div>
    {{ form_end(form) }}
</div>

<script>
(function() {
    const inputNom = document.querySelector('#category-form [name*="[nom]"]');
    const msgNom = document.getElementById('msg-nom-edit');

    inputNom.addEventListener('input', function() {
        const val = inputNom.value.trim();
        if (val.length === 0) {
            msgNom.textContent = "Obligatoire"; msgNom.style.color = "#dc3545"; inputNom.style.borderColor = "#dc3545";
        } else if (val.length < 3) {
            msgNom.textContent = "Trop court"; msgNom.style.color = "#e67e22"; inputNom.style.borderColor = "#e67e22";
        } else {
            msgNom.textContent = "Valide ✓"; msgNom.style.color = "#2D5A27"; inputNom.style.borderColor = "#2D5A27";
        }
    });
})();
</script>