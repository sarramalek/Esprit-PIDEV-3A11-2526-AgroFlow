{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Catégories - AgroFlow{% endblock %}

{% block body %}
<div class="dash-wrapper" style="padding: 30px; font-family: 'DM Sans', sans-serif; background-color: transparent !important;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="margin:0; font-size: 32px; color: #1a2a19;">Gestion des Catégories</h1>
            <p style="margin: 8px 0 0; color:#6c757d; font-size: 15px;">Liste des catégories que vous avez créées.</p>
        </div>
        <a href="{{ path('admin_categorie_new') }}" class="btn-primary-action">
            <i class="fa fa-plus"></i> Nouvelle Catégorie
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Agriculteur</th>
                    <th>Date de création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for categorie in categories %}
                    <tr>
                        <td>{{ categorie.nom }}</td>
                        <td>{{ categorie.description ?: 'Aucune description' }}</td>
                        <td>{{ categorie.agriculteur ? categorie.agriculteur.nom ~ ' ' ~ categorie.agriculteur.prenom : 'N/A' }}</td>
                        <td>{{ categorie.dateCreation ? categorie.dateCreation|date('d/m/Y') : 'N/A' }}</td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-sm btn-action btn-action-edit" title="Modifier">
                                    <i class="fa fa-pen"></i>
                                </a>
                                <form method="post" action="{{ path('admin_categorie_delete', {'id': categorie.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_categorie' ~ categorie.id) }}">
                                    <button class="btn btn-sm btn-action btn-action-delete" title="Supprimer" type="submit">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center">Aucune catégorie trouvée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
.btn-primary-action {
    background: linear-gradient(135deg, #2D5A27, #4CAF50);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.btn-primary-action:hover {
    background: linear-gradient(135deg, #4CAF50, #2D5A27);
    transform: translateY(-2px);
}

.table-responsive {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    overflow: hidden;
}

.table th {
    border-top: none;
    font-weight: 600;
    color: #2D5A27;
    padding: 15px;
}

.table td {
    padding: 15px;
    vertical-align: middle;
}

.btn-sm {
    padding: 6px 12px;
    font-size: 0.875rem;
}

.btn-outline-primary {
    border: 1px solid #2d5a27;
    color: #2d5a27;
    background: white;
}

.action-buttons{
    display: inline-flex;
    align-items: center;
    gap: 8px;
}
.btn-action{
    width: 36px;
    height: 36px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid #E2E8F0;
    background: #fff;
    transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
}
.btn-action:hover{
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.08);
}
.btn-action-edit{
    color: #2D5A27;
    border-color: rgba(45, 90, 39, 0.25);
}
.btn-action-edit:hover{
    border-color: #2D5A27;
}
.btn-action-delete{
    color: #c0392b;
    border-color: rgba(192, 57, 43, 0.25);
}
.btn-action-delete:hover{
    border-color: #c0392b;
}
</style>
{% endblock %}
