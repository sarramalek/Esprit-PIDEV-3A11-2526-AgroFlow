<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AgroFlow Admin{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    {# ═══════════════════════════════════════════════════
       CLOUDINARY — SDK JavaScript (transformation d'URL)
       Remplace "your_cloud_name" par ton cloud name réel
    ═══════════════════════════════════════════════════ #}
    <script>
        /**
         * Génère une URL Cloudinary optimisée à partir d'une URL brute
         * stockée en base (ex: https://res.cloudinary.com/cloud/image/upload/v123/avatar.jpg)
         *
         * @param {string} rawUrl   – URL brute issue de la BDD
         * @param {number} w        – largeur souhaitée (px)
         * @param {number} h        – hauteur souhaitée (px)
         * @returns {string}        – URL transformée (crop + face-detection)
         */
        function cloudinaryAvatar(rawUrl, w, h) {
            if (!rawUrl) return null;

            // Détecter si c'est déjà une URL Cloudinary
            var uploadPattern = /\/upload\//;
            if (!uploadPattern.test(rawUrl)) return rawUrl; // URL externe, on la retourne telle quelle

            // Injecter les transformations juste après "/upload/"
            var transform = 'c_fill,g_face,w_' + w + ',h_' + h + ',q_auto,f_auto/';
            return rawUrl.replace('/upload/', '/upload/' + transform);
        }

        /**
         * Initialise tous les éléments <img class="cloudinary-avatar">
         * en appliquant la transformation et en gérant le fallback initiales.
         */
        function initCloudinaryAvatars() {
            document.querySelectorAll('[data-cloudinary-src]').forEach(function(el) {
                var rawUrl = el.dataset.cloudinarySrc;
                var w = parseInt(el.dataset.w || el.width || 52, 10);
                var h = parseInt(el.dataset.h || el.height || 52, 10);
                var fallback = el.dataset.fallback || '';   // initiales

                if (rawUrl && rawUrl.trim() !== '' && rawUrl !== 'null') {
                    var optimized = cloudinaryAvatar(rawUrl.trim(), w, h);
                    el.src = optimized;
                    el.style.display = 'block';

                    // Masquer le fallback initiales s'il existe
                    var fbEl = document.getElementById(el.dataset.fallbackId);
                    if (fbEl) fbEl.style.display = 'none';

                    // En cas d'erreur de chargement → fallback initiales
                    el.onerror = function() {
                        el.style.display = 'none';
                        if (fbEl) fbEl.style.display = 'flex';
                    };
                } else {
                    // Pas d'URL → afficher initiales, cacher l'img
                    el.style.display = 'none';
                    var fbEl2 = document.getElementById(el.dataset.fallbackId);
                    if (fbEl2) fbEl2.style.display = 'flex';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', initCloudinaryAvatars);
    </script>

    <style>
        :root {
            --green-dark:   #1A3A1F;
            --green-mid:    #2D5A27;
            --green-accent: #4A8C3F;
            --green-light:  #C8E6C0;
            --cream:        #FCF8E6;
            --cream-dark:   #F0EAD0;
            --navy:         #1C2B3A;
            --text-main:    #1C2B3A;
            --text-muted:   #7A8A95;
            --white:        #FFFFFF;
            --sidebar-w:    260px;
            --topbar-h:     64px;
            --radius:       10px;
            --shadow:       0 2px 12px rgba(0,0,0,0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--cream);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* ═══════════════════════════════
           SIDEBAR
        ═══════════════════════════════ */
        .sidebar {
            width: var(--sidebar-w);
            background: var(--green-dark);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width 0.3s ease;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-track { background: transparent; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

        /* Brand */
        .sidebar-brand {
            padding: 22px 20px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }
        .sidebar-brand img { height: 38px; filter: brightness(0) invert(1); }
        .sidebar-brand-text {
            font-size: 18px;
            font-weight: 700;
            color: var(--cream);
            letter-spacing: -0.02em;
        }
        .sidebar-brand-text span { color: var(--green-light); }

        /* Nav */
        .sidebar-nav {
            padding: 12px 0;
            flex: 1;
        }

        .nav-section-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.3);
            padding: 14px 20px 6px;
        }

        .nav-item { position: relative; }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 11px 20px;
            color: rgba(255,255,255,0.72);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
            user-select: none;
        }
        .nav-link:hover {
            background: rgba(255,255,255,0.07);
            color: var(--cream);
            border-left-color: var(--green-light);
        }
        .nav-link.active {
            background: rgba(74,140,63,0.25);
            color: var(--cream);
            border-left-color: var(--green-accent);
        }
        .nav-link .nav-icon {
            width: 18px;
            text-align: center;
            font-size: 14px;
            flex-shrink: 0;
            opacity: 0.85;
        }
        .nav-link .nav-label { flex: 1; }
        .nav-link .nav-arrow {
            font-size: 10px;
            transition: transform 0.25s ease;
            opacity: 0.6;
        }
        .nav-item.open > .nav-link .nav-arrow {
            transform: rotate(90deg);
        }

        .nav-sub {
            list-style: none;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            background: rgba(0,0,0,0.18);
        }
        .nav-item.open > .nav-sub {
            max-height: 300px;
        }
        .nav-sub a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 20px 9px 46px;
            color: rgba(255,255,255,0.58);
            text-decoration: none;
            font-size: 13px;
            font-weight: 400;
            transition: all 0.2s;
            border-left: 3px solid transparent;
        }
        .nav-sub a:hover {
            color: var(--cream);
            background: rgba(255,255,255,0.05);
        }
        .nav-sub a.active {
            color: var(--green-light);
            font-weight: 500;
        }
        .nav-sub a .sub-dot {
            width: 5px; height: 5px;
            border-radius: 50%;
            background: currentColor;
            flex-shrink: 0;
            opacity: 0.7;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 14px 20px;
            border-top: 1px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }
        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 10px;
            transition: background 0.2s;
        }
        .sidebar-user:hover { background: rgba(255,255,255,0.05); }

        /* ─── Avatar wrapper ─────────────────────────────────
           Contient soit l'<img> Cloudinary soit les initiales
        ──────────────────────────────────────────────────── */
        .avatar-wrap {
            position: relative;
            flex-shrink: 0;
        }

        /* Image Cloudinary */
        .avatar-photo {
            display: none;          /* caché par défaut; JS l'active si URL valide */
            object-fit: cover;
            border-radius: 10px;
        }
        .avatar-photo.small { width: 36px; height: 36px; }
        .avatar-photo.big   { width: 52px; height: 52px; border-radius: 14px; }

        /* Fallback initiales */
        .sidebar-avatar {
            border-radius: 10px;
            background: var(--green-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: white;
        }
        .sidebar-avatar.small { width: 36px; height: 36px; }
        .sidebar-avatar.big   {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: linear-gradient(135deg,#4A8C3F,#2D5A27);
            font-size: 18px;
        }

        .sidebar-user-info { flex: 1; overflow: hidden; }
        .sidebar-user-name {
            font-size: 13px; font-weight: 600;
            color: var(--cream);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .sidebar-user-role {
            font-size: 11px; color: rgba(255,255,255,0.4);
        }

        /* Profile panel inputs */
        .pf-input {
            display: none;
            width: 100%;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 6px;
            color: #fff;
            font-size: 12px;
            padding: 5px 8px;
            margin-top: 3px;
            outline: none;
            font-family: 'DM Sans', sans-serif;
            transition: border 0.15s;
        }
        .pf-input:focus {
            border-color: rgba(74,140,63,0.8);
            background: rgba(255,255,255,0.12);
        }
        .pf-input.mono { font-family: 'DM Mono', monospace; }

        /* Toolbar buttons */
        .pf-btn {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.65);
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 6px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: all 0.15s;
            font-family: 'DM Sans', sans-serif;
        }
        .pf-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
        .pf-btn.save {
            background: rgba(74,140,63,0.3);
            border-color: rgba(74,140,63,0.5);
            color: #C8E6C0;
        }
        .pf-btn.save:hover { background: rgba(74,140,63,0.5); color: #fff; }
        .pf-btn.cancel {
            background: rgba(220,60,60,0.1);
            border-color: rgba(220,60,60,0.25);
            color: #ff9090;
        }
        .pf-btn.cancel:hover { background: rgba(220,60,60,0.22); }

        /* Bouton upload photo */
        .pf-photo-upload {
            display: none;          /* visible uniquement en mode édition */
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            background: rgba(255,255,255,0.06);
            border: 1px dashed rgba(255,255,255,0.2);
            border-radius: 8px;
            cursor: pointer;
            font-size: 11px;
            color: rgba(255,255,255,0.55);
            transition: all 0.2s;
            margin: 4px 16px 8px;
        }
        .pf-photo-upload:hover { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(74,140,63,0.5); }
        .pf-photo-upload input { display: none; }

        /* Barre de progression upload */
        .pf-upload-progress {
            display: none;
            height: 3px;
            background: rgba(255,255,255,0.1);
            border-radius: 2px;
            margin: 0 16px 8px;
            overflow: hidden;
        }
        .pf-upload-progress-bar {
            height: 100%;
            background: var(--green-accent);
            border-radius: 2px;
            width: 0%;
            transition: width 0.3s ease;
        }

        /* ═══════════════════════════════
           TOPBAR
        ═══════════════════════════════ */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--topbar-h);
            background: var(--white);
            border-bottom: 1px solid var(--cream-dark);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            z-index: 90;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        }

        .topbar-left { display: flex; align-items: center; gap: 16px; }
        .topbar-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--navy);
        }
        .topbar-breadcrumb {
            font-size: 13px;
            color: var(--text-muted);
            font-family: 'DM Mono', monospace;
        }
        .topbar-breadcrumb span { color: var(--green-accent); }

        .topbar-right { display: flex; align-items: center; gap: 14px; }

        .topbar-btn {
            width: 36px; height: 36px;
            border-radius: 8px;
            background: var(--cream);
            border: 1px solid var(--cream-dark);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; color: var(--text-muted);
            font-size: 14px; transition: all 0.2s;
            text-decoration: none;
        }
        .topbar-btn:hover { background: var(--cream-dark); color: var(--navy); }

        .topbar-badge { position: relative; }
        .topbar-badge::after {
            content: '';
            position: absolute;
            top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: #E53E3E;
            border-radius: 50%;
            border: 2px solid white;
        }

        /* ═══════════════════════════════
           MAIN CONTENT
        ═══════════════════════════════ */
        .main-wrapper {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            flex: 1;
            min-height: calc(100vh - var(--topbar-h));
            padding: 28px;
            background: var(--cream);
        }

        /* Flash messages */
        .flash-success {
            background: #e8f5e2;
            border: 1px solid #a3d48a;
            color: #2D5A27;
            padding: 12px 18px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .flash-error {
            background: #fdecea;
            border: 1px solid #f5a7a7;
            color: #8b1a1a;
            padding: 12px 18px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        {% block stylesheets %}{% endblock %}
    </style>
</head>

{# Vérification session — inchangée #}
<script>
function checkAndRedirect() {
    fetch('{{ path("app_check_session") }}', { credentials: 'same-origin' })
        .then(r => {
            if (r.status === 401 || r.redirected) {
                window.location.replace('{{ path("app_login") }}');
            }
        });
}
window.addEventListener('pageshow', function (e) { if (e.persisted) checkAndRedirect(); });
document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') checkAndRedirect(); });
checkAndRedirect();
</script>

