<!-- ═══════ SCRIPTS ═══════ -->
<script>
    /* ══════════════════════════════════════════════════════
       CLOUDINARY — Upload direct (unsigned preset)
       ▸ Remplace VOTRE_CLOUD_NAME   par ton cloud name
       ▸ Remplace VOTRE_UPLOAD_PRESET par ton unsigned preset
    ══════════════════════════════════════════════════════ */
    var CLOUDINARY_CLOUD_NAME   = 'dp0ily6qa';
    var CLOUDINARY_UPLOAD_PRESET = 'agroflow';  // preset non signé (unsigned)

    /**
     * Upload une photo vers Cloudinary et met à jour les avatars en temps réel.
     * Appelé quand l'utilisateur sélectionne un fichier via #photoFileInput.
     */
    function uploadPhotoToCloudinary(input) {
        if (!input.files || !input.files[0]) return;

        var file   = input.files[0];
        var label  = document.getElementById('photoUploadLabel');
        var bar    = document.getElementById('uploadProgressBar');
        var prog   = document.getElementById('uploadProgress');
        var txt    = document.getElementById('photoUploadText');

        // Afficher la barre de progression
        prog.style.display = 'block';
        bar.style.width    = '0%';
        txt.textContent    = 'Upload en cours…';
        label.style.pointerEvents = 'none';

        var formData = new FormData();
        formData.append('file',          file);
        formData.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);
        formData.append('folder',        'agroflow/avatars');

        var xhr = new XMLHttpRequest();

        // Progression
        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                bar.style.width = Math.round((e.loaded / e.total) * 100) + '%';
            }
        };

        xhr.onload = function() {
            label.style.pointerEvents = 'auto';
            prog.style.display = 'none';

            if (xhr.status === 200) {
                var res = JSON.parse(xhr.responseText);
                var secureUrl = res.secure_url;

                // Stocker l'URL dans le champ caché du formulaire
                document.getElementById('pfPhotoUrl').value = secureUrl;

                // Mettre à jour les deux avatars immédiatement
                _updateAvatarPhoto('pfPhotoSmall', 'pfAvatarSmall', secureUrl, 36, 36);
                _updateAvatarPhoto('pfPhotoBig',   'pfAvatarBig',   secureUrl, 52, 52);

                txt.textContent = 'Photo mise à jour ✓';
                showToast('Photo uploadée avec succès');
            } else {
                txt.textContent = 'Changer la photo de profil';
                showToast('Erreur lors de l\'upload', true);
            }
        };

        xhr.onerror = function() {
            label.style.pointerEvents = 'auto';
            prog.style.display = 'none';
            txt.textContent = 'Changer la photo de profil';
            showToast('Erreur réseau lors de l\'upload', true);
        };

        xhr.open('POST', 'https://api.cloudinary.com/v1_1/' + CLOUDINARY_CLOUD_NAME + '/image/upload');
        xhr.send(formData);
    }

    /**
     * Met à jour un avatar (img + fallback initiales) avec une URL Cloudinary.
     */
    function _updateAvatarPhoto(imgId, fallbackId, rawUrl, w, h) {
        var img = document.getElementById(imgId);
        var fb  = document.getElementById(fallbackId);
        if (!img) return;

        var optimized = cloudinaryAvatar(rawUrl, w, h);
        img.src = optimized;
        img.style.display = 'block';
        if (fb) fb.style.display = 'none';

        img.onerror = function() {
            img.style.display = 'none';
            if (fb) fb.style.display = 'flex';
        };
    }

    /* ── Navigation sidebar ── */
    function toggleMenu(el) {
        var item   = el.closest('.nav-item');
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.nav-item.open').forEach(function(i) { i.classList.remove('open'); });
        if (!isOpen) item.classList.add('open');
    }

    document.addEventListener('DOMContentLoaded', function() {
        var active = document.querySelector('.nav-sub a.active');
        if (active && active.closest('.nav-item')) active.closest('.nav-item').classList.add('open');
    });

    /* ── Panneau utilisateur ── */
    var _userPanelOpen = false;

    function toggleUserPanel() {
        _userPanelOpen = !_userPanelOpen;
        var panel   = document.getElementById('userPanel');
        var chevron = document.getElementById('userChevron');
        var btn     = document.getElementById('sidebarUserBtn');
        panel.style.maxHeight   = _userPanelOpen ? '700px' : '0';
        chevron.style.transform = _userPanelOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        btn.style.background    = _userPanelOpen ? 'rgba(255,255,255,0.06)' : '';
    }

    /* ── Édition profil ── */
    var _pfOriginals = {};

    function startProfileEdit() {
        document.querySelectorAll('.pf-input[name]').forEach(function(inp) {
            _pfOriginals[inp.name] = inp.value;
        });

        document.querySelectorAll('.pf-view').forEach(function(el) { el.style.display = 'none'; });
        document.querySelectorAll('.pf-input').forEach(function(el) { el.style.display = 'block'; });
        document.getElementById('pwdRow').style.display = 'flex';

        // Afficher le bouton upload photo
        document.getElementById('photoUploadLabel').style.display = 'flex';
        document.getElementById('photoUploadText').textContent    = 'Changer la photo de profil';

        document.getElementById('btnEdit').style.display   = 'none';
        document.getElementById('btnSave').style.display   = 'inline-flex';
        document.getElementById('btnCancel').style.display = 'inline-flex';

        document.getElementById('userPanel').style.maxHeight = '900px';

        var first = document.querySelector('.pf-input[name="email"]');
        if (first) first.focus();
    }

    function cancelProfileEdit() {
        document.querySelectorAll('.pf-input[name]').forEach(function(inp) {
            if (_pfOriginals[inp.name] !== undefined) inp.value = _pfOriginals[inp.name];
        });
        var pwd = document.querySelector('.pf-input[name="password"]');
        if (pwd) pwd.value = '';

        document.querySelectorAll('.pf-view').forEach(function(el) { el.style.display = 'block'; });
        document.querySelectorAll('.pf-input').forEach(function(el) { el.style.display = 'none'; });
        document.getElementById('pwdRow').style.display         = 'none';
        document.getElementById('photoUploadLabel').style.display = 'none';
        document.getElementById('uploadProgress').style.display   = 'none';

        document.getElementById('btnEdit').style.display   = 'inline-flex';
        document.getElementById('btnSave').style.display   = 'none';
        document.getElementById('btnCancel').style.display = 'none';
    }

    function submitProfileEdit() {
        var emailInp = document.querySelector('.pf-input[name="email"]');
        if (emailInp && !emailInp.value.trim()) {
            emailInp.style.borderColor = 'rgba(220,60,60,0.7)';
            emailInp.focus();
            return;
        }

        var btnSave = document.getElementById('btnSave');
        btnSave.disabled = true;
        btnSave.innerHTML = '<i class="fa fa-spinner fa-spin" style="font-size:10px;"></i> Envoi…';

        var form = document.getElementById('profileForm');
        var data = new FormData(form);

        fetch('{{ path('profile_update') }}', {
            method: 'POST',
            body: data,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(json) {
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';

            if (json.success) {
                // Mise à jour des labels texte
                document.querySelectorAll('.pf-view').forEach(function(view) {
                    var inp = view.parentElement.querySelector('.pf-input');
                    if (inp && inp.value.trim()) view.textContent = inp.value.trim();
                });

                // Mise à jour nom + initiales
                if (json.prenom && json.nom) {
                    var fullName = json.prenom + ' ' + json.nom;
                    var initials = json.prenom.charAt(0).toUpperCase() + json.nom.charAt(0).toUpperCase();

                    var nameSmall   = document.getElementById('pfNameSmall');
                    var nameBig     = document.getElementById('pfNameBig');
                    var avatarSmall = document.getElementById('pfAvatarSmall');
                    var avatarBig   = document.getElementById('pfAvatarBig');

                    if (nameSmall)   nameSmall.textContent   = fullName;
                    if (nameBig)     nameBig.textContent     = fullName;
                    if (avatarSmall) avatarSmall.textContent = initials;
                    if (avatarBig)   avatarBig.textContent   = initials;
                }

                // Si une nouvelle photo Cloudinary a été envoyée, mettre à jour data-cloudinary-src
                if (json.photo) {
                    ['pfPhotoSmall','pfPhotoBig'].forEach(function(id) {
                        var el = document.getElementById(id);
                        if (el) el.dataset.cloudinarySrc = json.photo;
                    });
                }

                cancelProfileEdit();
                showToast('Profil mis à jour avec succès');
            } else {
                showToast(json.error || 'Une erreur est survenue', true);
            }
        })
        .catch(function() {
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';
            showToast('Erreur réseau, veuillez réessayer.', true);
        });
    }

    /* ── Toast notification ── */
    function showToast(msg, isError) {
        var existing = document.getElementById('pfToast');
        if (existing) existing.remove();

        var t = document.createElement('div');
        t.id = 'pfToast';
        t.style.cssText = [
            'position:fixed','bottom:24px','right:24px','z-index:9999',
            'background:' + (isError ? 'rgba(160,30,30,0.95)' : 'rgba(30,90,35,0.95)'),
            'color:#fff','font-size:13px','font-weight:600',
            'font-family:DM Sans,sans-serif','padding:12px 20px',
            'border-radius:10px','display:flex','align-items:center',
            'gap:9px','box-shadow:0 4px 24px rgba(0,0,0,0.25)',
            'transition:opacity 0.4s ease','opacity:1'
        ].join(';');

        var icon = document.createElement('i');
        icon.className = isError ? 'fa fa-circle-xmark' : 'fa fa-circle-check';
        icon.style.fontSize = '14px';
        t.appendChild(icon);
        t.appendChild(document.createTextNode(msg));
        document.body.appendChild(t);

        setTimeout(function() { t.style.opacity = '0'; }, 2800);
        setTimeout(function() { if (t.parentNode) t.remove(); }, 3300);
    }

    function toggle2FA(enabled) {
    var track = document.getElementById('twofa-track');
    var thumb = document.getElementById('twofa-thumb');
    var status = document.getElementById('twofa-status');

    var fd = new FormData();
    fd.append('enabled', enabled ? '1' : '0');

    fetch('{{ path("app_2fa_toggle") }}', {
        method: 'POST',
        body: fd,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(json => {
        if (json.success) {
            track.style.background = enabled ? '#2D5A27' : '#ccc';
            thumb.style.left       = enabled ? '21px' : '3px';
            status.textContent     = enabled ? 'Activée' : 'Désactivée';
            agriShowToast(enabled ? '2FA activée ✓' : '2FA désactivée');
        }
    });
}
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
