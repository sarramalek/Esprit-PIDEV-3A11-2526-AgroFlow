{% extends 'base.html.twig' %}
{% block title %}Vérification 2FA – AgroFlow{% endblock %}
{% block body %}
<div style="max-width:420px;margin:80px auto;padding:40px;background:white;border-radius:18px;box-shadow:0 4px 24px rgba(0,0,0,0.08);">
    <div style="text-align:center;margin-bottom:28px;">
        <div style="width:56px;height:56px;background:#EAF3DE;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <i class="fa fa-shield-halved" style="font-size:24px;color:#2D5A27;"></i>
        </div>
        <h2 style="font-family:'Playfair Display',serif;color:#2C3E50;margin-bottom:6px;">Vérification en deux étapes</h2>
        <p style="color:#888;font-size:14px;">Un code a été envoyé à votre email / téléphone.</p>
    </div>

    {% if error %}
    <div style="background:#FFEBEE;border:1px solid #FFCDD2;color:#C62828;padding:10px 14px;border-radius:10px;margin-bottom:18px;font-size:13px;">
        <i class="fa fa-circle-exclamation"></i> {{ error }}
    </div>
    {% endif %}

    <form method="post" action="{{ path('app_2fa_verify') }}">
        <div style="margin-bottom:18px;">
            <label style="display:block;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Code de vérification</label>
            <input type="text" name="code" maxlength="6" autofocus autocomplete="one-time-code"
                   placeholder="000000"
                   style="width:100%;padding:14px;font-size:24px;letter-spacing:0.4em;text-align:center;border:2px solid #e0e0e0;border-radius:12px;font-family:'DM Sans',sans-serif;outline:none;transition:border 0.2s;"
                   onfocus="this.style.borderColor='#2D5A27'" onblur="this.style.borderColor='#e0e0e0'">
        </div>
        <button type="submit"
                style="width:100%;padding:13px;background:#2D5A27;color:white;border:none;border-radius:12px;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;cursor:pointer;">
            <i class="fa fa-check"></i> Vérifier
        </button>
    </form>

    <div style="text-align:center;margin-top:16px;">
        <a href="{{ path('app_2fa_resend') }}" style="font-size:13px;color:#2D5A27;text-decoration:none;">
            <i class="fa fa-rotate-right"></i> Renvoyer le code
        </a>
        &nbsp;·&nbsp;
        <a href="{{ path('app_logout') }}" style="font-size:13px;color:#aaa;text-decoration:none;">
            Annuler
        </a>
    </div>
</div>
{% endblock %}