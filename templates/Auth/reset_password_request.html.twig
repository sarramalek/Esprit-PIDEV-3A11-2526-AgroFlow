{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe - AgroFlow{% endblock %}

{% block body %}
<section style="min-height:100vh;display:flex;align-items:center;justify-content:center;background-color:#FCF8E6;">
    <div style="background:white;padding:50px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.1);width:100%;max-width:450px;">

        <div style="text-align:center;margin-bottom:30px;">
            <img src="{{ asset('assets/img/Logo.png') }}" alt="Logo" style="height:60px;margin-bottom:15px;">
            <h2 style="color:#2C3E50;font-family:'Marcellus',serif;">Mot de passe oublié</h2>
            <p style="color:#666;font-size:14px;">Entrez votre email et choisissez comment recevoir votre code.</p>
        </div>

        {% if error %}
        <div style="background:#fde8e8;border-left:4px solid #c0392b;color:#c0392b;padding:12px 16px;border-radius:8px;margin-bottom:20px;display:flex;align-items:center;gap:10px;font-size:14px;">
            <i class="fas fa-exclamation-circle"></i> {{ error }}
        </div>
        {% endif %}

        <form method="POST">

            {# Email #}
            <div style="margin-bottom:22px;">
                <label style="display:block;color:#2C3E50;font-weight:600;margin-bottom:8px;">
                    <i class="fa fa-envelope" style="color:#2D5A27;margin-right:6px;"></i> Adresse email
                </label>
                <input type="email" name="email" required
                       placeholder="votre@email.com"
                       style="width:100%;padding:12px 15px;border:2px solid #eee;border-radius:8px;font-size:15px;box-sizing:border-box;outline:none;font-family:'DM Sans',sans-serif;"
                       onfocus="this.style.borderColor='#2D5A27'"
                       onblur="this.style.borderColor='#eee'">
            </div>

            {# Choix du canal #}
            <div style="margin-bottom:28px;">
                <label style="display:block;color:#2C3E50;font-weight:600;margin-bottom:12px;">
                    Recevoir le code par :
                </label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">

                    <label id="labelEmail" style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:2px solid #2D5A27;border-radius:10px;cursor:pointer;background:#f5faf4;transition:all 0.2s;">
                        <input type="radio" name="canal" value="email" checked
                               style="accent-color:#2D5A27;"
                               onchange="highlightCanal('email')">
                        <div>
                            <div style="font-weight:600;font-size:13px;color:#2D5A27;">
                                <i class="fa fa-envelope" style="margin-right:5px;"></i> Email
                            </div>
                            <div style="font-size:11px;color:#888;">Reçu dans votre boite mail</div>
                        </div>
                    </label>

                    <label id="labelSms" style="display:flex;align-items:center;gap:10px;padding:14px 16px;border:2px solid #eee;border-radius:10px;cursor:pointer;background:white;transition:all 0.2s;">
                        <input type="radio" name="canal" value="sms"
                               style="accent-color:#2D5A27;"
                               onchange="highlightCanal('sms')">
                        <div>
                            <div style="font-weight:600;font-size:13px;color:#2C3E50;">
                                <i class="fa fa-mobile-screen-button" style="margin-right:5px;"></i> SMS
                            </div>
                            <div style="font-size:11px;color:#888;">Envoyé sur votre tél.</div>
                        </div>
                    </label>

                </div>
            </div>

            <button type="submit"
                    style="width:100%;background:#2D5A27;color:white;padding:14px;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;transition:background 0.2s;"
                    onmouseover="this.style.background='#1A3A1F'"
                    onmouseout="this.style.background='#2D5A27'">
                <i class="fa fa-paper-plane" style="margin-right:8px;"></i> Envoyer le code
            </button>

        </form>

        <p style="text-align:center;margin-top:22px;color:#666;font-size:14px;">
            <a href="{{ path('app_login') }}" style="color:#2D5A27;font-weight:600;">
                <i class="fa fa-arrow-left" style="margin-right:5px;"></i> Retour à la connexion
            </a>
        </p>
    </div>
</section>

<script>
function highlightCanal(val) {
    var labelEmail = document.getElementById('labelEmail');
    var labelSms   = document.getElementById('labelSms');
    if (val === 'email') {
        labelEmail.style.borderColor = '#2D5A27';
        labelEmail.style.background  = '#f5faf4';
        labelSms.style.borderColor   = '#eee';
        labelSms.style.background    = 'white';
    } else {
        labelSms.style.borderColor   = '#2D5A27';
        labelSms.style.background    = '#f5faf4';
        labelEmail.style.borderColor = '#eee';
        labelEmail.style.background  = 'white';
    }
}
</script>
{% endblock %}
