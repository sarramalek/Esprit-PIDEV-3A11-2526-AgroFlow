{% extends 'base.html.twig' %}

{% block title %}Connexion - AgroFlow{% endblock %}

{% block body %}
<section style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #FCF8E6;">
    <div style="background: white; padding: 50px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 100%; max-width: 450px;">

        <div style="text-align: center; margin-bottom: 30px;">
            <img src="{{ asset('assets/img/Logo.png') }}" alt="Logo" style="height: 60px; margin-bottom: 15px;">
            <h2 style="color: #2C3E50; font-family: 'Marcellus', serif;">Connexion</h2>
            <p style="color: #666;">Bienvenue sur AgroFlow</p>
        </div>

        {# ── Un seul bloc erreur ── #}
        {% if error %}
            <div style="
                background-color: #fde8e8;
                border-left: 4px solid #c0392b;
                color: #c0392b;
                padding: 12px 16px;
                border-radius: 8px;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 14px;
            ">
                <i class="fas fa-exclamation-circle"></i>
                {% if error.messageKey == 'Invalid credentials.' %}
                    Email ou mot de passe incorrect.
                {% elseif error.messageKey == 'Account is disabled.' %}
                    Votre compte est désactivé.
                {% else %}
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                {% endif %}
            </div>
        {% endif %}

        {{ form_start(loginForm) }}

            <div style="margin-bottom: 20px;">
                <label style="display: block; color: #2C3E50; font-weight: 600; margin-bottom: 8px;">Email</label>
                {{ form_widget(loginForm._username, {'attr': {
                    'style': 'width: 100%; padding: 12px 15px; border: 2px solid #eee; border-radius: 8px; font-size: 15px; box-sizing: border-box;',
                    'onfocus': "this.style.borderColor='#2D5A27'",
                    'onblur': "this.style.borderColor='#eee'"
                }}) }}
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; color: #2C3E50; font-weight: 600; margin-bottom: 8px;">Mot de passe</label>
                {{ form_widget(loginForm._password, {'attr': {
                    'style': 'width: 100%; padding: 12px 15px; border: 2px solid #eee; border-radius: 8px; font-size: 15px; box-sizing: border-box;',
                    'onfocus': "this.style.borderColor='#2D5A27'",
                    'onblur': "this.style.borderColor='#eee'"
                }}) }}
            </div>
<p style="text-align:center;margin-top:14px;font-size:14px;">
    <a href="{{ path('app_reset_password') }}" style="color:#2D5A27;font-weight:600;">
        Mot de passe oublié ?
    </a>
</p>
            <button type="submit"
                style="width: 100%; background-color: #2D5A27; color: white; padding: 14px; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer;">
                Se connecter
            </button>

        {{ form_end(loginForm) }}

        <p style="text-align: center; margin-top: 20px; color: #666;">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" style="color: #2D5A27; font-weight: 600;">S'inscrire</a>
        </p>
    </div>
</section>
{% endblock %}