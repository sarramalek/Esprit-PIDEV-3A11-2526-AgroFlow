{% extends 'base.html.twig' %}

{% block title %}Vérification du code - AgroFlow{% endblock %}

{% block body %}
<section style="min-height:100vh;display:flex;align-items:center;justify-content:center;background-color:#FCF8E6;">
    <div style="background:white;padding:50px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.1);width:100%;max-width:420px;">

        <div style="text-align:center;margin-bottom:30px;">
            <div style="width:64px;height:64px;border-radius:16px;background:linear-gradient(135deg,#4A8C3F,#2D5A27);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
                <i class="fa {% if canal == 'sms' %}fa-mobile-screen-button{% else %}fa-envelope{% endif %}"
                   style="font-size:26px;color:white;"></i>
            </div>
            <h2 style="color:#2C3E50;font-family:'Marcellus',serif;margin-bottom:8px;">Vérification</h2>
            <p style="color:#666;font-size:14px;">
                {% if canal == 'sms' %}
                    Un code à 6 chiffres a été envoyé par SMS sur votre numéro de téléphone.
                {% else %}
                    Un code à 6 chiffres a été envoyé à votre adresse email.
                {% endif %}
            </p>
        </div>

        {% for msg in app.flashes('success') %}
        <div style="background:#eaf3de;border-left:4px solid #2D5A27;color:#2D5A27;padding:12px 16px;border-radius:8px;margin-bottom:20px;display:flex;align-items:center;gap:10px;font-size:14px;">
            <i class="fa fa-circle-check"></i> {{ msg }}
        </div>
        {% endfor %}

        {% if error %}
        <div style="background:#fde8e8;border-left:4px solid #c0392b;color:#c0392b;padding:12px 16px;border-radius:8px;margin-bottom:20px;display:flex;align-items:center;gap:10px;font-size:14px;">
            <i class="fas fa-exclamation-circle"></i> {{ error }}
        </div>
        {% endif %}

        <form method="POST">
            <div style="margin-bottom:28px;">
                <label style="display:block;color:#2C3E50;font-weight:600;margin-bottom:12px;text-align:center;">
                    Entrez le code à 6 chiffres
                </label>

                {# Champs individuels pour chaque chiffre #}
                <div style="display:flex;gap:10px;justify-content:center;" id="codeInputs">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                    <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                           class="code-digit"
                           style="width:48px;height:56px;text-align:center;font-size:22px;font-weight:700;border:2px solid #eee;border-radius:10px;outline:none;color:#2C3E50;font-family:'DM Mono',monospace;transition:border 0.2s;">
                </div>

                {# Champ caché qui regroupe les 6 chiffres #}
                <input type="hidden" name="code" id="codeHidden">
            </div>

            {# Countdown #}
            <div style="text-align:center;margin-bottom:20px;font-size:13px;color:#888;">
                Code valable encore : <span id="countdown" style="font-weight:700;color:#2D5A27;">10:00</span>
            </div>

            <button type="submit" id="submitBtn"
                    style="width:100%;background:#2D5A27;color:white;padding:14px;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;transition:background 0.2s;"
                    onmouseover="this.style.background='#1A3A1F'"
                    onmouseout="this.style.background='#2D5A27'">
                <i class="fa fa-check" style="margin-right:8px;"></i> Vérifier le code
            </button>

        </form>

        <div style="text-align:center;margin-top:20px;">
            <a href="{{ path('app_reset_resend') }}"
               style="color:#2D5A27;font-weight:600;font-size:14px;text-decoration:none;">
                <i class="fa fa-rotate-right" style="margin-right:5px;"></i> Renvoyer un nouveau code
            </a>
        </div>

        <p style="text-align:center;margin-top:14px;color:#666;font-size:14px;">
            <a href="{{ path('app_reset_password') }}" style="color:#aaa;">
                <i class="fa fa-arrow-left" style="margin-right:5px;"></i> Recommencer
            </a>
        </p>
    </div>
</section>

<script>
    /* ── Déplacement automatique entre les cases ── */
    var digits = document.querySelectorAll('.code-digit');
    var hidden = document.getElementById('codeHidden');

    digits.forEach(function(inp, i) {
        inp.addEventListener('focus', function() { this.style.borderColor = '#2D5A27'; });
        inp.addEventListener('blur',  function() { this.style.borderColor = '#eee'; });

        inp.addEventListener('input', function() {
            // N'accepte que les chiffres
            this.value = this.value.replace(/\D/g, '');
            if (this.value && i < digits.length - 1) {
                digits[i + 1].focus();
            }
            syncHidden();
        });

        inp.addEventListener('keydown', function(e) {
            if (e.key === 'Backspace' && !this.value && i > 0) {
                digits[i - 1].focus();
            }
        });

        // Coller (paste) depuis le presse-papiers
        inp.addEventListener('paste', function(e) {
            e.preventDefault();
            var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
            for (var j = 0; j < pasted.length && (i + j) < digits.length; j++) {
                digits[i + j].value = pasted[j];
            }
            var next = Math.min(i + pasted.length, digits.length - 1);
            digits[next].focus();
            syncHidden();
        });
    });

    function syncHidden() {
        var val = '';
        digits.forEach(function(d) { val += d.value; });
        hidden.value = val;
    }

    /* ── Valider au remplissage complet ── */
    digits[digits.length - 1].addEventListener('input', function() {
        var complete = Array.from(digits).every(function(d) { return d.value !== ''; });
        if (complete) {
            syncHidden();
        }
    });

    /* ── Countdown 10 min ── */
    var totalSeconds = 600;
    var countdownEl  = document.getElementById('countdown');

    var timer = setInterval(function() {
        totalSeconds--;
        if (totalSeconds <= 0) {
            clearInterval(timer);
            countdownEl.textContent = '0:00';
            countdownEl.style.color = '#c0392b';
            return;
        }
        var m = Math.floor(totalSeconds / 60);
        var s = totalSeconds % 60;
        countdownEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;
        if (totalSeconds <= 60) countdownEl.style.color = '#c0392b';
    }, 1000);

    /* ── Focus sur le premier champ ── */
    digits[0].focus();
</script>
{% endblock %}
