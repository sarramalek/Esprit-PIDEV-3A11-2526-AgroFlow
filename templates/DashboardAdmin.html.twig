{% extends 'base_admin.html.twig' %}
{% block title %}Dashboard Admin - AgroFlow{% endblock %}

{% block stylesheets %}
<style>
    * { box-sizing: border-box; }
    body { background-color: #F4F6F9; font-family: Arial, sans-serif; }

    .dash-wrapper { padding: 30px; }

    /* ── Métriques ── */
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }
    .metric-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .metric-icon {
        width: 50px; height: 50px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .metric-label { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 5px; }
    .metric-value { font-size: 24px; font-weight: 700; color: #2C3E50; margin: 0; }
    .metric-sub   { font-size: 12px; color: #aaa; margin: 3px 0 0; }

    /* ── Charts row ── */
    .charts-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(0,1fr);
        gap: 20px;
        margin-bottom: 25px;
    }
    .card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .card-title {
        font-size: 13px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin: 0 0 16px;
    }

    /* ── Legend ── */
    .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }
    .legend-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: #666; }
    .legend-dot { width: 10px; height: 10px; border-radius: 2px; }

    /* ── Table ── */
    .users-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .users-table th { padding: 10px 12px; text-align: left; font-size: 11px; color: #999; text-transform: uppercase; border-bottom: 1px solid #eee; font-weight: 600; }
    .users-table td { padding: 12px; border-bottom: 1px solid #f5f5f5; color: #444; vertical-align: middle; }
    .users-table tr:last-child td { border-bottom: none; }
    .users-table tr:hover td { background-color: #FCF8E6; }

    /* ── Avatar ── */
    .avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 600; flex-shrink: 0; }

    /* ── Badge ── */
    .badge { display: inline-block; font-size: 11px; padding: 3px 10px; border-radius: 6px; font-weight: 500; }
    .badge-green  { background: #EAF3DE; color: #3B6D11; }
    .badge-blue   { background: #E6F1FB; color: #185FA5; }
    .badge-amber  { background: #FAEEDA; color: #854F0B; }
    .badge-red    { background: #FCEBEB; color: #A32D2D; }
    .badge-gray   { background: #f0f0f0; color: #555; }
</style>
{% endblock %}

{% block body %}
<div class="dash-wrapper">

    {# ── Header ── #}
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
        <div>
            <h2 style="margin:0; color:#2C3E50; font-size:22px;">Tableau de bord</h2>
            <p style="margin:5px 0 0; color:#888; font-size:14px;">Bienvenue, {{ app.user.prenom }} — Vue d'ensemble de AgroFlow</p>
        </div>
        <span class="badge badge-green" style="font-size:13px; padding:6px 14px;">
            <i class="fa fa-circle" style="font-size:8px; margin-right:5px;"></i> En direct
        </span>
    </div>

    {# ── Métriques ── #}
    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-icon" style="background:#EAF3DE;">
                <i class="fa fa-users" style="color:#3B6D11;"></i>
            </div>
            <div>
                <p class="metric-label">Utilisateurs</p>
                <p class="metric-value">{{ stats.totalUsers }}</p>
                <p class="metric-sub">+{{ stats.newThisMonth }} ce mois</p>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#E6F1FB;">
                <i class="fa fa-tractor" style="color:#185FA5;"></i>
            </div>
            <div>
                <p class="metric-label">Agriculteurs</p>
                <p class="metric-value">{{ stats.agriculteurs }}</p>
                <p class="metric-sub">{{ stats.agriculteursPct }}% des inscrits</p>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#FAEEDA;">
                <i class="fa fa-hard-hat" style="color:#BA7517;"></i>
            </div>
            <div>
                <p class="metric-label">Ouvriers</p>
                <p class="metric-value">{{ stats.ouvriers }}</p>
                <p class="metric-sub">{{ stats.ouvriersPct }}% des inscrits</p>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#E1F5EE;">
                <i class="fa fa-check-circle" style="color:#0F6E56;"></i>
            </div>
            <div>
                <p class="metric-label">Abonnements actifs</p>
                <p class="metric-value">{{ stats.abonnementsActifs }}</p>
                <p class="metric-sub">{{ stats.abonnementsPct }}% du total</p>
            </div>
        </div>
    </div>

    {# ── Charts ── #}
    <div class="charts-row">
        <div class="card">
            <p class="card-title">Répartition par rôle</p>
            <div class="legend">
                <div class="legend-item"><span class="legend-dot" style="background:#3B6D11;"></span> Agriculteurs {{ stats.agriculteursPct }}%</div>
                <div class="legend-item"><span class="legend-dot" style="background:#185FA5;"></span> Ouvriers {{ stats.ouvriersPct }}%</div>
                <div class="legend-item"><span class="legend-dot" style="background:#888;"></span> Admins {{ stats.adminsPct }}%</div>
            </div>
            <div style="position:relative; height:220px;">
                <canvas id="roleChart"></canvas>
            </div>
        </div>

        <div class="card">
            <p class="card-title">Inscriptions mensuelles</p>
            <div class="legend">
                <div class="legend-item"><span class="legend-dot" style="background:#3B6D11;"></span> Agriculteurs</div>
                <div class="legend-item"><span class="legend-dot" style="background:#185FA5;"></span> Ouvriers</div>
            </div>
            <div style="position:relative; height:220px;">
                <canvas id="inscriptionsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="card">
            <p class="card-title">Abonnements par statut</p>
            <div class="legend">
                <div class="legend-item"><span class="legend-dot" style="background:#0F6E56;"></span> Actif</div>
                <div class="legend-item"><span class="legend-dot" style="background:#BA7517;"></span> Expiré</div>
                <div class="legend-item"><span class="legend-dot" style="background:#A32D2D;"></span> Annulé</div>
            </div>
            <div style="position:relative; height:220px;">
                <canvas id="abonnementChart"></canvas>
            </div>
        </div>

        <div class="card">
            <p class="card-title">Revenus mensuels (TND)</p>
            <div style="position:relative; height:250px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    {# ── Derniers inscrits ── #}
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <p class="card-title" style="margin:0;">Derniers inscrits</p>
{# Remplace ligne 197 #}
{# <a href="{{ path('admin_users') }}" ...> #}
<a href="#" style="font-size:13px; color:#2D5A27; text-decoration:none; font-weight:600;">
    Voir tout <i class="fa fa-arrow-right"></i>
</a>                Voir tout <i class="fa fa-arrow-right"></i>
            </a>
        </div>
        <table class="users-table">
            <thead>
                <tr>
                    <th>Utilisateur</th>
                    <th>Rôle</th>
                    <th>Ville</th>
                    <th>Statut</th>
                    <th>Inscription</th>
                </tr>
            </thead>
            <tbody>
                {% for user in recentUsers %}
                <tr>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <div class="avatar" style="background:#EAF3DE; color:#3B6D11;">
                                {{ user.nom|first|upper }}{{ user.prenom ? user.prenom|first|upper : '' }}
                            </div>
                            <div>
                                <div style="font-weight:600; color:#2C3E50;">{{ user.nom }} {{ user.prenom }}</div>
                                <div style="font-size:12px; color:#aaa;">{{ user.email }}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        {% if user.role == 2 %}
                            <span class="badge badge-blue">Agriculteur</span>
                        {% elseif user.role == 1 %}
                            <span class="badge badge-amber">Ouvrier</span>
                        {% else %}
                            <span class="badge badge-gray">Admin</span>
                        {% endif %}
                    </td>
                    <td>{{ user.ville ?? '-' }}</td>
                    <td><span class="badge badge-green">Actif</span></td>
                    <td style="color:#aaa;">
                        {{ user.dateCreationcpt ? user.dateCreationcpt|date('d/m/Y') : '-' }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
    const agriculteurs = {{ stats.agriculteurs }};
    const ouvriers     = {{ stats.ouvriers }};
    const admins       = {{ stats.admins }};

    // Répartition par rôle
    new Chart(document.getElementById('roleChart'), {
        type: 'doughnut',
        data: {
            labels: ['Agriculteurs', 'Ouvriers', 'Admins'],
            datasets: [{ data: [agriculteurs, ouvriers, admins], backgroundColor: ['#3B6D11','#185FA5','#888780'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { display: false } } }
    });

    // Inscriptions mensuelles
    new Chart(document.getElementById('inscriptionsChart'), {
        type: 'bar',
        data: {
            labels: {{ inscriptionsLabels|json_encode|raw }},
            datasets: [
                { label: 'Agriculteurs', data: {{ inscriptionsAgriculteurs|json_encode|raw }}, backgroundColor: '#3B6D11', borderRadius: 4 },
                { label: 'Ouvriers',     data: {{ inscriptionsOuvriers|json_encode|raw }},     backgroundColor: '#185FA5', borderRadius: 4 }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { x: { grid: { display: false } }, y: { grid: { color: 'rgba(0,0,0,0.04)' } } }
        }
    });

    // Abonnements
    new Chart(document.getElementById('abonnementChart'), {
        type: 'pie',
        data: {
            labels: ['Actif', 'Expiré', 'Annulé'],
            datasets: [{ data: [{{ stats.abonnementsActifs }}, {{ stats.abonnementsExpires }}, {{ stats.abonnementsAnnules }}], backgroundColor: ['#0F6E56','#BA7517','#A32D2D'], borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });

    // Revenus
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: {{ inscriptionsLabels|json_encode|raw }},
            datasets: [{
                label: 'Revenus',
                data: {{ revenus|json_encode|raw }},
                borderColor: '#0F6E56',
                backgroundColor: 'rgba(15,110,86,0.08)',
                fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#0F6E56'
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { ticks: { callback: v => v.toLocaleString() + ' TND' } }
            }
        }
    });
</script>
{% endblock %}