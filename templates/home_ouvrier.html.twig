{% extends 'base_ouvrier.html.twig' %}

{% block title %}Accueil – Espace Ouvrier | AgroFlow{% endblock %}

{% block stylesheets %}
<style>
    /* ══════════════════════════════════════
       HERO BANNER
    ══════════════════════════════════════ */
    .hero {
        background: linear-gradient(135deg, #2D5A27 0%, #4A8C3F 60%, #6BAA5E 100%);
        border-radius: 20px;
        padding: 40px 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 32px;
        position: relative;
        overflow: hidden;
    }
    .hero::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 220px; height: 220px;
        background: rgba(255,255,255,0.06);
        border-radius: 50%;
    }
    .hero::after {
        content: '';
        position: absolute;
        bottom: -60px; right: 80px;
        width: 160px; height: 160px;
        background: rgba(255,255,255,0.04);
        border-radius: 50%;
    }
    .hero-text h1 {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        color: white;
        margin-bottom: 8px;
        line-height: 1.2;
    }
    .hero-text p {
        color: rgba(255,255,255,0.78);
        font-size: 14px;
        font-weight: 400;
    }
    .hero-date {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 14px;
        padding: 18px 28px;
        text-align: center;
        flex-shrink: 0;
        backdrop-filter: blur(6px);
    }
    .hero-date .day-num {
        font-family: 'Playfair Display', serif;
        font-size: 40px;
        color: white;
        line-height: 1;
    }
    .hero-date .day-label {
        font-size: 12px;
        color: rgba(255,255,255,0.7);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-top: 4px;
    }

    /* ══════════════════════════════════════
       STATS CARDS
    ══════════════════════════════════════ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 32px;
    }
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px 26px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.09);
    }
    .stat-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }
    .stat-icon.green  { background: #EAF3E6; color: #2D5A27; }
    .stat-icon.orange { background: #FFF3E0; color: #E65100; }
    .stat-icon.blue   { background: #E3F2FD; color: #1565C0; }
    .stat-info .count {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        color: #2C3E50;
        line-height: 1;
    }
    .stat-info .label {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* ══════════════════════════════════════
       CONTENT GRID (tâches + events)
    ══════════════════════════════════════ */
    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .panel {
        background: white;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        border: 1px solid #f0f0f0;
    }
    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
    }
    .panel-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 700;
        color: #2C3E50;
    }
    .panel-title i {
        font-size: 14px;
        color: #2D5A27;
    }
    .panel-link {
        font-size: 12px;
        color: #2D5A27;
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: gap 0.2s;
    }
    .panel-link:hover { gap: 8px; }

    /* Tâche row */
    .task-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid #f5f5f5;
    }
    .task-row:last-child { border-bottom: none; }
    .task-dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .task-dot.todo     { background: #FFA726; }
    .task-dot.progress { background: #42A5F5; }
    .task-dot.done     { background: #66BB6A; }
    .task-name {
        flex: 1;
        font-size: 13px;
        color: #2C3E50;
        font-weight: 500;
    }
    .task-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .badge-todo     { background: #FFF3E0; color: #E65100; }
    .badge-progress { background: #E3F2FD; color: #1565C0; }
    .badge-done     { background: #E8F5E9; color: #2E7D32; }

    /* Event row */
    .event-row {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 11px 0;
        border-bottom: 1px solid #f5f5f5;
    }
    .event-row:last-child { border-bottom: none; }
    .event-cal {
        width: 40px; height: 40px;
        border-radius: 10px;
        background: #EAF3E6;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .event-cal .eday {
        font-family: 'Playfair Display', serif;
        font-size: 16px;
        color: #2D5A27;
        line-height: 1;
    }
    .event-cal .emon {
        font-size: 9px;
        color: #6BAA5E;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .event-info .ename {
        font-size: 13px;
        font-weight: 600;
        color: #2C3E50;
    }
    .event-info .eloc {
        font-size: 11px;
        color: #aaa;
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 32px 16px;
        color: #bbb;
        font-size: 13px;
    }
    .empty-state i { font-size: 32px; margin-bottom: 10px; display: block; opacity: 0.4; }

    /* Animation d'entrée */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .hero        { animation: fadeUp 0.4s ease both; }
    .stats-grid  { animation: fadeUp 0.4s ease 0.1s both; }
    .content-grid{ animation: fadeUp 0.4s ease 0.2s both; }
</style>
{% endblock %}

{% block body %}

{# ── HERO ───────────────────────────────────────────────── #}
<div class="hero">
    <div class="hero-text">
        <h1>Bonjour, {{ app.user.prenom }} 👋</h1>
        <p>Voici un aperçu de votre journée de travail.</p>
    </div>
    <div class="hero-date">
        <div class="day-num">{{ "now"|date('d') }}</div>
        <div class="day-label">{{ "now"|date('F Y') }}</div>
    </div>
</div>

{# ── STATS ──────────────────────────────────────────────── #}
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa fa-list-check"></i></div>
        <div class="stat-info">
            <div class="count">{{ taches_total ?? 0 }}</div>
            <div class="label">Tâches assignées</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fa fa-spinner"></i></div>
        <div class="stat-info">
            <div class="count">{{ taches_en_cours ?? 0 }}</div>
            <div class="label">En cours</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa fa-calendar-days"></i></div>
        <div class="stat-info">
            <div class="count">{{ participations_total ?? 0 }}</div>
            <div class="label">Événements inscrits</div>
        </div>
    </div>
</div>

{# ── PANELS ─────────────────────────────────────────────── #}
<div class="content-grid">

    {# Tâches récentes #}
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa fa-list-check"></i> Mes tâches récentes
            </div>
            <a href="{{ path('ouvrier_taches') }}" class="panel-link">
                Voir tout <i class="fa fa-arrow-right"></i>
            </a>
        </div>

        {% if taches_recentes is defined and taches_recentes|length > 0 %}
            {% for tache in taches_recentes %}
            <div class="task-row">
                <div class="task-dot
                    {% if tache.statut == 'en_cours' %}progress
                    {% elseif tache.statut == 'terminee' %}done
                    {% else %}todo{% endif %}">
                </div>
                <span class="task-name">{{ tache.titre }}</span>
                <span class="task-badge
                    {% if tache.statut == 'en_cours' %}badge-progress
                    {% elseif tache.statut == 'terminee' %}badge-done
                    {% else %}badge-todo{% endif %}">
                    {% if tache.statut == 'en_cours' %}En cours
                    {% elseif tache.statut == 'terminee' %}Terminée
                    {% else %}À faire{% endif %}
                </span>
            </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="fa fa-list-check"></i>
                Aucune tâche pour le moment
            </div>
        {% endif %}
    </div>

    {# Événements à venir #}
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">
                <i class="fa fa-calendar-days"></i> Événements à venir
            </div>
            <a href="{{ path('ouvrier_evenements') }}" class="panel-link">
                Voir tout <i class="fa fa-arrow-right"></i>
            </a>
        </div>

        {% if evenements_avenir is defined and evenements_avenir|length > 0 %}
            {% for ev in evenements_avenir %}
            <div class="event-row">
                <div class="event-cal">
                    <div class="eday">{{ ev.date|date('d') }}</div>
                    <div class="emon">{{ ev.date|date('M') }}</div>
                </div>
                <div class="event-info">
                    <div class="ename">{{ ev.titre }}</div>
                    {% if ev.lieu is defined %}
                    <div class="eloc">
                        <i class="fa fa-location-dot"></i> {{ ev.lieu }}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div class="empty-state">
                <i class="fa fa-calendar-days"></i>
                Aucun événement à venir
            </div>
        {% endif %}
    </div>

</div>

{% endblock %}
