{# templates/admins/maintenances/history.html.twig #}
{% extends 'base_admin.html.twig' %}

{% block title %}Historique des maintenances avec IA — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f2ec; color: #1a1a18; }
    .main-container { max-width: 1400px; margin: 0 auto; padding: 32px 24px; }

    /* Header amélioré */
    .page-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        margin-bottom: 32px; 
        flex-wrap: wrap; 
        gap: 16px;
        background: linear-gradient(135deg, #1d3d17 0%, #2d5a1b 100%);
        padding: 24px 28px;
        border-radius: 24px;
        color: white;
    }
    .header-left h1 { 
        font-size: 26px; 
        font-weight: 700; 
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .header-left p { 
        font-size: 14px; 
        opacity: 0.9;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .header-buttons { display: flex; gap: 12px; }
    
    .btn-back, .btn-ai-dashboard {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 22px;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        backdrop-filter: blur(10px);
    }
    .btn-back {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
    }
    .btn-back:hover { 
        background: rgba(255,255,255,0.3); 
        transform: translateY(-2px);
        color: white;
    }
    .btn-ai-dashboard {
        background: linear-gradient(135deg, #ff9800, #f57c00);
        color: white;
        border: none;
        box-shadow: 0 4px 12px rgba(255,152,0,0.3);
    }
    .btn-ai-dashboard:hover { 
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255,152,0,0.4);
    }

    /* KPI Cards améliorées */
    .kpi-grid { 
        display: grid; 
        grid-template-columns: repeat(4, 1fr); 
        gap: 20px; 
        margin-bottom: 32px; 
    }
    .kpi-card { 
        background: white; 
        border-radius: 20px; 
        padding: 20px 24px; 
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        position: relative;
        overflow: hidden;
    }
    .kpi-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(135deg, #1d3d17, #2d5a1b);
    }
    .kpi-card:hover { 
        transform: translateY(-4px); 
        box-shadow: 0 12px 24px rgba(0,0,0,0.1);
    }
    .kpi-icon { 
        font-size: 32px; 
        margin-bottom: 12px;
        display: inline-block;
        padding: 12px;
        background: #e8f5e9;
        border-radius: 16px;
        color: #1d3d17;
    }
    .kpi-label { 
        font-size: 11px; 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        color: #9e9d95; 
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .kpi-value { 
        font-size: 32px; 
        font-weight: 700; 
        font-family: 'DM Mono', monospace; 
        color: #1a1a18;
        line-height: 1.2;
    }
    .kpi-value.green { color: #2d5a1b; }
    .kpi-value.red { color: #c62828; }
    .kpi-sub { 
        font-size: 12px; 
        color: #9e9d95; 
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* Filter Bar améliorée */
    .filter-bar { 
        background: white; 
        border-radius: 20px; 
        padding: 24px; 
        margin-bottom: 32px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.05);
    }
    .filter-form { 
        display: flex; 
        gap: 16px; 
        flex-wrap: wrap; 
        align-items: flex-end; 
    }
    .filter-group { 
        flex: 1; 
        min-width: 160px; 
    }
    .filter-label { 
        font-size: 11px; 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        color: #6b6b64; 
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .filter-select { 
        width: 100%; 
        padding: 12px 14px; 
        border: 2px solid #ece7dd; 
        border-radius: 14px; 
        font-family: 'DM Sans', sans-serif; 
        font-size: 13px; 
        background: #fafaf7; 
        transition: all 0.2s;
        cursor: pointer;
    }
    .filter-select:hover { border-color: #c8e6b0; background: white; }
    .filter-select:focus { 
        outline: none; 
        border-color: #2d5a1b; 
        background: white;
        box-shadow: 0 0 0 3px rgba(45,90,27,.1);
    }
    .btn-filter { 
        background: #1d3d17; 
        color: #c8e6b0; 
        border: none; 
        border-radius: 14px; 
        padding: 12px 24px; 
        font-size: 13px; 
        font-weight: 600; 
        cursor: pointer; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px; 
        transition: all 0.2s;
    }
    .btn-filter:hover { 
        background: #2d5a1b; 
        color: white; 
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(45,90,27,.3);
    }
    .btn-reset { 
        background: white; 
        color: #6b6b64; 
        border: 2px solid #ece7dd; 
        border-radius: 14px; 
        padding: 11px 20px; 
        font-size: 13px; 
        text-decoration: none; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px; 
        transition: all 0.2s;
    }
    .btn-reset:hover { 
        background: #ece7dd; 
        transform: translateY(-2px);
        color: #1a1a18;
    }

    /* Month Groups améliorés */
    .month-group { margin-bottom: 48px; }
    .month-header { 
        display: flex; 
        align-items: center; 
        gap: 16px; 
        margin-bottom: 24px;
        padding: 0 8px;
    }
    .month-pill { 
        background: linear-gradient(135deg, #1d3d17, #2d5a1b);
        color: white; 
        border-radius: 30px; 
        padding: 8px 20px; 
        font-size: 13px; 
        font-weight: 600; 
        letter-spacing: 0.5px; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px;
        box-shadow: 0 4px 12px rgba(29,61,23,.2);
    }
    .month-line { 
        flex: 1; 
        height: 2px; 
        background: linear-gradient(90deg, #ece7dd, transparent);
    }
    .month-count, .month-sum {
        font-size: 12px;
        font-weight: 500;
        padding: 6px 16px;
        background: #f5f2ec;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #3d3d38;
    }
    .month-sum { background: #e8f5e9; color: #2d5a1b; font-weight: 600; }

    /* Timeline améliorée */
    .timeline { position: relative; padding-left: 40px; }
    .timeline::before { 
        content: ''; 
        position: absolute; 
        left: 12px; 
        top: 0; 
        bottom: 0; 
        width: 3px; 
        background: linear-gradient(to bottom, #c8e6b0, #ece7dd);
        border-radius: 3px;
    }

    .tl-item { position: relative; margin-bottom: 20px; }
    .tl-dot { 
        position: absolute; 
        left: -28px; 
        top: 22px; 
        width: 16px; 
        height: 16px; 
        border-radius: 50%; 
        border: 3px solid #f5f2ec;
        transition: all 0.2s;
        cursor: pointer;
        z-index: 2;
    }
    .tl-item:hover .tl-dot { transform: scale(1.3); }
    .tl-dot.urgente { background: #c62828; box-shadow: 0 0 0 4px rgba(198,40,40,0.2); }
    .tl-dot.haute   { background: #e65100; box-shadow: 0 0 0 4px rgba(230,81,0,0.2); }
    .tl-dot.moyenne { background: #1565c0; box-shadow: 0 0 0 4px rgba(21,101,192,0.2); }
    .tl-dot.faible  { background: #9e9d95; box-shadow: 0 0 0 4px rgba(158,158,93,0.2); }

    .tl-card { 
        background: white; 
        border: 1px solid #ece7dd; 
        border-radius: 20px; 
        padding: 18px 22px; 
        display: flex; 
        gap: 20px; 
        align-items: flex-start; 
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    .tl-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, #c8e6b0, transparent);
        transform: scaleX(0);
        transition: transform 0.3s;
    }
    .tl-card:hover { 
        box-shadow: 0 8px 24px rgba(26,26,24,.12); 
        transform: translateY(-3px);
        border-color: #c8e6b0;
    }
    .tl-card:hover::before { transform: scaleX(1); }

    .tl-date-col { 
        min-width: 70px; 
        text-align: center;
        background: #f5f2ec;
        padding: 10px 12px;
        border-radius: 14px;
    }
    .tl-date-day { 
        font-family: 'DM Mono', monospace; 
        font-size: 26px; 
        font-weight: 700; 
        color: #1d3d17; 
        line-height: 1; 
    }
    .tl-date-month { 
        font-size: 11px; 
        color: #9e9d95; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        margin-top: 4px;
        font-weight: 600;
    }

    .tl-divider { width: 1px; background: #ece7dd; align-self: stretch; flex-shrink: 0; }

    .tl-body { flex: 1; min-width: 0; }
    .tl-top { 
        display: flex; 
        gap: 10px; 
        align-items: center; 
        flex-wrap: wrap; 
        margin-bottom: 10px; 
    }
    .tl-type { 
        font-size: 15px; 
        font-weight: 700; 
        color: #1d3d17; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px;
        background: #e8f5e9;
        padding: 4px 14px;
        border-radius: 30px;
    }

    /* Badges améliorés */
    .badge { 
        display: inline-flex; 
        align-items: center; 
        gap: 6px; 
        padding: 4px 12px; 
        border-radius: 30px; 
        font-size: 11px; 
        font-weight: 600; 
        letter-spacing: 0.3px;
    }
    .s-planifie { background: #e3f2fd; color: #1565c0; }
    .s-en_cours { background: #fff3e0; color: #e65100; }
    .s-termine  { background: #e8f5e9; color: #2e7d32; }
    .p-urgente  { background: #ffebee; color: #c62828; }
    .p-haute    { background: #fff3e0; color: #e65100; }
    .p-moyenne  { background: #e3f2fd; color: #1565c0; }
    .p-faible   { background: #f5f5f5; color: #616161; }

    .tl-machine { 
        font-size: 12px; 
        color: #6b6b64; 
        display: inline-flex; 
        align-items: center; 
        gap: 6px;
        background: #fafaf7;
        padding: 4px 12px;
        border-radius: 30px;
    }
    .tl-machine a { color: #2d5a1b; text-decoration: none; font-weight: 500; }
    .tl-machine a:hover { text-decoration: underline; }

    .tl-desc, .tl-km {
        font-size: 13px;
        color: #6b6b64;
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fafaf7;
        padding: 6px 14px;
        border-radius: 30px;
    }
    
    /* Recommandation IA améliorée */
    .tl-recommendation {
        margin-top: 12px;
        padding: 12px 16px;
        background: linear-gradient(135deg, #e8eaf6 0%, #e3f2fd 100%);
        border-left: 4px solid #1a237e;
        border-radius: 14px;
        font-size: 13px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        flex-wrap: wrap;
        transition: all 0.2s;
    }
    .tl-recommendation:hover { 
        background: linear-gradient(135deg, #e3f2fd 0%, #e8eaf6 100%);
        transform: translateX(4px);
    }
    .tl-recommendation .ai-badge {
        background: #1a237e;
        color: white;
        padding: 4px 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
    .tl-recommendation .reco-text { 
        color: #1a237e; 
        line-height: 1.5; 
        flex: 1;
        font-weight: 500;
    }

    /* Bouton IA amélioré */
    .btn-ai-analysis {
        margin-top: 10px;
        background: linear-gradient(135deg, #1a237e, #283593);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 8px 18px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-ai-analysis:hover { 
        background: linear-gradient(135deg, #283593, #1a237e); 
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(26,35,126,0.3);
    }

    /* Actions */
    .tl-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; min-width: 130px; }
    .tl-cost { 
        font-family: 'DM Mono', monospace; 
        font-size: 16px; 
        font-weight: 700; 
        color: #2d5a1b; 
        white-space: nowrap; 
        display: inline-flex; 
        align-items: center; 
        gap: 6px;
        background: #e8f5e9;
        padding: 6px 14px;
        border-radius: 30px;
    }
    .tl-actions { display: flex; gap: 8px; }
    .btn-icon { 
        width: 36px; 
        height: 36px; 
        border-radius: 12px; 
        display: inline-flex; 
        align-items: center; 
        justify-content: center; 
        text-decoration: none; 
        transition: all 0.2s; 
        border: none; 
        cursor: pointer; 
        font-size: 16px; 
    }
    .btn-view { background: #e8f5e9; color: #1b5e20; }
    .btn-view:hover { background: #c8e6c9; transform: scale(1.1); }
    .btn-edit { background: #fff8e1; color: #e65100; }
    .btn-edit:hover { background: #ffecb3; transform: scale(1.1); }
    .btn-delete { background: #ffebee; color: #c62828; }
    .btn-delete:hover { background: #ffcdd2; transform: scale(1.1); }

    /* Modal améliorée */
    .ai-modal { 
        display: none; 
        position: fixed; 
        z-index: 1000; 
        left: 0; 
        top: 0; 
        width: 100%; 
        height: 100%; 
        background-color: rgba(0,0,0,0.6); 
        backdrop-filter: blur(8px);
    }
    .ai-modal-content { 
        background: white; 
        margin: 5% auto; 
        padding: 0; 
        border-radius: 28px; 
        width: 90%; 
        max-width: 650px; 
        box-shadow: 0 32px 64px rgba(0,0,0,0.2); 
        animation: slideIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }
    @keyframes slideIn { 
        from { transform: translateY(-60px) scale(0.95); opacity: 0; } 
        to { transform: translateY(0) scale(1); opacity: 1; } 
    }
    .ai-modal-header { 
        background: linear-gradient(135deg, #1a237e, #283593); 
        color: white; 
        padding: 24px 28px; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
    }
    .ai-modal-header h3 { 
        margin: 0; 
        font-size: 20px; 
        font-weight: 700; 
        display: flex; 
        align-items: center; 
        gap: 10px; 
    }
    .ai-modal-close { 
        font-size: 32px; 
        cursor: pointer; 
        background: none; 
        border: none; 
        color: white; 
        opacity: 0.8; 
        transition: all 0.15s;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }
    .ai-modal-close:hover { 
        opacity: 1; 
        background: rgba(255,255,255,0.1);
        transform: scale(1.1);
    }
    .ai-modal-body { 
        padding: 28px; 
        max-height: 65vh; 
        overflow-y: auto; 
    }
    .ai-analysis-item { 
        margin-bottom: 24px; 
        padding-bottom: 20px; 
        border-bottom: 2px solid #f0f0ec;
    }
    .ai-analysis-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
    .ai-analysis-label { 
        font-size: 11px; 
        font-weight: 700; 
        text-transform: uppercase; 
        letter-spacing: 1px; 
        color: #9e9d95; 
        margin-bottom: 10px; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px;
    }
    .ai-analysis-value { 
        font-size: 14px; 
        color: #1a1a18; 
        line-height: 1.6;
        font-weight: 500;
    }
    .ai-analysis-value ul { 
        margin: 8px 0 0 20px; 
        padding: 0;
    }
    .ai-analysis-value li {
        margin: 8px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ai-loader { 
        text-align: center; 
        padding: 60px 20px; 
    }
    .ai-loader i { 
        font-size: 48px; 
        animation: spin 1s linear infinite;
        color: #1a237e;
    }
    @keyframes spin { 
        from { transform: rotate(0deg); } 
        to { transform: rotate(360deg); } 
    }

    /* Flash messages améliorés */
    .flash-message { 
        border-radius: 16px; 
        padding: 14px 20px; 
        margin-bottom: 24px; 
        font-size: 14px; 
        display: flex; 
        align-items: center; 
        gap: 12px;
        backdrop-filter: blur(10px);
        animation: slideDown 0.3s ease;
    }
    @keyframes slideDown {
        from { transform: translateY(-20px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    .flash-success { 
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border-left: 4px solid #22c55e;
        color: #166534; 
    }
    .flash-error { 
        background: linear-gradient(135deg, #fef2f2, #fee2e2);
        border-left: 4px solid #ef4444;
        color: #991b1b; 
    }

    .empty-state { 
        text-align: center; 
        padding: 80px 20px; 
        background: white; 
        border-radius: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .empty-state i { font-size: 64px; color: #c8e6b0; margin-bottom: 20px; display: inline-block; }
    .empty-state h3 { font-size: 18px; font-weight: 600; color: #3d3d38; margin-bottom: 8px; }
    .empty-state p { font-size: 14px; color: #9e9d95; }

    @media (max-width: 1024px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .page-header { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 768px) {
        .tl-right { display: none; }
        .timeline { padding-left: 20px; }
        .tl-date-col { min-width: 55px; }
        .tl-date-day { font-size: 20px; }
        .kpi-grid { grid-template-columns: 1fr; }
        .filter-form { flex-direction: column; }
        .filter-group { width: 100%; }
        .tl-recommendation { flex-direction: column; align-items: flex-start; }
        .ai-modal-content { width: 95%; margin: 10% auto; }
    }
</style>
{% endblock %}

{% block body %}
<div class="main-container">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-message flash-{{ type == 'error' ? 'error' : 'success' }}">
                <i class="bi bi-{{ type == 'error' ? 'x-octagon-fill' : 'check-circle-fill' }}"></i>
                <span>{{ msg }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {# Header amélioré #}
    <div class="page-header">
        <div class="header-left">
            <h1>
                <i class="bi bi-clock-history"></i>
                Historique des maintenances
                <span style="font-size: 14px; background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 30px;">
                    <i class="bi bi-robot"></i> IA Gemini intégrée
                </span>
            </h1>
            <p>
                <i class="bi bi-bar-chart-steps"></i>
                {{ totalCount }} intervention{{ totalCount != 1 ? 's' : '' }} — Classées par ordre chronologique décroissant
            </p>
        </div>
        <div class="header-buttons">
            <a href="{{ path('admin_maintenances_ai_dashboard') }}" class="btn-ai-dashboard">
                <i class="bi bi-robot"></i> Dashboard IA
                <i class="bi bi-arrow-right"></i>
            </a>
            <a href="{{ path('admin_maintenances_index') }}" class="btn-back">
                <i class="bi bi-list-ul"></i> Liste des maintenances
            </a>
        </div>
    </div>

    {# KPI Cards améliorées #}
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-clipboard-data"></i></div>
            <div class="kpi-label"><i class="bi bi-info-circle"></i> Total</div>
            <div class="kpi-value">{{ totalCount }}</div>
            <div class="kpi-sub"><i class="bi bi-tools"></i> interventions enregistrées</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="kpi-label"><i class="bi bi-coin"></i> Coût total</div>
            <div class="kpi-value green">{{ totalCout|number_format(2, ',', ' ') }} DT</div>
            <div class="kpi-sub"><i class="bi bi-calculator"></i> Dinars tunisiens</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-calendar-range"></i></div>
            <div class="kpi-label"><i class="bi bi-calendar-month"></i> Mois couverts</div>
            <div class="kpi-value">{{ grouped|length }}</div>
            <div class="kpi-sub"><i class="bi bi-bar-chart"></i> périodes distinctes</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="kpi-label"><i class="bi bi-alarm"></i> Urgentes</div>
            <div class="kpi-value red">{{ urgentesCount }}</div>
            <div class="kpi-sub"><i class="bi bi-flag-fill"></i> haute priorité</div>
        </div>
    </div>

    {# Filtres améliorés #}
    <div class="filter-bar">
        <form method="get" action="{{ path('admin_maintenances_history') }}" class="filter-form">
            <div class="filter-group">
                <div class="filter-label"><i class="bi bi-truck"></i> Matériel</div>
                <select name="idM" class="filter-select">
                    <option value="">— Tous les matériels —</option>
                    {% for machine in machines %}
                        <option value="{{ machine.id }}" {{ selectedIdM == machine.id ? 'selected' : '' }}>
                            🚜 {{ machine.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <div class="filter-label"><i class="bi bi-toggle-on"></i> Statut</div>
                <select name="statut" class="filter-select">
                    <option value="">— Tous les statuts —</option>
                    <option value="planifie" {{ selectedStatut == 'planifie' ? 'selected' : '' }}>📋 Planifié</option>
                    <option value="en_cours" {{ selectedStatut == 'en_cours' ? 'selected' : '' }}>⚙️ En cours</option>
                    <option value="termine" {{ selectedStatut == 'termine' ? 'selected' : '' }}>✅ Terminé</option>
                </select>
            </div>
            <div class="filter-group">
                <div class="filter-label"><i class="bi bi-flag"></i> Priorité</div>
                <select name="priorite" class="filter-select">
                    <option value="">— Toutes les priorités —</option>
                    <option value="faible" {{ selectedPriorite == 'faible' ? 'selected' : '' }}>⬇️ Faible</option>
                    <option value="moyenne" {{ selectedPriorite == 'moyenne' ? 'selected' : '' }}>➡️ Moyenne</option>
                    <option value="haute" {{ selectedPriorite == 'haute' ? 'selected' : '' }}>⬆️ Haute</option>
                    <option value="urgente" {{ selectedPriorite == 'urgente' ? 'selected' : '' }}>⚠️ Urgente</option>
                </select>
            </div>
            <div class="filter-group">
                <div class="filter-label"><i class="bi bi-calendar"></i> Année</div>
                <select name="year" class="filter-select">
                    <option value="">— Toutes les années —</option>
                    {% for y in years %}
                        <option value="{{ y }}" {{ selectedYear == y ? 'selected' : '' }}>📅 {{ y }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="display:flex; gap: 10px;">
                <button type="submit" class="btn-filter">
                    <i class="bi bi-funnel"></i> Appliquer les filtres
                </button>
                <a href="{{ path('admin_maintenances_history') }}" class="btn-reset">
                    <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser
                </a>
            </div>
        </form>
    </div>

    {# Timeline groupée par mois #}
    {% if grouped is empty %}
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>Aucune maintenance dans l'historique</h3>
            <p>Essayez de modifier vos filtres ou ajoutez des interventions.</p>
            <a href="{{ path('admin_maintenances_new') }}" class="btn-filter" style="display: inline-flex; margin-top: 20px;">
                <i class="bi bi-plus-lg"></i> Nouvelle maintenance
            </a>
        </div>
    {% else %}
        {% for monthKey, items in grouped %}
            <div class="month-group">
                <div class="month-header">
                    <span class="month-pill">
                        <i class="bi bi-calendar-week"></i> 
                        {{ items[0].dateMain|date('F Y')|capitalize }}
                    </span>
                    <div class="month-line"></div>
                    <span class="month-count">
                        <i class="bi bi-tools"></i> {{ items|length }} intervention{{ items|length != 1 ? 's' : '' }}
                    </span>
                    <span class="month-sum">
                        <i class="bi bi-cash"></i>
                        {% set monthTotal = 0 %}
                        {% for m in items %}{% set monthTotal = monthTotal + m.cout %}{% endfor %}
                        {{ monthTotal|number_format(2, ',', ' ') }} DT
                    </span>
                </div>

                <div class="timeline">
                    {% for m in items %}
                    <div class="tl-item" id="maintenance-{{ m.idMain }}">
                        <div class="tl-dot {{ m.priorite }}"></div>

                        <div class="tl-card">
                            {# Date améliorée #}
                            <div class="tl-date-col">
                                <div class="tl-date-day">{{ m.dateMain ? m.dateMain|date('d') : '—' }}</div>
                                <div class="tl-date-month">{{ m.dateMain ? m.dateMain|date('M') : '' }}</div>
                            </div>
                            <div class="tl-divider"></div>

                            {# Corps amélioré #}
                            <div class="tl-body">
                                <div class="tl-top">
                                    <span class="tl-type">
                                        <i class="bi bi-wrench-adjustable-circle"></i> {{ m.typePanne }}
                                    </span>

                                    <span class="badge s-{{ m.statut }}">
                                        {% if m.statut == 'planifie' %}<i class="bi bi-calendar-check"></i> Planifié
                                        {% elseif m.statut == 'en_cours' %}<i class="bi bi-gear-wide-connected"></i> En cours
                                        {% else %}<i class="bi bi-check-circle-fill"></i> Terminé{% endif %}
                                    </span>

                                    <span class="badge p-{{ m.priorite }}">
                                        {% if m.priorite == 'urgente' %}<i class="bi bi-exclamation-octagon-fill"></i> Urgente
                                        {% elseif m.priorite == 'haute' %}<i class="bi bi-arrow-up-circle-fill"></i> Haute
                                        {% elseif m.priorite == 'moyenne' %}<i class="bi bi-arrow-right-circle-fill"></i> Moyenne
                                        {% else %}<i class="bi bi-arrow-down-circle-fill"></i> Faible{% endif %}
                                    </span>

                                    {% if m.nom %}
                                        <span class="tl-machine">
                                            <i class="bi bi-tractor"></i> ·
                                            <a href="{{ path('admin_machines_show', {id: m.idM}) }}">
                                                <i class="bi bi-link"></i> {{ m.nom }}
                                            </a>
                                            <span style="color:#d8d1c1">#{{ m.idM }}</span>
                                        </span>
                                    {% endif %}
                                </div>

                                {% if m.description %}
                                    <div class="tl-desc" title="{{ m.description }}">
                                        <i class="bi bi-file-text-fill"></i> {{ m.description|slice(0, 80) }}{{ m.description|length > 80 ? '…' : '' }}
                                    </div>
                                {% endif %}

                                {% if m.kilometrage %}
                                    <div class="tl-km">
                                        <i class="bi bi-speedometer2"></i> {{ m.kilometrage|number_format(0, ',', ' ') }} km
                                    </div>
                                {% endif %}

                                {# Recommandation IA améliorée #}
                                {% if m.recommandation %}
                                    <div class="tl-recommendation">
                                        <span class="ai-badge">
                                            <i class="bi bi-gem"></i> Gemini AI
                                        </span>
                                        <span class="reco-text">
                                            <i class="bi bi-lightbulb-fill"></i> {{ m.recommandation }}
                                        </span>
                                    </div>
                                {% endif %}

                                {# Bouton IA amélioré #}
                                <button class="btn-ai-analysis" onclick="showAIAnalysis({{ m.idMain }}, '{{ m.typePanne|escape('js') }}', '{{ m.nom|escape('js') }}')">
                                    <i class="bi bi-stars"></i> Analyse IA complète
                                    <i class="bi bi-robot"></i>
                                </button>
                            </div>

                            {# Actions améliorées #}
                            <div class="tl-right">
                                <div class="tl-cost">
                                    <i class="bi bi-cash-coin"></i> {{ m.cout|number_format(2, ',', ' ') }} DT
                                </div>
                                <div class="tl-actions">
                                    <a href="{{ path('admin_maintenances_show', {id: m.idMain}) }}"
                                       class="btn-icon btn-view" title="Voir les détails">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a href="{{ path('admin_maintenances_edit', {id: m.idMain}) }}"
                                       class="btn-icon btn-edit" title="Modifier">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_maintenances_delete', {id: m.idMain}) }}" 
                                          style="display: inline;"
                                          onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer définitivement cette maintenance ? Cette action est irréversible.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ m.idMain) }}">
                                        <button type="submit" class="btn-icon btn-delete" title="Supprimer">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    {% endif %}

</div>

{# Modal IA améliorée #}
<div id="aiModal" class="ai-modal">
    <div class="ai-modal-content">
        <div class="ai-modal-header">
            <h3>
                <i class="bi bi-robot"></i>
                Analyse IA Gemini -
                <span id="modalMaintenanceType">...</span>
            </h3>
            <button class="ai-modal-close" onclick="closeAIModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="ai-modal-body" id="aiModalBody">
            <div class="ai-loader">
                <i class="bi bi-hourglass-split"></i>
                <p style="margin-top: 16px; color: #6b6b64;">Génération de l'analyse IA en cours...</p>
            </div>
        </div>
    </div>
</div>

<script>
    async function showAIAnalysis(maintenanceId, typePanne, machineNom) {
        const modal = document.getElementById('aiModal');
        const modalTypeSpan = document.getElementById('modalMaintenanceType');
        modalTypeSpan.innerHTML = `<i class="bi bi-wrench"></i> ${typePanne} <i class="bi bi-truck"></i> ${machineNom}`;
        modal.style.display = 'block';
        
        const body = document.getElementById('aiModalBody');
        body.innerHTML = `
            <div class="ai-loader">
                <i class="bi bi-hourglass-split"></i>
                <p style="margin-top: 16px; color: #6b6b64;">Analyse en cours avec Gemini AI...</p>
                <p style="font-size: 12px; color: #9e9d95; margin-top: 8px;">L'intelligence artificielle analyse vos données</p>
            </div>
        `;
        
        try {
            const response = await fetch(`/admin/materiels/maintenances/ai/analyze/${maintenanceId}`);
            const data = await response.json();
            
            if (data.error) {
                body.innerHTML = `
                    <div style="background: #fef2f2; border-radius: 16px; padding: 24px; text-align: center;">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 48px; color: #c62828;"></i>
                        <p style="margin-top: 16px; color: #991b1b; font-weight: 500;">${data.error}</p>
                    </div>
                `;
                return;
            }
            
            body.innerHTML = `
                <div class="ai-analysis-item">
                    <div class="ai-analysis-label">
                        <i class="bi bi-gem"></i> Recommandation IA
                    </div>
                    <div class="ai-analysis-value">
                        <i class="bi bi-chat-dots-fill" style="color: #1a237e; margin-right: 8px;"></i>
                        ${data.recommendation || 'Non disponible'}
                    </div>
                </div>
                <div class="ai-analysis-item">
                    <div class="ai-analysis-label">
                        <i class="bi bi-bar-chart-line"></i> Analyse détaillée
                    </div>
                    <div class="ai-analysis-value">
                        <i class="bi bi-binoculars-fill" style="color: #e65100; margin-right: 8px;"></i>
                        ${data.analysis || 'Aucune analyse supplémentaire'}
                    </div>
                </div>
                <div class="ai-analysis-item">
                    <div class="ai-analysis-label">
                        <i class="bi bi-calendar-arrow-up"></i> Prochaine intervention
                    </div>
                    <div class="ai-analysis-value">
                        <i class="bi bi-clock-history" style="color: #1565c0; margin-right: 8px;"></i>
                        ${data.next_maintenance || 'À déterminer'}
                    </div>
                </div>
                <div class="ai-analysis-item">
                    <div class="ai-analysis-label">
                        <i class="bi bi-clipboard-check"></i> Actions recommandées
                    </div>
                    <div class="ai-analysis-value">
                        <ul>
                            ${data.actions ? data.actions.map(a => `<li><i class="bi bi-arrow-right-circle-fill" style="color: #2d5a1b;"></i> ${a}</li>`).join('') : '<li><i class="bi bi-info-circle"></i> Maintenance préventive standard</li>'}
                        </ul>
                    </div>
                </div>
                <div class="ai-analysis-item">
                    <div class="ai-analysis-label">
                        <i class="bi bi-lightbulb-fill"></i> Conseils supplémentaires
                    </div>
                    <div class="ai-analysis-value">
                        <i class="bi bi-trophy-fill" style="color: #ff9800; margin-right: 8px;"></i>
                        ${data.tips || 'Surveillance périodique recommandée'}
                    </div>
                </div>
            `;
            
        } catch (error) {
            body.innerHTML = `
                <div style="background: #fef2f2; border-radius: 16px; padding: 24px; text-align: center;">
                    <i class="bi bi-wifi-off" style="font-size: 48px; color: #c62828;"></i>
                    <p style="margin-top: 16px; color: #991b1b; font-weight: 500;">Erreur de connexion: ${error.message}</p>
                    <p style="font-size: 12px; color: #9e9d95; margin-top: 8px;">Vérifiez votre connexion et réessayez</p>
                </div>
            `;
        }
    }
    
    function closeAIModal() {
        document.getElementById('aiModal').style.display = 'none';
    }
    
    window.onclick = function(event) {
        const modal = document.getElementById('aiModal');
        if (event.target === modal) {
            closeAIModal();
        }
    }
</script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% endblock %}