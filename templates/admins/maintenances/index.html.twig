{% extends 'base_admin.html.twig' %}

{% block title %}Liste des maintenances — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f2ec; color: #1a1a18; }

    .main-container { max-width: 1400px; margin: 0 auto; padding: 32px 28px; }

    /* Header avec tous les boutons */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .header-left h1 {
        font-size: 24px;
        font-weight: 600;
        color: #1d3d17;
        letter-spacing: -0.3px;
        margin-bottom: 6px;
    }
    .header-left p { font-size: 14px; color: #6b6b64; }

    .header-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    /* Boutons */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1d3d17;
        color: #c8e6b0;
        border: none;
        border-radius: 12px;
        padding: 10px 20px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.18s;
    }
    .btn-primary:hover { background: #2d5a1b; color: white; transform: translateY(-1px); }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #2d5a1b;
        border: 1.5px solid #2d5a1b;
        border-radius: 12px;
        padding: 9px 19px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.18s;
    }
    .btn-secondary:hover { background: #e8f5e9; transform: translateY(-1px); }

    .btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #6b6b64;
        border: 1.5px solid #d8d1c1;
        border-radius: 12px;
        padding: 9px 19px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.18s;
    }
    .btn-outline:hover { background: #ece7dd; color: #1a1a18; transform: translateY(-1px); }

    .btn-danger-outline {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #dc2626;
        border: 1.5px solid #fecaca;
        border-radius: 12px;
        padding: 9px 19px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.18s;
    }
    .btn-danger-outline:hover { background: #fef2f2; color: #991b1b; transform: translateY(-1px); }

    /* KPI Cards */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }
    .kpi-card {
        background: white;
        border: 1px solid #ece7dd;
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 1px 3px rgba(26,26,24,.05);
    }
    .kpi-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: #9e9d95;
        margin-bottom: 8px;
    }
    .kpi-value {
        font-size: 32px;
        font-weight: 600;
        color: #1d3d17;
        font-family: 'DM Mono', monospace;
    }
    .kpi-value.green { color: #2d5a1b; }
    .kpi-sub { font-size: 11px; color: #9e9d95; margin-top: 6px; }

    /* Filter Bar */
    .filter-bar {
        background: white;
        border: 1px solid #ece7dd;
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 24px;
    }
    .filter-form {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        align-items: flex-end;
    }
    .filter-group {
        flex: 1;
        min-width: 160px;
    }
    .filter-label {
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: #6b6b64;
        margin-bottom: 6px;
    }
    .filter-input, .filter-select {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #ece7dd;
        border-radius: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13px;
        background: #f5f2ec;
        transition: all 0.15s;
    }
    .filter-input:focus, .filter-select:focus {
        outline: none;
        border-color: #2d5a1b;
        background: white;
        box-shadow: 0 0 0 3px rgba(45,90,27,.1);
    }
    .filter-actions {
        display: flex;
        gap: 8px;
    }
    .btn-filter {
        background: #1d3d17;
        color: #c8e6b0;
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
    }
    .btn-filter:hover { background: #2d5a1b; color: white; }
    .btn-reset {
        background: white;
        color: #6b6b64;
        border: 1.5px solid #d8d1c1;
        border-radius: 10px;
        padding: 9px 18px;
        font-size: 13px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s;
    }
    .btn-reset:hover { background: #ece7dd; color: #1a1a18; }

    /* Result Summary */
    .result-summary { margin-bottom: 16px; }
    .result-badge {
        background: white;
        border: 1px solid #ece7dd;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .result-dot {
        width: 6px;
        height: 6px;
        background: #2d5a1b;
        border-radius: 50%;
    }

    /* Table */
    .table-wrapper {
        background: white;
        border: 1px solid #ece7dd;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(26,26,24,.08);
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }
    .data-table thead {
        background: #f5f2ec;
        border-bottom: 1.5px solid #ece7dd;
    }
    .data-table th {
        padding: 14px 18px;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #6b6b64;
        text-align: left;
    }
    .data-table td {
        padding: 14px 18px;
        border-bottom: 1px solid #ece7dd;
        font-size: 13px;
        color: #3d3d38;
        vertical-align: middle;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover { background: #fafaf7; }

    /* Type Badges */
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 500;
    }
    .type-moteur { background: #e8f5e9; color: #1b5e20; }
    .type-hydraulique { background: #e3f2fd; color: #0d47a1; }
    .type-electrique { background: #fff8e1; color: #e65100; }
    .type-mecanique { background: #fce4ec; color: #880e4f; }
    .type-pneumatique { background: #f3e5f5; color: #4a148c; }
    .type-transmission { background: #fff3e0; color: #bf360c; }
    .type-vidange { background: #e0f7fa; color: #004d40; }
    .type-logicielle { background: #eceff1; color: #263238; }
    .type-autre { background: #f5f5f5; color: #424242; }

    .machine-link {
        text-decoration: none;
        font-weight: 500;
        color: #1d3d17;
    }
    .machine-link:hover { text-decoration: underline; }
    .machine-id {
        font-size: 10px;
        color: #9e9d95;
        font-family: 'DM Mono', monospace;
        display: block;
        margin-top: 2px;
    }
    .cost-value {
        font-family: 'DM Mono', monospace;
        font-weight: 500;
        color: #2d5a1b;
    }
    .date-value {
        font-family: 'DM Mono', monospace;
        font-size: 12px;
    }
    .desc-cell {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #6b6b64;
        font-size: 12px;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 6px;
        justify-content: center;
    }
    .btn-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.15s;
        border: none;
        cursor: pointer;
    }
    .btn-view { background: #e8f5e9; color: #1b5e20; }
    .btn-view:hover { background: #c8e6c9; }
    .btn-edit { background: #fff8e1; color: #e65100; }
    .btn-edit:hover { background: #ffecb3; }
    .btn-delete {
        background: #ffebee;
        color: #c62828;
        border: none;
        cursor: pointer;
    }
    .btn-delete:hover { background: #ffcdd2; }

    /* Table Footer */
    .table-footer {
        background: #f5f2ec;
        border-top: 1px solid #ece7dd;
        padding: 14px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #6b6b64;
    }
    .total-cost {
        font-family: 'DM Mono', monospace;
        font-weight: 600;
        color: #1d3d17;
        font-size: 15px;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 64px 20px;
    }
    .empty-icon {
        width: 64px;
        height: 64px;
        background: #f5f2ec;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: #9e9d95;
        margin-bottom: 16px;
    }
    .empty-state h3 {
        font-size: 16px;
        font-weight: 500;
        color: #3d3d38;
        margin-bottom: 6px;
    }
    .empty-state p {
        font-size: 13px;
        color: #9e9d95;
        margin-bottom: 20px;
    }

    /* Flash Messages */
    .flash-message {
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .flash-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .flash-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

    /* Responsive */
    @media (max-width: 768px) {
        .main-container { padding: 20px 16px; }
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .filter-form { flex-direction: column; }
        .filter-group { width: 100%; }
        .table-wrapper { overflow-x: auto; }
        .data-table { min-width: 700px; }
        .page-header { flex-direction: column; align-items: flex-start; }
        .header-buttons { width: 100%; justify-content: flex-start; }
    }
</style>
{% endblock %}

{% block body %}
<div class="main-container">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-message flash-{{ type == 'error' ? 'error' : 'success' }}">
                <i class="bi bi-{{ type == 'error' ? 'x-circle-fill' : 'check-circle-fill' }}"></i>
                {{ msg }}
            </div>
        {% endfor %}
    {% endfor %}

    {# Header avec tous les boutons #}
    <div class="page-header">
        <div class="header-left">
            <h1>Liste des maintenances</h1>
            <p>Interventions, types de panne, coûts et matériel associé</p>
        </div>
        <div class="header-buttons">
            <a href="{{ path('admin_maintenances_stats_bar') }}" class="btn-secondary" target="_blank">
                <i class="bi bi-bar-chart-steps"></i> Statistiques
            </a>
            <a href="{{ path('admin_maintenances_export_pdf') }}" class="btn-secondary" target="_blank">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </a>
            <a href="{{ path('admin_maintenances_new') }}" class="btn-primary">
                <i class="bi bi-plus-lg"></i> Nouvelle maintenance
            </a>
        </div>
    </div>

    {# Cartes KPI #}
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Interventions</div>
            <div class="kpi-value">{{ maintenances|length }}</div>
            <div class="kpi-sub">enregistrées</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Coût total</div>
            <div class="kpi-value green">{{ totalCout|number_format(2, ',', ' ') }} DT</div>
            <div class="kpi-sub">Dinars tunisiens</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Ce mois</div>
            <div class="kpi-value">{{ maintenances|filter(m => m.dateMain and m.dateMain|date('Y-m') == 'now'|date('Y-m'))|length }}</div>
            <div class="kpi-sub">{{ 'now'|date('F Y') }}</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Coût moyen</div>
            <div class="kpi-value green">{{ maintenances|length > 0 ? (totalCout / maintenances|length)|number_format(2, ',', ' ') : '0,00' }} DT</div>
            <div class="kpi-sub">par intervention</div>
        </div>
    </div>

    {# Barre de filtres #}
    <div class="filter-bar">
        <form method="get" action="{{ path('admin_maintenances_index') }}" class="filter-form">
            <div class="filter-group">
                <div class="filter-label">Recherche</div>
                <input type="text" name="search" class="filter-input" value="{{ search }}" placeholder="Type, description, matériel…">
            </div>
            <div class="filter-group">
                <div class="filter-label">Type de panne</div>
                <select name="type" class="filter-select">
                    <option value="">— Tous les types —</option>
                    {% for type in types %}
                        <option value="{{ type }}" {{ selectedType == type ? 'selected' : '' }}>{{ type }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <div class="filter-label">Matériel</div>
                <select name="idM" class="filter-select">
                    <option value="">— Tous —</option>
                    {% for machine in machines %}
                        <option value="{{ machine.id }}" {{ selectedIdM == machine.id ? 'selected' : '' }}>{{ machine.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-group">
                <div class="filter-label">Tri par coût</div>
                <select name="coutFilter" class="filter-select">
                    <option value="">— Tous —</option>
                    <option value="asc" {{ coutFilter == 'asc' ? 'selected' : '' }}>Croissant</option>
                    <option value="desc" {{ coutFilter == 'desc' ? 'selected' : '' }}>Décroissant</option>
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn-filter"><i class="bi bi-funnel"></i> Filtrer</button>
                <a href="{{ path('admin_maintenances_index') }}" class="btn-reset"><i class="bi bi-arrow-counterclockwise"></i> Réinitialiser</a>
            </div>
        </form>
    </div>

    {# Résumé #}
    <div class="result-summary">
        <div class="result-badge">
            <span class="result-dot"></span>
            {{ maintenances|length }} maintenance{{ maintenances|length != 1 ? 's' : '' }} trouvée{{ maintenances|length != 1 ? 's' : '' }}
        </div>
    </div>

    {# Tableau #}
    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Matériel</th>
                    <th>Coût (DT)</th>
                    <th>Date</th>
                    <th>Description</th>
                    <th style="text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for m in maintenances %}
                <tr>
                    <td>
                        <span class="type-badge 
                            {% if m.typePanne == 'Moteur' %}type-moteur
                            {% elseif m.typePanne == 'Hydraulique' %}type-hydraulique
                            {% elseif m.typePanne in ['Électrique','Electricité'] %}type-electrique
                            {% elseif m.typePanne == 'Mécanique' %}type-mecanique
                            {% elseif m.typePanne == 'Pneumatique' %}type-pneumatique
                            {% elseif m.typePanne == 'Transmission' %}type-transmission
                            {% elseif m.typePanne == 'Vidange & Filtres' %}type-vidange
                            {% elseif m.typePanne == 'Logicielle' %}type-logicielle
                            {% else %}type-autre{% endif %}">
                            {% if m.typePanne == 'Moteur' %}<i class="bi bi-gear-fill"></i>
                            {% elseif m.typePanne == 'Hydraulique' %}<i class="bi bi-droplet-fill"></i>
                            {% elseif m.typePanne in ['Électrique','Electricité'] %}<i class="bi bi-lightning-charge-fill"></i>
                            {% elseif m.typePanne == 'Transmission' %}<i class="bi bi-arrow-repeat"></i>
                            {% else %}<i class="bi bi-tools"></i>{% endif %}
                            {{ m.typePanne }}
                        </span>
                    </td>
                    <td>
                        {% if m.nom %}
                            <a href="{{ path('admin_machines_show', {id: m.idM}) }}" class="machine-link">{{ m.nom }}</a>
                            <span class="machine-id">#{{ m.idM }}</span>
                        {% else %}
                            <span style="color: #9e9d95; font-style: italic;">— Non lié —</span>
                        {% endif %}
                    </td>
                    <td><span class="cost-value">{{ m.cout|number_format(2, ',', ' ') }}</span></td>
                    <td><span class="date-value">{{ m.dateMain ? m.dateMain|date('d/m/Y') : '—' }}</span></td>
                    <td><span class="desc-cell" title="{{ m.description }}">{{ m.description|default('—')|slice(0, 55) }}{{ m.description|length > 55 ? '…' : '' }}</span></td>
                    <td style="text-align: center;">
                        <div class="action-buttons">
                            <a href="{{ path('admin_maintenances_show', {id: m.idMain}) }}" class="btn-icon btn-view" title="Voir"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('admin_maintenances_edit', {id: m.idMain}) }}" class="btn-icon btn-edit" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="{{ path('admin_maintenances_delete', {id: m.idMain}) }}" style="display: inline;" onsubmit="return confirm('Supprimer définitivement cette maintenance ? Cette action est irréversible.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ m.idMain) }}">
                                <button type="submit" class="btn-icon btn-delete" title="Supprimer"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6">
                        <div class="empty-state">
                            <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                            <h3>Aucune maintenance trouvée</h3>
                            <p>Aucun résultat ne correspond à vos critères.</p>
                            <a href="{{ path('admin_maintenances_new') }}" class="btn-primary" style="display: inline-flex;">Nouvelle maintenance</a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if maintenances|length > 0 %}
        <div class="table-footer">
            <div>{{ maintenances|length }} intervention{{ maintenances|length != 1 ? 's' : '' }} affichée{{ maintenances|length != 1 ? 's' : '' }}</div>
            <div><span style="font-size: 11px; color: #9e9d95;">Total</span> <span class="total-cost">{{ totalCout|number_format(2, ',', ' ') }} DT</span></div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}