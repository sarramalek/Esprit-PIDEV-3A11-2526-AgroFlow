{% extends 'base_admin.html.twig' %}
{% block title %}Statistiques — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
:root {
    --forest: #1d3d17; --forest-md: #2d5a1b; --forest-lt: #3f7526;
    --sage: #7dab5a; --mint: #c8e6b0;
    --cream: #f5f2ec; --cream-dk: #ece7dd; --sand: #d8d1c1;
    --ink: #1a1a18; --ink-md: #3d3d38; --ink-lt: #6b6b64; --ink-xs: #9e9d95;
    --white: #ffffff; --r-sm: 8px; --r-md: 12px; --r-lg: 16px;
    --sh-sm: 0 1px 3px rgba(26,26,24,.05); --sh-md: 0 3px 10px rgba(26,26,24,.08);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--ink); }

.stats-page { padding: 40px 28px 80px; }
.stats-wrap { max-width: 1400px; margin: 0 auto; }

/* HEADER */
.stats-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 32px; flex-wrap: wrap; }
.stats-header-left { display: flex; align-items: center; gap: 14px; }
.stats-header-icon { width: 48px; height: 48px; background: var(--forest); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; font-size: 20px; color: var(--mint); box-shadow: 0 4px 14px rgba(29,61,23,.22); flex-shrink: 0; }
.stats-header h1 { font-size: 21px; font-weight: 600; color: var(--forest); letter-spacing: -.3px; }
.stats-header p  { font-size: 13px; color: var(--ink-lt); margin-top: 2px; }
.stats-header-actions { display: flex; gap: 9px; flex-wrap: wrap; }
.btn-ghost-ag { display: inline-flex; align-items: center; gap: 7px; background: var(--white); color: var(--ink-md); border: 1px solid var(--sand); border-radius: var(--r-md); padding: 9px 16px; font-size: 13px; font-weight: 500; text-decoration: none; transition: border-color .15s, background .15s; white-space: nowrap; }
.btn-ghost-ag:hover { border-color: var(--forest-md); color: var(--forest); background: var(--cream); }

/* KPI GRID */
.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
.kpi-card { background: var(--white); border: 1px solid var(--cream-dk); border-radius: var(--r-lg); padding: 22px 24px; box-shadow: var(--sh-sm); position: relative; overflow: hidden; transition: box-shadow .15s; }
.kpi-card:hover { box-shadow: var(--sh-md); }
.kpi-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
.kpi-card.k-green::before { background: var(--forest-md); }
.kpi-card.k-blue::before  { background: #2563eb; }
.kpi-card.k-amber::before { background: #d97706; }
.kpi-card.k-purple::before { background: #7c3aed; }
.kpi-icon { width: 38px; height: 38px; border-radius: var(--r-sm); display: flex; align-items: center; justify-content: center; font-size: 16px; margin-bottom: 14px; }
.kpi-card.k-green .kpi-icon { background: #f0fdf4; color: var(--forest-md); }
.kpi-card.k-blue  .kpi-icon { background: #eff6ff; color: #2563eb; }
.kpi-card.k-amber .kpi-icon { background: #fffbeb; color: #d97706; }
.kpi-card.k-purple .kpi-icon { background: #f3e8ff; color: #7c3aed; }
.kpi-label { font-size: 10px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--ink-xs); margin-bottom: 6px; }
.kpi-value { font-size: 26px; font-weight: 600; color: var(--ink); letter-spacing: -.5px; font-family: 'DM Mono', monospace; }
.kpi-sub   { font-size: 12px; color: var(--ink-xs); margin-top: 4px; }

/* CHART CARD */
.chart-card { background: var(--white); border: 1px solid var(--cream-dk); border-radius: var(--r-lg); padding: 26px; box-shadow: var(--sh-sm); margin-bottom: 20px; }
.card-title { font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
.card-title i { color: var(--ink-lt); }
.chart-wrap { position: relative; height: 300px; }

/* TWO CHARTS ROW */
.charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }

/* TABLE CARD */
.table-card { background: var(--white); border: 1px solid var(--cream-dk); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--sh-sm); margin-bottom: 20px; }
.table-card-header { padding: 16px 22px; border-bottom: 1px solid var(--cream-dk); font-size: 13px; font-weight: 600; color: var(--ink); display: flex; align-items: center; gap: 8px; background: var(--cream); }
.table-card-header i { color: var(--ink-lt); }

.stats-table { width: 100%; border-collapse: collapse; }
.stats-table thead th { padding: 11px 20px; font-size: 10px; font-weight: 600; letter-spacing: .8px; text-transform: uppercase; color: var(--ink-lt); border-bottom: 1px solid var(--cream-dk); background: var(--cream); text-align: left; }
.stats-table thead th.r { text-align: right; }
.stats-table tbody td { padding: 13px 20px; border-bottom: 1px solid var(--cream); font-size: 13px; color: var(--ink-md); vertical-align: middle; }
.stats-table tbody tr:last-child td { border-bottom: none; }
.stats-table tbody tr { transition: background .12s; }
.stats-table tbody tr:hover { background: #fafaf7; }
.stats-table tfoot td { padding: 13px 20px; border-top: 1.5px solid var(--cream-dk); background: var(--cream); font-size: 13px; font-weight: 600; color: var(--ink); }
.stats-table tfoot td.r { text-align: right; }

.pct-bar-wrap { display: flex; align-items: center; gap: 10px; justify-content: flex-end; }
.pct-label { font-family: 'DM Mono', monospace; font-size: 12px; min-width: 36px; text-align: right; }
.pct-bar { height: 5px; border-radius: 3px; background: var(--cream-dk); flex: 1; max-width: 80px; overflow: hidden; }
.pct-bar-fill { height: 100%; border-radius: 3px; background: var(--forest-md); }

.mono { font-family: 'DM Mono', monospace; font-size: 12px; }
.text-r { text-align: right; }

.tb { display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:500; }
.tb-moteur       { background:#e8f5e9;color:#1b5e20; }
.tb-hydraulique  { background:#e3f2fd;color:#0d47a1; }
.tb-electrique   { background:#fff8e1;color:#e65100; }
.tb-mecanique    { background:#fce4ec;color:#880e4f; }
.tb-pneumatique  { background:#f3e5f5;color:#4a148c; }
.tb-transmission { background:#fff3e0;color:#bf360c; }
.tb-vidange      { background:#e0f7fa;color:#004d40; }
.tb-logicielle   { background:#eceff1;color:#263238; }
.tb-autre        { background:#f5f5f5;color:#424242; }

@media (max-width: 1024px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .charts-row { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
    .stats-page { padding: 20px 14px 60px; }
    .stats-header { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 480px) {
    .kpi-grid { grid-template-columns: 1fr; }
}
</style>
{% endblock %}

{% block body %}
<div class="stats-page">
<div class="stats-wrap">

    <div class="stats-header">
        <div class="stats-header-left">
            <div class="stats-header-icon"><i class="bi bi-bar-chart-line"></i></div>
            <div>
                <h1>Statistiques — Maintenances</h1>
                <p>Vue d'ensemble des interventions, coûts, statuts et priorités</p>
            </div>
        </div>
        <div class="stats-header-actions">
            <a href="{{ path('admin_maintenances_export_pdf') }}" target="_blank" class="btn-ghost-ag">
                <i class="bi bi-file-earmark-pdf"></i> Export PDF
            </a>
            <a href="{{ path('admin_maintenances_index') }}" class="btn-ghost-ag">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card k-green">
            <div class="kpi-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="kpi-label">Coût total</div>
            <div class="kpi-value">{{ totalCout|default(0)|number_format(2, ',', '&nbsp;') }}</div>
            <div class="kpi-sub">Dinars tunisiens (DT)</div>
        </div>
        <div class="kpi-card k-blue">
            <div class="kpi-icon"><i class="bi bi-tools"></i></div>
            <div class="kpi-label">Interventions</div>
            <div class="kpi-value">{{ total|default(0) }}</div>
            <div class="kpi-sub">Maintenances enregistrées</div>
        </div>
        <div class="kpi-card k-amber">
            <div class="kpi-icon"><i class="bi bi-tags"></i></div>
            <div class="kpi-label">Types de pannes</div>
            <div class="kpi-value">{{ byType|default([])|length }}</div>
            <div class="kpi-sub">Catégories distinctes</div>
        </div>
        <div class="kpi-card k-purple">
            <div class="kpi-icon"><i class="bi bi-flag-fill"></i></div>
            <div class="kpi-label">En cours</div>
            <div class="kpi-value">{{ statsByStatut.en_cours|default(0) }}</div>
            <div class="kpi-sub">interventions actives</div>
        </div>
    </div>

    <div class="charts-row">
        <div class="chart-card">
            <div class="card-title"><i class="bi bi-bar-chart"></i> Répartition par type de panne</div>
            <div class="chart-wrap"><canvas id="barChart"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="card-title"><i class="bi bi-pie-chart"></i> Répartition par statut</div>
            <div class="chart-wrap"><canvas id="statutChart"></canvas></div>
        </div>
    </div>

    <div class="chart-card">
        <div class="card-title"><i class="bi bi-exclamation-triangle-fill"></i> Répartition par priorité</div>
        <div class="chart-wrap"><canvas id="prioriteChart"></canvas></div>
    </div>

    <div class="table-card">
        <div class="table-card-header"><i class="bi bi-table"></i> Détail par type de panne</div>

        {% set grandTotal = 0 %}
        {% for r in byType %}{% set grandTotal = grandTotal + r.total %}{% endfor %}

        <table class="stats-table">
            <thead>
                <tr>
                    <th>Type de panne</th>
                    <th class="r">Interventions</th>
                    <th class="r">Part</th>
                    <th class="r">Coût total</th>
                    <th class="r">Coût moyen</th>
                </tr>
            </thead>
            <tbody>
                {% for r in byType %}
                <tr>
                    <td>
                        <span class="tb {% if r.type == 'Moteur' %}tb-moteur{% elseif r.type == 'Hydraulique' %}tb-hydraulique{% elseif r.type in ['Électrique','Electricité'] %}tb-electrique{% elseif r.type == 'Mécanique' %}tb-mecanique{% elseif r.type == 'Pneumatique' %}tb-pneumatique{% elseif r.type == 'Transmission' %}tb-transmission{% elseif r.type == 'Vidange & filtres' %}tb-vidange{% elseif r.type == 'Logicielle' %}tb-logicielle{% else %}tb-autre{% endif %}">{{ r.type }}</span>
                    </td>
                    <td class="text-r mono">{{ r.total }}</td>
                    <td class="text-r">
                        {% if grandTotal > 0 %}
                            {% set pct = (r.total / grandTotal * 100)|round(1) %}
                            <div class="pct-bar-wrap">
                                <div class="pct-bar"><div class="pct-bar-fill" style="width:{{ pct }}%"></div></div>
                                <span class="pct-label">{{ pct }}%</span>
                            </div>
                        {% else %}0%{% endif %}
                    </td>
                    <td class="text-r mono" style="color:var(--forest-md);font-weight:500;">{{ (r.coutTotal|default(0))|number_format(2, ',', '&nbsp;') }} DT</td>
                    <td class="text-r mono" style="color:var(--ink-lt);">
                        {% if r.total > 0 %}{{ ((r.coutTotal|default(0)) / r.total)|number_format(2, ',', '&nbsp;') }} DT{% else %}0,00 DT{% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" style="text-align:center;padding:48px;color:var(--ink-xs);">
                    <i class="bi bi-inbox" style="font-size:26px;display:block;margin-bottom:10px;"></i>
                    Aucune donnée disponible
                </td></tr>
                {% endfor %}
            </tbody>
            {% if byType|length > 0 %}
            <tfoot>
                <tr>
                    <td>Total</td>
                    <td class="r">{{ grandTotal }}</td>
                    <td class="r">100%</td>
                    <td class="r mono" style="color:var(--forest-md);">{{ totalCout|default(0)|number_format(2, ',', '&nbsp;') }} DT</td>
                    <td class="r mono" style="color:var(--ink-lt);">{% if grandTotal > 0 %}{{ (totalCout|default(0) / grandTotal)|number_format(2, ',', '&nbsp;') }} DT{% else %}0,00 DT{% endif %}</td>
                </tr>
            </tfoot>
            {% endif %}
        </table>
    </div>

</div>
</div>

<script type="application/json" id="data-byType">
    {{ byType|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>
<script type="application/json" id="data-byStatut">
    {{ byStatut|default([])|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>
<script type="application/json" id="data-byPriorite">
    {{ byPriorite|default([])|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}
</script>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
(function(){
    'use strict';
    
    function readJson(id){ 
        try { 
            const el = document.getElementById(id); 
            const v = JSON.parse(el ? el.textContent : '[]'); 
            return Array.isArray(v) ? v : Object.values(v); 
        } catch(e){ 
            return []; 
        } 
    }
    
    // Données par type
    const byType = readJson('data-byType');
    const COLORS = ['#2d5a1b','#3f7526','#7dab5a','#1565c0','#e65100','#ad1457','#6a1b9a','#00695c','#37474f','#b45309'];
    
    // Graphique par type
    const ctx = document.getElementById('barChart');
    if(ctx && byType.length){
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: byType.map(r => r.type),
                datasets: [{
                    label: 'Interventions',
                    data: byType.map(r => Number(r.total)),
                    backgroundColor: byType.map((_,i) => COLORS[i%COLORS.length]+'cc'),
                    borderColor:     byType.map((_,i) => COLORS[i%COLORS.length]),
                    borderWidth: 1, borderRadius: 6, borderSkipped: false,
                    barPercentage: 0.6, categoryPercentage: 0.75
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1d3d17',
                        titleFont: {family:'DM Sans',size:13}, bodyFont: {family:'DM Mono',size:12},
                        padding: 10,
                        callbacks: { label: ctx => ' ' + ctx.raw + ' intervention' + (ctx.raw > 1 ? 's' : '') }
                    }
                },
                scales: {
                    y: { beginAtZero: true, ticks: {stepSize:1,precision:0,font:{family:'DM Mono',size:11},color:'#9e9d95'}, grid: {color:'rgba(0,0,0,.04)'}, border: {display:false} },
                    x: { ticks: {font:{family:'DM Sans',size:12},color:'#6b6b64'}, grid: {display:false}, border: {display:false} }
                }
            }
        });
    } else if(ctx) {
        ctx.parentElement.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ink-xs);font-size:13px;">Aucune donnée disponible</div>';
    }
    
    // Graphique par statut
    const byStatut = readJson('data-byStatut');
    const statutCtx = document.getElementById('statutChart');
    if(statutCtx && byStatut.length){
        const statutColors = { 'planifie': '#1565c0', 'en_cours': '#e65100', 'termine': '#2e7d32' };
        const statutLabels = { 'planifie': 'Planifié', 'en_cours': 'En cours', 'termine': 'Terminé' };
        const labels = byStatut.map(s => statutLabels[s.statut] || s.statut);
        const data = byStatut.map(s => Number(s.total));
        const backgroundColors = byStatut.map(s => statutColors[s.statut] || '#9e9d95');
        
        new Chart(statutCtx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors,
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'DM Sans', size: 11 }, color: '#3d3d38' } },
                    tooltip: {
                        backgroundColor: '#1d3d17',
                        titleFont: {family:'DM Sans',size:13}, bodyFont: {family:'DM Mono',size:12},
                        callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw} intervention${ctx.raw > 1 ? 's' : ''} (${((ctx.raw / byStatut.reduce((a,b) => a + Number(b.total), 0)) * 100).toFixed(1)}%)` }
                    }
                }
            }
        });
    } else if(statutCtx) {
        statutCtx.parentElement.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ink-xs);font-size:13px;">Aucune donnée disponible</div>';
    }
    
    // Graphique par priorité
    const byPriorite = readJson('data-byPriorite');
    const prioriteCtx = document.getElementById('prioriteChart');
    if(prioriteCtx && byPriorite.length){
        const prioriteColors = { 'faible': '#616161', 'moyenne': '#1565c0', 'haute': '#e65100', 'urgente': '#c62828' };
        const prioriteLabels = { 'faible': 'Faible', 'moyenne': 'Moyenne', 'haute': 'Haute', 'urgente': 'Urgente' };
        const labels = byPriorite.map(p => prioriteLabels[p.priorite] || p.priorite);
        const data = byPriorite.map(p => Number(p.total));
        const backgroundColors = byPriorite.map(p => prioriteColors[p.priorite] || '#9e9d95');
        
        new Chart(prioriteCtx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: backgroundColors,
                    borderWidth: 0,
                    hoverOffset: 8,
                    cutout: '60%'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'DM Sans', size: 11 }, color: '#3d3d38' } },
                    tooltip: {
                        backgroundColor: '#1d3d17',
                        titleFont: {family:'DM Sans',size:13}, bodyFont: {family:'DM Mono',size:12},
                        callbacks: { label: ctx => ` ${ctx.label}: ${ctx.raw} intervention${ctx.raw > 1 ? 's' : ''} (${((ctx.raw / byPriorite.reduce((a,b) => a + Number(b.total), 0)) * 100).toFixed(1)}%)` }
                    }
                }
            }
        });
    } else if(prioriteCtx) {
        prioriteCtx.parentElement.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ink-xs);font-size:13px;">Aucune donnée disponible</div>';
    }
})();
</script>
{% endblock %}