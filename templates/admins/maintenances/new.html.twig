{% extends 'base.html.twig' %}
{% block title %}Nouvelle Maintenance{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
  body { background: #f5f3ee; }

  /* ── Header ── */
  .form-header {
    background: #2d5a1b;
    border-radius: 16px 16px 0 0;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .form-header .icon-box {
    width: 52px; height: 52px;
    background: rgba(255,255,255,0.15);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 24px; color: #fff; flex-shrink: 0;
  }
  .form-header h2 { color: #fff; font-size: 22px; font-weight: 700; margin: 0; }
  .form-header p  { color: rgba(255,255,255,0.75); font-size: 13px; margin: 4px 0 0; }

  /* ── Card body ── */
  .form-card {
    background: #fff;
    border-radius: 0 0 16px 16px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }

  /* ── Section title ── */
  .section-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #2d5a1b;
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 1.5px solid #e5e7eb;
    margin-bottom: 24px;
    margin-top: 8px;
  }

  /* ── Labels ── */
  .form-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .6px;
    text-transform: uppercase;
    color: #374151;
    margin-bottom: 6px;
  }

  /* ── Inputs ── */
  .form-control, .form-select {
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    padding: 10px 14px;
    color: #111;
    transition: border-color .2s, box-shadow .2s;
    background: #fff;
  }
  .form-control:focus, .form-select:focus {
    border-color: #2d5a1b;
    box-shadow: 0 0 0 3px rgba(45,90,27,0.12);
    outline: none;
  }
  .form-control::placeholder { color: #9ca3af; font-style: italic; }

  /* ── States ── */
  .form-control.is-invalid, .form-select.is-invalid {
    border-color: #dc2626 !important;
    background-image: none;
    box-shadow: 0 0 0 3px rgba(220,38,38,0.10);
  }
  .form-control.is-valid, .form-select.is-valid {
    border-color: #16a34a !important;
    background-image: none;
    box-shadow: 0 0 0 3px rgba(22,163,74,0.10);
  }

  /* ── Error message ── */
  .field-error {
    display: none;
    color: #dc2626;
    font-size: 12px;
    margin-top: 5px;
    align-items: center;
    gap: 4px;
  }
  .field-error.visible { display: flex; }

  /* ── Char counter ── */
  .char-counter {
    font-size: 11px;
    color: #9ca3af;
    text-align: right;
    margin-top: 4px;
  }
  .char-counter.danger { color: #dc2626; font-weight: 700; }

  /* ── Error banner ── */
  .error-banner {
    display: none;
    background: #fef2f2;
    border: 1.5px solid #fca5a5;
    border-radius: 10px;
    padding: 14px 18px;
    color: #dc2626;
    font-size: 14px;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .error-banner.visible { display: flex; }

  /* ── Input group ── */
  .input-group .input-group-text {
    background: #f9fafb;
    border: 1.5px solid #d1d5db;
    border-radius: 8px 0 0 8px;
    color: #6b7280;
    font-size: 15px;
  }
  .input-group .form-control {
    border-left: none;
    border-radius: 0;
  }
  .input-group .input-group-text:last-child {
    border-left: none;
    border-radius: 0 8px 8px 0;
  }
  .input-group .form-control:focus {
    border-color: #2d5a1b;
    box-shadow: none;
  }
  .input-group:focus-within .input-group-text {
    border-color: #2d5a1b;
  }

  /* ── Buttons ── */
  .btn-save {
    background: #2d5a1b;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 11px 28px;
    font-size: 14px;
    font-weight: 600;
    display: flex; align-items: center; gap: 8px;
    transition: background .2s;
  }
  .btn-save:hover { background: #3a7322; color: #fff; }
  .btn-cancel {
    background: #fff;
    color: #6b7280;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    padding: 11px 22px;
    font-size: 14px;
    font-weight: 500;
    display: flex; align-items: center; gap: 8px;
    text-decoration: none;
    transition: background .2s;
  }
  .btn-cancel:hover { background: #f3f4f6; color: #374151; }
</style>
{% endblock %}

{% block body %}
<div class="container py-5" style="max-width: 700px;">

  {# ── Header ── #}
  <div class="form-header">
    <div class="icon-box">
      <i class="bi bi-tools"></i>
    </div>
    <div>
      <h2>Ajouter une nouvelle maintenance</h2>
      <p>Tous les champs marqués <strong style="color:#fff;">*</strong> sont obligatoires</p>
    </div>
  </div>

  <div class="form-card">

    {# ── Bannière d'erreur globale ── #}
    <div class="error-banner" id="errorBanner">
      <i class="bi bi-exclamation-circle-fill fs-5"></i>
      <span>Veuillez corriger les erreurs avant d'enregistrer.</span>
    </div>

    <form method="post" action="{{ path('admin_maintenances_new') }}" id="formNew" novalidate>

      {# ════════════════════════════════════
         SECTION 1 — IDENTIFICATION
      ════════════════════════════════════ #}
      <div class="section-title">
        <i class="bi bi-tag-fill"></i> Identification
      </div>

      <div class="row g-4 mb-4">

        {# Type de panne #}
        <div class="col-12">
          <label for="typePanne" class="form-label">
            Type de panne <span class="text-danger">*</span>
          </label>
          <select name="typePanne" id="typePanne" class="form-select" required>
            <option value="">— Choisir un type —</option>
            <option value="Électrique">⚡ Électrique</option>
            <option value="Mécanique">⚙️ Mécanique</option>
            <option value="Hydraulique">💧 Hydraulique</option>
            <option value="Pneumatique">🌬️ Pneumatique</option>
            <option value="Moteur">🔩 Moteur</option>
            <option value="Transmission">🔄 Transmission</option>
            <option value="Vidange &amp; Filtres">🛢️ Vidange &amp; Filtres</option>
            <option value="logicielle">💻 Logicielle</option>
            <option value="Autre">🔧 Autre</option>
          </select>
          <div class="field-error" id="typeError">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span id="typeErrorMsg">Veuillez sélectionner un type de panne.</span>
          </div>
        </div>

        {# Description #}
        <div class="col-12">
          <label for="description" class="form-label">
            Description <span class="text-danger">*</span>
          </label>
          <textarea name="description" id="description" class="form-control"
                    rows="3"
                    placeholder="ex : Remplacement du filtre à huile moteur et vidange complète…"
                    required></textarea>
          <div class="d-flex justify-content-between align-items-start mt-1">
            <div class="field-error" id="descError" style="flex:1;">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <span id="descErrorMsg">La description est obligatoire (entre 5 et 255 caractères).</span>
            </div>
            <div class="char-counter" id="descCount">0 / 255</div>
          </div>
        </div>

      </div>

      {# ════════════════════════════════════
         SECTION 2 — COÛT & DATE
      ════════════════════════════════════ #}
      <div class="section-title">
        <i class="bi bi-info-circle-fill"></i> Coût &amp; Date
      </div>

      <div class="row g-4 mb-4">

        {# Coût #}
        <div class="col-md-6">
          <label for="cout" class="form-label">
            Coût (DT) <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-cash-coin"></i></span>
            <input type="number" name="cout" id="cout" class="form-control"
                   step="0.01" min="0.01" max="999999.99"
                   placeholder="ex : 150.00"
                   required>
            <span class="input-group-text">DT</span>
          </div>
          <div class="field-error" id="coutError">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span id="coutErrorMsg">Le coût est obligatoire et doit être supérieur à 0.</span>
          </div>
          <div class="char-counter">Montant en dinars tunisiens</div>
        </div>

        {# Date #}
        <div class="col-md-6">
          <label for="dateMain" class="form-label">
            Date de maintenance <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
            <input type="date" name="dateMain" id="dateMain" class="form-control"
                   value="{{ 'now'|date('Y-m-d') }}"
                   max="{{ 'now'|date('Y-m-d') }}"
                   required>
          </div>
          <div class="field-error" id="dateError">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span id="dateErrorMsg">La date est obligatoire et ne peut pas être dans le futur.</span>
          </div>
          <div class="char-counter">La date ne peut pas être dans le futur</div>
        </div>

      </div>

      {# ── Boutons ── #}
      <div class="d-flex gap-3 pt-2">
        <button type="submit" class="btn-save">
          <i class="bi bi-check-lg"></i> Enregistrer
        </button>
        <a href="{{ path('admin_maintenances_index') }}" class="btn-cancel">
          <i class="bi bi-x-lg"></i> Annuler
        </a>
      </div>

    </form>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  'use strict';

  var form    = document.getElementById('formNew');
  var typeEl  = document.getElementById('typePanne');
  var coutEl  = document.getElementById('cout');
  var dateEl  = document.getElementById('dateMain');
  var descEl  = document.getElementById('description');
  var counter = document.getElementById('descCount');
  var banner  = document.getElementById('errorBanner');
  var today   = new Date().toISOString().split('T')[0];

  dateEl.setAttribute('max', today);

  /* ── Utilitaires ── */
  function markValid(el) {
    el.classList.remove('is-invalid');
    el.classList.add('is-valid');
  }
  function markInvalid(el) {
    el.classList.remove('is-valid');
    el.classList.add('is-invalid');
  }
  function showErr(divId, spanId, msg) {
    document.getElementById(spanId).textContent = msg;
    document.getElementById(divId).classList.add('visible');
  }
  function hideErr(divId) {
    document.getElementById(divId).classList.remove('visible');
  }

  /* ── Validateurs ── */
  function validateType() {
    if (!typeEl.value) {
      markInvalid(typeEl);
      showErr('typeError', 'typeErrorMsg', 'Veuillez sélectionner un type de panne.');
      return false;
    }
    markValid(typeEl); hideErr('typeError'); return true;
  }

  function validateCout() {
    var raw = coutEl.value.trim();
    var val = parseFloat(raw);
    if (raw === '' || isNaN(val)) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût est obligatoire.');
      return false;
    }
    if (val <= 0) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût doit être supérieur à 0.');
      return false;
    }
    if (val > 999999.99) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût ne peut pas dépasser 999 999,99 DT.');
      return false;
    }
    markValid(coutEl); hideErr('coutError'); return true;
  }

  function validateDate() {
    if (!dateEl.value) {
      markInvalid(dateEl);
      showErr('dateError', 'dateErrorMsg', 'La date est obligatoire.');
      return false;
    }
    if (dateEl.value > today) {
      markInvalid(dateEl);
      showErr('dateError', 'dateErrorMsg', 'La date ne peut pas être dans le futur.');
      return false;
    }
    markValid(dateEl); hideErr('dateError'); return true;
  }

  function validateDesc() {
    var val = descEl.value.trim();
    var l   = val.length;
    if (l === 0) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description est obligatoire.');
      return false;
    }
    if (l < 5) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description doit contenir au moins 5 caractères.');
      return false;
    }
    if (l > 255) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description ne peut pas dépasser 255 caractères.');
      return false;
    }
    markValid(descEl); hideErr('descError'); return true;
  }

  /* ── Événements live ── */
  typeEl.addEventListener('change', validateType);
  coutEl.addEventListener('input',  validateCout);
  dateEl.addEventListener('change', validateDate);

  descEl.addEventListener('input', function () {
    var l = this.value.length;
    counter.textContent = l + ' / 255';
    counter.className = ((l > 0 && l < 5) || l > 255)
      ? 'char-counter danger'
      : 'char-counter';
    if (this.classList.contains('is-valid') || this.classList.contains('is-invalid')) {
      validateDesc();
    }
  });
  descEl.addEventListener('blur', validateDesc);

  /* ── Soumission ── */
  form.addEventListener('submit', function (e) {
    var t1 = validateType();
    var t2 = validateCout();
    var t3 = validateDate();
    var t4 = validateDesc();
    if (!t1 || !t2 || !t3 || !t4) {
      e.preventDefault();
      e.stopPropagation();
      banner.classList.add('visible');
      var first = form.querySelector('.is-invalid');
      if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      banner.classList.remove('visible');
    }
  });

})();
</script>
{% endblock %}