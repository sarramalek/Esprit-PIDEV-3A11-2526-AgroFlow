{% extends 'base_admin.html.twig' %}

{% block title %}Nouvelle maintenance — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f2ec; color: #1a1a18; }

    .form-page { min-height: 100vh; padding: 40px 20px 80px; display: flex; justify-content: center; }
    .form-container { width: 100%; max-width: 680px; }

    /* Carte principale */
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(26,26,24,.08);
        overflow: hidden;
        border: 1px solid #ece7dd;
    }

    /* En-tête */
    .form-header {
        background: #1d3d17;
        padding: 28px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .header-icon {
        width: 48px; height: 48px;
        background: rgba(200,230,176,.15);
        border: 1px solid rgba(200,230,176,.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #c8e6b0;
    }
    .header-text h2 {
        font-size: 20px;
        font-weight: 600;
        color: white;
        letter-spacing: -.3px;
        margin: 0;
    }
    .header-text p {
        font-size: 12px;
        color: rgba(200,230,176,.75);
        margin: 4px 0 0;
    }

    /* Corps */
    .form-body { padding: 32px; }

    /* Sections */
    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #2d5a1b;
        padding-bottom: 10px;
        border-bottom: 1.5px solid #ece7dd;
        margin-bottom: 22px;
        margin-top: 6px;
    }

    /* Champs */
    .form-group { margin-bottom: 20px; }
    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #6b6b64;
        margin-bottom: 7px;
    }
    .form-label .req { color: #dc2626; }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        border: 1.5px solid #ece7dd;
        border-radius: 8px;
        padding: 10px 14px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        background: #f5f2ec;
        transition: all .18s;
        outline: none;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: #2d5a1b;
        background: white;
        box-shadow: 0 0 0 3px rgba(45,90,27,.1);
    }
    .form-textarea { resize: vertical; min-height: 110px; line-height: 1.6; }

    /* Input avec addon */
    .input-addon {
        display: flex;
        align-items: stretch;
    }
    .input-addon-text {
        background: #ece7dd;
        border: 1.5px solid #ece7dd;
        padding: 10px 12px;
        font-size: 13px;
        color: #6b6b64;
        display: flex;
        align-items: center;
    }
    .input-addon-text:first-child {
        border-right: none;
        border-radius: 8px 0 0 8px;
    }
    .input-addon-text:last-child {
        border-left: none;
        border-radius: 0 8px 8px 0;
        font-weight: 600;
    }
    .input-addon .form-input {
        border-radius: 0;
        flex: 1;
        border-left: none;
        border-right: none;
    }

    /* Select wrapper */
    .select-wrap { position: relative; }
    .select-wrap::after {
        content: '';
        position: absolute;
        right: 13px; top: 50%;
        transform: translateY(-50%);
        border: 5px solid transparent;
        border-top-color: #6b6b64;
        pointer-events: none;
    }
    .select-wrap .form-select { padding-right: 36px; cursor: pointer; }

    /* Validation */
    .form-input.is-valid, .form-select.is-valid, .form-textarea.is-valid { border-color: #16a34a !important; background-color: #f0fdf4 !important; }
    .form-input.is-invalid, .form-select.is-invalid, .form-textarea.is-invalid { border-color: #dc2626 !important; background-color: #fef2f2 !important; }

    .field-error {
        display: none;
        color: #dc2626;
        font-size: 11px;
        margin-top: 5px;
        align-items: center;
        gap: 5px;
    }
    .field-error.visible { display: flex; }

    .error-banner {
        display: none;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        color: #dc2626;
        font-size: 13px;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }
    .error-banner.visible { display: flex; }

    .char-counter {
        font-size: 11px;
        color: #9e9d95;
        font-family: 'DM Mono', monospace;
    }
    .char-counter.danger { color: #dc2626; font-weight: 600; }

    .desc-footer, .reco-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 4px;
    }

    .help-text { font-size: 11px; color: #9e9d95; margin-top: 4px; }

    /* Row 2 colonnes */
    .row-2cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* Actions */
    .form-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1.5px solid #ece7dd;
    }
    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1d3d17;
        color: #c8e6b0;
        border: none;
        border-radius: 12px;
        padding: 11px 24px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background .18s;
    }
    .btn-submit:hover { background: #2d5a1b; color: white; transform: translateY(-1px); }
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #6b6b64;
        border: 1px solid #d8d1c1;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        font-size: 14px;
        transition: all .15s;
    }
    .btn-cancel:hover { background: #ece7dd; color: #1a1a18; transform: translateY(-1px); }

    /* Flash */
    .flash-message {
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .flash-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .flash-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

    /* Loading spinner */
    .loading {
        display: inline-block;
        width: 14px;
        height: 14px;
        border: 2px solid #c8e6b0;
        border-top-color: transparent;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
        margin-right: 6px;
    }
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    .btn-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }

    @media (max-width: 600px) {
        .form-body { padding: 20px; }
        .row-2cols { grid-template-columns: 1fr; gap: 16px; }
        .form-actions { flex-direction: column; }
        .btn-submit, .btn-cancel { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="form-page">
<div class="form-container">

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-message flash-{{ type == 'error' ? 'error' : 'success' }}">
                <i class="bi bi-{{ type == 'error' ? 'x-circle-fill' : 'check-circle-fill' }}"></i>
                {{ msg }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="form-card">
        <div class="form-header">
            <div class="header-icon"><i class="bi bi-tools"></i></div>
            <div class="header-text">
                <h2>Ajouter une maintenance</h2>
                <p>Tous les champs marqués * sont obligatoires</p>
            </div>
        </div>

        <div class="form-body">
            <div class="error-banner" id="errorBanner">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>Veuillez corriger les erreurs avant d'enregistrer.</span>
            </div>

            <form method="post" action="{{ path('admin_maintenances_new') }}" id="maintenanceForm" novalidate>

                <div class="section-title"><i class="bi bi-tag-fill"></i> Identification</div>

                <div class="form-group">
                    <label class="form-label" for="typePanne">Type de panne <span class="req">*</span></label>
                    <div class="select-wrap">
                        <select name="typePanne" id="typePanne" class="form-select" required>
                            <option value="">— Choisir un type —</option>
                            <option value="Électrique">⚡ Électrique</option>
                            <option value="Mécanique">⚙️ Mécanique</option>
                            <option value="Hydraulique">💧 Hydraulique</option>
                            <option value="Pneumatique">🌬️ Pneumatique</option>
                            <option value="Moteur">🔩 Moteur</option>
                            <option value="Transmission">🔄 Transmission</option>
                            <option value="Vidange &amp; filtres">🛢️ Vidange & Filtres</option>
                            <option value="Logicielle">💻 Logicielle</option>
                            <option value="Autre">🔧 Autre</option>
                        </select>
                    </div>
                    <div class="field-error" id="typeError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="typeErrorMsg"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="description">Description <span class="req">*</span></label>
                    <textarea name="description" id="description" class="form-textarea"
                              placeholder="Ex : Remplacement du filtre à huile moteur et vidange complète…"
                              required></textarea>
                    <div class="desc-footer">
                        <div class="field-error" id="descError" style="flex:1;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="descErrorMsg"></span>
                        </div>
                        <span class="char-counter" id="descCount">0 / 1000</span>
                    </div>
                </div>

                <div class="section-title" style="margin-top:24px;"><i class="bi bi-cash-coin"></i> Coût &amp; Date</div>

                <div class="form-group">
                    <label class="form-label" for="cout">Coût <span class="req">*</span></label>
                    <div class="input-addon">
                        <span class="input-addon-text"><i class="bi bi-cash-coin"></i></span>
                        <input type="number" name="cout" id="cout" class="form-input"
                               step="0.01" min="0.01" max="999999.99" placeholder="0.00" required>
                        <span class="input-addon-text">DT</span>
                    </div>
                    <div class="field-error" id="coutError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="coutErrorMsg"></span>
                    </div>
                    <div class="help-text">Maximum 999 999,99 DT</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="dateMain">Date <span class="req">*</span></label>
                    <div class="input-addon">
                        <span class="input-addon-text"><i class="bi bi-calendar3"></i></span>
                        <input type="date" name="dateMain" id="dateMain" class="form-input"
                               value="{{ 'now'|date('Y-m-d') }}"
                               max="{{ 'now'|date('Y-m-d') }}" required>
                    </div>
                    <div class="field-error" id="dateError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="dateErrorMsg"></span>
                    </div>
                    <div class="help-text">Date ≤ aujourd'hui</div>
                </div>

                <div class="section-title" style="margin-top:8px;"><i class="bi bi-sliders2"></i> Suivi &amp; Priorité</div>

                <div class="row-2cols">
                    <div class="form-group">
                        <label class="form-label" for="statut">Statut <span class="req">*</span></label>
                        <div class="select-wrap">
                            <select name="statut" id="statut" class="form-select" required>
                                <option value="planifie" selected>📋 Planifié</option>
                                <option value="en_cours">⚙️ En cours</option>
                                <option value="termine">✅ Terminé</option>
                            </select>
                        </div>
                        <div class="field-error" id="statutError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="statutErrorMsg"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="priorite">Priorité <span class="req">*</span></label>
                        <div class="select-wrap">
                            <select name="priorite" id="priorite" class="form-select" required>
                                <option value="faible">⬇️ Faible</option>
                                <option value="moyenne" selected>➡️ Moyenne</option>
                                <option value="haute">⬆️ Haute</option>
                                <option value="urgente">⚠️ Urgente</option>
                            </select>
                        </div>
                        <div class="field-error" id="prioriteError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="prioriteErrorMsg"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="kilometrage">Kilométrage</label>
                    <div class="input-addon">
                        <span class="input-addon-text"><i class="bi bi-speedometer2"></i></span>
                        <input type="number" name="kilometrage" id="kilometrage" class="form-input"
                               step="1" min="0" max="9999999" placeholder="0">
                        <span class="input-addon-text">km</span>
                    </div>
                    <div class="field-error" id="kmError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="kmErrorMsg"></span>
                    </div>
                    <div class="help-text">Optionnel - Kilométrage au moment de la maintenance</div>
                </div>

                <div class="section-title" style="margin-top:8px;"><i class="bi bi-chat-dots-fill"></i> Recommandation</div>

                <div class="form-group">
                    <label class="form-label" for="recommandation">Recommandation <span style="font-weight:400;">(optionnel - sera générée automatiquement si vide)</span></label>
                    <textarea name="recommandation" id="recommandation" class="form-textarea"
                              placeholder="Ex : À surveiller tous les 5000 km, remplacer le filtre à air…"
                              rows="3"></textarea>
                    <div class="reco-footer">
                        <div class="field-error" id="recoError" style="flex:1;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="recoErrorMsg"></span>
                        </div>
                        <span class="char-counter" id="recoCount">0 / 2000</span>
                    </div>
                    <div class="help-text">
                        <i class="bi bi-robot"></i> Laissez vide pour une recommandation générée automatiquement par l'IA
                    </div>
                </div>

                <div class="section-title" style="margin-top:8px;"><i class="bi bi-cpu-fill"></i> Matériel associé</div>

                <div class="form-group">
                    <label class="form-label" for="idM">Matériel <span style="font-weight:400;">(optionnel)</span></label>
                    <div class="select-wrap">
                        <select name="idM" id="idM" class="form-select">
                            <option value="">— Aucun matériel —</option>
                            {% for machine in machines %}
                                <option value="{{ machine.id }}">{{ machine.nom }} (ID : {{ machine.id }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="help-text">Sélectionnez le matériel concerné par cette maintenance</div>
                </div>

                <div class="form-actions" style="margin-top:28px;">
                    <button type="submit" class="btn-submit" id="submitBtn">
                        <i class="bi bi-check-lg"></i> 
                        <span>Créer la maintenance</span>
                    </button>
                    <a href="{{ path('admin_maintenances_index') }}" class="btn-cancel">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const form = document.getElementById('maintenanceForm');
    const submitBtn = document.getElementById('submitBtn');
    const typeEl = document.getElementById('typePanne');
    const coutEl = document.getElementById('cout');
    const dateEl = document.getElementById('dateMain');
    const descEl = document.getElementById('description');
    const statutEl = document.getElementById('statut');
    const prioriteEl = document.getElementById('priorite');
    const kmEl = document.getElementById('kilometrage');
    const recoEl = document.getElementById('recommandation');
    const descCtr = document.getElementById('descCount');
    const recoCtr = document.getElementById('recoCount');
    const banner = document.getElementById('errorBanner');
    const today = new Date().toISOString().split('T')[0];
    dateEl.setAttribute('max', today);

    function valid(el) { 
        el.classList.remove('is-invalid'); 
        el.classList.add('is-valid'); 
    }
    function invalid(el) { 
        el.classList.remove('is-valid'); 
        el.classList.add('is-invalid'); 
    }
    function showErr(id, sid, msg) {
        const s = document.getElementById(sid); 
        if (s) s.textContent = msg;
        const d = document.getElementById(id); 
        if (d) d.classList.add('visible');
    }
    function hideErr(id) { 
        const d = document.getElementById(id); 
        if (d) d.classList.remove('visible'); 
    }

    function vType() {
        if (!typeEl.value) {
            invalid(typeEl);
            showErr('typeError', 'typeErrorMsg', 'Veuillez sélectionner un type de panne.');
            return false;
        }
        valid(typeEl);
        hideErr('typeError');
        return true;
    }

    function vCout() {
        const raw = coutEl.value.trim(), val = parseFloat(raw);
        if (raw === '' || isNaN(val)) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût est obligatoire.');
            return false;
        }
        if (val <= 0) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût doit être supérieur à 0.');
            return false;
        }
        if (val > 999999.99) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût ne peut pas dépasser 999 999,99 DT.');
            return false;
        }
        valid(coutEl);
        hideErr('coutError');
        return true;
    }

    function vDate() {
        if (!dateEl.value) {
            invalid(dateEl);
            showErr('dateError', 'dateErrorMsg', 'La date est obligatoire.');
            return false;
        }
        if (dateEl.value > today) {
            invalid(dateEl);
            showErr('dateError', 'dateErrorMsg', 'La date ne peut pas être dans le futur.');
            return false;
        }
        valid(dateEl);
        hideErr('dateError');
        return true;
    }

    function vDesc() {
        const v = descEl.value, l = v.length;
        if (l === 0) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'La description est obligatoire.');
            return false;
        }
        if (l < 5) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Minimum 5 caractères.');
            return false;
        }
        if (l > 1000) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Maximum 1000 caractères.');
            return false;
        }
        if (/[<>{}]/.test(v)) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Caractères < > { } interdits.');
            return false;
        }
        valid(descEl);
        hideErr('descError');
        return true;
    }

    function vStatut() {
        if (!statutEl.value) {
            invalid(statutEl);
            showErr('statutError', 'statutErrorMsg', 'Veuillez sélectionner un statut.');
            return false;
        }
        valid(statutEl);
        hideErr('statutError');
        return true;
    }

    function vPriorite() {
        if (!prioriteEl.value) {
            invalid(prioriteEl);
            showErr('prioriteError', 'prioriteErrorMsg', 'Veuillez sélectionner une priorité.');
            return false;
        }
        valid(prioriteEl);
        hideErr('prioriteError');
        return true;
    }

    function vKilometrage() {
        const raw = kmEl.value.trim();
        if (raw === '') {
            valid(kmEl);
            hideErr('kmError');
            return true;
        }
        const val = parseInt(raw);
        if (isNaN(val) || val < 0) {
            invalid(kmEl);
            showErr('kmError', 'kmErrorMsg', 'Le kilométrage doit être positif ou nul.');
            return false;
        }
        if (val > 9999999) {
            invalid(kmEl);
            showErr('kmError', 'kmErrorMsg', 'Kilométrage trop élevé (max 9 999 999).');
            return false;
        }
        valid(kmEl);
        hideErr('kmError');
        return true;
    }

    function vRecommandation() {
        const v = recoEl.value, l = v.length;
        if (l > 2000) {
            invalid(recoEl);
            showErr('recoError', 'recoErrorMsg', 'Maximum 2000 caractères.');
            return false;
        }
        // La recommandation est optionnelle, pas d'erreur si vide
        valid(recoEl);
        hideErr('recoError');
        return true;
    }

    function updateDescCtr() {
        const l = descEl.value.length;
        descCtr.textContent = l + ' / 1000';
        descCtr.className = 'char-counter' + ((l > 0 && l < 5) || l > 1000 ? ' danger' : '');
    }

    function updateRecoCtr() {
        const l = recoEl.value.length;
        recoCtr.textContent = l + ' / 2000';
        recoCtr.className = 'char-counter' + (l > 2000 ? ' danger' : '');
    }

    // Afficher le chargement lors de la soumission
    function showLoading() {
        const originalContent = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="loading"></span> Création en cours...';
        // Sauvegarder le contenu original pour une éventuelle restauration (optionnel)
        submitBtn.setAttribute('data-original', originalContent);
    }

    // Event listeners
    typeEl.addEventListener('change', vType);
    coutEl.addEventListener('input', vCout);
    dateEl.addEventListener('change', vDate);
    descEl.addEventListener('input', function() { 
        updateDescCtr(); 
        if (this.classList.contains('is-valid') || this.classList.contains('is-invalid')) vDesc(); 
    });
    descEl.addEventListener('blur', vDesc);
    statutEl.addEventListener('change', vStatut);
    prioriteEl.addEventListener('change', vPriorite);
    kmEl.addEventListener('input', vKilometrage);
    recoEl.addEventListener('input', function() { 
        updateRecoCtr(); 
        if (this.classList.contains('is-valid') || this.classList.contains('is-invalid')) vRecommandation(); 
    });
    recoEl.addEventListener('blur', vRecommandation);

    // Initialisation
    updateDescCtr();
    updateRecoCtr();

    form.addEventListener('submit', function(e) {
        const ok = vType() && vCout() && vDate() && vDesc() && vStatut() && vPriorite() && vKilometrage() && vRecommandation();
        if (!ok) {
            e.preventDefault();
            banner.classList.add('visible');
            const first = form.querySelector('.is-invalid');
            if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
            banner.classList.remove('visible');
            showLoading();
        }
    });
})();
</script>
{% endblock %}