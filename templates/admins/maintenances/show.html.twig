{% extends 'base_admin.html.twig' %}

{% block title %}Maintenance #{{ maintenance.idMain }} — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f2ec; color: #1a1a18; }

    .show-page { padding: 40px 20px 80px; display: flex; justify-content: center; }
    .show-container { width: 100%; max-width: 720px; }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: #6b6b64;
        text-decoration: none;
        margin-bottom: 18px;
        padding: 5px 10px;
        border-radius: 8px;
        transition: all .15s;
    }
    .back-link:hover { color: #2d5a1b; background: rgba(45,90,27,.07); }

    .show-card {
        background: white;
        border: 1px solid #ece7dd;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(26,26,24,.09);
    }

    .show-header {
        background: #1d3d17;
        padding: 28px 32px;
    }
    .show-header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }
    .show-header h2 {
        font-size: 20px;
        font-weight: 600;
        color: white;
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }
    .show-header-icon {
        width: 44px;
        height: 44px;
        background: rgba(200,230,176,.15);
        border: 1px solid rgba(200,230,176,.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #c8e6b0;
    }
    .show-header p {
        font-size: 12px;
        color: rgba(200,230,176,.7);
        margin: 6px 0 0;
    }
    .btn-back-header {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,.1);
        color: rgba(255,255,255,.9);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        padding: 8px 16px;
        font-size: 13px;
        text-decoration: none;
        transition: background .15s;
    }
    .btn-back-header:hover { background: rgba(255,255,255,.18); color: white; }

    /* Info rows */
    .info-row {
        display: flex;
        align-items: flex-start;
        padding: 18px 28px;
        border-bottom: 1px solid #ece7dd;
        gap: 20px;
        transition: background .12s;
    }
    .info-row:hover { background: #fafaf9; }
    .info-label {
        width: 140px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .info-label-icon {
        width: 30px;
        height: 30px;
        background: #f5f2ec;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: #2d5a1b;
    }
    .info-label-text {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .7px;
        text-transform: uppercase;
        color: #9e9d95;
    }
    .info-value {
        flex: 1;
        font-size: 14px;
        color: #3d3d38;
        line-height: 1.6;
        padding-top: 5px;
    }

    /* Type badge */
    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .type-moteur { background: #e8f5e9; color: #1b5e20; }
    .type-hydraulique { background: #e3f2fd; color: #0d47a1; }
    .type-electrique { background: #fff8e1; color: #e65100; }
    .type-mecanique { background: #fce4ec; color: #880e4f; }
    .type-pneumatique { background: #f3e5f5; color: #4a148c; }
    .type-transmission { background: #fff3e0; color: #bf360c; }
    .type-vidange { background: #e0f7fa; color: #004d40; }
    .type-logicielle { background: #eceff1; color: #263238; }
    .type-autre { background: #f5f5f5; color: #424242; }

    /* Statut badges */
    .statut-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }
    .statut-planifie { background: #e3f2fd; color: #1565c0; }
    .statut-en_cours { background: #fff3e0; color: #e65100; }
    .statut-termine { background: #e8f5e9; color: #2e7d32; }

    /* Priorité badges */
    .priorite-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }
    .priorite-faible { background: #f5f5f5; color: #616161; }
    .priorite-moyenne { background: #e3f2fd; color: #1565c0; }
    .priorite-haute { background: #fff3e0; color: #e65100; }
    .priorite-urgente { background: #ffebee; color: #c62828; }

    .machine-link {
        text-decoration: none;
        color: #2d5a1b;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .machine-link:hover { color: #1d3d17; }
    .machine-id {
        font-size: 11px;
        color: #9e9d95;
        font-family: 'DM Mono', monospace;
        background: #f5f2ec;
        padding: 2px 8px;
        border-radius: 20px;
        margin-left: 8px;
    }

    .cost-big {
        font-size: 28px;
        font-weight: 600;
        color: #2d5a1b;
        font-family: 'DM Mono', monospace;
        letter-spacing: -1px;
        display: flex;
        align-items: baseline;
        gap: 6px;
    }
    .cost-big .unit {
        font-size: 13px;
        font-weight: 500;
        color: #6b6b64;
        background: #f5f2ec;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .date-main { font-size: 15px; font-weight: 500; color: #1a1a18; }
    .date-sub { font-size: 11px; color: #9e9d95; margin-top: 3px; font-family: 'DM Mono', monospace; }

    .desc-box, .reco-box {
        background: #f5f2ec;
        border: 1px solid #ece7dd;
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 14px;
        line-height: 1.7;
        color: #3d3d38;
        white-space: pre-wrap;
        width: 100%;
    }

    .km-value {
        font-size: 18px;
        font-weight: 600;
        color: #1a1a18;
        font-family: 'DM Mono', monospace;
    }
    .km-unit {
        font-size: 12px;
        color: #6b6b64;
        margin-left: 4px;
    }

    /* Actions */
    .show-actions {
        padding: 20px 28px;
        border-top: 1px solid #ece7dd;
        background: #f5f2ec;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #fff8e1;
        color: #e65100;
        border: 1px solid #ffe082;
        border-radius: 12px;
        padding: 9px 20px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s;
    }
    .btn-edit:hover { background: #ffecb3; color: #bf360c; }
    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #ffebee;
        color: #c62828;
        border: none;
        border-radius: 12px;
        padding: 9px 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background .15s;
    }
    .btn-delete:hover { background: #ffcdd2; }
    .btn-close-ag {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: white;
        color: #6b6b64;
        border: 1px solid #d8d1c1;
        border-radius: 12px;
        padding: 9px 20px;
        font-size: 13px;
        text-decoration: none;
        transition: all .15s;
    }
    .btn-close-ag:hover { background: #ece7dd; color: #1a1a18; }

    /* Flash */
    .flash-message {
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 16px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .flash-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .flash-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

    @media (max-width: 600px) {
        .show-page { padding: 20px 12px 60px; }
        .info-row { flex-direction: column; gap: 10px; padding: 14px 18px; }
        .info-label { width: 100%; }
        .show-header { padding: 22px; }
        .show-actions { justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="show-page">
<div class="show-container">

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-message flash-{{ type == 'error' ? 'error' : 'success' }}">
                <i class="bi bi-{{ type == 'error' ? 'exclamation-circle-fill' : 'check-circle-fill' }}"></i>
                {{ msg }}
            </div>
        {% endfor %}
    {% endfor %}

    <a href="{{ path('admin_maintenances_index') }}" class="back-link">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>

    <div class="show-card">
        <div class="show-header">
            <div class="show-header-inner">
                <div>
                    <h2>
                        <span class="show-header-icon"><i class="bi bi-clipboard2-pulse-fill"></i></span>
                        Maintenance #{{ maintenance.idMain }}
                    </h2>
                    <p>Fiche d'intervention complète</p>
                </div>
                <a href="{{ path('admin_maintenances_index') }}" class="btn-back-header">
                    <i class="bi bi-grid-3x3-gap-fill"></i> Toutes les maintenances
                </a>
            </div>
        </div>

        <div>
            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-tag-fill"></i></div>
                    <span class="info-label-text">Type</span>
                </div>
                <div class="info-value">
                    <span class="type-badge 
                        {% if maintenance.typePanne == 'Moteur' %}type-moteur
                        {% elseif maintenance.typePanne == 'Hydraulique' %}type-hydraulique
                        {% elseif maintenance.typePanne in ['Électrique','Electricité'] %}type-electrique
                        {% elseif maintenance.typePanne == 'Mécanique' %}type-mecanique
                        {% elseif maintenance.typePanne == 'Pneumatique' %}type-pneumatique
                        {% elseif maintenance.typePanne == 'Transmission' %}type-transmission
                        {% elseif maintenance.typePanne == 'Vidange & filtres' %}type-vidange
                        {% elseif maintenance.typePanne == 'Logicielle' %}type-logicielle
                        {% else %}type-autre{% endif %}">
                        {% if maintenance.typePanne == 'Moteur' %}<i class="bi bi-gear-fill"></i>
                        {% elseif maintenance.typePanne == 'Hydraulique' %}<i class="bi bi-droplet-fill"></i>
                        {% elseif maintenance.typePanne in ['Électrique','Electricité'] %}<i class="bi bi-lightning-charge-fill"></i>
                        {% elseif maintenance.typePanne == 'Transmission' %}<i class="bi bi-arrow-repeat"></i>
                        {% else %}<i class="bi bi-tools"></i>{% endif %}
                        {{ maintenance.typePanne }}
                    </span>
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-cpu-fill"></i></div>
                    <span class="info-label-text">Matériel</span>
                </div>
                <div class="info-value">
                    {% if maintenance.nom %}
                        <a href="{{ path('admin_machines_show', {id: maintenance.idM}) }}" class="machine-link">
<span class="machine-id">#{{ maintenance.idM }}</span>
                        <span class="machine-id">#{{ maintenance.idM }}</span>
                    {% else %}
                        <span style="color: #9e9d95; font-style: italic;">— Non lié à un matériel —</span>
                    {% endif %}
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-cash-stack"></i></div>
                    <span class="info-label-text">Coût</span>
                </div>
                <div class="info-value">
                    <div class="cost-big">
                        {{ maintenance.cout|number_format(2, ',', ' ') }}
                        <span class="unit">DT</span>
                    </div>
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-calendar-week-fill"></i></div>
                    <span class="info-label-text">Date</span>
                </div>
                <div class="info-value">
                    {% if maintenance.dateMain %}
                        <div class="date-main">{{ maintenance.dateMain|date('d F Y') }}</div>
                        <div class="date-sub">{{ maintenance.dateMain|date('d/m/Y') }}</div>
                    {% else %}
                        <span style="color: #9e9d95; font-style: italic;">Non renseignée</span>
                    {% endif %}
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-flag-fill"></i></div>
                    <span class="info-label-text">Statut</span>
                </div>
                <div class="info-value">
                    <span class="statut-badge 
                        {% if maintenance.statut == 'planifie' %}statut-planifie
                        {% elseif maintenance.statut == 'en_cours' %}statut-en_cours
                        {% elseif maintenance.statut == 'termine' %}statut-termine{% endif %}">
                        <i class="bi bi-{% if maintenance.statut == 'planifie' %}calendar-check{% elseif maintenance.statut == 'en_cours' %}hourglass-split{% else %}check2-circle{% endif %}"></i>
                        {% if maintenance.statut == 'planifie' %}Planifié
                        {% elseif maintenance.statut == 'en_cours' %}En cours
                        {% else %}Terminé{% endif %}
                    </span>
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <span class="info-label-text">Priorité</span>
                </div>
                <div class="info-value">
                    <span class="priorite-badge 
                        {% if maintenance.priorite == 'faible' %}priorite-faible
                        {% elseif maintenance.priorite == 'moyenne' %}priorite-moyenne
                        {% elseif maintenance.priorite == 'haute' %}priorite-haute
                        {% elseif maintenance.priorite == 'urgente' %}priorite-urgente{% endif %}">
                        <i class="bi bi-{% if maintenance.priorite == 'faible' %}arrow-down-circle{% elseif maintenance.priorite == 'moyenne' %}dash-circle{% elseif maintenance.priorite == 'haute' %}arrow-up-circle{% else %}exclamation-circle{% endif %}"></i>
                        {% if maintenance.priorite == 'faible' %}Faible
                        {% elseif maintenance.priorite == 'moyenne' %}Moyenne
                        {% elseif maintenance.priorite == 'haute' %}Haute
                        {% else %}Urgente{% endif %}
                    </span>
                </div>
            </div>

            <div class="info-row">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-speedometer2"></i></div>
                    <span class="info-label-text">Kilométrage</span>
                </div>
                <div class="info-value">
                    {% if maintenance.kilometrage %}
                        <span class="km-value">{{ maintenance.kilometrage|number_format(0, ',', ' ') }}</span>
                        <span class="km-unit">km</span>
                    {% else %}
                        <span style="color: #9e9d95; font-style: italic;">Non renseigné</span>
                    {% endif %}
                </div>
            </div>

            <div class="info-row" style="align-items:flex-start;">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-file-text-fill"></i></div>
                    <span class="info-label-text">Description</span>
                </div>
                <div class="info-value">
                    {% if maintenance.description %}
                        <div class="desc-box">{{ maintenance.description|nl2br }}</div>
                    {% else %}
                        <span style="color: #9e9d95; font-style: italic;">Aucune description fournie</span>
                    {% endif %}
                </div>
            </div>

            <div class="info-row" style="align-items:flex-start;">
                <div class="info-label">
                    <div class="info-label-icon"><i class="bi bi-chat-dots-fill"></i></div>
                    <span class="info-label-text">Recommandation</span>
                </div>
                <div class="info-value">
                    {% if maintenance.recommandation %}
                        <div class="reco-box">{{ maintenance.recommandation|nl2br }}</div>
                    {% else %}
                        <span style="color: #9e9d95; font-style: italic;">Aucune recommandation</span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="show-actions">
            <a href="{{ path('admin_maintenances_edit', {id: maintenance.idMain}) }}" class="btn-edit">
                <i class="bi bi-pencil-square"></i> Modifier
            </a>
            <form method="post" action="{{ path('admin_maintenances_delete', {id: maintenance.idMain}) }}" style="display: inline;" onsubmit="return confirm('Supprimer définitivement cette maintenance ? Cette action est irréversible.')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ maintenance.idMain) }}">
                <button type="submit" class="btn-delete"><i class="bi bi-trash3-fill"></i> Supprimer</button>
            </form>
            <a href="{{ path('admin_maintenances_index') }}" class="btn-close-ag">
                <i class="bi bi-x-circle"></i> Fermer
            </a>
        </div>
    </div>
</div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}