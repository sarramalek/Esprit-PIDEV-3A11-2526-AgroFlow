{% extends 'base.html.twig' %}
{% block title %}Maintenance #{{ maintenance.idMain }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    .detail-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .detail-header {
        background: linear-gradient(135deg, #1a472a 0%, #2d5a1b 100%);
        border-radius: 16px 16px 0 0;
        padding: 20px 24px;
    }
    .detail-header h2 {
        color: white;
        font-size: 20px;
        margin: 0;
    }
    .detail-header p {
        color: rgba(255,255,255,0.7);
        margin: 5px 0 0;
        font-size: 13px;
    }
    .detail-body {
        padding: 24px;
    }
    .info-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }
    .info-row:last-child {
        border-bottom: none;
    }
    .info-label {
        width: 140px;
        font-weight: 600;
        color: #6b7280;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .info-value {
        flex: 1;
        font-size: 15px;
        color: #1f2937;
    }
    .badge-custom {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
    }
    .action-buttons {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 800px;">

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="detail-card">
        <div class="detail-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>
                        <i class="bi bi-wrench-adjustable me-2"></i>
                        Maintenance #{{ maintenance.idMain }}
                    </h2>
                    <p>Détails complets de l'intervention</p>
                </div>
                <a href="{{ path('admin_maintenances_index') }}" class="btn btn-light btn-sm">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
            </div>
        </div>

        <div class="detail-body">

            {# Type de panne #}
            <div class="info-row">
                <div class="info-label">
                    <i class="bi bi-tag me-1"></i> Type de panne
                </div>
                <div class="info-value">
                    <span class="badge-custom 
                        {% if maintenance.typePanne in ['Électrique','Electricité'] %}bg-warning text-dark
                        {% elseif maintenance.typePanne == 'Mécanique' %}bg-info text-dark
                        {% elseif maintenance.typePanne == 'Hydraulique' %}bg-primary text-white
                        {% elseif maintenance.typePanne == 'Pneumatique' %}bg-secondary text-white
                        {% elseif maintenance.typePanne == 'Logicielle' %}bg-dark text-white
                        {% elseif maintenance.typePanne == 'Moteur' %}bg-success text-white
                        {% elseif maintenance.typePanne == 'Transmission' %}bg-danger text-white
                        {% else %}bg-secondary text-white{% endif %}">
                        {{ maintenance.typePanne }}
                    </span>
                </div>
            </div>

            {# Matériel associé #}
            <div class="info-row">
                <div class="info-label">
                    <i class="bi bi-cpu me-1"></i> Matériel
                </div>
                <div class="info-value">
                    {% if maintenance.nom %}
                        <div class="fw-semibold">{{ maintenance.nom }}</div>
                        <small class="text-muted">ID: {{ maintenance.idM }}</small>
                    {% else %}
                        <span class="text-muted">— Non lié à un matériel —</span>
                    {% endif %}
                </div>
            </div>

            {# Coût #}
            <div class="info-row">
                <div class="info-label">
                    <i class="bi bi-cash-coin me-1"></i> Coût
                </div>
                <div class="info-value">
                    <span class="fs-4 fw-bold text-success">{{ maintenance.cout|number_format(2, ',', ' ') }} DT</span>
                </div>
            </div>

            {# Date #}
            <div class="info-row">
                <div class="info-label">
                    <i class="bi bi-calendar3 me-1"></i> Date
                </div>
                <div class="info-value">
                    {% if maintenance.dateMain %}
                        <i class="bi bi-calendar-check text-success me-1"></i>
                        {{ maintenance.dateMain|date('l d F Y') }}
                        <small class="text-muted">({{ maintenance.dateMain|date('d/m/Y') }})</small>
                    {% else %}
                        <span class="text-muted">Non renseignée</span>
                    {% endif %}
                </div>
            </div>

            {# Description #}
            <div class="info-row">
                <div class="info-label">
                    <i class="bi bi-file-text me-1"></i> Description
                </div>
                <div class="info-value">
                    {% if maintenance.description %}
                        <div class="p-3 bg-light rounded" style="white-space: pre-wrap;">
                            {{ maintenance.description }}
                        </div>
                    {% else %}
                        <span class="text-muted">— Aucune description —</span>
                    {% endif %}
                </div>
            </div>

            {# Actions #}
            <div class="action-buttons">
                <a href="{{ path('admin_maintenances_edit', {id: maintenance.idMain}) }}"
                   class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalDeleteShow">
                    <i class="bi bi-trash"></i> Supprimer
                </button>
                <a href="{{ path('admin_maintenances_index') }}" class="btn btn-secondary">
                    <i class="bi bi-x-lg"></i> Fermer
                </a>
            </div>

        </div>
    </div>
</div>

{# Modal suppression #}
<div class="modal fade" id="modalDeleteShow" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmer la suppression
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Supprimer définitivement la maintenance
                    <strong>{{ maintenance.typePanne }}</strong>
                    du <strong>{{ maintenance.dateMain ? maintenance.dateMain|date('d/m/Y') : '—' }}</strong> ?
                </p>
                {% if maintenance.nom %}
                    <div class="alert alert-info py-2">
                        <i class="bi bi-info-circle me-1"></i>
                        Matériel concerné : <strong>{{ maintenance.nom }}</strong>
                    </div>
                {% endif %}
                <div class="alert alert-warning py-2 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Cette action est <strong>irréversible</strong>.
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Annuler
                </button>
                <form method="post" action="{{ path('admin_maintenances_delete', {id: maintenance.idMain}) }}">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete_maintenance_' ~ maintenance.idMain) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}