{% extends 'base_admin.html.twig' %}

{% block title %}Modifier maintenance #{{ maintenance.idMain }} — AgroFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f5f2ec; color: #1a1a18; }

    .form-page { min-height: 100vh; padding: 40px 20px 80px; display: flex; justify-content: center; }
    .form-container { width: 100%; max-width: 720px; }

    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(26,26,24,.08);
        overflow: hidden;
        border: 1px solid #ece7dd;
    }

    .form-header {
        background: #1d3d17;
        padding: 28px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .header-icon {
        width: 48px; height: 48px;
        background: rgba(200,230,176,.15);
        border: 1px solid rgba(200,230,176,.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        color: #c8e6b0;
    }
    .header-text h2 {
        font-size: 20px;
        font-weight: 600;
        color: white;
        letter-spacing: -.3px;
        margin: 0;
    }
    .header-text p {
        font-size: 12px;
        color: rgba(200,230,176,.75);
        margin: 4px 0 0;
    }

    .form-body { padding: 32px; }

    .id-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 11px;
        font-weight: 500;
        color: #92400e;
        font-family: 'DM Mono', monospace;
        margin-bottom: 24px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #2d5a1b;
        padding-bottom: 10px;
        border-bottom: 1.5px solid #ece7dd;
        margin-bottom: 22px;
        margin-top: 6px;
    }

    .btn-wiki {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f5f2ec;
        color: #1d3d17;
        border: 1px solid #d8d1c1;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.18s;
        margin-left: 12px;
    }
    .btn-wiki:hover {
        background: #1d3d17;
        color: white;
        border-color: #1d3d17;
        transform: translateY(-1px);
    }

    .form-group { margin-bottom: 20px; }
    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: #6b6b64;
        margin-bottom: 7px;
    }
    .form-label .req { color: #dc2626; }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        border: 1.5px solid #ece7dd;
        border-radius: 8px;
        padding: 10px 14px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        background: #f5f2ec;
        transition: all .18s;
        outline: none;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: #2d5a1b;
        background: white;
        box-shadow: 0 0 0 3px rgba(45,90,27,.1);
    }
    .form-textarea { resize: vertical; min-height: 110px; line-height: 1.6; }

    .input-addon {
        display: flex;
        align-items: stretch;
    }
    .input-addon-text {
        background: #ece7dd;
        border: 1.5px solid #ece7dd;
        padding: 10px 12px;
        font-size: 13px;
        color: #6b6b64;
        display: flex;
        align-items: center;
    }
    .input-addon-text:first-child {
        border-right: none;
        border-radius: 8px 0 0 8px;
    }
    .input-addon-text:last-child {
        border-left: none;
        border-radius: 0 8px 8px 0;
        font-weight: 600;
    }
    .input-addon .form-input {
        border-radius: 0;
        flex: 1;
        border-left: none;
        border-right: none;
    }

    .select-wrap { position: relative; }
    .select-wrap::after {
        content: '';
        position: absolute;
        right: 13px; top: 50%;
        transform: translateY(-50%);
        border: 5px solid transparent;
        border-top-color: #6b6b64;
        pointer-events: none;
    }
    .select-wrap .form-select { padding-right: 36px; cursor: pointer; }

    .row-2cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-input.is-valid, .form-select.is-valid, .form-textarea.is-valid { border-color: #16a34a !important; }
    .form-input.is-invalid, .form-select.is-invalid, .form-textarea.is-invalid { border-color: #dc2626 !important; }

    .field-error {
        display: none;
        color: #dc2626;
        font-size: 11px;
        margin-top: 5px;
        align-items: center;
        gap: 5px;
    }
    .field-error.visible { display: flex; }

    .error-banner {
        display: none;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 12px 16px;
        color: #dc2626;
        font-size: 13px;
        align-items: center;
        gap: 10px;
        margin-bottom: 24px;
    }
    .error-banner.visible { display: flex; }

    .char-counter {
        font-size: 11px;
        color: #9e9d95;
        font-family: 'DM Mono', monospace;
    }
    .char-counter.danger { color: #dc2626; font-weight: 600; }

    .desc-footer, .reco-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-top: 4px;
    }

    .help-text { font-size: 11px; color: #9e9d95; margin-top: 4px; }

    .form-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-top: 8px;
        margin-top: 8px;
        border-top: 1.5px solid #ece7dd;
    }
    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #1d3d17;
        color: #c8e6b0;
        border: none;
        border-radius: 12px;
        padding: 11px 24px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background .18s;
    }
    .btn-submit:hover { background: #2d5a1b; color: white; transform: translateY(-1px); }
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: white;
        color: #6b6b64;
        border: 1px solid #d8d1c1;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        font-size: 14px;
        transition: all .15s;
    }
    .btn-cancel:hover { background: #ece7dd; color: #1a1a18; }

    .flash-message {
        border-radius: 12px;
        padding: 12px 18px;
        margin-bottom: 20px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .flash-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    .flash-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }

    @media (max-width: 600px) {
        .form-body { padding: 20px; }
        .row-2cols { grid-template-columns: 1fr; gap: 16px; }
        .form-actions { flex-direction: column; }
        .btn-submit, .btn-cancel { width: 100%; justify-content: center; }
    }
</style>
{% endblock %}

{% block body %}
<div class="form-page">
<div class="form-container">

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="flash-message flash-{{ type == 'error' ? 'error' : 'success' }}">
                <i class="bi bi-{{ type == 'error' ? 'x-circle-fill' : 'check-circle-fill' }}"></i>
                {{ msg }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="form-card">
        <div class="form-header">
            <div class="header-icon"><i class="bi bi-pencil-square"></i></div>
            <div class="header-text">
                <h2>Modifier maintenance #{{ maintenance.idMain }}</h2>
                <p>Tous les champs marqués * sont obligatoires</p>
            </div>
        </div>

        <div class="form-body">
            <div class="id-badge">
                <i class="bi bi-info-circle"></i> ID : {{ maintenance.idMain }}
            </div>

            <div class="error-banner" id="errorBanner">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>Veuillez corriger les erreurs avant d'enregistrer.</span>
            </div>

            <form method="post" action="{{ path('admin_maintenances_edit', {id: maintenance.idMain}) }}" id="maintenanceForm" novalidate>

                {# Section Identification #}
                <div class="section-title">
                    <i class="bi bi-tag-fill"></i> Identification
                    {% if maintenance.typePanne %}
                        <a href="{{ path('admin_maintenances_wiki_pannes', {q: maintenance.typePanne}) }}" 
                           class="btn-wiki" target="_blank">
                            <i class="bi bi-wikipedia"></i> Wikipedia
                        </a>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label class="form-label" for="typePanne">Type de panne <span class="req">*</span></label>
                    <div class="select-wrap">
                        <select name="typePanne" id="typePanne" class="form-select" required>
                            <option value="">— Choisir un type —</option>
                            <option value="Électrique" {{ maintenance.typePanne == 'Électrique' ? 'selected' : '' }}>⚡ Électrique</option>
                            <option value="Mécanique" {{ maintenance.typePanne == 'Mécanique' ? 'selected' : '' }}>⚙️ Mécanique</option>
                            <option value="Hydraulique" {{ maintenance.typePanne == 'Hydraulique' ? 'selected' : '' }}>💧 Hydraulique</option>
                            <option value="Pneumatique" {{ maintenance.typePanne == 'Pneumatique' ? 'selected' : '' }}>🌬️ Pneumatique</option>
                            <option value="Moteur" {{ maintenance.typePanne == 'Moteur' ? 'selected' : '' }}>🔩 Moteur</option>
                            <option value="Transmission" {{ maintenance.typePanne == 'Transmission' ? 'selected' : '' }}>🔄 Transmission</option>
                            <option value="Vidange &amp; filtres" {{ maintenance.typePanne == 'Vidange & filtres' ? 'selected' : '' }}>🛢️ Vidange &amp; Filtres</option>
                            <option value="Logicielle" {{ maintenance.typePanne == 'Logicielle' ? 'selected' : '' }}>💻 Logicielle</option>
                            <option value="Autre" {{ maintenance.typePanne == 'Autre' ? 'selected' : '' }}>🔧 Autre</option>
                        </select>
                    </div>
                    <div class="field-error" id="typeError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="typeErrorMsg"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="description">Description <span class="req">*</span></label>
                    <textarea name="description" id="description" class="form-textarea"
                              placeholder="Ex : Remplacement du filtre à huile moteur et vidange complète…"
                              required>{{ maintenance.description }}</textarea>
                    <div class="desc-footer">
                        <div class="field-error" id="descError" style="flex:1;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="descErrorMsg"></span>
                        </div>
                        <span class="char-counter" id="descCount">{{ maintenance.description|length|default(0) }} / 1000</span>
                    </div>
                </div>

                {# Section Coût & Date #}
                <div class="section-title" style="margin-top:24px;">
                    <i class="bi bi-cash-coin"></i> Coût &amp; Date
                </div>

                <div class="row-2cols" style="margin-bottom: 20px;">
                    <div class="form-group">
                        <label class="form-label" for="cout">Coût <span class="req">*</span></label>
                        <div class="input-addon">
                            <span class="input-addon-text"><i class="bi bi-cash-coin"></i></span>
                            <input type="number" name="cout" id="cout" class="form-input" 
                                   step="0.01" min="0.01" max="999999.99" 
                                   placeholder="0,00" value="{{ maintenance.cout }}" required>
                            <span class="input-addon-text">DT</span>
                        </div>
                        <div class="field-error" id="coutError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="coutErrorMsg"></span>
                        </div>
                        <div class="help-text">Maximum 999 999,99 DT</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="dateMain">Date <span class="req">*</span></label>
                        <div class="input-addon">
                            <span class="input-addon-text"><i class="bi bi-calendar3"></i></span>
                            <input type="date" name="dateMain" id="dateMain" class="form-input"
                                   value="{{ maintenance.dateMain ? maintenance.dateMain|date('Y-m-d') : 'now'|date('Y-m-d') }}"
                                   max="{{ 'now'|date('Y-m-d') }}" required>
                        </div>
                        <div class="field-error" id="dateError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="dateErrorMsg"></span>
                        </div>
                        <div class="help-text">Date ≤ aujourd'hui</div>
                    </div>
                </div>

                {# Section Suivi & Priorité #}
                <div class="section-title" style="margin-top:8px;">
                    <i class="bi bi-sliders2"></i> Suivi &amp; Priorité
                </div>

                <div class="row-2cols" style="margin-bottom: 20px;">
                    <div class="form-group">
                        <label class="form-label" for="statut">Statut <span class="req">*</span></label>
                        <div class="select-wrap">
                            <select name="statut" id="statut" class="form-select" required>
                                <option value="planifie" {{ maintenance.statut == 'planifie' ? 'selected' : '' }}>📋 Planifié</option>
                                <option value="en_cours" {{ maintenance.statut == 'en_cours' ? 'selected' : '' }}>⚙️ En cours</option>
                                <option value="termine" {{ maintenance.statut == 'termine' ? 'selected' : '' }}>✅ Terminé</option>
                            </select>
                        </div>
                        <div class="field-error" id="statutError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="statutErrorMsg"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="priorite">Priorité <span class="req">*</span></label>
                        <div class="select-wrap">
                            <select name="priorite" id="priorite" class="form-select" required>
                                <option value="faible" {{ maintenance.priorite == 'faible' ? 'selected' : '' }}>⬇️ Faible</option>
                                <option value="moyenne" {{ maintenance.priorite == 'moyenne' ? 'selected' : '' }}>➡️ Moyenne</option>
                                <option value="haute" {{ maintenance.priorite == 'haute' ? 'selected' : '' }}>⬆️ Haute</option>
                                <option value="urgente" {{ maintenance.priorite == 'urgente' ? 'selected' : '' }}>⚠️ Urgente</option>
                            </select>
                        </div>
                        <div class="field-error" id="prioriteError">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="prioriteErrorMsg"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="kilometrage">Kilométrage</label>
                    <div class="input-addon">
                        <span class="input-addon-text"><i class="bi bi-speedometer2"></i></span>
                        <input type="number" name="kilometrage" id="kilometrage" class="form-input"
                               step="1" min="0" max="9999999" placeholder="0"
                               value="{{ maintenance.kilometrage }}">
                        <span class="input-addon-text">km</span>
                    </div>
                    <div class="field-error" id="kmError">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span id="kmErrorMsg"></span>
                    </div>
                    <div class="help-text">Optionnel - Kilométrage au moment de la maintenance</div>
                </div>

                {# Section Recommandation #}
                <div class="section-title" style="margin-top:8px;">
                    <i class="bi bi-chat-dots-fill"></i> Recommandation
                </div>

                <div class="form-group">
                    <label class="form-label" for="recommandation">Recommandation</label>
                    <textarea name="recommandation" id="recommandation" class="form-textarea"
                              placeholder="Ex : À surveiller tous les 5000 km, remplacer le filtre à air…"
                              rows="3">{{ maintenance.recommandation }}</textarea>
                    <div class="reco-footer">
                        <div class="field-error" id="recoError" style="flex:1;">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span id="recoErrorMsg"></span>
                        </div>
                        <span class="char-counter" id="recoCount">{{ maintenance.recommandation|length|default(0) }} / 2000</span>
                    </div>
                </div>

                {# Section Matériel associé #}
                <div class="section-title" style="margin-top:8px;">
                    <i class="bi bi-cpu-fill"></i> Matériel associé
                </div>

                <div class="form-group">
                    <label class="form-label" for="idM">Matériel <span style="font-weight:400; color:#9e9d95;">(optionnel)</span></label>
                    <div class="select-wrap">
                        <select name="idM" id="idM" class="form-select">
                            <option value="">— Aucun matériel —</option>
                            {% for machine in machines %}
                                <option value="{{ machine.id }}" {{ maintenance.idM == machine.id ? 'selected' : '' }}>
                                    {{ machine.nom }} (ID : {{ machine.id }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="help-text">Sélectionnez le matériel concerné par cette maintenance</div>
                </div>

                {# Actions #}
                <div class="form-actions" style="margin-top:28px;">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-check-lg"></i> Mettre à jour
                    </button>
                    <a href="{{ path('admin_maintenances_show', {id: maintenance.idMain}) }}" class="btn-cancel">
                        <i class="bi bi-x-lg"></i> Annuler
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function() {
    'use strict';
    
    const form = document.getElementById('maintenanceForm');
    const typeEl = document.getElementById('typePanne');
    const coutEl = document.getElementById('cout');
    const dateEl = document.getElementById('dateMain');
    const descEl = document.getElementById('description');
    const statutEl = document.getElementById('statut');
    const prioriteEl = document.getElementById('priorite');
    const kmEl = document.getElementById('kilometrage');
    const recoEl = document.getElementById('recommandation');
    const descCtr = document.getElementById('descCount');
    const recoCtr = document.getElementById('recoCount');
    const banner = document.getElementById('errorBanner');
    const today = new Date().toISOString().split('T')[0];
    
    // Initialisation
    dateEl.setAttribute('max', today);
    
    // Helper functions
    function valid(el) { 
        el.classList.remove('is-invalid'); 
        el.classList.add('is-valid'); 
    }
    
    function invalid(el) { 
        el.classList.remove('is-valid'); 
        el.classList.add('is-invalid'); 
    }
    
    function showErr(id, sid, msg) {
        const s = document.getElementById(sid); 
        if (s) s.textContent = msg;
        const d = document.getElementById(id); 
        if (d) d.classList.add('visible');
    }
    
    function hideErr(id) { 
        const d = document.getElementById(id); 
        if (d) d.classList.remove('visible'); 
    }
    
    // Validation functions
    function validateType() {
        if (!typeEl.value) {
            invalid(typeEl);
            showErr('typeError', 'typeErrorMsg', 'Veuillez sélectionner un type de panne.');
            return false;
        }
        valid(typeEl);
        hideErr('typeError');
        return true;
    }
    
    function validateCost() {
        const raw = coutEl.value.trim();
        const val = parseFloat(raw);
        
        if (raw === '' || isNaN(val)) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût est obligatoire.');
            return false;
        }
        if (val <= 0) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût doit être supérieur à 0.');
            return false;
        }
        if (val > 999999.99) {
            invalid(coutEl);
            showErr('coutError', 'coutErrorMsg', 'Le coût ne peut pas dépasser 999 999,99 DT.');
            return false;
        }
        valid(coutEl);
        hideErr('coutError');
        return true;
    }
    
    function validateDate() {
        if (!dateEl.value) {
            invalid(dateEl);
            showErr('dateError', 'dateErrorMsg', 'La date est obligatoire.');
            return false;
        }
        if (dateEl.value > today) {
            invalid(dateEl);
            showErr('dateError', 'dateErrorMsg', 'La date ne peut pas être dans le futur.');
            return false;
        }
        valid(dateEl);
        hideErr('dateError');
        return true;
    }
    
    function validateDescription() {
        const v = descEl.value;
        const l = v.length;
        
        if (l === 0) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'La description est obligatoire.');
            return false;
        }
        if (l < 5) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Minimum 5 caractères.');
            return false;
        }
        if (l > 1000) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Maximum 1000 caractères.');
            return false;
        }
        if (/[<>{}]/.test(v)) {
            invalid(descEl);
            showErr('descError', 'descErrorMsg', 'Caractères < > { } interdits.');
            return false;
        }
        valid(descEl);
        hideErr('descError');
        return true;
    }
    
    function validateStatut() {
        if (!statutEl.value) {
            invalid(statutEl);
            showErr('statutError', 'statutErrorMsg', 'Veuillez sélectionner un statut.');
            return false;
        }
        valid(statutEl);
        hideErr('statutError');
        return true;
    }
    
    function validatePriorite() {
        if (!prioriteEl.value) {
            invalid(prioriteEl);
            showErr('prioriteError', 'prioriteErrorMsg', 'Veuillez sélectionner une priorité.');
            return false;
        }
        valid(prioriteEl);
        hideErr('prioriteError');
        return true;
    }
    
    function validateKilometrage() {
        const raw = kmEl.value.trim();
        if (raw === '') {
            valid(kmEl);
            hideErr('kmError');
            return true;
        }
        const val = parseInt(raw);
        if (isNaN(val) || val < 0) {
            invalid(kmEl);
            showErr('kmError', 'kmErrorMsg', 'Le kilométrage doit être positif ou nul.');
            return false;
        }
        if (val > 9999999) {
            invalid(kmEl);
            showErr('kmError', 'kmErrorMsg', 'Kilométrage trop élevé (max 9 999 999).');
            return false;
        }
        valid(kmEl);
        hideErr('kmError');
        return true;
    }
    
    function validateRecommandation() {
        const v = recoEl.value;
        const l = v.length;
        if (l > 2000) {
            invalid(recoEl);
            showErr('recoError', 'recoErrorMsg', 'Maximum 2000 caractères.');
            return false;
        }
        valid(recoEl);
        hideErr('recoError');
        return true;
    }
    
    function updateDescCounter() {
        const l = descEl.value.length;
        descCtr.textContent = l + ' / 1000';
        descCtr.className = 'char-counter' + ((l > 0 && l < 5) || l > 1000 ? ' danger' : '');
    }
    
    function updateRecoCounter() {
        const l = recoEl.value.length;
        recoCtr.textContent = l + ' / 2000';
        recoCtr.className = 'char-counter' + (l > 2000 ? ' danger' : '');
    }
    
    // Event listeners
    typeEl.addEventListener('change', validateType);
    coutEl.addEventListener('input', validateCost);
    dateEl.addEventListener('change', validateDate);
    descEl.addEventListener('input', function() { 
        updateDescCounter(); 
        if (this.classList.contains('is-valid') || this.classList.contains('is-invalid')) {
            validateDescription();
        }
    });
    descEl.addEventListener('blur', validateDescription);
    statutEl.addEventListener('change', validateStatut);
    prioriteEl.addEventListener('change', validatePriorite);
    kmEl.addEventListener('input', validateKilometrage);
    recoEl.addEventListener('input', function() { 
        updateRecoCounter(); 
        if (this.classList.contains('is-valid') || this.classList.contains('is-invalid')) {
            validateRecommandation();
        }
    });
    recoEl.addEventListener('blur', validateRecommandation);
    
    // Validation initiale au chargement
    window.addEventListener('DOMContentLoaded', function() {
        if (typeEl.value) validateType();
        if (coutEl.value) validateCost();
        if (dateEl.value) validateDate();
        if (descEl.value) {
            validateDescription();
            updateDescCounter();
        }
        if (statutEl.value) validateStatut();
        if (prioriteEl.value) validatePriorite();
        if (kmEl.value) validateKilometrage();
        if (recoEl.value) {
            validateRecommandation();
            updateRecoCounter();
        }
    });
    
    // Form submission
    form.addEventListener('submit', function(e) {
        const isValid = validateType() & validateCost() & validateDate() & 
                       validateDescription() & validateStatut() & validatePriorite() & 
                       validateKilometrage() & validateRecommandation();
        
        if (!isValid) {
            e.preventDefault();
            e.stopPropagation();
            banner.classList.add('visible');
            
            const firstInvalid = form.querySelector('.is-invalid');
            if (firstInvalid) {
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalid.focus();
            }
        } else {
            banner.classList.remove('visible');
        }
    });
})();
</script>
{% endblock %}