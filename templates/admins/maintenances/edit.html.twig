{% extends 'base.html.twig' %}
{% block title %}Modifier Maintenance #{{ maintenance.idMain }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
  .field-error { display:none; color:#dc3545; font-size:.875em; margin-top:4px; }
  .field-error.visible { display:block; }
  .char-counter { font-size:.8em; }
  .char-counter.danger { color:#dc3545; font-weight:600; }
</style>
{% endblock %}

{% block body %}
<div class="container py-4" style="max-width:650px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">
      <i class="bi bi-pencil-square text-warning"></i>
      Modifier <span class="text-muted">#{{ maintenance.idMain }}</span>
    </h2>
    <a href="{{ path('admin_maintenances_index') }}" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Retour
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-warning text-dark fw-semibold">
      <i class="bi bi-tools me-2"></i>Modifier les informations
    </div>
    <div class="card-body">
      <form method="post"
            action="{{ path('admin_maintenances_edit', {id: maintenance.idMain}) }}"
            id="formEdit" novalidate>

        {# ── Type de panne ── #}
        <div class="mb-3">
          <label for="typePanne" class="form-label fw-semibold">
            Type de panne <span class="text-danger">*</span>
          </label>
          <select name="typePanne" id="typePanne" class="form-select" required>
            {% set types = ['Électrique','Mécanique','Hydraulique','Pneumatique','Moteur','Transmission','Vidange & Filtres','logicielle','Autre'] %}
            {% for opt in types %}
              <option value="{{ opt }}" {{ maintenance.typePanne == opt ? 'selected' : '' }}>
                {{ opt }}
              </option>
            {% endfor %}
          </select>
          <div class="field-error" id="typeError">
            <i class="bi bi-exclamation-circle me-1"></i>
            <span id="typeErrorMsg">Veuillez sélectionner un type de panne.</span>
          </div>
        </div>

        {# ── Coût ── #}
        <div class="mb-3">
          <label for="cout" class="form-label fw-semibold">
            Coût (DT) <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-cash-coin"></i></span>
            <input type="number" name="cout" id="cout" class="form-control"
                   step="0.01" min="0.01" max="999999.99"
                   value="{{ maintenance.cout }}" required>
            <span class="input-group-text">DT</span>
          </div>
          <div class="field-error" id="coutError">
            <i class="bi bi-exclamation-circle me-1"></i>
            <span id="coutErrorMsg">Le coût est obligatoire et doit être supérieur à 0.</span>
          </div>
        </div>

        {# ── Date ── #}
        <div class="mb-3">
          <label for="dateMain" class="form-label fw-semibold">
            Date de maintenance <span class="text-danger">*</span>
          </label>
          <input type="date" name="dateMain" id="dateMain" class="form-control"
                 value="{{ maintenance.dateMain ? maintenance.dateMain|date('Y-m-d') : '' }}"
                 max="{{ 'now'|date('Y-m-d') }}" required>
          <div class="field-error" id="dateError">
            <i class="bi bi-exclamation-circle me-1"></i>
            <span id="dateErrorMsg">Date obligatoire, ne peut pas être dans le futur.</span>
          </div>
        </div>

        {# ── Description ── #}
        <div class="mb-4">
          <label for="description" class="form-label fw-semibold">
            Description <span class="text-danger">*</span>
          </label>
          <textarea name="description" id="description" class="form-control"
                    rows="3" required>{{ maintenance.description }}</textarea>
          <div class="d-flex justify-content-between mt-1">
            <div class="field-error" id="descError" style="flex:1;">
              <i class="bi bi-exclamation-circle me-1"></i>
              <span id="descErrorMsg">La description est obligatoire (entre 5 et 255 caractères).</span>
            </div>
            <small id="descCount" class="char-counter text-muted ms-auto">
              {{ maintenance.description|length }} / 255
            </small>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-warning px-4">
            <i class="bi bi-check-lg"></i> Mettre à jour
          </button>
          <a href="{{ path('admin_maintenances_show', {id: maintenance.idMain}) }}"
             class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Annuler
          </a>
        </div>

      </form>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
  'use strict';

  var form    = document.getElementById('formEdit');
  var typeEl  = document.getElementById('typePanne');
  var coutEl  = document.getElementById('cout');
  var dateEl  = document.getElementById('dateMain');
  var descEl  = document.getElementById('description');
  var counter = document.getElementById('descCount');
  var today   = new Date().toISOString().split('T')[0];

  dateEl.setAttribute('max', today);

  /* ── Utilitaires ── */
  function markValid(el) {
    el.classList.remove('is-invalid');
    el.classList.add('is-valid');
  }
  function markInvalid(el) {
    el.classList.remove('is-valid');
    el.classList.add('is-invalid');
  }
  function showErr(divId, spanId, msg) {
    document.getElementById(spanId).textContent = msg;
    document.getElementById(divId).classList.add('visible');
  }
  function hideErr(divId) {
    document.getElementById(divId).classList.remove('visible');
  }

  /* ── Validateurs ── */
  function validateType() {
    if (!typeEl.value) {
      markInvalid(typeEl);
      showErr('typeError', 'typeErrorMsg', 'Veuillez sélectionner un type de panne.');
      return false;
    }
    markValid(typeEl); hideErr('typeError'); return true;
  }

  function validateCout() {
    var raw = coutEl.value.trim();
    var val = parseFloat(raw);
    if (raw === '' || isNaN(val)) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût est obligatoire.');
      return false;
    }
    if (val <= 0) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût doit être supérieur à 0.');
      return false;
    }
    if (val > 999999.99) {
      markInvalid(coutEl);
      showErr('coutError', 'coutErrorMsg', 'Le coût ne peut pas dépasser 999 999,99 DT.');
      return false;
    }
    markValid(coutEl); hideErr('coutError'); return true;
  }

  function validateDate() {
    if (!dateEl.value) {
      markInvalid(dateEl);
      showErr('dateError', 'dateErrorMsg', 'La date est obligatoire.');
      return false;
    }
    if (dateEl.value > today) {
      markInvalid(dateEl);
      showErr('dateError', 'dateErrorMsg', 'La date ne peut pas être dans le futur.');
      return false;
    }
    markValid(dateEl); hideErr('dateError'); return true;
  }

  function validateDesc() {
    var val = descEl.value.trim();
    var l   = val.length;
    if (l === 0) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description est obligatoire.');
      return false;
    }
    if (l < 5) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description doit contenir au moins 5 caractères.');
      return false;
    }
    if (l > 255) {
      markInvalid(descEl);
      showErr('descError', 'descErrorMsg', 'La description ne peut pas dépasser 255 caractères.');
      return false;
    }
    markValid(descEl); hideErr('descError'); return true;
  }

  /* ── Initialisation au chargement (champs pré-remplis) ── */
  window.addEventListener('load', function () {
    validateType();
    validateCout();
    validateDate();
    validateDesc();
  });

  /* ── Événements ── */
  typeEl.addEventListener('change', validateType);
  coutEl.addEventListener('input',  validateCout);
  dateEl.addEventListener('change', validateDate);

  descEl.addEventListener('input', function () {
    var l = this.value.length;
    counter.textContent = l + ' / 255';
    if ((l > 0 && l < 5) || l > 255) {
      counter.className = 'char-counter ms-auto danger';
    } else {
      counter.className = 'char-counter ms-auto text-muted';
    }
    validateDesc();
  });
  descEl.addEventListener('blur', validateDesc);

  /* ── Soumission ── */
  form.addEventListener('submit', function (e) {
    var t1 = validateType();
    var t2 = validateCout();
    var t3 = validateDate();
    var t4 = validateDesc();
    if (!t1 || !t2 || !t3 || !t4) {
      e.preventDefault();
      e.stopPropagation();
      var first = form.querySelector('.is-invalid');
      if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

})();
</script>
{% endblock %}
