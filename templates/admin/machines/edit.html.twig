{% extends 'base_admin.html.twig' %}

{% block title %}Modifier — {{ machine.nom }} - Admin{% endblock %}
{% block page_title %}Gestion des Machines{% endblock %}
{% block breadcrumb %}Matériels / Machines / Modifier{% endblock %}

{% block body %}
<div style="max-width: 680px; margin: 0 auto;">

    <a href="{{ path('admin_machines_index') }}"
       style="color:#2D5A27; text-decoration:none; font-size:13px;
              display:inline-flex; align-items:center; gap:6px; margin-bottom:20px;">
        <i class="fa fa-arrow-left"></i> Retour à la liste
    </a>

    {% for msg in app.flashes('success') %}
        <div style="padding:12px 18px; border-radius:8px; margin-bottom:16px;
                    background:#EAF3DE; color:#3B6D11; border:1px solid #c0dd97;
                    display:flex; align-items:center; gap:10px; font-size:13.5px;">
            <i class="fa fa-check-circle"></i> {{ msg }}
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div style="padding:12px 18px; border-radius:8px; margin-bottom:16px;
                    background:#FCEBEB; color:#A32D2D; border:1px solid #f7c1c1;
                    display:flex; align-items:center; gap:10px; font-size:13.5px;">
            <i class="fa fa-exclamation-circle"></i> {{ msg }}
        </div>
    {% endfor %}

    <div style="background:#f9fbf8; border:1px solid #d6e8cc; border-radius:10px;
                padding:14px 18px; margin-bottom:18px;
                display:flex; align-items:center; gap:12px;">
        <div style="width:38px; height:38px; border-radius:8px; background:#EAF3DE;
                    display:flex; align-items:center; justify-content:center;
                    color:#3B6D11; font-size:16px; flex-shrink:0;">
            <i class="fa fa-server"></i>
        </div>
        <div>
            <div style="font-weight:600; color:#2C3E50; font-size:14px;">
                {{ machine.nom }}
            </div>
            <div style="font-size:12px; color:#888; margin-top:2px;">
                ID #{{ machine.id }}
                {% if machine.numeroSerie %}
                    &nbsp;·&nbsp;
                    <span style="font-family:monospace;">{{ machine.numeroSerie }}</span>
                {% endif %}
                {% if machine.dateAchat %}
                    &nbsp;·&nbsp; Acheté le {{ machine.dateAchat|date('d/m/Y') }}
                {% endif %}
            </div>
        </div>
    </div>

    <div style="background:white; border-radius:14px;
                box-shadow:0 2px 12px rgba(0,0,0,.07); overflow:hidden;">

        <div style="background:linear-gradient(135deg,#854F0B,#BA7517);
                    padding:24px 28px; display:flex; align-items:center; gap:14px;">
            <div style="width:44px; height:44px; border-radius:10px;
                        background:rgba(255,255,255,.15);
                        display:flex; align-items:center; justify-content:center;
                        font-size:18px; color:#fff; flex-shrink:0;">
                <i class="fa fa-pen"></i>
            </div>
            <div>
                <div style="color:#fff; font-size:17px; font-weight:600; margin:0;">
                    Modifier la machine
                </div>
                <div style="color:rgba(255,255,255,.7); font-size:12px; margin-top:3px;">
                    Modifiez les champs souhaités puis enregistrez
                </div>
            </div>
        </div>

        <div style="padding:28px 32px;">
            <form method="post" novalidate id="machineForm">
                {{ include('admin/machines/_form.html.twig', {agriculteurs: agriculteurs}) }}
                
                <div style="display:flex; gap:12px; margin-top:28px; padding-top:20px;
                            border-top:1px solid #f0f0f0;">
                    <button type="submit"
                            style="flex:1; background:#854F0B; color:white; padding:12px 20px;
                                   border:none; border-radius:8px; font-size:14px; font-weight:600;
                                   cursor:pointer; display:flex; align-items:center;
                                   justify-content:center; gap:8px;">
                        <i class="fa fa-floppy-disk"></i> Sauvegarder les modifications
                    </button>
                    <a href="{{ path('admin_machines_index') }}"
                       style="flex:1; background:#f5f5f5; color:#555; padding:12px 20px;
                              border-radius:8px; text-decoration:none; text-align:center;
                              font-size:14px; font-weight:500; display:flex;
                              align-items:center; justify-content:center; gap:8px;
                              border:1.5px solid #e0e0e0;">
                        <i class="fa fa-xmark"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}