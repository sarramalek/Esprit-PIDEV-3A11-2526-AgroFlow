{% extends 'base_admin.html.twig' %}

{% block title %}Supprimer la machine - {{ machine.nom }}{% endblock %}
{% block page_title %}Suppression d'une machine{% endblock %}
{% block breadcrumb %}Matériels / Machines / Supprimer{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">

    <a href="{{ path('admin_machines_index') }}" 
       style="color:#2D5A27; text-decoration:none; font-size:14px; display:inline-flex; align-items:center; gap:6px; margin-bottom:25px;">
        <i class="fa fa-arrow-left"></i> Retour à la liste
    </a>

    <div style="background:white; border-radius:12px; padding:35px; box-shadow:0 4px 15px rgba(0,0,0,0.07); text-align:center;">
        
        <div style="width:70px; height:70px; background:#FCEBEB; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px;">
            <i class="fa fa-trash" style="font-size:32px; color:#A32D2D;"></i>
        </div>

        <h2 style="color:#2C3E50; margin-bottom:15px;">Confirmation de suppression</h2>
        
        <p style="color:#666; margin-bottom:25px;">
            Êtes-vous sûr de vouloir supprimer la machine 
            <strong style="color:#A32D2D;">{{ machine.nom }}</strong> ?
        </p>

        <div style="background:#f9f9f9; border-radius:10px; padding:15px; margin-bottom:25px; text-align:left;">
            <div style="display:grid; grid-template-columns:120px 1fr; gap:10px; font-size:14px;">
                <div style="color:#888;">Marque :</div>
                <div><strong>{{ machine.marque }}</strong></div>
                
                <div style="color:#888;">Modèle :</div>
                <div><strong>{{ machine.modele }}</strong></div>
                
                <div style="color:#888;">N° série :</div>
                <div><strong>{{ machine.numeroSerie }}</strong></div>
                
                <div style="color:#888;">État :</div>
                <div><strong>{{ machine.etatM }}</strong></div>
                
                {% if machine.agriculteur %}
                <div style="color:#888;">Propriétaire :</div>
                <div><strong>{{ machine.nomAgriculteur }} (CIN: {{ machine.cinAgriculteur }})</strong></div>
                {% endif %}
            </div>
        </div>

        <p style="color:#A32D2D; font-size:13px; margin-bottom:25px;">
            <i class="fa fa-exclamation-triangle"></i> Cette action est irréversible.
        </p>

        <div style="display:flex; gap:12px; justify-content:center;">
            <a href="{{ path('admin_machines_index') }}" 
               style="background:#f5f5f5; color:#555; padding:12px 24px; border-radius:8px; text-decoration:none; font-weight:500;">
                <i class="fa fa-times"></i> Annuler
            </a>
            
            <form method="post" action="{{ path('admin_machines_delete', {id: machine.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ machine.id) }}">
                <button type="submit" 
                        style="background:#A32D2D; color:white; padding:12px 24px; border:none; border-radius:8px; cursor:pointer; font-weight:500;">
                    <i class="fa fa-trash"></i> Confirmer la suppression
                </button>
            </form>
        </div>

    </div>
</div>
{% endblock %}