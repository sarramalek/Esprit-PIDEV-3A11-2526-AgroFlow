{% extends 'base_admin.html.twig' %}

{% block title %}Confirmation suppression - {{ machine.nom }}{% endblock %}
{% block page_title %}Supprimer une machine{% endblock %}
{% block breadcrumb %}Matériels / Machines / Supprimer{% endblock %}

{% block body %}
<div style="max-width: 500px; margin: 40px auto;">
    
    <a href="{{ path('admin_machines_show', {id: machine.id}) }}"
       style="color:#2D5A27; text-decoration:none; font-size:13px;
              display:inline-flex; align-items:center; gap:6px; margin-bottom:20px;">
        <i class="fa fa-arrow-left"></i> Retour au détail
    </a>

    <div style="background:white; border-radius:12px; padding:30px; text-align:center; box-shadow:0 2px 12px rgba(0,0,0,0.1);">
        
        <div style="font-size: 50px; color: #e53e3e; margin-bottom: 20px;">
            <i class="fa fa-exclamation-triangle"></i>
        </div>
        
        <h3 style="color: #2C3E50; margin-bottom: 15px;">Confirmation de suppression</h3>
        
        <p style="color: #666; margin-bottom: 25px;">
            Êtes-vous sûr de vouloir supprimer la machine 
            <strong style="color:#2D5A27;">{{ machine.nom }}</strong> 
            ({{ machine.marque }} {{ machine.modele }}) ?<br>
            Cette action est <strong style="color:#e53e3e;">irréversible</strong>.
        </p>

        <div style="background:#f8f9fa; border-radius:8px; padding:15px; margin-bottom:25px; text-align:left;">
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span style="color:#666;">Marque :</span>
                <span style="font-weight:500;">{{ machine.marque }}</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span style="color:#666;">Modèle :</span>
                <span style="font-weight:500;">{{ machine.modele }}</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span style="color:#666;">Kilométrage :</span>
                <span style="font-weight:500;">{{ machine.kilometrage }} km/h</span>
            </div>
            <div style="display:flex; justify-content:space-between;">
                <span style="color:#666;">Propriétaire :</span>
                <span style="font-weight:500;">{{ machine.nomAgriculteur }}</span>
            </div>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: center;">
            <form method="post" action="{{ path('admin_machines_delete', {id: machine.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ machine.id) }}">
                <button type="submit" 
                        style="background:#e53e3e; color:white; padding:10px 20px; border:none; border-radius:6px; cursor:pointer; font-size:14px; font-weight:500;">
                    <i class="fa fa-trash"></i> Oui, supprimer définitivement
                </button>
            </form>
            <a href="{{ path('admin_machines_show', {id: machine.id}) }}" 
               style="background:#888; color:white; padding:10px 20px; border-radius:6px; text-decoration:none; font-size:14px; font-weight:500;">
                <i class="fa fa-times"></i> Non, annuler
            </a>
        </div>
        
    </div>
</div>
{% endblock %}