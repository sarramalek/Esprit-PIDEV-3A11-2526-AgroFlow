{# admin/machines/_form.html.twig #}

{% if errors is defined and errors|length > 0 %}
    <div style="margin-bottom: 24px; padding: 14px 18px; background:#FCEBEB; border-left:4px solid #A32D2D; border-radius:8px;">
        <div style="font-weight:600; color:#A32D2D; margin-bottom:8px;">
            <i class="fa fa-circle-exclamation"></i> Veuillez corriger les erreurs suivantes :
        </div>
        <ul style="margin:0; padding-left:20px; color:#A32D2D; font-size:13px;">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<div style="display: flex; flex-direction: column; gap: 20px;">
    
    <!-- Sélection agriculteur -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Propriétaire (Agriculteur)
        </label>
        <select name="agriculteur" required
                style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;
                       background:white; transition:border .2s;">
            <option value="">-- Sélectionnez un agriculteur --</option>
            {% for agriculteur in agriculteurs %}
                <option value="{{ agriculteur.cin }}"
                    {% if machine.agriculteur and machine.agriculteur.cin == agriculteur.cin %}selected{% endif %}>
                    {{ agriculteur.nom }} {{ agriculteur.prenom }} (CIN: {{ agriculteur.cin }})
                </option>
            {% endfor %}
        </select>
    </div>

    <!-- Nom -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Nom de la machine
        </label>
        <input type="text" name="nom" value="{{ machine.nom }}" required
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;"
               placeholder="Ex: Tracteur Fendt 724">
    </div>

    <!-- Marque -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Marque
        </label>
        <input type="text" name="marque" value="{{ machine.marque }}" required
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;"
               placeholder="Ex: John Deere, Fendt, Massey Ferguson...">
    </div>

    <!-- Modèle -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Modèle
        </label>
        <input type="text" name="modele" value="{{ machine.modele }}" required
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;"
               placeholder="Ex: 724, 6155R, 8R...">
    </div>

    <!-- Numéro de série (optionnel) -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            Numéro de série
        </label>
        <input type="text" name="numeroSerie" value="{{ machine.numeroSerie }}"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;"
               placeholder="Optionnel - Ex: SN-2024-001">
    </div>

    <!-- État -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> État
        </label>
        <select name="etatM" required style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
            <option value="">-- Sélectionnez un état --</option>
            {% for etat in ['Neuf', 'Bon', 'Occasion', 'En panne'] %}
                <option value="{{ etat }}" {% if machine.etatM == etat %}selected{% endif %}>
                    {{ etat }}
                </option>
            {% endfor %}
        </select>
    </div>

    <!-- Kilométrage -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Kilométrage (heures/km)
        </label>
        <input type="number" name="kilometrage" value="{{ machine.kilometrage }}" required min="0"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
    </div>

    <!-- Kilométrage dernière visite -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            <span style="color:#e53e3e;">*</span> Kilométrage lors de la dernière visite
        </label>
        <input type="number" name="kmLastVisite" value="{{ machine.kmLastVisite }}" required min="0"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
    </div>

    <!-- Date d'achat -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            Date d'achat
        </label>
        <input type="date" name="dateAchat" value="{{ machine.dateAchat ? machine.dateAchat|date('Y-m-d') : '' }}"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
    </div>

    <!-- Date dernière visite -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            Date de dernière visite
        </label>
        <input type="date" name="dateLastVisite" value="{{ machine.dateLastVisite ? machine.dateLastVisite|date('Y-m-d') : '' }}"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
    </div>

    <!-- Prochaine maintenance -->
    <div>
        <label style="display:block; margin-bottom:6px; font-weight:600; color:#2C3E50; font-size:13px;">
            Prochaine maintenance
        </label>
        <input type="date" name="prochaineMaintenance" value="{{ machine.prochaineMaintenance ? machine.prochaineMaintenance|date('Y-m-d') : '' }}"
               style="width:100%; padding:12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:14px;">
    </div>

    <div style="font-size:12px; color:#888; margin-top:-8px;">
        <i class="fa fa-info-circle"></i> Les champs marqués <span style="color:#e53e3e;">*</span> sont obligatoires
    </div>
</div>