{% extends 'base_admin.html.twig' %}

{% block title %}Machines - Admin{% endblock %}
{% block page_title %}Gestion Machines{% endblock %}
{% block breadcrumb %}Matériels / Machines{% endblock %}

{% block body %}
    <!-- Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
        <h2 style="margin:0; color:#2C3E50;">Liste des Machines</h2>
        
        <a href="{{ path('admin_machines_new') }}"
           style="background:#2D5A27; color:white; padding:10px 20px; border-radius:8px; text-decoration:none; font-size:14px; display:flex; align-items:center; gap:8px;">
            <i class="fa fa-plus"></i> Nouvelle Machine
        </a>
    </div>

    <!-- Messages flash -->
    {% for msg in app.flashes('success') %}
        <div style="background:#EAF3DE; color:#3B6D11; padding:12px 16px; border-radius:8px; margin-bottom:16px;">
            <i class="fa fa-check-circle"></i> {{ msg }}
        </div>
    {% endfor %}

    {% for msg in app.flashes('error') %}
        <div style="background:#FCEBEB; color:#A32D2D; padding:12px 16px; border-radius:8px; margin-bottom:16px;">
            <i class="fa fa-exclamation-circle"></i> {{ msg }}
        </div>
    {% endfor %}

    <!-- Tableau sans la colonne ID -->
    <div style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.06); overflow:hidden;">
        <table style="width:100%; border-collapse:collapse; font-size:14px;" id="machinesTable">
            <thead>
                <tr style="background:#f8f9fa;">
                    <th style="padding:12px 16px; text-align:left; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">Nom</th>
                    <th style="padding:12px 16px; text-align:left; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">Marque</th>
                    <th style="padding:12px 16px; text-align:left; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">Modèle</th>
                    <th style="padding:12px 16px; text-align:left; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">N° Série</th>
                    <th style="padding:12px 16px; text-align:center; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">État</th>
                    <th style="padding:12px 16px; text-align:center; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee;">Date Achat</th>
                    <th style="padding:12px 16px; text-align:center; color:#888; font-size:11px; text-transform:uppercase; border-bottom:1px solid #eee; width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for machine in machines %}
                <tr style="border-bottom:1px solid #f5f5f5;">
                    <td style="padding:12px 16px; font-weight:600; color:#2C3E50;">{{ machine.nom }}</td>
                    <td style="padding:12px 16px;">{{ machine.marque }}</td>
                    <td style="padding:12px 16px;">{{ machine.modele }}</td>
                    <td style="padding:12px 16px; font-family:monospace; font-size:12px; color:#555;">{{ machine.numeroSerie }}</td>
                    
                    <!-- Badge État -->
                    <td style="padding:12px 16px; text-align:center;">
                        {% if machine.etatM in ['Neuf', 'Bon', 'Actif'] %}
                            <span style="background:#EAF3DE; color:#3B6D11; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:500;">
                                {{ machine.etatM }}
                            </span>
                        {% elseif machine.etatM in ['En panne', 'Hors service'] %}
                            <span style="background:#FCEBEB; color:#A32D2D; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:500;">
                                {{ machine.etatM }}
                            </span>
                        {% else %}
                            <span style="background:#FAEEDA; color:#854F0B; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:500;">
                                {{ machine.etatM }}
                            </span>
                        {% endif %}
                    </td>

                    <td style="padding:12px 16px; text-align:center; color:#666;">
                        {{ machine.dateAchat ? machine.dateAchat|date('d/m/Y') : '-' }}
                    </td>

                    <!-- Actions -->
                    <td style="padding:12px 16px; text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center;">
                            <a href="{{ path('admin_machines_show', {id: machine.id}) }}"
                               style="background:#E6F1FB; color:#185FA5; padding:6px 10px; border-radius:6px; text-decoration:none;">
                                <i class="fa fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_machines_edit', {id: machine.id}) }}"
                               style="background:#FAEEDA; color:#854F0B; padding:6px 10px; border-radius:6px; text-decoration:none;">
                                <i class="fa fa-pen"></i>
                            </a>
                            <form method="post" action="{{ path('admin_machines_delete', {id: machine.id}) }}" 
                                  onsubmit="return confirm('Voulez-vous vraiment supprimer cette machine ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ machine.id) }}">
                                <button type="submit"
                                        style="background:#FCEBEB; color:#A32D2D; padding:6px 10px; border:none; border-radius:6px; cursor:pointer;">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" style="padding:60px 20px; text-align:center; color:#888;">
                        <i class="fa fa-tractor" style="font-size:48px; margin-bottom:15px; opacity:0.3; display:block;"></i>
                        <p>Aucune machine trouvée</p>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}