        </div>

        <div class="nav-item">
            <a href="{{ path('agriculteur_evenement_index') }}"
               class="nav-link {% if app.request.get('_route') in ['agriculteur_evenement_index','agriculteur_participation_index'] %}active{% endif %}">
                <i class="fa fa-calendar-days"></i> Événements
                <i class="fa fa-chevron-down chevron"></i>
            </a>
            <div class="dropdown">
                <a href="{{ path('agriculteur_evenement_index') }}"
                   class="{% if app.request.get('_route') == 'agriculteur_evenement_index' %}active{% endif %}">
                    <i class="fa fa-calendar-days"></i> Événements
                </a>
                <a href="{{ path('agriculteur_participation_index') }}"
                   class="{% if app.request.get('_route') == 'agriculteur_participation_index' %}active{% endif %}">
                    <i class="fa fa-ticket"></i> Mes participations
