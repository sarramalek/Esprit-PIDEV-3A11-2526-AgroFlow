{% block javascripts %}
<script>
    /* ══════════════════════════════════════════════════════
       CLOUDINARY
    ══════════════════════════════════════════════════════ */
    var CLOUDINARY_CLOUD_NAME    = 'dp0ily6qa';
    var CLOUDINARY_UPLOAD_PRESET = 'agroflow';

    function agriUploadPhoto(input) {
        if (!input.files || !input.files[0]) return;
        var file  = input.files[0];
        var bar   = document.getElementById('agriUploadProgressBar');
        var prog  = document.getElementById('agriUploadProgress');
        var txt   = document.getElementById('agriPhotoUploadText');
        var label = document.getElementById('agriPhotoUploadLabel');

        prog.style.display = 'block';
        bar.style.width = '0%';
        txt.textContent = 'Upload en cours…';
        label.style.pointerEvents = 'none';

        var fd = new FormData();
        fd.append('file', file);
        fd.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);
        fd.append('folder', 'agroflow/avatars');

        var xhr = new XMLHttpRequest();
        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) bar.style.width = Math.round(e.loaded / e.total * 100) + '%';
        };
        xhr.onload = function() {
            label.style.pointerEvents = 'auto';
            prog.style.display = 'none';
            if (xhr.status === 200) {
                var res = JSON.parse(xhr.responseText);
                var secureUrl = res.secure_url;
                document.getElementById('agriPhotoUrl').value = secureUrl;
                _agriUpdateAvatar('agriPhotoSmall', 'agriAvatarSmall', secureUrl, 34, 34);
                _agriUpdateAvatar('agriPhotoBig',   'agriAvatarBig',   secureUrl, 52, 52);
                txt.textContent = 'Photo mise à jour ✓';
                var fd2 = new FormData();
                fd2.append('photo', secureUrl);
                fetch('{{ path("profile_update") }}', { method: 'POST', body: fd2, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function(r) { return r.json(); })
                    .then(function(json) { agriShowToast(json.success ? 'Photo sauvegardée ✓' : 'Sauvegarde échouée', !json.success); });
            } else {
                txt.textContent = 'Changer la photo de profil';
                agriShowToast('Erreur lors de l\'upload', true);
            }
        };
        xhr.onerror = function() { label.style.pointerEvents = 'auto'; prog.style.display = 'none'; txt.textContent = 'Changer la photo de profil'; agriShowToast('Erreur réseau', true); };
        xhr.open('POST', 'https://api.cloudinary.com/v1_1/' + CLOUDINARY_CLOUD_NAME + '/image/upload');
        xhr.send(fd);
    }

    function _agriUpdateAvatar(imgId, fbId, rawUrl, w, h) {
        var img = document.getElementById(imgId);
        var fb  = document.getElementById(fbId);
        if (!img) return;
        img.src = cloudinaryAvatar(rawUrl, w, h);
        img.style.display = 'block';
        if (fb) fb.style.display = 'none';
        img.onerror = function() { img.style.display = 'none'; if (fb) fb.style.display = 'flex'; };
    }

    /* ══════════════════════════════════════════════════════
       PROFIL PANEL
    ══════════════════════════════════════════════════════ */
    function toggleProfilePanel() {
        var panel   = document.getElementById('profilePanel');
        var chevron = document.getElementById('profileChevron');
        var open    = panel.style.display === 'block';
        panel.style.display     = open ? 'none' : 'block';
        chevron.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    document.addEventListener('click', function(e) {
        var menu = document.getElementById('profileMenu');
        if (menu && !menu.contains(e.target)) {
            document.getElementById('profilePanel').style.display = 'none';
            document.getElementById('profileChevron').style.transform = 'rotate(0deg)';
        }
        // Fermer le popup IA si clic en dehors (sauf le bouton lui-même)
        var popup  = document.getElementById('aiPopup');
        var navBtn = document.getElementById('aiNavBtn');
        if (popup && popup.classList.contains('open') && !popup.contains(e.target) && !navBtn.contains(e.target)) {
            popup.classList.remove('open');
            navBtn.classList.remove('active');
        }
    });

    var _agriOriginals = {};

    function agriStartEdit() {
        document.querySelectorAll('.agri-pf-input[name]').forEach(function(inp) { _agriOriginals[inp.name] = inp.value; });
        document.querySelectorAll('.agri-pf-view').forEach(function(el) { el.style.display = 'none'; });
        document.querySelectorAll('.agri-pf-input').forEach(function(el) { el.style.display = 'block'; });
        document.getElementById('agriPwdRow').style.display = 'flex';
        document.getElementById('agriPhotoUploadLabel').style.display = 'flex';
        document.getElementById('agriPhotoUploadText').textContent = 'Changer la photo de profil';
        document.getElementById('agriBtnEdit').style.display   = 'none';
        document.getElementById('agriBtnSave').style.display   = 'inline-flex';
        document.getElementById('agriBtnCancel').style.display = 'inline-flex';
        var first = document.querySelector('.agri-pf-input[name="email"]');
        if (first) first.focus();
    }

    function agriCancelEdit() {
        document.querySelectorAll('.agri-pf-input[name]').forEach(function(inp) { if (_agriOriginals[inp.name] !== undefined) inp.value = _agriOriginals[inp.name]; });
        var pwd = document.querySelector('.agri-pf-input[name="password"]');
        if (pwd) pwd.value = '';
        document.querySelectorAll('.agri-pf-view').forEach(function(el) { el.style.display = 'block'; });
        document.querySelectorAll('.agri-pf-input').forEach(function(el) { el.style.display = 'none'; });
        document.getElementById('agriPwdRow').style.display = 'none';
        document.getElementById('agriPhotoUploadLabel').style.display = 'none';
        document.getElementById('agriUploadProgress').style.display   = 'none';
        document.getElementById('agriBtnEdit').style.display   = 'inline-flex';
        document.getElementById('agriBtnSave').style.display   = 'none';
        document.getElementById('agriBtnCancel').style.display = 'none';
    }

    function agriSubmitEdit() {
        var emailInp = document.querySelector('.agri-pf-input[name="email"]');
        if (emailInp && !emailInp.value.trim()) { emailInp.style.borderColor = 'rgba(220,60,60,0.7)'; emailInp.focus(); return; }
        var btnSave = document.getElementById('agriBtnSave');
        btnSave.disabled = true;
        btnSave.innerHTML = '<i class="fa fa-spinner fa-spin" style="font-size:10px;"></i> Envoi…';
        var data = new FormData(document.getElementById('agriProfileForm'));
        fetch('{{ path("profile_update") }}', { method: 'POST', body: data, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(json) {
                btnSave.disabled = false;
                btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';
                if (json.success) {
                    document.querySelectorAll('.agri-pf-view').forEach(function(view) {
                        var inp = view.parentElement.querySelector('.agri-pf-input');
                        if (inp && inp.value.trim()) view.textContent = inp.value.trim();
                    });
                    if (json.prenom && json.nom) {
                        var fullName = json.prenom + ' ' + json.nom;
                        var initials = json.prenom.charAt(0).toUpperCase() + json.nom.charAt(0).toUpperCase();
                        ['agriNameSmall','agriNameBig'].forEach(function(id) { var el = document.getElementById(id); if (el) el.textContent = fullName; });
                        ['agriAvatarSmall','agriAvatarBig'].forEach(function(id) { var el = document.getElementById(id); if (el) el.textContent = initials; });
                    }
                    if (json.photo) {
                        ['agriPhotoSmall','agriPhotoBig'].forEach(function(id) { var el = document.getElementById(id); if (el) el.dataset.cloudinarySrc = json.photo; });
                    }
                    agriCancelEdit();
                    agriShowToast('Profil mis à jour avec succès');
                } else {
                    agriShowToast(json.error || 'Une erreur est survenue', true);
                }
            })
            .catch(function() {
                btnSave.disabled = false;
                btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';
                agriShowToast('Erreur réseau, veuillez réessayer.', true);
            });
    }

    function agriShowToast(msg, isError) {
        var existing = document.getElementById('agriToast');
        if (existing) existing.remove();
        var t = document.createElement('div');
        t.id = 'agriToast';
        t.style.cssText = ['position:fixed','bottom:24px','right:24px','z-index:99999','background:' + (isError ? 'rgba(160,30,30,0.95)' : 'rgba(30,90,35,0.95)'),'color:#fff','font-size:13px','font-weight:600','font-family:DM Sans,sans-serif','padding:12px 20px','border-radius:10px','display:flex','align-items:center','gap:9px','box-shadow:0 4px 24px rgba(0,0,0,0.2)','transition:opacity 0.4s ease','opacity:1'].join(';');
        var icon = document.createElement('i');
        icon.className = isError ? 'fa fa-circle-xmark' : 'fa fa-circle-check';
        icon.style.fontSize = '14px';
        t.appendChild(icon);
        t.appendChild(document.createTextNode(msg));
        document.body.appendChild(t);
        setTimeout(function() { t.style.opacity = '0'; }, 2800);
        setTimeout(function() { if (t.parentNode) t.remove(); }, 3300);
    }

    function toggle2FA(enabled) {
        var track = document.getElementById('twofa-track');
        var thumb = document.getElementById('twofa-thumb');
        var status = document.getElementById('twofa-status');
        var fd = new FormData();
        fd.append('enabled', enabled ? '1' : '0');
        fetch('{{ path("app_2fa_toggle") }}', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(json => {
                if (json.success) {
                    track.style.background = enabled ? '#2D5A27' : '#ccc';
                    thumb.style.left       = enabled ? '21px' : '3px';
                    status.textContent     = enabled ? 'Activée' : 'Désactivée';
                    agriShowToast(enabled ? '2FA activée ✓' : '2FA désactivée');
                }
            });
    }

    /* ══════════════════════════════════════════════════════
       ASSISTANT IA — POPUP
    ══════════════════════════════════════════════════════ */
    var AI_ASK_URL   = '{{ path("chat_ask") }}';
    var AI_CLEAR_URL = '{{ path("chat_clear") }}';
    var aiIsLoading  = false;
    var aiFirstOpen  = true;

    function toggleAiPopup() {
        var popup  = document.getElementById('aiPopup');
        var btn    = document.getElementById('aiNavBtn');
        var isOpen = popup.classList.toggle('open');
        btn.classList.toggle('active', isOpen);

        // Vérifier la connexion à la première ouverture
        if (isOpen && aiFirstOpen) {
            aiFirstOpen = false;
            aiCheckHealth();
        }
        if (isOpen) {
            setTimeout(function() { document.getElementById('aiChatInput').focus(); }, 300);
        }
    }

    function aiCheckHealth() {
        var dot  = document.getElementById('aiStatusDot');
        var txt  = document.getElementById('aiStatusText');
        var db   = document.getElementById('aiStatusDb');
        var lbl  = document.getElementById('aiPopupStatusLabel');

        fetch('/chat/health', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.status === 'ok') {
                    dot.className = 'ai-status-dot ok';
                    txt.textContent = 'Connecté à MySQL';
                    db.textContent  = data.database + ' · ' + data.tables + ' table(s)';
                    lbl.textContent = 'En ligne · ' + data.database;
                } else { throw new Error(data.message); }
            })
            .catch(function() {
                dot.className = 'ai-status-dot err';
                txt.textContent = 'Serveur non disponible';
                db.textContent  = '';
                lbl.textContent = 'Hors ligne';
            });
    }

    function aiAutoResize(el) {
        el.style.height = 'auto';
        el.style.height = Math.min(el.scrollHeight, 80) + 'px';
    }

    function aiHandleKey(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); aiSendMessage(); }
    }

    function aiUseChip(btn) {
        document.getElementById('aiChatInput').value = btn.textContent.trim();
        aiSendMessage();
    }

    function aiHideEmpty() {
        var e = document.getElementById('aiEmpty');
        if (e) e.remove();
    }

    function aiEsc(str) {
        return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function aiAppendUser(text) {
        aiHideEmpty();
        var msgs = document.getElementById('aiMessages');
        var el = document.createElement('div');
        el.className = 'ai-msg ai-msg-user';
        el.innerHTML = '<div class="bbl">' + aiEsc(text) + '</div>';
        msgs.appendChild(el);
        msgs.scrollTop = msgs.scrollHeight;
    }

    function aiAppendTyping() {
        aiHideEmpty();
        var msgs = document.getElementById('aiMessages');
        var el = document.createElement('div');
        el.id = 'aiTyping';
        el.className = 'ai-msg ai-msg-bot';
        el.innerHTML = '<div class="bot-av">🌿</div><div class="bbl"><div class="ai-typing"><span></span><span></span><span></span></div></div>';
        msgs.appendChild(el);
        msgs.scrollTop = msgs.scrollHeight;
    }

   function aiAppendBot(data) {
    var msgs = document.getElementById('aiMessages');
    var el = document.createElement('div');
    el.className = 'ai-msg ai-msg-bot';

    var html = '<div class="bbl">';

    // ── Analyse textuelle uniquement ──
    var analysis = data.analysis || '';
    if (analysis && !analysis.trim().toUpperCase().startsWith('SELECT')) {
        html += aiEsc(analysis).replace(/\n/g, '<br>');
    }

    // ── Erreur SQL ──
    if (data.sql_error) {
        html += '<div style="margin-top:6px;padding:7px 10px;background:#fff5f5;border:1px solid #fcc;border-radius:6px;font-size:11px;color:#c0392b;">⚠️ ' + aiEsc(data.sql_error) + '</div>';
    }

    // ── Aucun résultat ──
    if (data.sql && !data.sql_error && data.results && data.results.length === 0) {
        html += '<p style="margin-top:6px;font-size:12px;color:#888;">Aucun résultat trouvé.</p>';
    }

    html += '</div>';
    el.innerHTML = '<div class="bot-av"><i class="fa fa-robot" style="color:white;font-size:12px;"></i></div>'
+ html;
    msgs.appendChild(el);
    msgs.scrollTop = msgs.scrollHeight;
}

    function aiAppendError(msg) {
        var msgs = document.getElementById('aiMessages');
        var el = document.createElement('div');
        el.className = 'ai-msg ai-msg-bot';
        el.innerHTML = '<div class="bot-av" style="background:#c0392b">⚠️</div><div class="bbl" style="background:#fff5f5;border-color:#fcc;color:#c0392b;">' + aiEsc(msg) + '</div>';
        msgs.appendChild(el);
        msgs.scrollTop = msgs.scrollHeight;
    }

    async function aiSendMessage() {
        if (aiIsLoading) return;
        var input = document.getElementById('aiChatInput');
        var q = input.value.trim();
        if (!q) return;

        aiIsLoading = true;
        document.getElementById('aiSendBtn').disabled = true;
        input.value = '';
        input.style.height = 'auto';

        aiAppendUser(q);
        aiAppendTyping();

        try {
            var res = await fetch(AI_ASK_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ question: q })
            });

            document.getElementById('aiTyping')?.remove();

            if (!res.ok) {
                var err = await res.json().catch(function() { return { error: 'Erreur inconnue' }; });
                aiAppendError(err.error || 'Erreur serveur');
            } else {
                aiAppendBot(await res.json());
            }
        } catch(e) {
            document.getElementById('aiTyping')?.remove();
            aiAppendError('Serveur inaccessible. Vérifiez votre connexion.');
        }

        aiIsLoading = false;
        document.getElementById('aiSendBtn').disabled = false;
        input.focus();
    }

    async function aiClearChat() {
        await fetch(AI_CLEAR_URL, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        var msgs = document.getElementById('aiMessages');
        msgs.innerHTML = '<div class="ai-empty" id="aiEmpty"><div class="ai-empty-icon">🌾</div><div><strong>Conversation effacée</strong><p>Posez une nouvelle question.</p></div></div>';
    }
</script>
{% endblock %}

</body>
</html>
