{% extends 'base_agriculteur.html.twig' %}
{% block title %}Rotation #{{ rotation.id }} — AgroFlow{% endblock %}

{% block stylesheets %}
<style>
.show-wrap { max-width:640px; margin:0 auto; }
.actions-top { display:flex; gap:10px; margin-bottom:24px; }
.btn-back { display:inline-flex; align-items:center; gap:8px; background:#f0f0f0; color:#333; padding:10px 18px; border-radius:10px; font-size:14px; font-weight:500; text-decoration:none; }
.btn-edit { display:inline-flex; align-items:center; gap:8px; background:#2D5A27; color:white; padding:10px 18px; border-radius:10px; font-size:14px; font-weight:500; text-decoration:none; }
.btn-edit:hover { background:#1B3A20; color:white; }
.show-card { background:white; border-radius:16px; box-shadow:0 2px 16px rgba(0,0,0,0.08); overflow:hidden; }
.show-card-header { background:linear-gradient(135deg,#4A8C3F,#2D5A27); padding:28px; display:flex; align-items:center; gap:18px; }
.show-avatar { width:60px; height:60px; border-radius:14px; background:rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; font-size:28px; color:white; }
.show-title { font-size:20px; font-weight:700; color:white; }
.show-subtitle { font-size:13px; color:rgba(255,255,255,0.75); margin-top:4px; }
.show-body { padding:28px; }
.detail-row { display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid #f5f5f5; font-size:14px; }
.detail-row:last-child { border-bottom:none; }
.detail-label { color:#888; font-weight:500; display:flex; align-items:center; gap:8px; }
.detail-label i { color:#2D5A27; width:16px; }
.detail-value { font-weight:600; color:#1B3A20; }
.badge { display:inline-block; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600; }
.badge-active { background:#D1FAE5; color:#065F46; }
.badge-inactive { background:#FEE2E2; color:#991B1B; }
.duree-badge { background:#EDE9FE; color:#5B21B6; padding:4px 12px; border-radius:20px; font-size:13px; font-weight:600; }
</style>
{% endblock %}

{% block body %}
<div class="show-wrap">
    <div class="actions-top">
        <a href="{{ path('agri_rotations') }}" class="btn-back">
            <i class="fa fa-arrow-left"></i> Retour
        </a>
        <a href="{{ path('agri_rotations_edit', {id: rotation.id}) }}" class="btn-edit">
            <i class="fa fa-pen"></i> Modifier
        </a>
    </div>

    <div class="show-card">
        <div class="show-card-header">
            <div class="show-avatar"><i class="fa fa-rotate"></i></div>
            <div>
                <div class="show-title">Rotation #{{ rotation.id }}</div>
                <div class="show-subtitle">
                    {{ rotation.terrain.nomTerrain }} — {{ rotation.plante.nomP }}
                </div>
            </div>
        </div>
        <div class="show-body">

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-map"></i> Terrain</span>
                <span class="detail-value">{{ rotation.terrain.nomTerrain }}</span>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-seedling"></i> Plante</span>
                <span class="detail-value">{{ rotation.plante.nomP }}</span>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-calendar-plus"></i> Date de début</span>
                <span class="detail-value">
                    {{ rotation.dateDebut ? rotation.dateDebut|date('d/m/Y') : '—' }}
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-calendar-check"></i> Date de fin</span>
                <span class="detail-value">
                    {{ rotation.dateFin ? rotation.dateFin|date('d/m/Y') : '—' }}
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-clock"></i> Durée</span>
                <span class="detail-value">
                    {% if rotation.dateDebut and rotation.dateFin %}
                        {% set diff = rotation.dateFin.diff(rotation.dateDebut) %}
                        <span class="duree-badge">{{ diff.days }} jour{{ diff.days > 1 ? 's' : '' }}</span>
                    {% else %}
                        <span style="color:#aaa">—</span>
                    {% endif %}
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="fa fa-circle-dot"></i> Statut</span>
                <span class="detail-value">
                    <span class="badge {{ rotation.status ? 'badge-active' : 'badge-inactive' }}">
                        {{ rotation.status ? 'Actif' : 'Inactif' }}
                    </span>
                </span>
            </div>

        </div>
    </div>
</div>
{% endblock %}