{% extends 'base_agriculteur.html.twig' %}
{% block title %}{{ terrain.nomTerrain }} — AgroFlow{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
.show-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; }

.show-card {
    background:#fff; border-radius:12px; border:1px solid #e8e4d0;
    overflow:hidden;
}
.show-card-header {
    background:linear-gradient(135deg,#1A3A1F,#2D5A27);
    padding:18px 22px;
}
.show-card-header h2 { font-size:18px; font-weight:700; color:#fff; }
.show-card-header p  { font-size:12px; color:rgba(255,255,255,.6); margin-top:3px; }
.show-card-body { padding:20px 22px; }

.info-row {
    display:flex; justify-content:space-between; align-items:center;
    padding:11px 0; border-bottom:1px solid #F0EAD0;
}
.info-row:last-child { border-bottom:none; }
.info-label { font-size:12px; color:#7A8A95; font-weight:600;
              text-transform:uppercase; letter-spacing:.06em; }
.info-value { font-size:14px; font-weight:600; color:#1C2B3A; }

.badge-sol {
    background:#f0fff4; color:#2D5A27; border:1px solid #C8E6C0;
    padding:3px 12px; border-radius:20px; font-size:12px; font-weight:600;
}

.ph-meter { width:100%; }
.ph-meter-bar { height:10px; background:#F0EAD0; border-radius:5px; margin-top:6px; }
.ph-meter-fill { height:100%; border-radius:5px;
                 background:linear-gradient(90deg,#4A8C3F,#C8E6C0); }

.rot-list { list-style:none; }
.rot-list li {
    display:flex; align-items:center; gap:10px;
    padding:10px 0; border-bottom:1px solid #F0EAD0; font-size:13px;
}
.rot-list li:last-child { border-bottom:none; }
.rot-dot { width:8px; height:8px; border-radius:50%; background:#4A8C3F; flex-shrink:0; }

.back-bar { display:flex; gap:10px; margin-bottom:22px; flex-wrap:wrap; }
.btn-back {
    background:#FCF8E6; color:#1C2B3A; border:1px solid #e8e4d0;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    text-decoration:none; display:inline-flex; align-items:center; gap:7px;
}
.btn-edit-top {
    background:#ebf8ff; color:#2b6cb0; border:1px solid #bee3f8;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    text-decoration:none; display:inline-flex; align-items:center; gap:7px;
}
.btn-pdf {
    background:#fff5f5; color:#c53030; border:1px solid #fed7d7;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    text-decoration:none; display:inline-flex; align-items:center; gap:7px;
}
.btn-meteo {
    background:#F0FDF4; color:#166534; border:1px solid #86EFAC;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    display:inline-flex; align-items:center; gap:7px; cursor:pointer;
}
.btn-meteo:hover { background:#DCFCE7; }
.btn-analyse {
    background:#FFF7ED; color:#92400E; border:1px solid #FCD34D;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    display:inline-flex; align-items:center; gap:7px; cursor:pointer;
}
.btn-analyse:hover { background:#FEF3C7; }
.btn-carte {
    background:#EFF6FF; color:#1D4ED8; border:1px solid #BFDBFE;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    display:inline-flex; align-items:center; gap:7px; cursor:pointer;
}
.btn-carte:hover { background:#DBEAFE; }
.btn-air {
    background:#F5F3FF; color:#6D28D9; border:1px solid #DDD6FE;
    padding:9px 18px; border-radius:8px; font-weight:600; font-size:13px;
    display:inline-flex; align-items:center; gap:7px; cursor:pointer;
}
.btn-air:hover { background:#EDE9FE; }

/* ── Carte Leaflet ── */
#carteMap { height:320px; border-radius:10px; margin-top:8px; z-index:1; }
.carte-info { background:#EFF6FF; border-radius:10px; padding:12px 14px;
              font-size:13px; color:#1D4ED8; margin-top:12px; }

/* ── Qualité de l'air ── */
.air-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; }
.air-item { border-radius:10px; padding:12px 14px; }
.air-item-label { font-size:11px; color:#6B7280; font-weight:600; text-transform:uppercase; }
.air-item-val { font-size:20px; font-weight:700; margin-top:2px; }
.air-score { text-align:center; margin:12px 0 18px; }
.air-score-num { font-size:36px; font-weight:700; }
.air-score-label { font-size:13px; color:#6B7280; margin-top:4px; }
.air-reco { border-radius:10px; padding:12px 14px; font-size:13px; line-height:1.6; }
.air-reco.good   { background:#D1FAE5; color:#065F46; }
.air-reco.medium { background:#FEF3C7; color:#92400E; }
.air-reco.bad    { background:#FEE2E2; color:#991B1B; }

/* ── Modals ── */
.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; }
.modal-overlay.active { display:flex; }
.modal-box { background:#FFFDF5; border-radius:16px; padding:32px; width:90%; max-width:480px; box-shadow:0 20px 60px rgba(0,0,0,0.2); position:relative; font-family:'DM Sans',sans-serif; animation:modalIn 0.25s ease; }
.modal-box.wide { max-width:620px; }
@keyframes modalIn { from{transform:translateY(20px);opacity:0} to{transform:none;opacity:1} }
.modal-close { position:absolute; top:14px; right:16px; background:none; border:none; font-size:20px; cursor:pointer; color:#999; }
.modal-close:hover { color:#333; }
.modal-title { font-size:18px; font-weight:700; color:#1B3A20; margin-bottom:4px; display:flex; align-items:center; gap:10px; }
.modal-subtitle { font-size:13px; color:#6B7280; margin-bottom:20px; }
.modal-loading { text-align:center; padding:30px 0; color:#6B7280; font-size:14px; }
.modal-loading i { font-size:28px; display:block; margin-bottom:10px; animation:spin 1s linear infinite; }
@keyframes spin { to{transform:rotate(360deg)} }
.meteo-main { font-size:32px; font-weight:700; color:#1B3A20; margin:12px 0 4px; }
.meteo-desc { font-size:14px; color:#6B7280; margin-bottom:20px; }
.meteo-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px; }
.meteo-item { background:#F0FDF4; border-radius:10px; padding:12px 14px; }
.meteo-item-label { font-size:11px; color:#6B7280; font-weight:600; text-transform:uppercase; }
.meteo-item-val { font-size:18px; font-weight:700; color:#1B3A20; margin-top:2px; }
.meteo-coords { font-size:12px; color:#9CA3AF; background:#F9FAFB; border-radius:8px; padding:8px 12px; }
.meteo-reco { background:#D1FAE5; border-radius:10px; padding:12px 14px; font-size:13px; color:#065F46; font-weight:500; margin-top:12px; }
.analyse-score-wrap { text-align:center; margin:16px 0 20px; }
.analyse-score-bar { height:14px; background:#E5E7EB; border-radius:7px; overflow:hidden; margin:8px 0 4px; }
.analyse-score-fill { height:100%; border-radius:7px; transition:width 0.8s ease; }
.analyse-score-num { font-size:28px; font-weight:700; color:#1B3A20; }
.analyse-score-label { font-size:13px; color:#6B7280; }
.analyse-detail { background:#FAFAFA; border-radius:10px; padding:14px; font-size:13px; color:#374151; margin-bottom:14px; line-height:1.6; }
.analyse-reco { border-radius:10px; padding:14px; font-size:13px; line-height:1.6; }
.analyse-reco.good   { background:#D1FAE5; color:#065F46; }
.analyse-reco.medium { background:#FEF3C7; color:#92400E; }
.analyse-reco.bad    { background:#FEE2E2; color:#991B1B; }
</style>
{% endblock %}

{% block body %}

<div class="back-bar">
    <a href="{{ path('agri_terrains') }}" class="btn-back">
        <i class="fa fa-arrow-left"></i> Mes terrains
    </a>
    <a href="{{ path('agri_terrains_edit', {id: terrain.id}) }}" class="btn-edit-top">
        <i class="fa fa-pen"></i> Modifier
    </a>
    <a href="{{ path('agri_terrains_certificat_propriete', {id: terrain.id}) }}"
       class="btn-pdf"
       target="_blank">
        <i class="fa fa-file-pdf"></i> Certificat PDF
    </a>
    <button class="btn-meteo"
        onclick="openMeteo('{{ terrain.localisation }}', '{{ terrain.nomTerrain }}')">
        <i class="fa fa-cloud-sun"></i> Météo
    </button>
    <button class="btn-analyse"
        onclick="openAnalyse('{{ terrain.nomTerrain }}', '{{ terrain.typeSol }}', {{ terrain.pH ?? 0 }}, {{ terrain.surface ?? 0 }}, '{{ terrain.localisation }}')">
        <i class="fa fa-seedling"></i> Analyse
    </button>
    <button class="btn-carte"
        onclick="openCarte('{{ terrain.localisation }}', '{{ terrain.nomTerrain }}')">
        <i class="fa fa-map-location-dot"></i> Carte
    </button>
    <button class="btn-air"
        onclick="openAir('{{ terrain.localisation }}', '{{ terrain.nomTerrain }}')">
        <i class="fa fa-wind"></i> Qualité de l'air
    </button>
</div>

<div class="show-grid">

    {# Infos générales #}
    <div class="show-card">
        <div class="show-card-header">
            <h2>{{ terrain.nomTerrain }}</h2>
            <p><i class="fa fa-location-dot"></i> {{ terrain.localisation }}</p>
        </div>
        <div class="show-card-body">
            <div class="info-row">
                <span class="info-label">Surface</span>
                <span class="info-value">{{ terrain.surface }} ha</span>
            </div>
            <div class="info-row">
                <span class="info-label">Type de sol</span>
                <span class="badge-sol">{{ terrain.typeSol }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Localisation</span>
                <span class="info-value">{{ terrain.localisation }}</span>
            </div>
            <div class="info-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                <span class="info-label">pH du sol — {{ terrain.pH ?? '—' }}/14</span>
                {% if terrain.pH %}
                <div class="ph-meter-bar" style="width:100%">
                    <div class="ph-meter-fill"
                         style="width:{{ ((terrain.pH / 14) * 100)|round }}%">
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Rotations associées #}
    <div class="show-card">
        <div class="show-card-header">
            <h2>Rotations de culture</h2>
            <p>{{ terrain.rotations|length }} rotation(s) enregistrée(s)</p>
        </div>
        <div class="show-card-body">
            {% if terrain.rotations is empty %}
                <p style="color:#7A8A95;font-size:13px;text-align:center;padding:20px 0">
                    <i class="fa fa-seedling" style="font-size:24px;display:block;margin-bottom:8px;opacity:.3"></i>
                    Aucune rotation enregistrée
                </p>
            {% else %}
                <ul class="rot-list">
                {% for rot in terrain.rotations %}
                    <li>
                        <span class="rot-dot"></span>
                        <div>
                            <strong>{{ rot.plante.nomP ?? 'Plante' }}</strong>
                            <div style="font-size:11px;color:#7A8A95">
                                {{ rot.dateDebutT is defined ? rot.dateDebutT|date('d/m/Y') : (rot.getDateDebutT() ?? '—') }}
                                →
                                {{ rot.dateFinT is defined ? rot.dateFinT|date('d/m/Y') : (rot.getDateFinT() ?? '—') }}
                            </div>
                        </div>
                        <span style="margin-left:auto">
                            <span style="background:{% if rot.status == 1 %}#f0fff4;color:#276749{% else %}#fffbeb;color:#92400e{% endif %};
                                         padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600">
                                {{ rot.status == 1 ? 'Actif' : 'Terminé' }}
                            </span>
                        </span>
                    </li>
                {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>

</div>

{# ══ MODAL CARTE ══ #}
<div class="modal-overlay" id="carteModal">
    <div class="modal-box wide">
        <button class="modal-close" onclick="closeModal('carteModal'); destroyMap()">×</button>
        <div class="modal-title"><i class="fa fa-map-location-dot" style="color:#1D4ED8"></i> <span id="carteTitle">Carte</span></div>
        <div class="modal-subtitle" id="carteSubtitle"></div>
        <div id="carteMap"></div>
        <div class="carte-info" id="carteInfo">📍 Chargement de la localisation…</div>
    </div>
</div>

{# ══ MODAL QUALITÉ DE L'AIR ══ #}
<div class="modal-overlay" id="airModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal('airModal')">×</button>
        <div class="modal-title"><i class="fa fa-wind" style="color:#6D28D9"></i> <span id="airTitle">Qualité de l'air</span></div>
        <div class="modal-subtitle" id="airSubtitle"></div>
        <div id="airContent">
            <div class="modal-loading"><i class="fa fa-spinner"></i> Chargement…</div>
        </div>
    </div>
</div>

{# ══ MODAL MÉTÉO ══ #}
<div class="modal-overlay" id="meteoModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal('meteoModal')">×</button>
        <div class="modal-title"><i class="fa fa-cloud-sun" style="color:#F59E0B"></i> <span id="meteoTitle">Météo</span></div>
        <div class="modal-subtitle" id="meteoSubtitle"></div>
        <div id="meteoContent">
            <div class="modal-loading"><i class="fa fa-spinner"></i> Chargement…</div>
        </div>
    </div>
</div>

{# ══ MODAL ANALYSE ══ #}
<div class="modal-overlay" id="analyseModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal('analyseModal')">×</button>
        <div class="modal-title"><i class="fa fa-seedling" style="color:#4A8C3F"></i> <span id="analyseTitle">Analyse du Terrain</span></div>
        <div class="modal-subtitle" id="analyseSubtitle"></div>
        <div id="analyseContent">
            <div class="modal-loading"><i class="fa fa-spinner"></i> Analyse en cours…</div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
// ══════════════════════════════════════════════════════
// MODAL HELPERS
// ══════════════════════════════════════════════════════
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.classList.remove('active'); });
});

// ══════════════════════════════════════════════════════
// CARTE — Leaflet.js + OpenStreetMap
// ══════════════════════════════════════════════════════
let leafletMap = null;

function destroyMap() {
    if (leafletMap) { leafletMap.remove(); leafletMap = null; }
}

async function openCarte(localisation, nom) {
    document.getElementById('carteTitle').textContent    = 'Carte — ' + nom;
    document.getElementById('carteSubtitle').textContent = localisation;
    document.getElementById('carteInfo').textContent     = '📍 Chargement de la localisation…';
    destroyMap();
    document.getElementById('carteModal').classList.add('active');

    try {
        const geoResp = await fetch(
            `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(localisation + ', Tunisie')}&format=json&limit=1`,
            { headers: { 'Accept-Language': 'fr' } }
        );
        const geoData = await geoResp.json();
        let lat = 33.8869, lon = 9.5375, displayName = localisation + ', Tunisie (approx.)';
        if (geoData.length > 0) {
            lat = parseFloat(geoData[0].lat);
            lon = parseFloat(geoData[0].lon);
            displayName = geoData[0].display_name;
        }

        setTimeout(() => {
            leafletMap = L.map('carteMap').setView([lat, lon], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(leafletMap);

            const greenIcon = L.divIcon({
                html: `<div style="background:#2D5A27;width:18px;height:18px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.4)"></div>`,
                iconSize: [18, 18], iconAnchor: [9, 9]
            });
            L.marker([lat, lon], { icon: greenIcon })
                .addTo(leafletMap)
                .bindPopup(`<strong>${nom}</strong><br>${localisation}`)
                .openPopup();

            leafletMap.invalidateSize();
        }, 200);

        document.getElementById('carteInfo').innerHTML =
            `📍 <strong>${nom}</strong> — ${displayName}<br>
             <span style="font-size:12px;color:#6B7280">Lat: ${lat.toFixed(5)}, Lon: ${lon.toFixed(5)}</span>`;

    } catch (e) {
        document.getElementById('carteInfo').innerHTML = '<span style="color:#DC2626">Erreur de géolocalisation. Vérifiez votre connexion.</span>';
    }
}

// ══════════════════════════════════════════════════════
// QUALITÉ DE L'AIR — Open-Meteo Air Quality API
// ══════════════════════════════════════════════════════
async function openAir(localisation, nom) {
    document.getElementById('airTitle').textContent    = 'Qualité de l\'air — ' + nom;
    document.getElementById('airSubtitle').textContent = localisation;
    document.getElementById('airContent').innerHTML    = '<div class="modal-loading"><i class="fa fa-spinner"></i> Chargement…</div>';
    document.getElementById('airModal').classList.add('active');

    try {
        const geoResp = await fetch(
            `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(localisation + ', Tunisie')}&format=json&limit=1`,
            { headers: { 'Accept-Language': 'fr' } }
        );
        const geoData = await geoResp.json();
        let lat = 33.8869, lon = 9.5375;
        if (geoData.length > 0) {
            lat = parseFloat(geoData[0].lat);
            lon = parseFloat(geoData[0].lon);
        }

        const airResp = await fetch(
            `https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}` +
            `&hourly=pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,ozone,dust,european_aqi&timezone=Africa/Tunis&forecast_days=1`
        );
        const airData = await airResp.json();
        const h = new Date().getHours();

        const aqi      = airData.hourly?.european_aqi?.[h]      ?? '—';
        const pm10     = airData.hourly?.pm10?.[h]               ?? '—';
        const pm25     = airData.hourly?.pm2_5?.[h]              ?? '—';
        const no2      = airData.hourly?.nitrogen_dioxide?.[h]   ?? '—';
        const ozone    = airData.hourly?.ozone?.[h]              ?? '—';
        const dust     = airData.hourly?.dust?.[h]               ?? '—';

        let aqiLabel, aqiColor, aqiClass, aqiIcon, reco;
        if      (aqi <= 20)  { aqiLabel='Très bonne';  aqiColor='#16A34A'; aqiClass='good';   aqiIcon='😊'; reco='✅ Air excellent — Conditions idéales pour travailler au champ.'; }
        else if (aqi <= 40)  { aqiLabel='Bonne';       aqiColor='#65A30D'; aqiClass='good';   aqiIcon='🙂'; reco='✅ Bonne qualité d\'air — Travaux agricoles sans restriction.'; }
        else if (aqi <= 60)  { aqiLabel='Modérée';     aqiColor='#D97706'; aqiClass='medium'; aqiIcon='😐'; reco='⚠️ Qualité modérée — Limiter les efforts physiques prolongés.'; }
        else if (aqi <= 80)  { aqiLabel='Mauvaise';    aqiColor='#EA580C'; aqiClass='medium'; aqiIcon='😷'; reco='⚠️ Mauvaise qualité — Porter un masque, éviter les heures de pointe.'; }
        else if (aqi <= 100) { aqiLabel='Très mauvaise';aqiColor='#DC2626';aqiClass='bad';    aqiIcon='🚫'; reco='❌ Très mauvaise — Éviter tout travail en extérieur.'; }
        else                 { aqiLabel='Extrême';     aqiColor='#7C3AED'; aqiClass='bad';    aqiIcon='☠️'; reco='❌ Niveau extrême — Restez à l\'intérieur, protégez vos cultures.'; }

        document.getElementById('airContent').innerHTML = `
            <div class="air-score">
                <div class="air-score-num" style="color:${aqiColor}">${aqiIcon} ${aqi}</div>
                <div style="font-size:15px;font-weight:700;color:${aqiColor};margin-top:4px">${aqiLabel}</div>
                <div class="air-score-label">Indice AQI Européen</div>
            </div>
            <div class="air-grid">
                <div class="air-item" style="background:#F0F9FF">
                    <div class="air-item-label">🌫️ PM10</div>
                    <div class="air-item-val" style="color:#0369A1">${pm10} µg/m³</div>
                </div>
                <div class="air-item" style="background:#FFF7ED">
                    <div class="air-item-label">💨 PM2.5</div>
                    <div class="air-item-val" style="color:#C2410C">${pm25} µg/m³</div>
                </div>
                <div class="air-item" style="background:#F5F3FF">
                    <div class="air-item-label">🟣 NO₂</div>
                    <div class="air-item-val" style="color:#7C3AED">${no2} µg/m³</div>
                </div>
                <div class="air-item" style="background:#ECFDF5">
                    <div class="air-item-label">🔵 Ozone</div>
                    <div class="air-item-val" style="color:#065F46">${ozone} µg/m³</div>
                </div>
                <div class="air-item" style="background:#FEF9C3;grid-column:1/-1">
                    <div class="air-item-label">🟤 Poussière</div>
                    <div class="air-item-val" style="color:#92400E">${dust} µg/m³</div>
                </div>
            </div>
            <div class="air-reco ${aqiClass}">${reco}</div>`;

    } catch (e) {
        document.getElementById('airContent').innerHTML = '<p style="color:#DC2626;text-align:center">Erreur de chargement. Vérifiez votre connexion.</p>';
    }
}

// ══════════════════════════════════════════════════════
// MÉTÉO — Nominatim (géocodage) + Open-Meteo (météo) — sans clé API
// ══════════════════════════════════════════════════════
async function openMeteo(localisation, nom) {
    document.getElementById('meteoTitle').textContent    = 'Météo — ' + nom;
    document.getElementById('meteoSubtitle').textContent = localisation;
    document.getElementById('meteoContent').innerHTML    = '<div class="modal-loading"><i class="fa fa-spinner"></i> Chargement…</div>';
    document.getElementById('meteoModal').classList.add('active');

    try {
        const geoResp = await fetch(
            `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(localisation + ', Tunisie')}&format=json&limit=1`,
            { headers: { 'Accept-Language': 'fr' } }
        );
        const geoData = await geoResp.json();
        let lat = 33.8869, lon = 9.5375, displayName = localisation + ', Tunisie (approx.)';
        if (geoData.length > 0) {
            lat = parseFloat(geoData[0].lat);
            lon = parseFloat(geoData[0].lon);
            displayName = geoData[0].display_name;
        }

        const wResp = await fetch(
            `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
            `&current_weather=true&hourly=relative_humidity_2m,precipitation,windspeed_10m&forecast_days=1&timezone=Africa/Tunis`
        );
        const wData = await wResp.json();
        const cw = wData.current_weather;
        const h  = new Date().getHours();
        const humidity = wData.hourly?.relative_humidity_2m?.[h] ?? '—';
        const precip   = wData.hourly?.precipitation?.[h] ?? 0;

        const wcode = cw.weathercode;
        let icon = '☀️', desc = 'Ciel dégagé';
        if (wcode >= 1  && wcode <= 3)  { icon = '⛅';  desc = 'Partiellement nuageux'; }
        if (wcode >= 45 && wcode <= 48) { icon = '🌫️'; desc = 'Brouillard'; }
        if (wcode >= 51 && wcode <= 67) { icon = '🌧️'; desc = 'Pluie'; }
        if (wcode >= 71 && wcode <= 77) { icon = '❄️';  desc = 'Neige'; }
        if (wcode >= 80 && wcode <= 82) { icon = '🌦️'; desc = 'Averses'; }
        if (wcode >= 95)                { icon = '⛈️';  desc = 'Orage'; }

        let reco = '💧 Conditions normales — Arrosage standard selon vos plantes.';
        if (precip > 5)          reco = "🌧️ Pluie prévue — Arrosage inutile aujourd'hui.";
        if (precip > 20)         reco = '⚠️ Fortes précipitations — Surveiller le drainage.';
        if (cw.temperature > 35) reco = '🔥 Forte chaleur — Arroser tôt le matin ou en soirée.';
        if (humidity < 30)       reco = "💨 Faible humidité — Augmenter la fréquence d'arrosage.";

        document.getElementById('meteoContent').innerHTML = `
            <div style="font-size:40px;text-align:center;margin-bottom:4px">${icon}</div>
            <div class="meteo-main" style="text-align:center">${cw.temperature} °C</div>
            <div class="meteo-desc" style="text-align:center">${desc}</div>
            <div class="meteo-grid">
                <div class="meteo-item"><div class="meteo-item-label">💧 Humidité</div><div class="meteo-item-val">${humidity} %</div></div>
                <div class="meteo-item"><div class="meteo-item-label">💨 Vent</div><div class="meteo-item-val">${cw.windspeed} km/h</div></div>
                <div class="meteo-item"><div class="meteo-item-label">🌧️ Précipitations</div><div class="meteo-item-val">${precip} mm</div></div>
                <div class="meteo-item"><div class="meteo-item-label">📍 Coordonnées</div><div class="meteo-item-val" style="font-size:13px">${lat.toFixed(4)}, ${lon.toFixed(4)}</div></div>
            </div>
            <div class="meteo-coords">📍 ${displayName}</div>
            <div class="meteo-reco">${reco}</div>`;
    } catch (e) {
        document.getElementById('meteoContent').innerHTML = '<p style="color:#DC2626;text-align:center">Erreur météo. Vérifiez votre connexion.</p>';
    }
}

// ══════════════════════════════════════════════════════
// ANALYSE TERRAIN — logique interne + Open-Meteo pour arrosage
// ══════════════════════════════════════════════════════
async function openAnalyse(nom, typeSol, ph, surface, localisation) {
    document.getElementById('analyseTitle').textContent    = 'Analyse — ' + nom;
    document.getElementById('analyseSubtitle').textContent = localisation;
    document.getElementById('analyseContent').innerHTML    = '<div class="modal-loading"><i class="fa fa-spinner"></i> Analyse en cours…</div>';
    document.getElementById('analyseModal').classList.add('active');

    let score = 50, details = [];

    const phScore = calculerScorePH(ph);
    score += phScore.pts;
    details.push(`pH (${ph}) : ${phScore.label}`);

    if (surface >= 1 && surface <= 100) { score += 10; details.push(`Surface : ${surface} ha — Idéale`); }
    else if (surface > 100)             { score += 5;  details.push(`Surface : ${surface} ha — Grande`); }
    else                                { score -= 5;  details.push(`Surface : ${surface} ha — Petite`); }

    const rec = getRecommandations(typeSol, ph);
    details.push(`Type sol : ${typeSol}`);
    score = Math.max(0, Math.min(100, score));

    let scoreLabel, scoreClass, scoreColor;
    if (score >= 75)      { scoreLabel = '🌿 Excellent — Terrain très cultivable';                scoreClass = 'good';   scoreColor = '#16A34A'; }
    else if (score >= 50) { scoreLabel = '⚙️ Moyen — Terrain cultivable avec améliorations';     scoreClass = 'medium'; scoreColor = '#D97706'; }
    else                  { scoreLabel = '⚠️ Faible — Terrain nécessite des corrections';         scoreClass = 'bad';    scoreColor = '#DC2626'; }

    let arrosageReco = '💧 Arrosage standard recommandé.';
    try {
        const geoR = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(localisation + ', Tunisie')}&format=json&limit=1`);
        const geoD = await geoR.json();
        if (geoD.length > 0) {
            const wR = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${geoD[0].lat}&longitude=${geoD[0].lon}&current_weather=true&hourly=precipitation&forecast_days=1&timezone=Africa/Tunis`);
            const wD = await wR.json();
            const precip = wD.hourly?.precipitation?.[new Date().getHours()] ?? 0;
            const temp   = wD.current_weather?.temperature ?? 20;
            if (precip > 5)     arrosageReco = "🌧️ Pluie détectée — Pas d'arrosage nécessaire.";
            else if (temp > 35) arrosageReco = '🔥 Chaleur élevée — Arroser tôt le matin ou après 18h.';
            else                arrosageReco = '💧 Conditions normales — Arrosage standard.';
        }
    } catch (_) {}

    document.getElementById('analyseContent').innerHTML = `
        <div class="analyse-score-wrap">
            <div class="analyse-score-num">${score} <span style="font-size:16px;color:#9CA3AF">/ 100</span></div>
            <div class="analyse-score-bar"><div class="analyse-score-fill" style="width:${score}%;background:${scoreColor}"></div></div>
            <div class="analyse-score-label">${scoreLabel}</div>
        </div>
        <div class="analyse-detail">${details.map(d => `• ${d}`).join('<br>')}</div>
        <div class="analyse-reco ${scoreClass}">
            <strong>🌱 Recommandation de Plantes (pH = ${ph})</strong><br>
            ${rec.contexte}<br>
            ✔️ <strong>Recommandées :</strong> ${rec.bon.join(', ')}<br>
            ✖️ <strong>Éviter :</strong> ${rec.eviter.join(', ')}<br><br>
            🚿 <strong>Arrosage :</strong> ${arrosageReco}
        </div>`;
}

function calculerScorePH(ph) {
    if (ph >= 6.0 && ph <= 7.0) return { pts: 25,  label: 'Optimal ✅' };
    if (ph >= 5.5 && ph < 6.0)  return { pts: 15,  label: 'Légèrement acide ⚠️' };
    if (ph > 7.0  && ph <= 7.5) return { pts: 15,  label: 'Légèrement basique ⚠️' };
    if (ph > 7.5  && ph <= 8.0) return { pts: 5,   label: 'Basique — à corriger ⚠️' };
    if (ph < 5.5)               return { pts: -10, label: 'Trop acide ❌' };
    return                             { pts: -5,  label: 'Trop basique ❌' };
}

function getRecommandations(typeSol, ph) {
    let bon = [], eviter = [], contexte = '';
    if (ph < 5.5)       { contexte = '🔴 Sol très acide';          bon = ['Myrtille','Pomme de terre','Seigle'];              eviter = ['Luzerne','Betterave','Asperge']; }
    else if (ph <= 6.5) { contexte = '🟡 Sol légèrement acide';    bon = ['Tomate','Maïs','Carotte','Haricot','Fraise'];       eviter = ['Luzerne','Betterave sucrière']; }
    else if (ph <= 7.0) { contexte = '🟢 Sol neutre (idéal)';      bon = ['Blé','Maïs','Tomate','Laitue','Carotte','Chou'];    eviter = ['Myrtille','Azalée']; }
    else if (ph <= 7.5) { contexte = '🟡 Sol légèrement basique';  bon = ['Asperge','Chou','Betterave','Epinard','Céleri'];     eviter = ['Pomme de terre','Tomate','Fraise']; }
    else                { contexte = '🔴 Sol basique';              bon = ['Luzerne','Orge','Datte'];                          eviter = ['Pomme de terre','Tomate','Fraise','Maïs']; }

    if (typeSol === 'Sableux')       { bon.push('Melon','Pastèque');                       contexte += ' — Sol sableux (drainage rapide)'; }
    else if (typeSol === 'Argileux') { bon.push('Riz','Blé'); eviter.push('Carotte (déformation)'); contexte += ' — Sol argileux (rétention eau)'; }
    else if (typeSol === 'Humifère') { bon.push('Légumes feuilles','Framboise');            contexte += ' — Sol humifère (riche)'; }

    return { bon, eviter, contexte };
}
