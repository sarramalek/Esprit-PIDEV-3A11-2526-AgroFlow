{% extends 'base_ouvrier.html.twig' %}

{% block title %}Événements disponibles - AgroFlow (Ouvrier){% endblock %}

{% block stylesheets %}
<style>
    .event-card { background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 20px; margin-bottom: 20px; transition: 0.2s; }
    .event-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .statut-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .statut-Planifié { background: #E8F5E9; color: #2E7D32; }
    .statut-Terminé { background: #E3F2FD; color: #1976D2; }
    .statut-Annulé { background: #FFEBEE; color: #C62828; }
    .filter-bar { background: #f8f9fa; border-radius: 12px; padding: 20px; margin-bottom: 24px; }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6">Événements disponibles</h1>
            <p class="text-muted">Découvrez et inscrivez-vous aux événements agricoles (espace ouvrier)</p>
        </div>
        <div>
            <a href="{{ path('ouvrier_participation_index') }}" class="btn btn-outline-primary">
                <i class="fa fa-calendar-check"></i> Mes participations
            </a>
        </div>
    </div>

    <!-- Filtres -->
    <div class="filter-bar">
        <form method="GET" action="{{ path('ouvrier_evenement_index') }}" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small text-muted">Recherche</label>
                <input type="text" name="search" class="form-control" value="{{ search }}" placeholder="Titre...">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Date début</label>
                <input type="date" name="dateDebut" class="form-control" value="{{ dateDebutFiltre }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Date fin</label>
                <input type="date" name="dateFin" class="form-control" value="{{ dateFinFiltre }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Lieu</label>
                <input type="text" name="lieu" class="form-control" value="{{ lieuFiltre }}" placeholder="Lieu...">
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">Statut</label>
                <select name="statut" class="form-select">
                    <option value="">Tous</option>
                    <option value="Planifié" {% if statutFiltre == 'Planifié' %}selected{% endif %}>Planifié</option>
                    <option value="Terminé" {% if statutFiltre == 'Terminé' %}selected{% endif %}>Terminé</option>
                    <option value="Annulé" {% if statutFiltre == 'Annulé' %}selected{% endif %}>Annulé</option>
                </select>
            </div>
            <div class="col-12 text-end">
                <button type="submit" class="btn btn-primary">Filtrer</button>
                <a href="{{ path('ouvrier_evenement_index') }}" class="btn btn-secondary">Réinitialiser</a>
            </div>
        </form>
    </div>

    <div class="row">
        <div class="col-12">
            <p class="text-muted">{{ total }} événement(s) trouvé(s)</p>
        </div>
    </div>

    <div class="row">
        {% for evenement in evenements %}
            <div class="col-md-6 col-lg-4">
                <div class="event-card">
                    <h5 class="fw-bold">{{ evenement.titre }}</h5>
                    <p class="small text-muted mb-2">{{ evenement.typeEvenement }}</p>
                    <p class="mb-1"><i class="fa fa-calendar"></i> Du {{ evenement.dateDebut|date('d/m/Y') }} au {{ evenement.dateFin|date('d/m/Y') }}</p>
                    <p class="mb-1"><i class="fa fa-map-marker"></i> {{ evenement.lieu }}</p>
                    <p><span class="statut-badge statut-{{ evenement.statut }}">{{ evenement.statut }}</span></p>
                    <p class="small">{{ evenement.description|slice(0, 100) }}...</p>
                    <div class="mt-3">
                        {% if evenement.statut in ['Planifié', 'planifie'] %}
                            <a href="{{ path('ouvrier_evenement_inscription', {id: evenement.idEvenement}) }}" class="btn btn-sm btn-success w-100">
                                <i class="fa fa-pen"></i> S'inscrire
                            </a>
                        {% else %}
                            <button class="btn btn-sm btn-secondary w-100" disabled>Inscription non disponible</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">Aucun événement trouvé.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}