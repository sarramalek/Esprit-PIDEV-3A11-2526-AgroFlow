{% extends 'base_admin.html.twig' %}

{% block title %}Nouvelle Catégorie — AGROFLOW{% endblock %}
{% block page_title %}Ajouter une Catégorie{% endblock %}
{% block breadcrumb %}Événements / Catégories / Ajouter{% endblock %}

{% block stylesheets %}
<style>
    /* Réutilisation des styles de l'index */
    .af-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 30px;
        margin-bottom: 20px;
    }
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
    }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-outline { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    .btn-outline:hover { background: var(--cream-dark); color: var(--navy); }
    .btn-success { background: var(--green-accent); color: #fff; }

    /* Style pour le formulaire Symfony */
    form div { margin-bottom: 1rem; }
    label { display: block; font-size: 13px; font-weight: 600; color: var(--navy); margin-bottom: 8px; }
    input, textarea, select {
        width: 100%; padding: 10px 14px;
        border: 1px solid var(--cream-dark); border-radius: 8px;
        background: var(--cream); font-size: 14px;
        color: var(--navy); outline: none;
    }
    input:focus, textarea:focus { border-color: var(--green-accent); background: #fff; }
</style>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        
        <div class="page-header">
            <div>
                <h1><i class="fa fa-plus-circle" style="color:var(--green-accent);margin-right:8px;"></i>Nouvelle Catégorie</h1>
                <p class="text-muted small">Créez une nouvelle catégorie pour classifier vos événements</p>
            </div>
        </div>

        <div class="af-card">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    {# BOUTON ANNULER #}
                    <a href="{{ path('categorie_evenement_index') }}" class="btn btn-ghost">
                        <i class="fa fa-xmark"></i> Annuler
                    </a>
                </div>
            {{ form_end(form) }}
        </div>

    </div>
</div>
{% endblock %}