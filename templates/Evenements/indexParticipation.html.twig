{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Participations — AGROFLOW{% endblock %}
{% block page_title %}Gestion des Participations{% endblock %}
{% block breadcrumb %}Événements / Participations{% endblock %}

{% block stylesheets %}
<style>
    .af-card { background: var(--white); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; margin-bottom: 20px; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: var(--navy); }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 600; border: none; text-decoration: none; }
    .btn-success { background: var(--green-accent); color: #fff; }
    .btn-primary { background: var(--navy); color: #fff; }
    .btn-outline { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    .btn-warning { background: #F6AD55; color: #fff; }
    .btn-danger { background: #E53E3E; color: #fff; }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    .btn-sm { padding: 6px 12px; font-size: 12px; }
    .search-bar { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
    .search-field { flex: 1; min-width: 180px; }
    .search-field label { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 6px; }
    .search-field input, .search-field select { width: 100%; padding: 10px 14px; border: 1px solid var(--cream-dark); border-radius: 8px; background: var(--cream); font-size: 14px; outline: none; }
    .filter-row { display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px; }
    .af-table { width: 100%; border-collapse: collapse; }
    .af-table thead th { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); padding: 10px 14px; border-bottom: 2px solid var(--cream-dark); background: var(--cream); text-align: left; }
    .af-table tbody tr { border-bottom: 1px solid var(--cream-dark); transition: background 0.15s; }
    .af-table tbody tr:hover { background: #fafdf8; }
    .af-table td { padding: 14px; font-size: 14px; vertical-align: middle; }
    .statut-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; }
    .statut-Inscrit { background: #FFF9C4; color: #F57F17; }
    .statut-Confirmé { background: #E8F5E9; color: #2E7D32; }
    .statut-Annulé { background: #FFEBEE; color: #C62828; }
    .presence-oui { color: #2E7D32; font-weight: bold; }
    .presence-non { color: #C62828; font-weight: bold; }
    .actions-group { display: flex; gap: 8px; justify-content: center; }
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .flash-msg { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; margin-bottom: 8px; }
    .flash-success { background: #f0fff4; border: 1px solid #9ae6b4; color: #276749; }
    .flash-error { background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; }
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 999; align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: var(--white); border-radius: 14px; box-shadow: 0 20px 60px rgba(0,0,0,0.2); width: 440px; max-width: 94vw; overflow: hidden; }
    .modal-header { padding: 20px 24px 12px; display: flex; justify-content: space-between; align-items: center; }
    .modal-header h5 { font-size: 16px; font-weight: 700; color: #c53030; display: flex; gap: 8px; }
    .modal-body { padding: 4px 24px 16px; }
    .modal-footer { padding: 14px 24px 20px; border-top: 1px solid var(--cream-dark); display: flex; justify-content: flex-end; gap: 10px; }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1><i class="fa fa-users" style="color:var(--green-accent);margin-right:8px;"></i>Gestion des Participations</h1>
        <p>Suivez les inscriptions aux événements</p>
    </div>
    <a href="{{ path('participation_ajouter') }}" class="btn btn-success">
        <i class="fa fa-plus"></i> Nouvelle participation
    </a>
</div>

{# Flash messages #}
{% if app.flashes|length > 0 %}
<div class="flash-list">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-msg flash-{{ label == 'success' ? 'success' : 'error' }}">
                <i class="fa fa-{{ label == 'success' ? 'circle-check' : 'triangle-exclamation' }}"></i>
                {{ message }}
                <button class="flash-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}

{# Filtres #}
<div class="af-card">
    <form method="GET" action="{{ path('participation_index') }}">
        <div class="search-bar">
            <div class="search-field" style="flex:2;">
                <label>Rechercher par événement</label>
                <input type="text" name="search" value="{{ search }}" placeholder="Ex: Formation, Foire...">
            </div>
            <div class="search-field">
                <label>Date inscription</label>
                <input type="date" name="dateInscription" value="{{ dateInscriptionFiltre }}">
            </div>
            <button type="submit" class="btn btn-primary"><i class="fa fa-magnifying-glass"></i> Filtrer</button>
            {% if search or dateInscriptionFiltre or statutFiltre or presenceFiltre or userIdFiltre %}
                <a href="{{ path('participation_index') }}" class="btn btn-outline"><i class="fa fa-xmark"></i> Réinitialiser</a>
            {% endif %}
        </div>
        <div class="filter-row">
            <div class="search-field">
                <label>Statut</label>
                <select name="statut">
                    <option value="">Tous les statuts</option>
                    {% for s in statuts %}
                        <option value="{{ s }}" {% if statutFiltre == s %}selected{% endif %}>{{ s }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="search-field">
                <label>Présence</label>
                <select name="presence">
                    <option value="">Toutes</option>
                    {% for p in presences %}
                        <option value="{{ p }}" {% if presenceFiltre == p %}selected{% endif %}>{{ p }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="search-field">
                <label>Utilisateur (CIN ou nom)</label>
                <input type="text" name="userId" value="{{ userIdFiltre }}" placeholder="Ex: 12345 ou Dupont">
            </div>
        </div>
        <p class="search-hint mt-2">{{ total }} participation(s) trouvée(s)</p>
    </form>
</div>

{# Tableau #}
<div class="af-card">
    <div class="section-header d-flex justify-content-between align-items-center mb-3">
        <div class="section-title"><i class="fa fa-list"></i> Liste des participations</div>
        <a href="{{ path('participation_index') }}" class="btn btn-ghost btn-sm"><i class="fa fa-rotate-right"></i> Actualiser</a>
    </div>

    {% if participations is empty %}
        <div class="empty-state">
            <i class="fa fa-inbox"></i>
            <p>Aucune participation trouvée.</p>
            <a href="{{ path('participation_ajouter') }}" class="btn btn-success mt-3">Créer une participation</a>
        </div>
    {% else %}
        <div style="overflow-x:auto;">
            <table class="af-table">
                <thead>
                    <tr>
                        <th>Événement</th>
                        <th>Utilisateur</th>
                        <th>Date inscription</th>
                        <th>Statut</th>
                        <th>Présence</th>
                        <th style="width:180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in participations %}
                        <tr>
                            <td><strong>{{ p.evenement.titre }}</strong></td>
                            <td>
                                {% if p.utilisateur %}
                                    {{ p.utilisateur.prenom }} {{ p.utilisateur.nom }} (CIN: {{ p.utilisateur.cin }})
                                {% else %}
                                    <span class="text-danger">Utilisateur introuvable</span>
                                {% endif %}
                            </td>
                            <td>{{ p.dateInscription|date('d/m/Y') }}</td>
                            <td>
                                <span class="statut-badge statut-{{ p.statutParticipation }}">
                                    {{ p.statutParticipation }}
                                </span>
                            </td>
                            <td class="presence-{{ p.presence ? 'oui' : 'non' }}">
                                {{ p.presence ? '✓ Oui' : '✗ Non' }}
                            </td>
                            <td>
                                <div class="actions-group">
                                    <a href="{{ path('participation_modifier', {id: p.idParticipation}) }}" class="btn btn-warning btn-sm">
                                        <i class="fa fa-pencil"></i> Modifier
                                    </a>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="openModal('modal-{{ p.idParticipation }}')">
                                        <i class="fa fa-trash"></i> Supprimer
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# Modales de suppression #}
{% for p in participations %}
<div class="modal-overlay" id="modal-{{ p.idParticipation }}">
    <div class="modal-box">
        <div class="modal-header">
            <h5><i class="fa fa-triangle-exclamation"></i> Confirmation de suppression</h5>
            <button class="modal-close" onclick="closeModal('modal-{{ p.idParticipation }}')">✕</button>
        </div>
        <div class="modal-body">
            <p>Voulez-vous vraiment supprimer cette participation ?</p>
            <div class="modal-cat-name fw-bold fs-5 my-2">
                Événement : {{ p.evenement.titre }}<br>
                Utilisateur :
                {% if p.utilisateur %}
                    {{ p.utilisateur.prenom }} {{ p.utilisateur.nom }} (CIN: {{ p.utilisateur.cin }})
                {% else %}
                    <span class="text-danger">Inconnu</span>
                {% endif %}
            </div>
            <div class="modal-warning bg-warning-subtle p-2 rounded">
                <i class="fa fa-circle-info"></i> Cette action est <strong>irréversible</strong>.
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" onclick="closeModal('modal-{{ p.idParticipation }}')"><i class="fa fa-xmark"></i> Annuler</button>
            <form method="POST" action="{{ path('participation_supprimer', {id: p.idParticipation}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer_' ~ p.idParticipation) }}">
                <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Oui, supprimer</button>
            </form>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}

{% block javascripts %}
<script>
    function openModal(id) {
        document.getElementById(id).classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) closeModal(this.id);
        });
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => closeModal(m.id));
    });
</script>
{% endblock %}