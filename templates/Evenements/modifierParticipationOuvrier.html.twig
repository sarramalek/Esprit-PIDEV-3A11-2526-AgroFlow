{% extends 'base_ouvrier.html.twig' %}

{% block title %}Modifier ma participation{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Modifier ma présence</h5>
                </div>
                <div class="card-body">
                    <p><strong>Événement :</strong> {{ participation.evenement.titre }}</p>
                    <p><strong>Date inscription :</strong> {{ participation.dateInscription|date('d/m/Y') }}</p>
                    <p><strong>Statut actuel :</strong> {{ participation.statutParticipation }}</p>

                    {{ form_start(form) }}
                        {{ form_row(form.presence, {attr: {class: 'form-select'}}) }}
                        <div class="d-flex justify-content-between mt-4">
                            {{ form_widget(form.submit, {attr: {class: 'btn btn-primary'}}) }}
                            <a href="{{ path('ouvrier_participation_index') }}" class="btn btn-secondary">Retour</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}