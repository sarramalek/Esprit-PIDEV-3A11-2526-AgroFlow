{% extends 'base_admin.html.twig' %}

{% block title %}Modifier la Catégorie — AGROFLOW{% endblock %}
{% block page_title %}Modification{% endblock %}
{% block breadcrumb %}Événements / Catégories / Modifier{% endblock %}

{% block stylesheets %}
<style>
    /* Styles identiques pour la cohérence */
    .af-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 30px;
    }
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
    }
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-warning { background: #F6AD55; color: #fff; }
    .btn-outline { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    
    /* Info Label */
    .info-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #ebf8ff;
        border: 1px solid #bee3f8;
        color: #2b6cb0;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    form div { margin-bottom: 1rem; }
    label { display: block; font-size: 13px; font-weight: 600; color: var(--navy); margin-bottom: 8px; }
    input, textarea {
        width: 100%; padding: 10px 14px;
        border: 1px solid var(--cream-dark); border-radius: 8px;
        background: var(--cream); font-size: 14px;
    }
    input:focus { border-color: #F6AD55; background: #fff; }
</style>
{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="page-header">
            <div>
                <h1><i class="fa fa-pencil" style="color:#F6AD55;margin-right:8px;"></i>Modifier la Catégorie</h1>
                <p class="text-muted small">Mettez à jour les informations de la catégorie existante</p>
            </div>
        </div>

        <div class="info-banner">
            <i class="fa fa-circle-info fs-5"></i>
            <span>Modification en cours de : <strong>{{ categorie.nomCategorie }}</strong></span>
        </div>

        <div class="af-card">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    {# BOUTON ANNULER #}
                    <a href="{{ path('categorie_evenement_index') }}" class="btn btn-outline">
                        <i class="fa fa-rotate-left"></i> Abandonner
                    </a>

                    {# BOUTON VALIDER #}
                    <button type="submit" class="btn btn-warning">
                        <i class="fa fa-floppy-disk"></i> Enregistrer les modifications
                    </button>
                </div>
            {{ form_end(form) }}
        </div>

    </div>
</div>
{% endblock %}