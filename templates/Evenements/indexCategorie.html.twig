{% extends 'base_admin.html.twig' %}

{% block title %}Gestion des Catégories — AGROFLOW{% endblock %}
{% block page_title %}Gestion des Catégories{% endblock %}
{% block breadcrumb %}Événements / Catégories{% endblock %}

{% block stylesheets %}
<style>
    /* ── Cards ── */
    .af-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 24px;
        margin-bottom: 20px;
    }

    /* ── Page Header ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .page-header h1 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--navy);
    }
    .page-header p {
        font-size: 13px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* ── Buttons ── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-success { background: var(--green-accent); color: #fff; }
    .btn-success:hover { background: var(--green-mid); color: #fff; }
    .btn-primary { background: var(--navy); color: #fff; }
    .btn-primary:hover { background: #263a50; color: #fff; }
    .btn-outline { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    .btn-outline:hover { background: var(--cream-dark); color: var(--navy); }
    .btn-warning { background: #F6AD55; color: #fff; }
    .btn-warning:hover { background: #dd8f30; color: #fff; }
    .btn-danger { background: #E53E3E; color: #fff; }
    .btn-danger:hover { background: #c53030; color: #fff; }
    .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--cream-dark); }
    .btn-ghost:hover { background: var(--cream); }
    .btn-sm { padding: 6px 12px; font-size: 12px; }

    /* ── Search ── */
    .search-bar { display: flex; gap: 12px; align-items: flex-end; }
    .search-field { flex: 1; }
    .search-field label {
        display: block;
        font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.06em;
        color: var(--text-muted); margin-bottom: 6px;
    }
    .search-field input {
        width: 100%; padding: 10px 14px;
        border: 1px solid var(--cream-dark); border-radius: 8px;
        background: var(--cream); font-size: 14px;
        font-family: 'DM Sans', sans-serif; color: var(--navy);
        outline: none; transition: border-color 0.2s;
    }
    .search-field input:focus { border-color: var(--green-accent); background: #fff; }
    .search-hint { font-size: 12px; color: var(--text-muted); margin-top: 8px; font-style: italic; }

    /* ── Table ── */
    .af-table { width: 100%; border-collapse: collapse; }
    .af-table thead th {
        font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.07em;
        color: var(--text-muted); padding: 10px 14px;
        border-bottom: 2px solid var(--cream-dark);
        background: var(--cream); text-align: left;
    }
    .af-table thead th:last-child { text-align: center; }
    .af-table tbody tr { border-bottom: 1px solid var(--cream-dark); transition: background 0.15s; }
    .af-table tbody tr:last-child { border-bottom: none; }
    .af-table tbody tr:hover { background: #fafdf8; }
    .af-table td { padding: 14px; font-size: 14px; vertical-align: middle; }
    .af-table td:last-child { text-align: center; }

    .cat-badge { display: inline-flex; align-items: center; gap: 10px; }
    .cat-icon {
        width: 34px; height: 34px; border-radius: 8px;
        background: var(--green-light); display: flex;
        align-items: center; justify-content: center;
        color: var(--green-mid); font-size: 14px; flex-shrink: 0;
    }
    .cat-name { font-weight: 600; color: var(--navy); }
    .desc-text { color: var(--text-muted); font-size: 13px; line-height: 1.5; }

    .actions-group { display: flex; gap: 8px; justify-content: center; }

    /* ── Section header ── */
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .section-title { font-size: 15px; font-weight: 700; color: var(--navy); display: flex; align-items: center; gap: 8px; }
    .section-title i { color: var(--green-accent); }

    /* ── Flash messages ── */
    .flash-list { margin-bottom: 16px; }
    .flash-msg {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 8px;
        font-size: 13px; font-weight: 500; margin-bottom: 8px;
        animation: slideIn 0.3s ease;
    }
    .flash-success { background: #f0fff4; border: 1px solid #9ae6b4; color: #276749; }
    .flash-error   { background: #fff5f5; border: 1px solid #feb2b2; color: #c53030; }
    .flash-close {
        margin-left: auto; cursor: pointer;
        background: none; border: none;
        font-size: 14px; color: inherit; opacity: 0.6;
    }
    .flash-close:hover { opacity: 1; }

    /* ── Empty state ── */
    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .empty-state i { font-size: 3rem; opacity: 0.3; }
    .empty-state p { margin-top: 12px; font-size: 15px; }

    /* ── Modal ── */
    .modal-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 999;
        align-items: center; justify-content: center;
    }
    .modal-overlay.open { display: flex; animation: fadeIn 0.2s ease; }
    .modal-box {
        background: var(--white);
        border-radius: 14px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        width: 440px; max-width: 94vw;
        animation: scaleIn 0.2s ease;
        overflow: hidden;
    }
    .modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 20px 24px 12px;
    }
    .modal-header h5 {
        font-size: 16px; font-weight: 700; color: #c53030;
        display: flex; align-items: center; gap: 8px;
    }
    .modal-close {
        background: none; border: none; cursor: pointer;
        font-size: 18px; color: var(--text-muted);
        padding: 2px 6px; border-radius: 6px; transition: background 0.2s;
    }
    .modal-close:hover { background: var(--cream-dark); }
    .modal-body { padding: 4px 24px 16px; }
    .modal-body p { font-size: 14px; color: var(--text-muted); margin-bottom: 6px; }
    .modal-cat-name { font-size: 17px; font-weight: 700; color: var(--navy); margin: 4px 0 12px; }
    .modal-warning {
        display: flex; align-items: center; gap: 8px;
        background: #fff8f0; border: 1px solid #fbd38d;
        border-radius: 8px; padding: 10px 14px;
        font-size: 13px; color: #7b5100;
    }
    .modal-footer {
        display: flex; gap: 10px; justify-content: flex-end;
        padding: 14px 24px 20px; border-top: 1px solid var(--cream-dark);
    }

    /* ── Animations ── */
    @keyframes fadeIn  { from { opacity: 0 } to { opacity: 1 } }
    @keyframes scaleIn { from { transform: scale(0.95); opacity: 0 } to { transform: scale(1); opacity: 1 } }
    @keyframes slideIn { from { transform: translateY(-6px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }
</style>
{% endblock %}

{% block body %}

{# ── PAGE HEADER ── #}
<div class="page-header">
    <div>
        <h1><i class="fa fa-tags" style="color:var(--green-accent);margin-right:8px;"></i>Gestion des Catégories</h1>
        <p>Organisez et suivez les catégories d'événements</p>
    </div>
    <a href="{{ path('categorie_evenement_ajouter') }}" class="btn btn-success">
        <i class="fa fa-plus"></i> Nouvelle catégorie
    </a>
</div>

{# ── FLASH MESSAGES ── #}
{% if app.flashes|length > 0 %}
<div class="flash-list">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-msg flash-{{ label == 'success' ? 'success' : 'error' }}">
                <i class="fa fa-{{ label == 'success' ? 'circle-check' : 'triangle-exclamation' }}"></i>
                {{ message }}
                <button class="flash-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}

{# ── SEARCH BAR ── #}
<div class="af-card">
    <form method="GET" action="{{ path('categorie_evenement_index') }}">
        <div class="search-bar">
            <div class="search-field">
                <label>Rechercher</label>
                <input
                    type="text"
                    name="recherche"
                    value="{{ recherche }}"
                    placeholder="Rechercher par nom de catégorie…"
                    autocomplete="off"
                />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-magnifying-glass"></i> Rechercher
            </button>
            {% if recherche %}
                <a href="{{ path('categorie_evenement_index') }}" class="btn btn-outline">
                    <i class="fa fa-xmark"></i> Réinitialiser
                </a>
            {% endif %}
        </div>
        <p class="search-hint">
            {{ total }} catégorie(s) trouvée(s){% if recherche %} pour "<strong>{{ recherche }}</strong>"{% endif %}
        </p>
    </form>
</div>

{# ── TABLE ── #}
<div class="af-card">
    <div class="section-header">
        <div class="section-title">
            <i class="fa fa-list"></i> Liste des Catégories
        </div>
        <a href="{{ path('categorie_evenement_index') }}" class="btn btn-ghost btn-sm">
            <i class="fa fa-rotate-right"></i> Actualiser
        </a>
    </div>

    {% if categories is empty %}
        <div class="empty-state">
            <i class="fa fa-inbox"></i>
            <p>Aucune catégorie trouvée.</p>
            {% if recherche %}
                <a href="{{ path('categorie_evenement_index') }}" class="btn btn-outline" style="margin-top:12px;">
                    Voir toutes les catégories
                </a>
            {% else %}
                <a href="{{ path('categorie_evenement_ajouter') }}" class="btn btn-success" style="margin-top:12px;">
                    <i class="fa fa-plus"></i> Créer une catégorie
                </a>
            {% endif %}
        </div>
    {% else %}
        <div style="overflow-x:auto;">
            <table class="af-table">
                <thead>
                    <tr>
                        <th style="width:280px;">Nom</th>
                        <th>Description</th>
                        <th style="width:200px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for categorie in categories %}
                    <tr>
                        <td>
                            <div class="cat-badge">
                                <div class="cat-icon"><i class="fa fa-tag"></i></div>
                                <span class="cat-name">{{ categorie.nomCategorie }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="desc-text">
                                {% if categorie.descriptionCategorie|length > 120 %}
                                    <span title="{{ categorie.descriptionCategorie }}">
                                        {{ categorie.descriptionCategorie|slice(0, 120) }}…
                                    </span>
                                {% else %}
                                    {{ categorie.descriptionCategorie }}
                                {% endif %}
                            </span>
                        </td>
                        <td>
                            <div class="actions-group">
                                <a href="{{ path('categorie_evenement_modifier', {id: categorie.idCategorie}) }}"
                                   class="btn btn-warning btn-sm">
                                    <i class="fa fa-pencil"></i> Modifier
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        onclick="openModal('modal-{{ categorie.idCategorie }}')">
                                    <i class="fa fa-trash"></i> Supprimer
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# ── MODALES — EN DEHORS DU TABLEAU ── #}
{% for categorie in categories %}
<div class="modal-overlay" id="modal-{{ categorie.idCategorie }}">
    <div class="modal-box">
        <div class="modal-header">
            <h5><i class="fa fa-triangle-exclamation"></i> Confirmation de suppression</h5>
            <button class="modal-close" onclick="closeModal('modal-{{ categorie.idCategorie }}')">✕</button>
        </div>
        <div class="modal-body">
            <p>Voulez-vous vraiment supprimer la catégorie :</p>
            <div class="modal-cat-name">"{{ categorie.nomCategorie }}"</div>
            <div class="modal-warning">
                <i class="fa fa-circle-info"></i>
                Cette action est <strong>&nbsp;irréversible</strong>.
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" onclick="closeModal('modal-{{ categorie.idCategorie }}')">
                <i class="fa fa-xmark"></i> Annuler
            </button>
            <form method="POST"
                  action="{{ path('categorie_evenement_supprimer', {id: categorie.idCategorie}) }}"
                  style="display:inline;">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('supprimer_' ~ categorie.idCategorie) }}"/>
                <button type="submit" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Oui, supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endfor %}

{% endblock %}

{% block javascripts %}
<script>
    function openModal(id) {
        document.getElementById(id).classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
        document.body.style.overflow = '';
    }
    // Clic sur l'overlay = fermeture
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) closeModal(this.id);
        });
    });
    // Touche Échap = fermeture
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape')
            document.querySelectorAll('.modal-overlay.open').forEach(m => closeModal(m.id));
    });
</script>
{% endblock %}
