{% extends 'base_admin.html.twig' %}

{% block title %}Utilisateurs — AgroFlow Admin{% endblock %}
{% block page_title %}Gestion des Utilisateurs{% endblock %}
{% block breadcrumb %}Utilisateurs{% endblock %}

{% block stylesheets %}
<style>
    .page { display: flex; flex-direction: column; gap: 24px; }

    /* ── Stats ── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }
    .stat-card {
        background: var(--white);
        border: 1px solid var(--cream-dark);
        border-radius: var(--radius);
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--shadow);
    }
    .stat-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; flex-shrink: 0;
    }
    .stat-val { font-size: 26px; font-weight: 700; color: var(--navy); line-height: 1; }
    .stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

    /* ── Toolbar ── */
    .toolbar {
        background: var(--white);
        border: 1px solid var(--cream-dark);
        border-radius: var(--radius);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--shadow);
    }
    .search-wrap {
        position: relative; flex: 1;
    }
    .search-wrap i {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        color: var(--text-muted); font-size: 13px;
    }
    .search-input {
        width: 100%; padding: 9px 12px 9px 36px;
        border: 1px solid var(--cream-dark);
        border-radius: 8px; font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        background: var(--cream);
        transition: border 0.2s;
    }
    .search-input:focus { outline: none; border-color: var(--green-accent); background: white; }

    .filter-select {
        padding: 9px 14px;
        border: 1px solid var(--cream-dark);
        border-radius: 8px; font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        background: var(--cream); color: var(--navy);
        cursor: pointer;
    }
    .filter-select:focus { outline: none; border-color: var(--green-accent); }

    .btn {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 18px; border-radius: 8px;
        font-size: 13px; font-weight: 600;
        text-decoration: none; border: none; cursor: pointer;
        transition: all 0.2s; white-space: nowrap;
    }
    .btn-primary { background: var(--green-mid); color: white; }
    .btn-primary:hover { background: var(--green-dark); color: white; }
    .btn-secondary { background: var(--cream); border: 1px solid var(--cream-dark); color: var(--navy); }
    .btn-secondary:hover { background: var(--cream-dark); }
    .btn-danger { background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; }
    .btn-danger:hover { background: #DC2626; color: white; }
    .btn-sm { padding: 6px 12px; font-size: 12px; }
    .btn-icon { padding: 7px 10px; }

    /* ── Table ── */
    .table-card {
        background: var(--white);
        border: 1px solid var(--cream-dark);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }
    .table-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--cream-dark);
        display: flex; align-items: center; justify-content: space-between;
    }
    .table-title { font-size: 15px; font-weight: 600; color: var(--navy); }
    .table-count { font-size: 12px; color: var(--text-muted); }

    table { width: 100%; border-collapse: collapse; }
    thead th {
        background: var(--cream);
        padding: 11px 16px;
        text-align: left;
        font-size: 11px; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.07em;
        color: var(--text-muted);
        border-bottom: 1px solid var(--cream-dark);
    }
    tbody tr { transition: background 0.15s; }
    tbody tr:hover { background: #FAFDF8; }
    tbody td {
        padding: 13px 16px;
        font-size: 14px;
        border-bottom: 1px solid var(--cream-dark);
        vertical-align: middle;
    }
    tbody tr:last-child td { border-bottom: none; }

    /* User cell */
    .user-cell { display: flex; align-items: center; gap: 11px; }
    .user-av {
        width: 38px; height: 38px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 700; color: white; flex-shrink: 0;
        background: linear-gradient(135deg, var(--green-accent), var(--green-mid));
    }
    .user-name { font-weight: 600; color: var(--navy); }
    .user-email { font-size: 12px; color: var(--text-muted); }

    /* Role badge */
    .badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 20px;
        font-size: 11px; font-weight: 600;
    }
    .badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .badge-admin  { background: #FEF3C7; color: #B45309; }
    .badge-agri   { background: #D1FAE5; color: #065F46; }
    .badge-ouv    { background: #DBEAFE; color: #1D4ED8; }
    .badge-other  { background: var(--cream-dark); color: var(--text-muted); }

    /* Actions */
    .actions { display: flex; align-items: center; gap: 6px; }

    /* Empty state */
    .empty {
        text-align: center; padding: 60px 20px; color: var(--text-muted);
    }
    .empty i { font-size: 40px; margin-bottom: 14px; opacity: 0.3; display: block; }

    /* Flash */
    .flash { padding: 12px 18px; border-radius: 8px; font-size: 14px; font-weight: 500; margin-bottom: 4px; }
    .flash-success { background: #D1FAE5; color: #065F46; border: 1px solid #A7F3D0; }
    .flash-danger  { background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; }
</style>
{% endblock %}

{% block body %}
<div class="page">

    {# Flash messages #}
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('danger') %}
        <div class="flash flash-danger"><i class="fa fa-triangle-exclamation"></i> {{ msg }}</div>
    {% endfor %}

    {# Stats #}
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:#EAF3E6;">
                <i class="fa fa-users" style="color:#2D5A27;"></i>
            </div>
            <div>
                <div class="stat-val">{{ stats.total }}</div>
                <div class="stat-label">Total utilisateurs</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#FEF3C7;">
                <i class="fa fa-shield-halved" style="color:#B45309;"></i>
            </div>
            <div>
                <div class="stat-val">{{ stats.admins }}</div>
                <div class="stat-label">Administrateurs</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#D1FAE5;">
                <i class="fa fa-tractor" style="color:#065F46;"></i>
            </div>
            <div>
                <div class="stat-val">{{ stats.agriculteurs }}</div>
                <div class="stat-label">Agriculteurs</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#DBEAFE;">
                <i class="fa fa-person-digging" style="color:#1D4ED8;"></i>
            </div>
            <div>
                <div class="stat-val">{{ stats.ouvriers }}</div>
                <div class="stat-label">Ouvriers</div>
            </div>
        </div>
    </div>

    {# Toolbar #}
    <form method="GET" class="toolbar">
        <div class="search-wrap">
            <i class="fa fa-search"></i>
            <input type="text" name="q" value="{{ search }}"
                   class="search-input" placeholder="Rechercher par nom, prénom ou email…">
        </div>
        <select name="role" class="filter-select" onchange="this.form.submit()">
            <option value="">Tous les rôles</option>
            <option value="3" {% if role == '3' %}selected{% endif %}>Administrateurs</option>
            <option value="2" {% if role == '2' %}selected{% endif %}>Agriculteurs</option>
            <option value="1" {% if role == '1' %}selected{% endif %}>Ouvriers</option>
        </select>
        <button type="submit" class="btn btn-secondary"><i class="fa fa-filter"></i> Filtrer</button>
        {% if search or role %}
            <a href="{{ path('admin_users_list') }}" class="btn btn-secondary"><i class="fa fa-xmark"></i> Réinitialiser</a>
        {% endif %}
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <i class="fa fa-plus"></i> Nouvel utilisateur
        </a>
    </form>

    {# Table #}
    <div class="table-card">
        <div class="table-header">
            <div class="table-title"><i class="fa fa-users" style="color:var(--green-accent);margin-right:8px;"></i>Liste des utilisateurs</div>
            <div class="table-count">{{ users|length }} résultat(s)</div>
        </div>

        {% if users|length > 0 %}
        <table>
            <thead>
                <tr>
                    <th>Utilisateur</th>
                    <th>CIN</th>
                    <th>Téléphone</th>
                    <th>Ville</th>
                    <th>Rôle</th>
                    <th>Inscription</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>
                        <div class="user-cell">
                            <div class="user-av">
                                {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                            </div>
                            <div>
                                <div class="user-name">{{ user.prenom }} {{ user.nom }}</div>
                                <div class="user-email">{{ user.email }}</div>
                            </div>
                        </div>
                    </td>
                    <td style="font-family:'DM Mono',monospace; font-size:13px;">{{ user.cin }}</td>
                    <td>{{ user.tel ?? '—' }}</td>
                    <td>{{ user.ville ?? '—' }}</td>
                    <td>
                        {% if user.role == 3 %}
                            <span class="badge badge-admin"><i class="fa fa-shield-halved"></i> Admin</span>
                        {% elseif user.role == 2 %}
                            <span class="badge badge-agri"><i class="fa fa-tractor"></i> Agriculteur</span>
                        {% elseif user.role == 1 %}
                            <span class="badge badge-ouv"><i class="fa fa-person-digging"></i> Ouvrier</span>
                        {% else %}
                            <span class="badge badge-other">Inconnu</span>
                        {% endif %}
                    </td>
                    <td style="font-size:13px; color:var(--text-muted);">
                        {{ user.dateCreationcpt ? user.dateCreationcpt|date('d/m/Y') : '—' }}
                    </td>
                    <td>
                        <div class="actions">
                            <a href="{{ path('admin_users_show', {cin: user.cin}) }}"
                               class="btn btn-sm btn-secondary btn-icon" title="Voir">
                                <i class="fa fa-eye"></i>
                            </a>
                            <a href="{{ path('admin_users_edit', {cin: user.cin}) }}"
                               class="btn btn-sm btn-secondary btn-icon" title="Modifier">
                                <i class="fa fa-pen"></i>
                            </a>
                            <form method="POST"
                                  action="{{ path('admin_users_delete', {cin: user.cin}) }}"
                                  onsubmit="return confirm('Supprimer {{ user.prenom }} {{ user.nom }} ?')">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete_user_' ~ user.cin) }}">
                                <button type="submit" class="btn btn-sm btn-danger btn-icon" title="Supprimer">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
            <div class="empty">
                <i class="fa fa-users-slash"></i>
                <div style="font-size:15px; font-weight:600; color:var(--navy);">Aucun utilisateur trouvé</div>
                <div style="margin-top:6px; font-size:13px;">Modifiez vos filtres ou ajoutez un utilisateur</div>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
