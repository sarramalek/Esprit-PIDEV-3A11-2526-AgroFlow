{% extends 'base_agriculteur.html.twig' %}
{% block title %}Tâches de {{ ouvrier.prenom }} {{ ouvrier.nom }}{% endblock %}

{% block stylesheets %}
<style>
:root {
    --vert: #2d6a4f; --vert-l: #52b788; --terre: #bc6c25;
    --beige: #fefae0; --danger: #c1121f; --warn: #e9c46a;
}
body { background: var(--beige); font-family: 'Segoe UI', sans-serif; }

.page-header {
    background: linear-gradient(135deg, var(--vert), var(--vert-l));
    color: white; padding: 1.5rem 2rem;
    border-radius: 0 0 1.5rem 1.5rem; margin-bottom: 2rem;
    display: flex; justify-content: space-between; align-items: center;
}

.layout { display: grid; grid-template-columns: 1fr 360px; gap: 1.5rem; }
@media(max-width:768px) { .layout { grid-template-columns: 1fr; } }

/* ---- Tableau tâches ---- */
.card {
    background: white; border-radius: 1rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.07); overflow: hidden;
}
.card-header {
    padding: 1rem 1.5rem; background: var(--vert); color: white;
    font-weight: 700; font-size: 1rem;
}
table { width: 100%; border-collapse: collapse; }
th { background: #f4f4f4; padding: .65rem 1rem; text-align: left; font-size: .85rem; color: #444; }
td { padding: .7rem 1rem; border-bottom: 1px solid #f0f0f0; font-size: .9rem; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: #f9fff9; }

/* badges état */
.badge {
    display: inline-block; padding: .2rem .65rem;
    border-radius: 2rem; font-size: .75rem; font-weight: 700;
}
.badge-afaire    { background: #dce8f5; color: #1d4e89; }
.badge-encours   { background: #fff3cd; color: #856404; }
.badge-terminee  { background: #d4edda; color: #155724; }
.badge-retard    { background: #f8d7da; color: #842029; }

/* badge priorité */
.prio-haute   { color: var(--danger); font-weight: 700; }
.prio-normale { color: var(--vert);   font-weight: 600; }
.prio-basse   { color: #888; }

.btn-del {
    background: transparent; border: 1px solid var(--danger); color: var(--danger);
    padding: .25rem .6rem; border-radius: .4rem; font-size: .8rem;
    cursor: pointer; transition: all .2s;
}
.btn-del:hover { background: var(--danger); color: white; }

/* ---- Formulaire ajout tâche ---- */
.form-card {
    background: white; border-radius: 1rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.07); padding: 1.5rem;
    position: sticky; top: 1rem;
}
.form-card h3 { margin: 0 0 1.25rem; color: var(--vert); font-size: 1rem; }
.form-group { display: flex; flex-direction: column; gap: .3rem; margin-bottom: .85rem; }
label { font-size: .82rem; font-weight: 600; color: #444; }
input, select, textarea {
    padding: .5rem .75rem; border: 1px solid #ddd; border-radius: .5rem;
    font-size: .9rem; font-family: inherit; transition: border .2s;
}
input:focus, select:focus, textarea:focus { border-color: var(--vert); outline: none; }
textarea { resize: vertical; min-height: 70px; }
.btn-add {
    width: 100%; background: var(--vert); color: white;
    border: none; padding: .7rem; border-radius: .6rem;
    font-size: .95rem; font-weight: 600; cursor: pointer; transition: background .2s;
}
.btn-add:hover { background: var(--vert-l); }

.retard-label { font-size: .75rem; color: var(--danger); font-weight: 700; }

.back-link {
    display: inline-block; margin-bottom: 1.5rem;
    color: var(--vert); text-decoration: none; font-size: .9rem;
}
.back-link:hover { text-decoration: underline; }
.field-error {
    color: var(--danger);
    font-size: .75rem;
    font-weight: 600;
    display: none;
    margin-top: .2rem;
}
input.invalid, select.invalid, textarea.invalid {
    border-color: var(--danger) !important;
}
</style>
{% endblock %}

{% block body %}
<div class="page-header container-fluid px-4">
    <div>
        <h1 style="margin:0; font-size:1.4rem;">
            📋 Tâches de {{ ouvrier.prenom }} {{ ouvrier.nom }}
        </h1>
        <small style="opacity:.85;">
            {% if ouvrier.terrain %}
                🌿 {{ ouvrier.terrain.nomTerrain }}
            {% else %}
                Aucun terrain assigné
            {% endif %}
        </small>
    </div>
</div>

<div class="container">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <a href="{{ path('app_ouvrier_index') }}" class="back-link">← Retour aux ouvriers</a>

    <div class="layout">

        {# ---- Liste des tâches ---- #}
        <div class="card">
            <div class="card-header">
                {{ taches|length }} tâche{{ taches|length != 1 ? 's' : '' }} assignée{{ taches|length != 1 ? 's' : '' }}
            </div>

            {% if taches is empty %}
                <p style="padding:1.5rem; color:#aaa; text-align:center; font-style:italic;">
                    Aucune tâche pour cet ouvrier.
                </p>
            {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Tâche</th>
                        <th>État</th>
                        <th>Priorité</th>
                        <th>Échéance</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for tache in taches %}
                    {% set enRetard = tache.dateEcheancee and tache.dateEcheancee < date() and tache.etat != 'terminée' %}
                    <tr>
                        <td>
                            <strong>{{ tache.nomTache }}</strong><br>
                            <small style="color:#777;">{{ tache.description }}</small>
                        </td>
                        <td>
                            {% if tache.etat == 'à faire' %}
                                <span class="badge badge-afaire">À faire</span>
                            {% elseif tache.etat == 'en cours' %}
                                <span class="badge badge-encours">En cours</span>
                            {% elseif tache.etat == 'terminée' %}
                                <span class="badge badge-terminee">Terminée</span>
                            {% else %}
                                <span class="badge">{{ tache.etat }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="prio-{{ tache.priorite == 'haute' ? 'haute' : (tache.priorite == 'basse' ? 'basse' : 'normale') }}">
                                {{ tache.priorite|capitalize }}
                            </span>
                        </td>
                        <td>
                            {{ tache.dateEcheancee ? tache.dateEcheancee|date('d/m/Y') : '—' }}
                            {% if enRetard %}
                                <br><span class="retard-label">⚠ En retard</span>
                            {% endif %}
                        </td>
<td>
<form method="post" action="{{ path('app_ouvrier_tache_delete', {'id': tache.id}) }}"
      onsubmit="return confirm('Supprimer cette tâche ?')">
    <input type="hidden" name="_token" value="{{ csrf_token('delete'~tache.id) }}">
    <button type="submit" class="btn-del">🗑 Supprimer</button>
</form>
</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

        {# ---- Formulaire ajout tâche ---- #}
        {# ---- Formulaire ajout tâche ---- #}
<div class="form-card">
    <h3>➕ Assigner une nouvelle tâche</h3>

    {# Messages d'erreur JS #}
    <div id="form-errors" style="display:none; background:#f8d7da; color:#842029; border:1px solid #f5c2c7; border-radius:.5rem; padding:.75rem 1rem; margin-bottom:1rem; font-size:.85rem;"></div>

    <form id="tache-form" method="post" action="{{ path('app_ouvrier_tache_add', {cin: ouvrier.cin}) }}" novalidate>

        <div class="form-group">
            <label for="nom_tache">Nom de la tâche *</label>
            <input type="text" id="nom_tache" name="nom_tache" placeholder="Ex: Arrosage parcelle A" maxlength="100">
            <span class="field-error" id="err-nom"></span>
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Détails de la tâche..." maxlength="1000"></textarea>
            <span class="field-error" id="err-desc"></span>
            <small id="desc-counter" style="color:#aaa; font-size:.75rem; text-align:right;">0 / 1000</small>
        </div>

        <div class="form-group">
            <label for="etat">État</label>
            <select id="etat" name="etat">
                <option value="à faire">À faire</option>
                <option value="en cours">En cours</option>
            </select>
        </div>

        <div class="form-group">
            <label for="priorite">Priorité</label>
            <select id="priorite" name="priorite">
                <option value="normale">Normale</option>
                <option value="haute">Haute</option>
                <option value="basse">Basse</option>
            </select>
        </div>

        <div class="form-group">
            <label for="date_echeancee">Date d'échéance</label>
            <input type="date" id="date_echeancee" name="date_echeancee">
            <span class="field-error" id="err-date"></span>
        </div>

        <button type="submit" class="btn-add">✅ Assigner la tâche</button>
    </form>
</div>
</div>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
function () {
    const form       = document.getElementById('tache-form');
    const nomInput   = document.getElementById('nom_tache');
    const descInput  = document.getElementById('description');
    const dateInput  = document.getElementById('date_echeancee');
    const errBox     = document.getElementById('form-errors');
    const counter    = document.getElementById('desc-counter');

    /* Compteur description */
    descInput.addEventListener('input', () => {
        counter.textContent = descInput.value.length + ' / 1000';
    });

    /* Helpers */
    function showFieldError(id, msg) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = msg;
        el.style.display = 'block';
    }
    function clearFieldError(id, inputEl) {
        const el = document.getElementById(id);
        if (el) { el.textContent = ''; el.style.display = 'none'; }
        if (inputEl) inputEl.classList.remove('invalid');
    }
    function markInvalid(inputEl, errId, msg) {
        inputEl.classList.add('invalid');
        showFieldError(errId, msg);
    }

    /* Validation live sur blur */
    nomInput.addEventListener('blur', () => validateNom());
    descInput.addEventListener('blur', () => validateDesc());
    dateInput.addEventListener('blur', () => validateDate());

    function validateNom() {
        clearFieldError('err-nom', nomInput);
        const val = nomInput.value.trim();
        const regex = /^[\p{L}0-9 \-_.,!?'"()]+$/u;

        if (!val) {
            markInvalid(nomInput, 'err-nom', 'Le nom de la tâche est obligatoire.');
            return false;
        }
        if (val.length < 3) {
            markInvalid(nomInput, 'err-nom', 'Le nom doit contenir au moins 3 caractères.');
            return false;
        }
        if (val.length > 100) {
            markInvalid(nomInput, 'err-nom', 'Le nom ne peut pas dépasser 100 caractères.');
            return false;
        }
        if (!regex.test(val)) {
            markInvalid(nomInput, 'err-nom', 'Le nom contient des caractères non autorisés.');
            return false;
        }
        return true;
    }

    function validateDesc() {
        clearFieldError('err-desc', descInput);
        if (descInput.value.length > 1000) {
            markInvalid(descInput, 'err-desc', 'La description ne peut pas dépasser 1000 caractères.');
            return false;
        }
        return true;
    }

    function validateDate() {
        clearFieldError('err-date', dateInput);
        const val = dateInput.value;
        if (!val) return true; /* facultatif */

        const chosen = new Date(val);
        chosen.setHours(0, 0, 0, 0);
        const today  = new Date();
        today.setHours(0, 0, 0, 0);

        if (chosen < today) {
            markInvalid(dateInput, 'err-date', "La date d'échéance doit être aujourd'hui ou dans le futur.");
            return false;
        }
        return true;
    }

    /* Validation globale à la soumission */
    form.addEventListener('submit', function (e) {
        errBox.style.display = 'none';
        errBox.innerHTML     = '';

        const okNom  = validateNom();
        const okDesc = validateDesc();
        const okDate = validateDate();

        if (!okNom || !okDesc || !okDate) {
            e.preventDefault();
            const errors = [];
            if (!okNom)  errors.push(document.getElementById('err-nom').textContent);
            if (!okDesc) errors.push(document.getElementById('err-desc').textContent);
            if (!okDate) errors.push(document.getElementById('err-date').textContent);
            errBox.innerHTML     = '<strong>Veuillez corriger les erreurs suivantes :</strong><ul style="margin:.4rem 0 0; padding-left:1.2rem;">' +
                errors.map(m => '<li>' + m + '</li>').join('') + '</ul>';
            errBox.style.display = 'block';
            errBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    });
})();
</script>
{% endblock %}
