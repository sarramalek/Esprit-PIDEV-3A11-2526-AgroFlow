{% extends 'base_admin.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Modifier' : 'Nouvel' }} utilisateur — AgroFlow Admin{% endblock %}
{% block page_title %}{{ mode == 'edit' ? 'Modifier l\'utilisateur' : 'Nouvel utilisateur' }}{% endblock %}
{% block breadcrumb %}Utilisateurs / {{ mode == 'edit' ? 'Modifier' : 'Créer' }}{% endblock %}

{% block stylesheets %}
<style>
    .page { display: flex; flex-direction: column; gap: 24px; }

    .back-btn {
        display: inline-flex; align-items: center; gap: 8px;
        color: var(--text-muted); text-decoration: none;
        font-size: 13px; font-weight: 500; transition: color 0.2s;
    }
    .back-btn:hover { color: var(--navy); }

    .form-card {
        background: var(--white);
        border: 1px solid var(--cream-dark);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        max-width: 860px;
    }
    .form-card-header {
        padding: 18px 28px;
        border-bottom: 1px solid var(--cream-dark);
        display: flex; align-items: center; gap: 12px;
    }
    .form-card-icon {
        width: 42px; height: 42px; border-radius: 11px;
        background: var(--green-mid);
        display: flex; align-items: center; justify-content: center;
        font-size: 17px; color: white;
    }
    .form-card-title { font-size: 16px; font-weight: 700; color: var(--navy); }
    .form-card-sub   { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

    .form-body { padding: 28px; }

    .section-label {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--green-accent);
        margin-bottom: 16px; margin-top: 28px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--cream-dark);
        display: flex; align-items: center; gap: 8px;
    }
    .section-label:first-child { margin-top: 0; }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full { grid-column: 1 / -1; }

    label {
        font-size: 12px; font-weight: 600;
        color: var(--navy);
    }
    label .req { color: #DC2626; margin-left: 2px; }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="date"],
    select {
        padding: 10px 14px;
        border: 1px solid var(--cream-dark);
        border-radius: 8px;
        font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        color: var(--navy);
        background: var(--cream);
        transition: border 0.2s, box-shadow 0.2s;
        width: 100%;
    }
    input:focus, select:focus {
        outline: none;
        border-color: var(--green-accent);
        background: white;
        box-shadow: 0 0 0 3px rgba(74,140,63,0.1);
    }
    input:disabled {
        background: var(--cream-dark);
        color: var(--text-muted);
        cursor: not-allowed;
    }

    .field-error {
        font-size: 12px; color: #DC2626;
        display: flex; align-items: center; gap: 5px;
    }
    .field-error::before { content: '⚠'; }

    .form-footer {
        padding: 18px 28px;
        border-top: 1px solid var(--cream-dark);
        display: flex; align-items: center; gap: 12px;
        background: var(--cream);
    }
    .btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 22px; border-radius: 8px;
        font-size: 14px; font-weight: 600;
        text-decoration: none; border: none; cursor: pointer;
        transition: all 0.2s;
    }
    .btn-primary { background: var(--green-mid); color: white; }
    .btn-primary:hover { background: var(--green-dark); color: white; }
    .btn-secondary { background: white; border: 1px solid var(--cream-dark); color: var(--navy); }
    .btn-secondary:hover { background: var(--cream-dark); }

    .help-text { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
</style>
{% endblock %}

{% block body %}
<div class="page">

    <a href="{{ path('admin_users_list') }}" class="back-btn">
        <i class="fa fa-arrow-left"></i> Retour à la liste
    </a>

    <div class="form-card">
        <div class="form-card-header">
            <div class="form-card-icon">
                <i class="fa fa-{{ mode == 'edit' ? 'pen' : 'user-plus' }}"></i>
            </div>
            <div>
                <div class="form-card-title">
                    {{ mode == 'edit' ? 'Modifier ' ~ user.prenom ~ ' ' ~ user.nom : 'Créer un nouvel utilisateur' }}
                </div>
                <div class="form-card-sub">
                    {{ mode == 'edit' ? 'Modifiez les informations ci-dessous' : 'Remplissez le formulaire pour créer un compte' }}
                </div>
            </div>
        </div>

        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="form-body">

            {# ── Identité ── #}
            <div class="section-label"><i class="fa fa-id-card"></i> Identité</div>
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.cin) }}
                    {{ form_widget(form.cin) }}
                    {% if not form.cin.vars.disabled %}
                        <div class="help-text">Le CIN sert d'identifiant unique et ne peut pas être modifié après création.</div>
                    {% endif %}
                    {% for err in form.cin.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role) }}
                    {% for err in form.role.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.prenom) }}
                    {{ form_widget(form.prenom) }}
                    {% for err in form.prenom.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom) }}
                    {% for err in form.nom.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.dateNaiss) }}
                    {{ form_widget(form.dateNaiss) }}
                    {% for err in form.dateNaiss.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.tel) }}
                    {{ form_widget(form.tel) }}
                    {% for err in form.tel.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
            </div>

            {# ── Contact ── #}
            <div class="section-label"><i class="fa fa-envelope"></i> Contact & localisation</div>
            <div class="form-grid">
                <div class="form-group full">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {% for err in form.email.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.ville) }}
                    {{ form_widget(form.ville) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.adresse) }}
                    {{ form_widget(form.adresse) }}
                </div>
            </div>

            {# ── Mot de passe ── #}
            <div class="section-label"><i class="fa fa-lock"></i> Mot de passe</div>
            {% if mode == 'edit' %}
                <div class="help-text" style="margin-bottom:14px; font-size:13px;">
                    <i class="fa fa-circle-info" style="color:var(--green-accent);"></i>
                    Laissez les champs vides pour conserver le mot de passe actuel.
                </div>
            {% endif %}
            <div class="form-grid">
                <div class="form-group">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    {% for err in form.plainPassword.first.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
                <div class="form-group">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    {% for err in form.plainPassword.second.vars.errors %}
                        <div class="field-error">{{ err.message }}</div>
                    {% endfor %}
                </div>
            </div>

        </div>

        <div class="form-footer">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-{{ mode == 'edit' ? 'floppy-disk' : 'user-plus' }}"></i>
                {{ mode == 'edit' ? 'Enregistrer les modifications' : 'Créer l\'utilisateur' }}
            </button>
            <a href="{{ path('admin_users_list') }}" class="btn btn-secondary">
                <i class="fa fa-xmark"></i> Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </div>

</div>
{% endblock %}
