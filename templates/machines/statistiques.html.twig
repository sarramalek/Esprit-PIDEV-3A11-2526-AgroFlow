{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}Statistiques des machines — AgroFlow{% endblock %}

{% block body %}
<style>
    .stats-container { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .stats-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .stats-header h1 { margin: 0; font-size: 1.9rem; font-weight: 700; color: #1f2a1f; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
    .stat-card { background: white; border-radius: 20px; padding: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .stat-card h3 { margin: 0 0 1.2rem 0; color: #2d6a2d; font-size: 1.3rem; }
    .stat-number { font-size: 2.5rem; font-weight: 800; color: #1f2a1f; text-align: center; }
    .stat-label { text-align: center; color: #6b8c6b; margin-top: 0.5rem; }
    canvas { max-height: 300px; width: 100% !important; }
    .btn {
        padding: 0.65rem 1.4rem;
        border-radius: 10px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-secondary { background: #f0f7f0; color: #2d6a2d; border: 1px solid #dce8d5; }
    .btn-secondary:hover { background: #e0ecd9; }
    @media (max-width: 768px) {
        .stats-container { padding: 1rem; }
        .stats-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="stats-container">
    <div class="stats-header">
        <h1>📊 Statistiques des machines</h1>
        <a href="{{ path('agri_machines') }}" class="btn btn-secondary">
            ← Retour aux machines
        </a>
    </div>

    <div class="stats-grid">
        <!-- Carte total -->
        <div class="stat-card">
            <h3>📦 Total des machines</h3>
            <div class="stat-number">{{ stats.total }}</div>
            <div class="stat-label">machines enregistrées</div>
        </div>

        <!-- Graphique par état -->
        <div class="stat-card">
            <h3>🔄 Répartition par état</h3>
            <canvas id="etatChart"></canvas>
        </div>

        <!-- Graphique par marque -->
        <div class="stat-card">
            <h3>🏭 Répartition par marque</h3>
            <canvas id="marqueChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Graphique par état
    const etatCtx = document.getElementById('etatChart').getContext('2d');
    new Chart(etatCtx, {
        type: 'pie',
        data: {
            labels: {{ etatLabels|json_encode|raw }},
            datasets: [{
                data: {{ etatValues|json_encode|raw }},
                backgroundColor: ['#2d6a2d', '#6b8c6b', '#a8c4a0', '#d4a373', '#e9c46a'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });

    // Graphique par marque
    const marqueCtx = document.getElementById('marqueChart').getContext('2d');
    new Chart(marqueCtx, {
        type: 'bar',
        data: {
            labels: {{ marqueLabels|json_encode|raw }},
            datasets: [{
                label: 'Nombre de machines',
                data: {{ marqueValues|json_encode|raw }},
                backgroundColor: '#2d6a2d',
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            }
        }
    });
</script>
{% endblock %}