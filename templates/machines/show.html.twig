{# templates/machines/show.html.twig #}
{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}{{ machine.nom }} — AgroFlow{% endblock %}

{% block body %}
<style>
    :root {
        --green-dark:#2d5a1b; --green-mid:#3a7a22;
        --green-light:#f0f7eb; --green-border:#c8e6b0;
        --text-dark:#1a2e10; --text-mid:#4a6741; --text-light:#7a9b6a;
        --shadow:0 4px 16px rgba(45,90,27,.10);
    }
    * { box-sizing:border-box; }
    .show-wrap { max-width:900px; margin:0 auto; padding:1.5rem; }

    .flash { padding:.75rem 1.1rem; border-radius:10px; margin-bottom:1rem; font-weight:500; font-size:.92rem; }
    .flash-success { background:#e6f4e0; color:#1e5c0e; border:1px solid #b4dba0; }
    .flash-error   { background:#fdecea; color:#8b1a1a; border:1px solid #f3b8b0; }

    /* Breadcrumb */
    .breadcrumb { display:flex; align-items:center; gap:.5rem; font-size:.84rem; color:var(--text-light); margin-bottom:1.3rem; }
    .breadcrumb a { color:var(--green-dark); text-decoration:none; font-weight:600; }
    .breadcrumb a:hover { text-decoration:underline; }

    /* Card */
    .show-card { background:#fff; border-radius:18px; box-shadow:var(--shadow); overflow:hidden; }

    /* Card header */
    .show-header {
        background:var(--green-dark);
        padding:1.4rem 1.8rem 1.2rem;
        display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap;
    }
    .show-header-left h1 { margin:0 0 .3rem; font-size:1.6rem; font-weight:700; color:#fff; }
    .show-header-left p  { margin:0; font-size:.9rem; color:#b5d9a0; }
    .badge { padding:.3rem .9rem; border-radius:50px; font-size:.82rem; font-weight:700; }
    .badge-neuf     { background:#d4edda; color:#155724; }
    .badge-bon      { background:#cce5ff; color:#004085; }
    .badge-occasion { background:#fff3cd; color:#856404; }
    .badge-panne    { background:#f8d7da; color:#721c24; }

    /* Stats row */
    .stats-row { display:flex; border-bottom:1px solid #eef5e8; }
    .stat-box { flex:1; padding:1rem .5rem; text-align:center; border-right:1px solid #eef5e8; }
    .stat-box:last-child { border-right:none; }
    .stat-val { font-size:1.3rem; font-weight:700; color:var(--text-dark); }
    .stat-lbl { font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--text-light); margin-top:.2rem; }

    /* Alerts */
    .alert { margin:1rem 1.5rem 0; padding:.65rem 1rem; border-radius:9px; font-size:.85rem; font-weight:500; display:flex; gap:.6rem; align-items:flex-start; }
    .alert-overdue { background:#fdecea; color:#8b1a1a; border:1px solid #f3b8b0; }
    .alert-soon    { background:#fff8e6; color:#7a5700; border:1px solid #f0d88a; }
    .alert-warning { background:#fef4e4; color:#7a5700; border:1px solid #f0d88a; }

    /* Info grid */
    .info-section { padding:1.5rem 1.8rem; }
    .info-section-title { font-size:.78rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--green-dark); border-left:3px solid var(--green-dark); padding-left:.6rem; margin:0 0 1rem; }
    .info-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 2rem; }
    .info-item { display:flex; flex-direction:column; gap:.25rem; }
    .info-label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--text-light); }
    .info-value { font-size:1rem; color:var(--text-dark); font-weight:500; }
    .info-value.highlight { color:var(--green-dark); font-weight:700; }
    .divider { border:none; border-top:1px solid #eef5e8; margin:0 1.8rem; }

    /* Actions */
    .show-actions { padding:1.1rem 1.5rem; background:var(--green-light); border-top:1px solid var(--green-border); display:flex; gap:.7rem; flex-wrap:wrap; align-items:center; }
    .btn { display:inline-flex; align-items:center; gap:.4rem; padding:.6rem 1.3rem; border-radius:10px; font-weight:600; font-size:.88rem; text-decoration:none; cursor:pointer; border:none; font-family:inherit; transition:all .18s; }
    .btn-back   { background:transparent; color:var(--text-mid); border:1.5px solid var(--green-border); }
    .btn-back:hover { background:var(--green-light); }
    .btn-edit   { background:var(--green-dark); color:#fff; }
    .btn-edit:hover { background:#1f4012; transform:translateY(-1px); box-shadow:0 3px 10px rgba(45,90,27,.25); }
    .btn-delete { background:#fdf0f0; color:#c53030; border:1.5px solid #f5c6cb; }
    .btn-delete:hover { background:#fde0e0; }
    .form-inline { display:contents; }
</style>

<div class="show-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label == 'success' ? 'success' : 'error' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <nav class="breadcrumb">
        <a href="{{ path('agri_machines') }}">⚙️ Machines</a>
        <span>›</span>
        <span>{{ machine.nom }}</span>
    </nav>

    <div class="show-card">

        {# ── Header ── #}
        <div class="show-header">
            <div class="show-header-left">
                <h1>{{ machine.nom }}</h1>
                <p>📍 {{ machine.marque }} · {{ machine.modele }}{% if machine.numeroSerie %} · <code style="font-size:.8rem;opacity:.8;">{{ machine.numeroSerie }}</code>{% endif %}</p>
                <p style="margin-top:.3rem; font-size:.82rem; color:#8fcf70;">Propriétaire : {{ nomAgriculteur|default('—') }}</p>
            </div>
            {% if machine.etatM == 'Neuf' %}     {% set bc='badge-neuf' %}
            {% elseif machine.etatM == 'Bon' %}  {% set bc='badge-bon' %}
            {% elseif machine.etatM == 'Occasion' %} {% set bc='badge-occasion' %}
            {% else %} {% set bc='badge-panne' %} {% endif %}
            <span class="badge {{ bc }}">{{ machine.etatM }}</span>
        </div>

        {# ── Stats row ── #}
        <div class="stats-row">
            <div class="stat-box">
                <div class="stat-val">{{ machine.kilometrage|number_format(0,',',' ') }}</div>
                <div class="stat-lbl">KILOMÉTRAGE</div>
            </div>
            <div class="stat-box">
                <div class="stat-val">{{ machine.kmLastVisite|number_format(0,',',' ') }}</div>
                <div class="stat-lbl">KM DERNIÈRE VISITE</div>
            </div>
            <div class="stat-box">
                <div class="stat-val">{{ machine.dateAchat ? machine.dateAchat|date('Y') : '—' }}</div>
                <div class="stat-lbl">ANNÉE ACHAT</div>
            </div>
        </div>

        {# ── Alerts ── #}
        {% set today = date() %}
        {% if machine.prochaineMaintenance %}
            {% if machine.prochaineMaintenance < today %}
                <div class="alert alert-overdue">
                    🔴 <div><strong>Maintenance dépassée !</strong> Prévue le {{ machine.prochaineMaintenance|date('d/m/Y') }}. Planifiez une intervention immédiatement.</div>
                </div>
            {% elseif machine.prochaineMaintenance <= date('+30 days') %}
                <div class="alert alert-soon">
                    ⚠️ <div><strong>Maintenance proche.</strong> Prévue le {{ machine.prochaineMaintenance|date('d/m/Y') }}.</div>
                </div>
            {% endif %}
        {% endif %}
        {% if machine.kmLastVisite > machine.kilometrage %}
            <div class="alert alert-warning" style="margin-bottom:0;">
                ⚠️ <div><strong>Incohérence :</strong> le km de la dernière visite ({{ machine.kmLastVisite|number_format(0,',',' ') }} km) dépasse le kilométrage actuel.</div>
            </div>
        {% endif %}

        {# ── Infos générales ── #}
        <div class="info-section">
            <p class="info-section-title">📋 Informations générales</p>
            <div class="info-grid">
                <div class="info-item"><span class="info-label">Nom</span><span class="info-value">{{ machine.nom }}</span></div>
                <div class="info-item"><span class="info-label">Marque</span><span class="info-value">{{ machine.marque }}</span></div>
                <div class="info-item"><span class="info-label">Modèle</span><span class="info-value">{{ machine.modele }}</span></div>
                <div class="info-item"><span class="info-label">Numéro de série</span><span class="info-value">{{ machine.numeroSerie ?? '—' }}</span></div>
                <div class="info-item"><span class="info-label">Date d'achat</span><span class="info-value">{{ machine.dateAchat ? machine.dateAchat|date('d/m/Y') : '—' }}</span></div>
                <div class="info-item"><span class="info-label">État</span>
                    <span class="badge {{ bc }}" style="align-self:flex-start;margin-top:.1rem;">{{ machine.etatM }}</span>
                </div>
            </div>
        </div>

        <hr class="divider">

        {# ── Maintenance ── #}
        <div class="info-section">
            <p class="info-section-title">🔧 Maintenance & Kilométrage</p>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Kilométrage actuel</span>
                    <span class="info-value highlight">{{ machine.kilometrage|number_format(0,',',' ') }} km</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Date dernière visite</span>
                    <span class="info-value">{{ machine.dateLastVisite ? machine.dateLastVisite|date('d/m/Y') : '—' }}</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Km à la dernière visite</span>
                    <span class="info-value">{{ machine.kmLastVisite|number_format(0,',',' ') }} km</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Prochaine maintenance</span>
                    <span class="info-value">{{ machine.prochaineMaintenance ? machine.prochaineMaintenance|date('d/m/Y') : '—' }}</span>
                </div>
                {% if machine.kilometrage > machine.kmLastVisite %}
                <div class="info-item">
                    <span class="info-label">Km parcourus depuis visite</span>
                    <span class="info-value highlight">{{ (machine.kilometrage - machine.kmLastVisite)|number_format(0,',',' ') }} km</span>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── Actions ── #}
        <div class="show-actions">
            <a href="{{ path('agri_machines') }}" class="btn btn-back">← Retour</a>
            <a href="{{ path('agri_machine_edit', {id: machine.id}) }}" class="btn btn-edit">✏️ Modifier</a>
            <form method="post" action="{{ path('agri_machine_delete', {id: machine.id}) }}" class="form-inline"
                  onsubmit="return confirm('⚠️ Supprimer « {{ machine.nom }} » ?\nCette action est irréversible.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_machine_' ~ machine.id) }}">
                <button type="submit" class="btn btn-delete">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                    Supprimer
                </button>
            </form>
        </div>

    </div>
</div>
{% endblock %}
