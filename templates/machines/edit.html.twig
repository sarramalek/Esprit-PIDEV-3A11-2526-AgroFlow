{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}Modifier {{ machine.nom }} — AgroFlow{% endblock %}

{% block body %}
<div class="af-page">
    <div class="af-breadcrumb">
        <a href="{{ path('agri_machines') }}">Machines</a>
        <span class="af-breadcrumb__sep">›</span>
        <a href="{{ path('agri_machine_show', {id: machine.id}) }}">{{ machine.nom }}</a>
        <span class="af-breadcrumb__sep">›</span>
        <span>Modifier</span>
    </div>

    <div class="af-page-header">
        <h1 class="af-page-header__title">
            <span class="af-page-header__icon">✏️</span>
            Modifier la machine
        </h1>
        <p class="af-page-header__subtitle">Les champs marqués d'un <span class="required-star">*</span> sont obligatoires</p>
    </div>

    {% if form.vars.submitted and not form.vars.valid %}
    <div class="af-alert af-alert--error">
        <span class="af-alert__icon">⚠️</span>
        <span>Le formulaire contient des erreurs. Veuillez les corriger avant de continuer.</span>
    </div>
    {% endif %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="af-alert af-alert--{{ label == 'success' ? 'success' : 'error' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="af-card">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'af-form'}}) }}
        <div class="af-form-grid">
            <div class="form-group {% if form.nom.vars.errors|length > 0 %}has-error{% elseif form.nom.vars.submitted and form.nom.vars.value is not empty %}has-success{% endif %}">
                {{ form_label(form.nom) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">🚜</span>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex : John Deere 5075E'}}) }}
                    {% if form.nom.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% elseif form.nom.vars.submitted and form.nom.vars.value is not empty %}
                        <span class="input-status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.nom.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.nom.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">Ex : John Deere 5075E, Massey Ferguson 5713...</small>
                {% endif %}
            </div>

            <div class="form-group {% if form.marque.vars.errors|length > 0 %}has-error{% elseif form.marque.vars.submitted and form.marque.vars.value is not empty %}has-success{% endif %}">
                {{ form_label(form.marque) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">🏷️</span>
                    {{ form_widget(form.marque, {'attr': {'class': 'form-control', 'placeholder': 'Ex : John Deere'}}) }}
                    {% if form.marque.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% elseif form.marque.vars.submitted and form.marque.vars.value is not empty %}
                        <span class="input-status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.marque.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.marque.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">Ex : John Deere, Massey Ferguson, New Holland...</small>
                {% endif %}
            </div>

            <div class="form-group {% if form.modele.vars.errors|length > 0 %}has-error{% elseif form.modele.vars.submitted and form.modele.vars.value is not empty %}has-success{% endif %}">
                {{ form_label(form.modele) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">🔧</span>
                    {{ form_widget(form.modele, {'attr': {'class': 'form-control', 'placeholder': 'Ex : 5075E'}}) }}
                    {% if form.modele.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% elseif form.modele.vars.submitted and form.modele.vars.value is not empty %}
                        <span class="input-status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.modele.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.modele.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">Ex : 5075E, 5713, T7.210...</small>
                {% endif %}
            </div>

            <div class="form-group {% if form.numeroSerie.vars.errors|length > 0 %}has-error{% elseif form.numeroSerie.vars.submitted and form.numeroSerie.vars.value is not empty %}has-success{% endif %}">
                {{ form_label(form.numeroSerie) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">🔢</span>
                    {{ form_widget(form.numeroSerie, {'attr': {'class': 'form-control', 'style': 'text-transform: uppercase;', 'placeholder': 'Ex : 1M1234ABC'}}) }}
                    {% if form.numeroSerie.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% elseif form.numeroSerie.vars.submitted and form.numeroSerie.vars.value is not empty %}
                        <span class="input-status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.numeroSerie.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.numeroSerie.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">5 à 30 caractères — sans espaces (sera automatiquement mis en majuscules)</small>
                {% endif %}
            </div>

            <div class="form-group {% if form.etatM.vars.errors|length > 0 %}has-error{% endif %}">
                {{ form_label(form.etatM) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">📋</span>
                    {{ form_widget(form.etatM, {'attr': {'class': 'form-control'}}) }}
                    {% if form.etatM.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% endif %}
                </div>
                {% if form.etatM.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.etatM.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">Sélectionnez l'état actuel de la machine</small>
                {% endif %}
            </div>

            <div class="form-group {% if form.dateAchat.vars.errors|length > 0 %}has-error{% elseif form.dateAchat.vars.submitted and form.dateAchat.vars.value is not empty %}has-success{% endif %}">
                {{ form_label(form.dateAchat) }}<span class="required-star"> *</span>
                <div class="input-wrapper">
                    <span class="input-icon">📅</span>
                    {{ form_widget(form.dateAchat, {'attr': {'class': 'form-control', 'placeholder': 'JJ/MM/AAAA'}}) }}
                    {% if form.dateAchat.vars.errors|length > 0 %}
                        <span class="input-status-icon error">✖</span>
                    {% elseif form.dateAchat.vars.submitted and form.dateAchat.vars.value is not empty %}
                        <span class="input-status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.dateAchat.vars.errors|length > 0 %}
                    <ul class="field-errors">
                        {% for error in form.dateAchat.vars.errors %}
                            <li>⚠ {{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <small class="field-hint">Entre 1900 et aujourd'hui (format: JJ/MM/AAAA)</small>
                {% endif %}
            </div>
        </div>

        <div class="af-form-actions">
            <button type="submit" class="btn btn-primary">
                💾 Enregistrer les modifications
            </button>
            <a href="{{ path('agri_machines') }}" class="btn btn-ghost">
                ✖ Annuler
            </a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<style>
.required-star { color: #e74c3c; font-weight: 700; margin-left: 2px; }

.af-alert { 
    padding: 12px 18px; 
    border-radius: 8px; 
    margin-bottom: 1.4rem; 
    font-size: 0.93rem; 
    font-weight: 500; 
    display: flex;
    align-items: center;
    gap: 8px;
}
.af-alert--error { 
    background: #fff0f0; 
    border: 1.5px solid #f5c6c6; 
    color: #c0392b; 
}
.af-alert--success { 
    background: #d4edda; 
    border: 1.5px solid #c3e6cb; 
    color: #155724; 
}
.af-alert__icon { font-size: 1.1rem; }

.af-card { 
    background: #fff; 
    border: 1px solid #dce8d5; 
    border-radius: 12px; 
    padding: 2.2rem; 
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.af-form-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 0 2rem; 
}
@media (max-width: 640px) { 
    .af-form-grid { 
        grid-template-columns: 1fr; 
    } 
}

.form-group { 
    margin-bottom: 1.6rem; 
}
.form-group label { 
    display: inline-block; 
    margin-bottom: 7px; 
    font-weight: 600; 
    color: #5a7a5a; 
    font-size: 0.92rem; 
}

.input-wrapper { 
    position: relative; 
    display: flex; 
    align-items: center; 
}
.input-icon { 
    position: absolute; 
    left: 12px; 
    font-size: 1rem; 
    pointer-events: none; 
    z-index: 1; 
}
.input-status-icon { 
    position: absolute; 
    right: 12px; 
    font-size: 0.9rem; 
    pointer-events: none;
    z-index: 1;
}
.input-status-icon.error { 
    color: #e74c3c; 
}
.input-status-icon.success { 
    color: #2d6a2d; 
}

.form-control {
    width: 100%; 
    padding: 11px 38px 11px 38px; 
    border: 1.5px solid #dce8d5;
    border-radius: 8px; 
    font-size: 0.96rem; 
    box-sizing: border-box;
    background: #fafffe; 
    transition: all 0.2s ease;
}
.form-control:focus { 
    outline: none; 
    border-color: #2d6a2d; 
    box-shadow: 0 0 0 3px rgba(45,106,45,0.1); 
}

.has-error .form-control { 
    border-color: #e74c3c; 
    background: #fff8f8; 
}
.has-success .form-control { 
    border-color: #2d6a2d; 
    background: #f6fff6; 
}

.field-errors { 
    list-style: none; 
    margin: 6px 0 0 0; 
    padding: 0; 
}
.field-errors li { 
    color: #c0392b; 
    font-size: 0.83rem; 
    margin-top: 4px; 
}

.field-hint { 
    color: #8aaa8a; 
    font-size: 0.81rem; 
    margin-top: 5px; 
    display: block; 
}

.af-form-actions { 
    margin-top: 2rem; 
    display: flex; 
    gap: 12px; 
    padding-top: 1.4rem; 
    border-top: 1px solid #eef4ee; 
}

.btn { 
    padding: 0.7rem 1.5rem; 
    border-radius: 8px; 
    font-weight: 600; 
    text-decoration: none; 
    cursor: pointer; 
    border: none; 
    font-size: 0.95rem; 
    display: inline-flex; 
    align-items: center; 
    gap: 6px; 
    transition: all 0.2s ease;
}
.btn-primary { 
    background: #2d6a2d; 
    color: white; 
}
.btn-primary:hover { 
    background: #245524; 
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(45,106,45,0.2);
}
.btn-ghost { 
    background: transparent; 
    color: #5a7a5a; 
    border: 1.5px solid #dce8d5; 
}
.btn-ghost:hover { 
    background: #f0f7f0; 
    border-color: #2d6a2d;
}
</style>
{% endblock %}