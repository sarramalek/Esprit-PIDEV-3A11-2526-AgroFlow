{# templates/machines/index.html.twig #}
{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}Mes Machines — AgroFlow{% endblock %}

{% block body %}
<style>
    :root {
        --green-dark:  #2d5a1b;
        --green-mid:   #3a7a22;
        --green-light: #f0f7eb;
        --green-border:#c8e6b0;
        --text-dark:   #1a2e10;
        --text-mid:    #4a6741;
        --text-light:  #7a9b6a;
        --white:       #ffffff;
        --cream:       #f8fdf4;
        --shadow:      0 4px 16px rgba(45,90,27,0.10);
    }

    * { box-sizing: border-box; }

    .page-wrap { max-width: 1400px; margin: 0 auto; padding: 1.5rem; }

    .flash { padding: .75rem 1.1rem; border-radius: 10px; margin-bottom: 1rem; font-weight: 500; font-size: .92rem; }
    .flash-success { background: #e6f4e0; color: #1e5c0e; border: 1px solid #b4dba0; }
    .flash-error   { background: #fdecea; color: #8b1a1a; border: 1px solid #f3b8b0; }

    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem; }
    .page-header h1 { margin: 0; font-size: 1.8rem; font-weight: 700; color: var(--text-dark); }

    .btn { display: inline-flex; align-items: center; gap: .45rem; padding: .6rem 1.3rem; border-radius: 10px; font-weight: 600; font-size: .88rem; text-decoration: none; cursor: pointer; border: none; font-family: inherit; transition: all .18s; }
    .btn-primary   { background: var(--green-dark); color: #fff; }
    .btn-primary:hover { background: #1f4012; transform: translateY(-1px); box-shadow: 0 3px 10px rgba(45,90,27,.25); }
    .btn-secondary { background: var(--green-light); color: var(--green-dark); border: 1px solid var(--green-border); }
    .btn-secondary:hover { background: #dff0d3; }

    .filters-bar { background: var(--white); border-radius: 14px; box-shadow: var(--shadow); padding: 1.2rem 1.5rem; margin-bottom: 1.6rem; }
    .filters-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .8rem; margin-bottom: .8rem; }
    .f-group { display: flex; flex-direction: column; gap: .3rem; }
    .f-group label { font-size: .72rem; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: .5px; }
    .f-group input, .f-group select { padding: .65rem .85rem; border: 1.5px solid var(--green-border); border-radius: 9px; font-size: .88rem; background: var(--cream); outline: none; font-family: inherit; transition: border-color .18s; }
    .f-group input:focus, .f-group select:focus { border-color: var(--green-dark); }
    .filters-actions { display: flex; gap: .7rem; justify-content: flex-end; }

    .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 1.4rem; }

    .machine-card {
        background: var(--white);
        border-radius: 18px;
        box-shadow: var(--shadow);
        overflow: hidden;
        transition: transform .2s, box-shadow .2s;
        display: flex;
        flex-direction: column;
    }
    .machine-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(45,90,27,.15); }

    .card-header {
        background: var(--green-dark);
        padding: 1.1rem 1.3rem .95rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .5rem;
    }
    .card-header-left { flex: 1; min-width: 0; }
    .card-title    { margin: 0 0 .2rem 0; font-size: 1.08rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-subtitle { font-size: .82rem; color: #b5d9a0; display: flex; align-items: center; gap: .3rem; }

    .badge          { padding: .28rem .85rem; border-radius: 50px; font-size: .78rem; font-weight: 700; white-space: nowrap; }
    .badge-neuf     { background: #d4edda; color: #155724; }
    .badge-bon      { background: #cce5ff; color: #004085; }
    .badge-occasion { background: #fff3cd; color: #856404; }
    .badge-panne    { background: #f8d7da; color: #721c24; }

    .card-stats { display: flex; border-bottom: 1px solid #eef5e8; }
    .stat-item { flex: 1; padding: .85rem .5rem; text-align: center; border-right: 1px solid #eef5e8; }
    .stat-item:last-child { border-right: none; }
    .stat-value { font-size: 1.18rem; font-weight: 700; color: var(--text-dark); line-height: 1; }
    .stat-label { font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-light); margin-top: .2rem; }

    .maintenance-alert { margin: .6rem 1rem 0; padding: .5rem .75rem; border-radius: 8px; font-size: .78rem; font-weight: 500; }
    .alert-overdue { background: #fdecea; color: #8b1a1a; border: 1px solid #f3b8b0; }
    .alert-soon    { background: #fff8e6; color: #7a5700; border: 1px solid #f0d88a; }

    .card-actions { padding: .85rem 1rem; display: flex; gap: .5rem; align-items: center; margin-top: auto; }
    .action-btn {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .45rem .95rem; border-radius: 20px; font-size: .8rem; font-weight: 600;
        text-decoration: none; transition: all .16s; border: 1.5px solid transparent;
        cursor: pointer; white-space: nowrap; background: none; font-family: inherit;
    }
    .btn-view { background: #f0f7eb; color: var(--green-dark); border-color: var(--green-border); }
    .btn-view:hover { background: #dff0d3; }
    .btn-edit { background: #fff8ee; color: #b96b00; border-color: #ffd9a0; }
    .btn-edit:hover { background: #ffecd1; border-color: #f0bb70; }
    .btn-delete { background: #fdf0f0; color: #c53030; border-color: #f5c6cb; padding: .45rem .6rem; }
    .btn-delete:hover { background: #fde0e0; }
    .form-inline { display: contents; }

    .empty-state { text-align: center; padding: 4rem 2rem; color: var(--text-light); font-size: 1rem; line-height: 2; }
    .result-count { text-align: center; color: var(--text-light); font-size: .82rem; margin-top: 1.2rem; }

    /* Styles pour la pagination */
    .pagination-container {
        margin-top: 2rem;
        display: flex;
        justify-content: center;
    }
    .pagination-buttons {
        display: flex;
        gap: .6rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
    }
    .pagination-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.55rem 0.9rem;
        border-radius: 10px;
        font-weight: bold;
        border: none;
        min-width: 42px;
        font-size: .9rem;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }
    .pagination-btn-active {
        background: var(--green-dark);
        color: white;
        box-shadow: 0 2px 8px rgba(45,90,27,0.3);
    }
    .pagination-btn-neutral {
        background: #f2f7ee;
        color: var(--green-dark);
        border: 1px solid var(--green-border);
    }
    .pagination-btn-neutral:hover {
        background: #e6f2dc;
    }
    .pagination-btn-active:hover {
        background: #1f4012;
        transform: translateY(-2px);
    }
    .pagination-btn-inactive {
        background: #ffffff;
        color: var(--green-dark);
        border: 1px solid var(--green-border);
        cursor: not-allowed;
        opacity: 0.65;
        pointer-events: none;
    }
    .pagination-ellipsis {
        color: var(--text-light);
        font-weight: 700;
        padding: 0 .15rem;
    }
    .pagination-container .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        flex-wrap: wrap;
    }
    .pagination-container .pagination span,
    .pagination-container .pagination a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 .75rem;
        border-radius: 10px;
        border: 1px solid var(--green-border);
        text-decoration: none;
        font-weight: 700;
        font-size: .9rem;
    }
    .pagination-container .pagination a {
        color: var(--green-dark);
        background: #f2f7ee;
    }
    .pagination-container .pagination a:hover {
        background: #e6f2dc;
    }
    .pagination-container .pagination .current {
        background: var(--green-dark);
        color: #fff;
        border-color: var(--green-dark);
    }
    .pagination-container .pagination .disabled {
        background: #e0e0e0;
        color: #999;
        border-color: #d0d0d0;
    }
    .af-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: .45rem;
        flex-wrap: wrap;
    }
    .af-page {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 .75rem;
        border-radius: 10px;
        border: 1px solid var(--green-border);
        background: #f2f7ee;
        color: var(--green-dark);
        text-decoration: none;
        font-weight: 700;
        font-size: .9rem;
    }
    .af-page:hover { background: #e6f2dc; }
    .af-current {
        background: var(--green-dark);
        color: #fff;
        border-color: var(--green-dark);
    }
    .af-disabled {
        background: #e0e0e0;
        color: #999;
        border-color: #d0d0d0;
    }
    .pagination-status {
        text-align: center;
        margin-top: 1rem;
        color: var(--text-light);
        font-size: 0.85rem;
        display: flex;
        justify-content: center;
        gap: 2rem;
    }
    .status-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .status-dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }
    .status-dot-active {
        background: var(--green-dark);
    }
    .status-dot-inactive {
        background: #e0e0e0;
    }
</style>

<div class="page-wrap">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label == 'success' ? 'success' : 'error' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="page-header">
        <h1>⚙️ Mes Machines</h1>
        <div style="display:flex;gap:.7rem;">
            <a href="{{ path('agri_machine_new') }}" class="btn btn-primary">➕ Ajouter</a>
            <a href="{{ path('agri_machine_statistiques') }}" class="btn btn-secondary">📊 Statistiques</a>
        </div>
    </div>

    {# ── Barre de filtres ── #}
    <div class="filters-bar">
        <div class="filters-grid">
            <div class="f-group">
                <label>🔍 Recherche</label>
                <input type="text" id="filter-search" placeholder="Nom, marque, modèle..."
                       value="{{ app.request.query.get('search','') }}">
            </div>
            <div class="f-group">
                <label>📊 État</label>
                <select id="filter-etat">
                    <option value="">Tous les états</option>
                    {% for opt in ['Neuf','Bon','Occasion','En panne'] %}
                        <option value="{{ opt }}" {{ app.request.query.get('etat','') == opt ? 'selected' : '' }}>{{ opt }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="f-group">
                <label>📋 Trier par</label>
                <select id="filter-sortBy">
                    <option value="dateAchat"   {{ app.request.query.get('sortBy','dateAchat') == 'dateAchat'   ? 'selected':'' }}>📅 Date d'achat</option>
                    <option value="marque"      {{ app.request.query.get('sortBy','dateAchat') == 'marque'      ? 'selected':'' }}>🏭 Marque</option>
                    <option value="kilometrage" {{ app.request.query.get('sortBy','dateAchat') == 'kilometrage' ? 'selected':'' }}>📊 Kilométrage</option>
                </select>
            </div>
            <div class="f-group">
                <label>⬆⬇ Ordre</label>
                <select id="filter-sortDir">
                    <option value="DESC" {{ app.request.query.get('sortDir','DESC') == 'DESC' ? 'selected':'' }}>↓ Décroissant</option>
                    <option value="ASC"  {{ app.request.query.get('sortDir','DESC') == 'ASC'  ? 'selected':'' }}>↑ Croissant</option>
                </select>
            </div>
        </div>
        <div class="filters-actions">
            <button type="button" class="btn btn-primary"   onclick="submitFilters()">🔎 Filtrer</button>
            <button type="button" class="btn btn-secondary" onclick="resetFilters()">⟳ Réinitialiser</button>
        </div>
    </div>

    {% set machinesList = machinesPagination is defined ? machinesPagination : machines %}

    {# ── Grille de cartes ── #}
    {% if machinesList|length == 0 %}
        <div class="empty-state">
            🤷 Aucune machine trouvée.<br>
            <a href="{{ path('agri_machine_new') }}" style="color:var(--green-dark);display:inline-block;margin-top:.5rem;">➕ Ajouter votre première machine</a>
        </div>
    {% else %}
        <div class="cards-grid">
            {% for machine in machinesList %}

                {% if machine.etatM == 'Neuf' %}         {% set bc = 'badge-neuf' %}
                {% elseif machine.etatM == 'Bon' %}      {% set bc = 'badge-bon' %}
                {% elseif machine.etatM == 'Occasion' %} {% set bc = 'badge-occasion' %}
                {% else %}                                {% set bc = 'badge-panne' %}
                {% endif %}

                {% set today = date() %}
                {% set alertClass = '' %}
                {% set alertMsg   = '' %}
                {% if machine.prochaineMaintenance %}
                    {% if machine.prochaineMaintenance < today %}
                        {% set alertClass = 'alert-overdue' %}
                        {% set alertMsg   = '🔴 Maintenance dépassée !' %}
                    {% elseif machine.prochaineMaintenance <= date('+30 days') %}
                        {% set alertClass = 'alert-soon' %}
                        {% set alertMsg   = '⚠️ Maintenance le ' ~ machine.prochaineMaintenance|date('d/m/Y') %}
                    {% endif %}
                {% endif %}

                <div class="machine-card">
                    <div class="card-header">
                        <div class="card-header-left">
                            <div class="card-title">{{ machine.nom }}</div>
                            <div class="card-subtitle">📍 {{ machine.marque }} · {{ machine.modele }}</div>
                        </div>
                        <span class="badge {{ bc }}">{{ machine.etatM }}</span>
                    </div>

                    {% if alertClass %}
                        <div class="maintenance-alert {{ alertClass }}">{{ alertMsg }}</div>
                    {% endif %}

                    <div class="card-stats">
                        <div class="stat-item">
                            <div class="stat-value">{{ machine.kilometrage|number_format(0,',',' ') }}</div>
                            <div class="stat-label">KM</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">{{ machine.dateAchat ? machine.dateAchat|date('Y') : '—' }}</div>
                            <div class="stat-label">ACHAT</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">{{ machine.prochaineMaintenance ? machine.prochaineMaintenance|date('m/Y') : '—' }}</div>
                            <div class="stat-label">MAINTENANCE</div>
                        </div>
                    </div>

                    <div class="card-actions">
                        <a href="{{ path('agri_machine_show', {id: machine.id}) }}" class="action-btn btn-view">👁 Voir</a>
                        <a href="{{ path('agri_machine_edit', {id: machine.id}) }}" class="action-btn btn-edit">✏️ Modifier</a>
                        <div style="margin-left:auto;">
                            <form method="post" action="{{ path('agri_machine_delete', {id: machine.id}) }}" class="form-inline"
                                  onsubmit="return confirm('⚠️ Supprimer « {{ machine.nom }} » ?\nCette action est irréversible.');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_machine_' ~ machine.id) }}">
                                <button type="submit" class="action-btn btn-delete" title="Supprimer">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6l-1 14H6L5 6"/>
                                        <path d="M10 11v6M14 11v6"/>
                                        <path d="M9 6V4h6v2"/>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

            {% endfor %}
        </div>

        {% if machinesPagination is defined and machinesPagination.pageCount > 1 %}
            <div class="pagination-container">
                <div class="pagination-buttons">
                    {% set currentPage = machinesPagination.getCurrentPageNumber %}
                    {% set prevPage = currentPage > 1 ? currentPage - 1 : 1 %}
                    {% set nextPage = currentPage < machinesPagination.pageCount ? currentPage + 1 : machinesPagination.pageCount %}
                    <a
                        href="{{ path('agri_machines', app.request.query.all|merge({page: nextPage})) }}"
                        class="pagination-btn {{ currentPage < machinesPagination.pageCount ? 'pagination-btn-active' : 'pagination-btn-inactive' }}"
                    >1</a>
                    <a
                        href="{{ path('agri_machines', app.request.query.all|merge({page: prevPage})) }}"
                        class="pagination-btn {{ currentPage > 1 ? 'pagination-btn-active' : 'pagination-btn-inactive' }}"
                    >0</a>
                </div>
            </div>
        {% endif %}

        {# ── Compteur ── #}
        <div class="result-count">
            📊 {{ machinesPagination is defined ? machinesPagination.getTotalItemCount : machinesList|length }} machine(s) trouvée(s)
        </div>

    {% endif %}

</div>

<script>
function submitFilters() {
    const params = new URLSearchParams({
        search:  document.getElementById('filter-search').value,
        etat:    document.getElementById('filter-etat').value,
        sortBy:  document.getElementById('filter-sortBy').value,
        sortDir: document.getElementById('filter-sortDir').value,
    });
    window.location.href = '{{ path('agri_machines') }}?' + params.toString();
}

function resetFilters() {
    window.location.href = '{{ path('agri_machines') }}';
}

document.getElementById('filter-search').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') submitFilters();
});
</script>
{% endblock %}