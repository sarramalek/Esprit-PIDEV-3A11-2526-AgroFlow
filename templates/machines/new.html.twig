{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}Nouvelle machine — AgroFlow{% endblock %}

{% block body %}
<div class="af-page">
    <div class="af-breadcrumb">
        <a href="{{ path('agri_machines') }}">Machines</a>
        <span class="af-breadcrumb__sep">›</span>
        <span>Nouvelle machine</span>
    </div>

    <div class="af-page-header">
        <h1 class="af-page-header__title">➕ Nouvelle machine</h1>
        <p class="af-page-header__subtitle">
            Les champs marqués d'un <span class="req">*</span> sont obligatoires
        </p>
    </div>

    {% if not form.vars.valid and form.vars.submitted %}
        <div class="af-alert af-alert--error">
            ⚠️ Le formulaire contient des erreurs. Veuillez les corriger avant de continuer.
        </div>
    {% endif %}

    <div class="af-card">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        <div class="af-grid">
            
            <!-- Champ Nom de la machine (corrigé) -->
            <div class="form-group {{ form.nom.vars.errors|length > 0 ? 'is-invalid' : (form.nom.vars.value is not empty ? 'is-valid' : '') }}">
                {{ form_label(form.nom, 'Nom de la machine') }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.nom, {'attr': {'placeholder': 'Ex : John Deere 5075E'}}) }}
                    <span class="input-icon-left">🚜</span>
                    {% if form.nom.vars.errors|length > 0 %}
                        <span class="status-icon error">✖</span>
                    {% elseif form.nom.vars.value is not empty %}
                        <span class="status-icon success">✔</span>
                    {% endif %}
                </div>
                {% if form.nom.vars.errors|length > 0 %}
                    <ul class="error-list">
                        {% for e in form.nom.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}
                    </ul>
                {% else %}
                    <small class="hint">Ex : John Deere 5075E, Massey Ferguson 5713, Fendt 724 Vario</small>
                {% endif %}
            </div>

            <!-- Les autres champs restent inchangés -->
            <div class="form-group {{ form.marque.vars.errors|length > 0 ? 'is-invalid' : (form.marque.vars.value is not empty ? 'is-valid' : '') }}">
                {{ form_label(form.marque) }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.marque) }}
                    <span class="input-icon-left">🏷️</span>
                    {% if form.marque.vars.errors|length > 0 %}<span class="status-icon error">✖</span>
                    {% elseif form.marque.vars.value is not empty %}<span class="status-icon success">✔</span>{% endif %}
                </div>
                {% if form.marque.vars.errors|length > 0 %}
                    <ul class="error-list">{% for e in form.marque.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}</ul>
                {% else %}<small class="hint">Lettres uniquement — Ex : Massey Ferguson</small>{% endif %}
            </div>

            <div class="form-group {{ form.modele.vars.errors|length > 0 ? 'is-invalid' : (form.modele.vars.value is not empty ? 'is-valid' : '') }}">
                {{ form_label(form.modele) }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.modele) }}
                    <span class="input-icon-left">🔧</span>
                    {% if form.modele.vars.errors|length > 0 %}<span class="status-icon error">✖</span>
                    {% elseif form.modele.vars.value is not empty %}<span class="status-icon success">✔</span>{% endif %}
                </div>
                {% if form.modele.vars.errors|length > 0 %}
                    <ul class="error-list">{% for e in form.modele.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}</ul>
                {% else %}<small class="hint">Ex : 5075E, 5713</small>{% endif %}
            </div>

            <div class="form-group {{ form.numeroSerie.vars.errors|length > 0 ? 'is-invalid' : (form.numeroSerie.vars.value is not empty ? 'is-valid' : '') }}">
                {{ form_label(form.numeroSerie) }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.numeroSerie, {'attr': {'style': 'text-transform:uppercase;'}}) }}
                    <span class="input-icon-left">🔢</span>
                    {% if form.numeroSerie.vars.errors|length > 0 %}<span class="status-icon error">✖</span>
                    {% elseif form.numeroSerie.vars.value is not empty %}<span class="status-icon success">✔</span>{% endif %}
                </div>
                {% if form.numeroSerie.vars.errors|length > 0 %}
                    <ul class="error-list">{% for e in form.numeroSerie.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}</ul>
                {% else %}<small class="hint">5 à 30 caractères — sans espaces</small>{% endif %}
            </div>

            <div class="form-group {{ form.etatM.vars.errors|length > 0 ? 'is-invalid' : '' }}">
                {{ form_label(form.etatM) }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.etatM) }}
                    <span class="input-icon-left">📋</span>
                    {% if form.etatM.vars.errors|length > 0 %}<span class="status-icon error">✖</span>{% endif %}
                </div>
                {% if form.etatM.vars.errors|length > 0 %}
                    <ul class="error-list">{% for e in form.etatM.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}</ul>
                {% else %}<small class="hint">État actuel de la machine</small>{% endif %}
            </div>

            <div class="form-group {{ form.dateAchat.vars.errors|length > 0 ? 'is-invalid' : (form.dateAchat.vars.value is not empty ? 'is-valid' : '') }}">
                {{ form_label(form.dateAchat) }}<span class="req"> *</span>
                <div class="input-wrap">
                    {{ form_widget(form.dateAchat) }}
                    <span class="input-icon-left">📅</span>
                    {% if form.dateAchat.vars.errors|length > 0 %}<span class="status-icon error">✖</span>
                    {% elseif form.dateAchat.vars.value is not empty %}<span class="status-icon success">✔</span>{% endif %}
                </div>
                {% if form.dateAchat.vars.errors|length > 0 %}
                    <ul class="error-list">{% for e in form.dateAchat.vars.errors %}<li>⚠ {{ e.message }}</li>{% endfor %}</ul>
                {% else %}<small class="hint">Entre 1900 et aujourd'hui</small>{% endif %}
            </div>

        </div>

        <div class="af-actions">
            <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
            <a href="{{ path('agri_machines') }}" class="btn btn-ghost">✖ Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
.req { color: #e74c3c; font-weight: 700; }
.af-alert { padding: 12px 18px; border-radius: 8px; margin-bottom: 1.2rem; font-size: 0.93rem; font-weight: 500; }
.af-alert--error { background: #fff0f0; border: 1.5px solid #f5c6c6; color: #c0392b; }
.af-card { background: #fff; border: 1px solid #dce8d5; border-radius: 12px; padding: 2.2rem; }
.af-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; }
@media (max-width: 640px) { .af-grid { grid-template-columns: 1fr; } }
.form-group { margin-bottom: 1.6rem; }
.form-group label { display: inline-block; margin-bottom: 7px; font-weight: 600; color: #5a7a5a; font-size: 0.92rem; }
.input-wrap { position: relative; }
.input-icon-left { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); font-size: 0.95rem; pointer-events: none; }
.status-icon { position: absolute; right: 11px; top: 50%; transform: translateY(-50%); font-size: 0.85rem; }
.status-icon.error { color: #e74c3c; }
.status-icon.success { color: #2d6a2d; }
.input-wrap input, .input-wrap select {
    width: 100%; padding: 11px 36px; border: 1.5px solid #dce8d5;
    border-radius: 8px; font-size: 0.96rem; box-sizing: border-box;
    background: #fafffe; transition: border-color 0.2s, box-shadow 0.2s;
}
.input-wrap input:focus, .input-wrap select:focus { outline: none; border-color: #2d6a2d; box-shadow: 0 0 0 3px rgba(45,106,45,0.1); }
.is-invalid .input-wrap input, .is-invalid .input-wrap select { border-color: #e74c3c; background: #fff8f8; }
.is-valid .input-wrap input, .is-valid .input-wrap select { border-color: #2d6a2d; background: #f6fff6; }
.error-list { list-style: none; margin: 5px 0 0; padding: 0; }
.error-list li { color: #c0392b; font-size: 0.83rem; margin-top: 3px; }
.hint { display: block; margin-top: 5px; color: #8aaa8a; font-size: 0.81rem; }
.af-actions { display: flex; gap: 12px; margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid #eef4ee; }
.btn { padding: 0.7rem 1.5rem; border-radius: 8px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px; transition: opacity 0.2s; }
.btn:hover { opacity: 0.85; }
.btn-primary { background: #2d6a2d; color: white; }
.btn-ghost { background: transparent; color: #5a7a5a; border: 1.5px solid #dce8d5; }
.btn-ghost:hover { background: #f0f7f0; }
.af-page-header__title { margin: 0 0 0.3rem 0; font-size: 1.85rem; color: #1a2e1a; }
.af-page-header__subtitle { margin: 0 0 1.5rem 0; color: #7a9a7a; font-size: 0.88rem; }
</style>
{% endblock %}