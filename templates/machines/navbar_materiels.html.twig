{# templates/includes/navbar_materiels.html.twig #}
<!-- Gestion Matériels -->
<div class="nav-item {% if app.request.get('_route') starts with 'agri_machine_' %}open{% endif %}">
    <div class="nav-link {% if app.request.get('_route') starts with 'agri_machine_' %}active{% endif %}"
         onclick="toggleMenu(this)">
        <span class="nav-icon"><i class="fa fa-tractor"></i></span>
        <span class="nav-label">Gestion Matériels</span>
        <i class="fa fa-chevron-right nav-arrow"></i>
    </div>
    <ul class="nav-sub">
        <li>
            <a href="{{ path('agri_machines') }}"
               class="{% if app.request.get('_route') == 'agri_machines' or app.request.get('_route') starts with 'agri_machine_' %}active{% endif %}">
                <span class="sub-dot"></span> Machines
            </a>
        </li>
        <li>
            <a href="{{ path('agri_maintenances') }}"
               class="{% if app.request.get('_route') starts with 'agri_maintenance_' %}active{% endif %}">
                <span class="sub-dot"></span> Maintenances
            </a>
        </li>
    </ul>
</div>