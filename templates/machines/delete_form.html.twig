{# templates/machines/_delete_form.html.twig
   Partial réutilisable — inclure avec : {{ include('machines/_delete_form.html.twig') }}
   Requiert la variable `machine` dans le contexte. #}
<form method="post"
      action="{{ path('agri_machine_delete', {id: machine.id}) }}"
      style="display:inline;"
      onsubmit="return confirm('⚠️ Supprimer définitivement « {{ machine.nom }} » ?\nCette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_machine_' ~ machine.id) }}">
    <button type="submit" style="
        display:inline-flex; align-items:center; gap:.35rem;
        padding:.45rem .75rem;
        background:#fdf0f0; color:#c53030; border:1.5px solid #f5c6cb;
        border-radius:50px; font-size:.8rem; font-weight:600;
        cursor:pointer; font-family:inherit; transition:all .16s;
    "
    onmouseover="this.style.background='#fde0e0'"
    onmouseout="this.style.background='#fdf0f0'">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v6M14 11v6"/>
            <path d="M9 6V4h6v2"/>
        </svg>
    </button>
</form>
