{# templates/machines/export_pdf.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Machines - AgroFlow</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            color: #333;
            line-height: 1.4;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #2d5a1b;
        }
        .header h1 {
            color: #2d5a1b;
            margin: 0;
            font-size: 26px;
        }
        .header p {
            margin: 8px 0;
            color: #666;
            font-size: 12px;
        }
        .filters-info {
            background: #f5f5f5;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 5px;
            font-size: 11px;
            border-left: 3px solid #2d5a1b;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 12px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
            vertical-align: top;
        }
        th {
            background-color: #2d5a1b;
            color: white;
            font-weight: bold;
            font-size: 13px;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .machine-title {
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 5px;
            color: #2d5a1b;
        }
        .machine-detail {
            font-size: 11px;
            color: #666;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            font-size: 10px;
            color: #666;
        }
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
        }
        .badge-neuf { background: #d4edda; color: #155724; }
        .badge-bon { background: #cce5ff; color: #004085; }
        .badge-occasion { background: #fff3cd; color: #856404; }
        .badge-panne { background: #f8d7da; color: #721c24; }
        .maintenance-alert {
            font-size: 10px;
            color: #dc3545;
            margin-top: 5px;
            font-weight: bold;
        }
        .maintenance-warning {
            font-size: 10px;
            color: #856404;
            margin-top: 5px;
        }
        .page-number {
            font-size: 10px;
            color: #999;
            text-align: center;
            margin-top: 20px;
        }
        .summary-box {
            background: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
            margin-top: 20px;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🌾 AgroFlow - Liste des Machines Agricoles</h1>
        <p>Généré le {{ date|date('d/m/Y à H:i:s') }}</p>
        <p><strong>Utilisateur:</strong> {{ user.nom }} {{ user.prenom }} | <strong>CIN:</strong> {{ user.cin }} | <strong>Email:</strong> {{ user.email }}</p>
    </div>
    
    {% if filters.search or filters.etat %}
    <div class="filters-info">
        <strong>🔍 Filtres appliqués:</strong><br>
        {% if filters.search %}📝 Recherche: <strong>{{ filters.search }}</strong><br>{% endif %}
        {% if filters.etat %}🏷️ État: <strong>{{ filters.etat }}</strong>{% endif %}
    </div>
    {% endif %}
    
    <table>
        <thead>
            <tr>
                <th>🚜 Machine</th>
                <th>📊 Caractéristiques</th>
                <th>🏷️ État</th>
                <th>🔧 Maintenance</th>
            </tr>
        </thead>
        <tbody>
            {% for machine in machines %}
                <tr>
                    <td style="width: 25%;">
                        <div class="machine-title">{{ machine.nom }}</div>
                        <div class="machine-detail">{{ machine.marque }} {{ machine.modele }}</div>
                        {% if machine.numeroSerie is defined and machine.numeroSerie %}
                            <div class="machine-detail">🔢 Série: {{ machine.numeroSerie }}</div>
                        {% endif %}
                    </td>
                    <td style="width: 30%;">
                        📅 Achat: {{ machine.dateAchat ? machine.dateAchat|date('d/m/Y') : 'Non renseigné' }}<br>
                        📊 Kilométrage: {{ machine.kilometrage|number_format(0,',',' ') }} km<br>
                        {% if machine.dateAchat %}
                            {% set age = date().diff(machine.dateAchat).y %}
                            📆 Âge: {{ age }} an(s)
                        {% endif %}
                    </td>
                    <td style="width: 20%;">
                        <span class="badge 
                            {% if machine.etatM == 'Neuf' %}badge-neuf
                            {% elseif machine.etatM == 'Bon' %}badge-bon
                            {% elseif machine.etatM == 'Occasion' %}badge-occasion
                            {% else %}badge-panne{% endif %}">
                            {{ machine.etatM }}
                        </span>
                    </td>
                    <td style="width: 25%;">
                        {% if machine.prochaineMaintenance %}
                            📅 Prochaine: {{ machine.prochaineMaintenance|date('d/m/Y') }}<br>
                            {% set today = date() %}
                            {% set diff = machine.prochaineMaintenance.diff(today).days %}
                            {% if machine.prochaineMaintenance < today %}
                                <div class="maintenance-alert">⚠️ MAINTENANCE DÉPASSÉE ({{ diff }} jours)</div>
                            {% elseif machine.prochaineMaintenance <= date('+30 days') %}
                                <div class="maintenance-warning">⚠️ Dans moins de {{ diff }} jours</div>
                            {% else %}
                                <div class="maintenance-warning">📆 Dans {{ diff }} jours</div>
                            {% endif %}
                        {% else %}
                            <span style="color: #999;">Non planifiée</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div class="summary-box">
        <strong>📊 RÉCAPITULATIF DU PARC MACHINE</strong><br>
        <table style="width: 100%; margin-top: 10px; border: none;">
            <tr style="background: none;">
                <td style="border: none; padding: 5px;">📋 Total machines:</td>
                <td style="border: none; padding: 5px;"><strong>{{ machines|length }}</strong></td>
                <td style="border: none; padding: 5px;">✅ En bon état:</td>
                <td style="border: none; padding: 5px;">
                    <strong>
                        {% set bonEtat = 0 %}
                        {% for machine in machines %}
                            {% if machine.etatM == 'Neuf' or machine.etatM == 'Bon' %}
                                {% set bonEtat = bonEtat + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ bonEtat }}
                    </strong>
                </td>
            </tr>
            <tr style="background: none;">
                <td style="border: none; padding: 5px;">📊 Kilométrage total:</td>
                <td style="border: none; padding: 5px;">
                    <strong>
                        {% set totalKm = 0 %}
                        {% for machine in machines %}
                            {% set totalKm = totalKm + (machine.kilometrage|default(0)) %}
                        {% endfor %}
                        {{ totalKm|number_format(0,',',' ') }} km
                    </strong>
                </td>
                <td style="border: none; padding: 5px;">🔧 En maintenance:</td>
                <td style="border: none; padding: 5px;">
                    <strong>
                        {% set maintenanceCount = 0 %}
                        {% for machine in machines %}
                            {% if machine.prochaineMaintenance and machine.prochaineMaintenance <= date('+30 days') %}
                                {% set maintenanceCount = maintenanceCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ maintenanceCount }}
                    </strong>
                </td>
            </tr>
            <tr style="background: none;">
                <td style="border: none; padding: 5px;">🚨 En panne:</td>
                <td style="border: none; padding: 5px;">
                    <strong style="color: #dc3545;">
                        {% set panneCount = 0 %}
                        {% for machine in machines %}
                            {% if machine.etatM == 'En panne' %}
                                {% set panneCount = panneCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ panneCount }}
                    </strong>
                </td>
                <td style="border: none; padding: 5px;">⏰ Maintenance dépassée:</td>
                <td style="border: none; padding: 5px;">
                    <strong style="color: #dc3545;">
                        {% set overdueCount = 0 %}
                        {% for machine in machines %}
                            {% if machine.prochaineMaintenance and machine.prochaineMaintenance < date() %}
                                {% set overdueCount = overdueCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        {{ overdueCount }}
                    </strong>
                </td>
            </tr>
        </table>
    </div>
    
    <div class="footer">
        <p>📄 Document généré automatiquement par AgroFlow - Gestion de parc machine</p>
        <p>© {{ date|date('Y') }} AgroFlow - Tous droits réservés</p>
        <p class="page-number">Page 1/1</p>
    </div>
</body>
</html>