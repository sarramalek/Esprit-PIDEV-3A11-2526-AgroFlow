    </a>

    <nav class="navmenu">
        <div class="nav-item">
            <a href="{{ path('ouvrier_home') }}"
               class="nav-link {% if app.request.get('_route') == 'ouvrier_home' %}active{% endif %}">
                <i class="fa fa-house"></i> Accueil
