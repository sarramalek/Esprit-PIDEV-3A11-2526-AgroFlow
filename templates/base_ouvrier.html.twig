                <i class="fa fa-calendar-days"></i> Participations
            </a>
        </div>
        <div class="nav-item">
    
</div>
    </nav>

    <div class="header-actions">
        {% if app.user %}
        <div id="profileMenu">

            <div onclick="toggleProfilePanel()"
                 style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:6px 12px;border-radius:10px;transition:background 0.2s;"
                 onmouseover="this.style.background='#f5faf4'"
                 onmouseout="this.style.background='transparent'">

                {# ── Avatar small navbar ── #}
                <div style="position:relative;width:34px;height:34px;flex-shrink:0;">
                    <img id="ouvPhotoSmall"
                         style="display:none;width:34px;height:34px;border-radius:9px;object-fit:cover;"
                         data-cloudinary-src="{{ app.user.img is defined ? app.user.img : '' }}"
                         data-w="34" data-h="34"
                         data-fallback-id="ouvAvatarSmall"
                         src="" alt="Photo de profil">
                    <div class="user-avatar-sm" id="ouvAvatarSmall">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                </div>

                <div style="line-height:1.3;">
                    <div id="ouvNameSmall" style="font-size:13px;font-weight:600;color:#2C3E50;">
                        {{ app.user.prenom }} {{ app.user.nom }}
                    </div>
                    <div style="font-size:11px;color:#aaa;">Ouvrier</div>
                </div>
                <i class="fa fa-chevron-down" id="profileChevron"
                   style="font-size:9px;color:#aaa;transition:transform 0.25s;"></i>
            </div>

            <div id="profilePanel">

                {# En-tête avatar #}
                <div style="padding:18px 16px 14px;text-align:center;border-bottom:1px solid #f0f0f0;background:#fafdf8;">

                    {# ── Avatar big panel ── #}
                    <div style="position:relative;width:52px;height:52px;margin:0 auto 10px;">
                        <img id="ouvPhotoBig"
                             style="display:none;width:52px;height:52px;border-radius:14px;object-fit:cover;"
                             data-cloudinary-src="{{ app.user.img is defined ? app.user.img : '' }}"
                             data-w="52" data-h="52"
                             data-fallback-id="ouvAvatarBig"
                             src="" alt="Photo de profil">
                        <div id="ouvAvatarBig"
                             style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#4A8C3F,#2D5A27);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:white;">
                            {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                        </div>
                    </div>

                    <div id="ouvNameBig" style="font-size:14px;font-weight:700;color:#2C3E50;">
                        {{ app.user.prenom }} {{ app.user.nom }}
                    </div>
                    <div style="display:inline-flex;align-items:center;gap:5px;background:#EAF3DE;border:1px solid #c8e6c0;color:#2D5A27;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;margin-top:6px;">
                        <span style="width:5px;height:5px;border-radius:50%;background:#6FE065;display:inline-block;"></span>
                        Ouvrier
                    </div>
                </div>

                {# Barre d'outils édition #}
                <div style="display:flex;justify-content:flex-end;padding:8px 12px 4px;gap:6px;border-bottom:1px solid #f5f5f5;">
                    <button class="ouv-pf-btn" id="ouvBtnEdit" onclick="ouvStartEdit()">
                        <i class="fa fa-pen" style="font-size:10px;"></i> Modifier
                    </button>
                    <button class="ouv-pf-btn save" id="ouvBtnSave" onclick="ouvSubmitEdit()" style="display:none;">
                        <i class="fa fa-check" style="font-size:10px;"></i> Enregistrer
                    </button>
                    <button class="ouv-pf-btn cancel" id="ouvBtnCancel" onclick="ouvCancelEdit()" style="display:none;">
                        <i class="fa fa-times" style="font-size:10px;"></i> Annuler
                    </button>
                </div>

                {# Bouton upload photo (visible uniquement en édition) #}
                <label class="ouv-photo-upload" id="ouvPhotoUploadLabel">
                    <i class="fa fa-camera" style="font-size:12px;color:#4A8C3F;"></i>
                    <span id="ouvPhotoUploadText">Changer la photo de profil</span>
                    <input type="file" id="ouvPhotoFileInput" accept="image/*"
                           onchange="ouvUploadPhoto(this)">
                </label>
                <div class="ouv-upload-progress" id="ouvUploadProgress">
                    <div class="ouv-upload-progress-bar" id="ouvUploadProgressBar"></div>
                </div>

                {# Formulaire profil #}
                <form id="ouvProfileForm" onsubmit="return false;">

                    {# Champ caché URL Cloudinary #}
                    <input type="hidden" name="photo" id="ouvPhotoUrl"
                           value="{{ app.user.img is defined ? app.user.img : '' }}">

                    <div style="padding:4px 0;">

                        {# Email #}
                        {% if app.user.email is defined %}
                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-envelope" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Email</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;word-break:break-all;">{{ app.user.email }}</div>
                                <input class="ouv-pf-input" name="email" type="email" value="{{ app.user.email }}">
                            </div>
                        </div>
                        {% endif %}

                        {# Prénom #}
                        {% if app.user.prenom is defined %}
                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-user" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Prénom</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.prenom }}</div>
                                <input class="ouv-pf-input" name="prenom" type="text" value="{{ app.user.prenom }}">
                            </div>
                        </div>
                        {% endif %}

                        {# Nom #}
                        {% if app.user.nom is defined %}
                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-user" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Nom</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.nom }}</div>
                                <input class="ouv-pf-input" name="nom" type="text" value="{{ app.user.nom }}">
                            </div>
                        </div>
                        {% endif %}

                        {# CIN #}
                        {% if app.user.cin is defined %}
                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-id-card" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">CIN</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.cin }}</div>
                                <input class="ouv-pf-input" name="cin" type="text" value="{{ app.user.cin }}" maxlength="8">
                            </div>
                        </div>
                        {% endif %}

                        {# Téléphone #}
                        {% if app.user.tel is defined %}
                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-phone" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Téléphone</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.tel }}</div>
                                <input class="ouv-pf-input" name="tel" type="tel" value="{{ app.user.tel }}">
