                        <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-location-dot" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Ville</div>
                                <div class="ouv-pf-view" style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.ville }}</div>
                                <input class="ouv-pf-input" name="ville" type="text" value="{{ app.user.ville }}">
                            </div>
                        </div>
                        {% endif %}

                        {# Nouveau mot de passe — visible uniquement en mode édition #}
                        <div id="ouvPwdRow" style="display:none;align-items:flex-start;gap:10px;padding:9px 16px;border-bottom:1px solid #f8f8f8;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;">
                                <i class="fa fa-lock" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Nouveau mot de passe</div>
                                <input class="ouv-pf-input" name="password" type="password"
                                       placeholder="Laisser vide pour ne pas changer"
                                       style="display:block;">
                            </div>
                        </div>

                        {# Date création — lecture seule #}
                        {% if app.user.dateCreationcpt is defined %}
                        <div style="display:flex;align-items:center;gap:10px;padding:9px 16px;">
                            <div style="width:28px;height:28px;border-radius:8px;background:#f0f0f0;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="fa fa-calendar" style="font-size:11px;color:#888;"></i>
                            </div>
                            <div>
                                <div style="font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:0.06em;">Membre depuis</div>
                                <div style="font-size:12px;color:#2C3E50;margin-top:1px;">{{ app.user.dateCreationcpt|date('d/m/Y') }}</div>
                            </div>
                        </div>
                        {% endif %}

                    </div>
                </form>

                {# Déconnexion #}
                <div style="padding:10px 12px;border-top:1px solid #f0f0f0;">
                    <a href="{{ path('app_logout') }}"
                       style="display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:8px;background:rgba(220,60,60,0.08);border:1px solid rgba(220,60,60,0.15);color:#e74c3c;text-decoration:none;font-size:13px;font-weight:600;transition:all 0.2s;"
                       onmouseover="this.style.background='rgba(220,60,60,0.15)'"
                       onmouseout="this.style.background='rgba(220,60,60,0.08)'">
                        <i class="fa fa-arrow-right-from-bracket"></i> Déconnexion
                    </a>
                </div>

            </div>{# fin #profilePanel #}
        </div>{# fin #profileMenu #}
        {% endif %}
    </div>
</header>

<main class="main-content">
    {% for msg in app.flashes('success') %}
        <div class="flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

{% block javascripts %}
<script>
    /* ── Dropdown Stocks ── */
    function toggleDropdown(id) {
        const menu = document.getElementById(id);
        menu.classList.toggle('show');
    }
    /* ══════════════════════════════════════════════════════
       CLOUDINARY — Upload direct (unsigned preset)
    ══════════════════════════════════════════════════════ */
    var CLOUDINARY_CLOUD_NAME    = 'dp0ily6qa';
    var CLOUDINARY_UPLOAD_PRESET = 'agroflow';

    function ouvUploadPhoto(input) {
        if (!input.files || !input.files[0]) return;
        var file  = input.files[0];
        var bar   = document.getElementById('ouvUploadProgressBar');
        var prog  = document.getElementById('ouvUploadProgress');
        var txt   = document.getElementById('ouvPhotoUploadText');
        var label = document.getElementById('ouvPhotoUploadLabel');

        prog.style.display = 'block';
        bar.style.width = '0%';
        txt.textContent = 'Upload en cours…';
        label.style.pointerEvents = 'none';

        var fd = new FormData();
        fd.append('file', file);
        fd.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);
        fd.append('folder', 'agroflow/avatars');

        var xhr = new XMLHttpRequest();

        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                bar.style.width = Math.round(e.loaded / e.total * 100) + '%';
            }
        };

        xhr.onload = function() {
            label.style.pointerEvents = 'auto';
            prog.style.display = 'none';

            if (xhr.status === 200) {
                var res = JSON.parse(xhr.responseText);
                var secureUrl = res.secure_url;

                document.getElementById('ouvPhotoUrl').value = secureUrl;

                _ouvUpdateAvatar('ouvPhotoSmall', 'ouvAvatarSmall', secureUrl, 34, 34);
                _ouvUpdateAvatar('ouvPhotoBig',   'ouvAvatarBig',   secureUrl, 52, 52);

                txt.textContent = 'Photo mise à jour ✓';

                // Auto-save immédiat en base
                var fd2 = new FormData();
                fd2.append('photo', secureUrl);
                fetch('{{ path("profile_update") }}', {
                    method: 'POST',
                    body: fd2,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(r) { return r.json(); })
                .then(function(json) {
                    if (json.success) {
                        ouvShowToast('Photo sauvegardée ✓');
                    } else {
                        ouvShowToast('Upload OK mais sauvegarde échouée', true);
                    }
                });
            } else {
                txt.textContent = 'Changer la photo de profil';
                ouvShowToast('Erreur lors de l\'upload', true);
            }
        };

        xhr.onerror = function() {
            label.style.pointerEvents = 'auto';
            prog.style.display = 'none';
            txt.textContent = 'Changer la photo de profil';
            ouvShowToast('Erreur réseau', true);
        };

        xhr.open('POST', 'https://api.cloudinary.com/v1_1/' + CLOUDINARY_CLOUD_NAME + '/image/upload');
        xhr.send(fd);
    }

    function _ouvUpdateAvatar(imgId, fbId, rawUrl, w, h) {
        var img = document.getElementById(imgId);
        var fb  = document.getElementById(fbId);
        if (!img) return;
        img.src = cloudinaryAvatar(rawUrl, w, h);
        img.style.display = 'block';
        if (fb) fb.style.display = 'none';
        img.onerror = function() {
            img.style.display = 'none';
            if (fb) fb.style.display = 'flex';
        };
    }

    /* ── Ouvrir / fermer le panel ── */
    function toggleProfilePanel() {
        var panel   = document.getElementById('profilePanel');
        var chevron = document.getElementById('profileChevron');
        var open    = panel.style.display === 'block';
        panel.style.display     = open ? 'none' : 'block';
        chevron.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    document.addEventListener('click', function(e) {
        var menu = document.getElementById('profileMenu');
        if (menu && !menu.contains(e.target)) {
            document.getElementById('profilePanel').style.display = 'none';
            document.getElementById('profileChevron').style.transform = 'rotate(0deg)';
        }
    });

    /* ── Édition profil ── */
    var _ouvOriginals = {};

    function ouvStartEdit() {
        document.querySelectorAll('.ouv-pf-input[name]').forEach(function(inp) {
            _ouvOriginals[inp.name] = inp.value;
        });

        document.querySelectorAll('.ouv-pf-view').forEach(function(el) { el.style.display = 'none'; });
        document.querySelectorAll('.ouv-pf-input').forEach(function(el) { el.style.display = 'block'; });
        document.getElementById('ouvPwdRow').style.display = 'flex';

        // Afficher le bouton upload photo
        document.getElementById('ouvPhotoUploadLabel').style.display = 'flex';
        document.getElementById('ouvPhotoUploadText').textContent = 'Changer la photo de profil';

        document.getElementById('ouvBtnEdit').style.display   = 'none';
        document.getElementById('ouvBtnSave').style.display   = 'inline-flex';
        document.getElementById('ouvBtnCancel').style.display = 'inline-flex';

        var first = document.querySelector('.ouv-pf-input[name="email"]');
        if (first) first.focus();
    }

    function ouvCancelEdit() {
        document.querySelectorAll('.ouv-pf-input[name]').forEach(function(inp) {
            if (_ouvOriginals[inp.name] !== undefined) inp.value = _ouvOriginals[inp.name];
        });
        var pwd = document.querySelector('.ouv-pf-input[name="password"]');
        if (pwd) pwd.value = '';

        document.querySelectorAll('.ouv-pf-view').forEach(function(el) { el.style.display = 'block'; });
        document.querySelectorAll('.ouv-pf-input').forEach(function(el) { el.style.display = 'none'; });
        document.getElementById('ouvPwdRow').style.display = 'none';

        // Masquer le bouton upload photo
        document.getElementById('ouvPhotoUploadLabel').style.display = 'none';
        document.getElementById('ouvUploadProgress').style.display   = 'none';

        document.getElementById('ouvBtnEdit').style.display   = 'inline-flex';
        document.getElementById('ouvBtnSave').style.display   = 'none';
        document.getElementById('ouvBtnCancel').style.display = 'none';
    }

    function ouvSubmitEdit() {
        var emailInp = document.querySelector('.ouv-pf-input[name="email"]');
        if (emailInp && !emailInp.value.trim()) {
            emailInp.style.borderColor = 'rgba(220,60,60,0.7)';
            emailInp.focus();
            return;
        }

        var btnSave = document.getElementById('ouvBtnSave');
        btnSave.disabled = true;
        btnSave.innerHTML = '<i class="fa fa-spinner fa-spin" style="font-size:10px;"></i> Envoi…';

        var data = new FormData(document.getElementById('ouvProfileForm'));

        fetch('{{ path("profile_update") }}', {
            method: 'POST',
            body: data,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r) { return r.json(); })
        .then(function(json) {
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';

            if (json.success) {
                // Mise à jour des libellés visibles
                document.querySelectorAll('.ouv-pf-view').forEach(function(view) {
                    var inp = view.parentElement.querySelector('.ouv-pf-input');
                    if (inp && inp.value.trim()) view.textContent = inp.value.trim();
                });

                // Mise à jour nom + initiales
                if (json.prenom && json.nom) {
                    var fullName = json.prenom + ' ' + json.nom;
                    var initials = json.prenom.charAt(0).toUpperCase() + json.nom.charAt(0).toUpperCase();
                    var nameSmall   = document.getElementById('ouvNameSmall');
                    var nameBig     = document.getElementById('ouvNameBig');
                    var avatarSmall = document.getElementById('ouvAvatarSmall');
                    var avatarBig   = document.getElementById('ouvAvatarBig');
                    if (nameSmall)   nameSmall.textContent   = fullName;
                    if (nameBig)     nameBig.textContent     = fullName;
                    if (avatarSmall) avatarSmall.textContent = initials;
                    if (avatarBig)   avatarBig.textContent   = initials;
                }

                // Mise à jour data-cloudinary-src si nouvelle photo
                if (json.photo) {
                    ['ouvPhotoSmall', 'ouvPhotoBig'].forEach(function(id) {
                        var el = document.getElementById(id);
                        if (el) el.dataset.cloudinarySrc = json.photo;
                    });
                }

                ouvCancelEdit();
                ouvShowToast('Profil mis à jour avec succès');
            } else {
                ouvShowToast(json.error || 'Une erreur est survenue', true);
            }
        })
        .catch(function() {
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="fa fa-check" style="font-size:10px;"></i> Enregistrer';
            ouvShowToast('Erreur réseau, veuillez réessayer.', true);
        });
    }

    /* ── Toast ── */
    function ouvShowToast(msg, isError) {
        var existing = document.getElementById('ouvToast');
        if (existing) existing.remove();

        var t = document.createElement('div');
        t.id = 'ouvToast';
        t.style.cssText = [
            'position:fixed',
            'bottom:24px',
            'right:24px',
            'z-index:99999',
            'background:' + (isError ? 'rgba(160,30,30,0.95)' : 'rgba(30,90,35,0.95)'),
            'color:#fff',
            'font-size:13px',
            'font-weight:600',
            'font-family:DM Sans,sans-serif',
            'padding:12px 20px',
            'border-radius:10px',
            'display:flex',
            'align-items:center',
            'gap:9px',
            'box-shadow:0 4px 24px rgba(0,0,0,0.2)',
            'transition:opacity 0.4s ease',
            'opacity:1'
        ].join(';');

        var icon = document.createElement('i');
        icon.className = isError ? 'fa fa-circle-xmark' : 'fa fa-circle-check';
        icon.style.fontSize = '14px';
        t.appendChild(icon);
        t.appendChild(document.createTextNode(msg));
        document.body.appendChild(t);

        setTimeout(function() { t.style.opacity = '0'; }, 2800);
        setTimeout(function() { if (t.parentNode) t.remove(); }, 3300);
    }
</script>
{% endblock %}

</body>
</html>