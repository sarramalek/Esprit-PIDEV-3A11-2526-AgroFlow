{% extends 'base.html.twig' %}

{% block title %}Accueil - Agriculture{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- FontAwesome & Bootstrap Icons (Nécessaires pour le template Agriculture) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        /* Surcharge pour la home page pour occuper tout l'espace si une sidebar est dans base.html.twig */
        .content-area { padding: 0 !important; background-color: var(--background-color) !important; }
        .main-container { flex-direction: column; }
        .sidebar-nature { display: none; } /* On masque la sidebar sur la page d'accueil pour le mode Full landing page */
        .navbar-tech { display: none; } /* On peut masquer la navbar tech si le template a sa propre header, mais on garde le hero ici */
        
        /* Correction couleurs globales issues de CSS template */
        body { background-color: white; font-family: "Open Sans", sans-serif; margin: 0; padding: 0; }
        .custom-container { max-width: 1320px; margin: 0 auto; padding: 0 15px; }

        /* Effet hover Premium sur les cartes */
        .post-item-agro {
            background: white; border: 2px solid #eee; border-radius: 8px; position: relative; transition: border-color 0.3s ease, box-shadow 0.3s ease; overflow: hidden;
        }
        .post-item-agro:hover {
            border-color: #2D5A27 !important;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        /* Tutos Section Styles */
        .tuto-card {
            background: white; border: 1px solid #eee; border-radius: 12px; overflow: hidden; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column;
        }
        .tuto-card:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,0.08); transform: translateY(-5px); border-color: #2D5A27;
        }
        .tuto-img {
            position: relative; overflow: hidden;
        }
        .tuto-img img {
            transition: all 0.5s ease;
        }
        .tuto-card:hover .tuto-img img {
            filter: brightness(0.7);
            transform: scale(1.05);
        }
        .play-btn-overlay {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2;
        }
        .play-pulse {
            color: #2D5A27; font-size: 4rem; background: white; border-radius: 50%; line-height: 1; padding: 0;
            animation: pulse-animation 2s infinite; transition: color 0.3s ease;
            box-shadow: inset 0 0 0 2px white;
        }
        @keyframes pulse-animation {
            0% { box-shadow: 0 0 0 0 rgba(45, 90, 39, 0.7); }
            70% { box-shadow: 0 0 0 20px rgba(45, 90, 39, 0); }
            100% { box-shadow: 0 0 0 0 rgba(45, 90, 39, 0); }
        }
        .tuto-content {
            padding: 25px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start;
        }
        .tuto-title {
            color: #2C3E50; font-family: 'Marcellus', serif; font-size: 20px; font-weight: bold; margin-bottom: 20px; transition: color 0.3s ease;
        }
        .tuto-card:hover .tuto-title {
            color: #2D5A27;
        }
        .tuto-link {
            display: inline-block; background: #FCF8E6; color: #2D5A27; padding: 10px 20px; border-radius: 50px; text-decoration: none; font-weight: 600; font-size: 14px; transition: all 0.3s ease;
        }
        .tuto-link:hover {
            background: #2D5A27; color: white;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

