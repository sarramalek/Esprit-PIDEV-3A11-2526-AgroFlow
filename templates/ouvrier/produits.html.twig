{% extends 'base_ouvrier.html.twig' %}

{% block title %}Produits – Ouvrier | AgroFlow{% endblock %}

{% block stylesheets %}
<style>
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-top: 24px;
    }
    .stock-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: #ffffff;
        border: 1px solid rgba(34, 79, 46, 0.12);
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 18px 40px rgba(31, 61, 33, 0.08);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        overflow: hidden;
    }
    .stock-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 28px 55px rgba(31, 61, 33, 0.12);
        border-color: rgba(34, 79, 46, 0.18);
    }
    .stock-card .card-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 12px;
    }
    .stock-card .card-title {
        font-size: 1.18rem;
        font-weight: 800;
        color: #173824;
        margin: 0;
    }
    .stock-card .card-badge {
        background: #eff7ed;
        color: #1f4f2d;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }
    .stock-card .card-stat {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        color: #5b6e60;
        font-size: 0.92rem;
    }
    .stock-card .card-stat span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #f4faf4;
    }
    .stock-card .card-description {
        color: #4a5a50;
        line-height: 1.7;
        min-height: 56px;
        margin: 0;
        font-size: 0.96rem;
    }
    .stock-card .card-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }
    .stock-card .card-button,
    .stock-card .card-button-outline,
    .stock-card .hover-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: none;
        border-radius: 999px;
        padding: 12px 18px;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.22s ease, background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
        text-decoration: none;
    }
    .stock-card .card-button {
        background: linear-gradient(135deg, #2e6e3b 0%, #1f4f2f 100%);
        color: white;
        box-shadow: 0 10px 22px rgba(34, 79, 46, 0.14);
    }
    .stock-card .card-button:hover,
    .stock-card .card-button-outline:hover,
    .stock-card .hover-button:hover {
        transform: translateY(-2px);
    }
    .stock-card .card-button-outline {
        background: #ffffff;
        color: #1f4f2f;
        border: 1px solid rgba(34, 79, 46, 0.15);
        box-shadow: 0 8px 18px rgba(27, 68, 39, 0.05);
    }
    .stock-card .sortie-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        align-items: end;
        margin-top: 8px;
    }
    .stock-card .sortie-form input {
        width: 100%;
        border: 1px solid rgba(34, 79, 46, 0.12);
        border-radius: 16px;
        padding: 12px 14px;
        color: #24372e;
        background: #f7faf7;
        outline: none;
        font-size: 0.94rem;
    }
    .stock-card .sortie-form input:focus {
        border-color: #2d5a27;
        background: #eef5eb;
    }
    .stock-card .stock-level {
        padding: 10px 14px;
        border-radius: 18px;
        background: #eef7ef;
        color: #21502d;
        font-size: 0.92rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
    .stock-card .hover-actions {
        position: absolute;
        top: 16px;
        right: 16px;
        display: flex;
        gap: 10px;
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .stock-card:hover .hover-actions {
        opacity: 1;
        transform: translateY(0);
    }
    .stock-card .hover-button {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid rgba(34, 79, 46, 0.12);
        color: #1f472d;
        box-shadow: 0 10px 22px rgba(31, 61, 33, 0.08);
    }
    .stock-card .hover-button:hover {
        background: #2d5a27;
        color: white;
        border-color: transparent;
    }
    .article-modal,
    .movement-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: grid;
        place-items: center;
        padding: 20px;
    }
    .article-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
    }
    .article-modal-content,
    .movement-modal-content {
        position: relative;
        width: min(720px, 100%);
        background: #FCF8E6;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.16);
        padding: 0;
        z-index: 1;
        overflow: hidden;
        animation: modalFadeIn 0.25s ease-out;
        min-height: 320px;
    }
    .movement-modal-content {
        background: #fffdf3;
    }
    .movement-modal .article-modal-header {
        background: #f8f3df;
        border-bottom: 1px solid rgba(34, 79, 46, 0.1);
    }
    .movement-modal .article-modal-body {
        padding: 24px 28px 28px;
    }
    .movement-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        margin-top: 16px;
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(34, 79, 46, 0.06);
    }
    .movement-table th,
    .movement-table td {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(34, 79, 46, 0.08);
        text-align: left;
        vertical-align: middle;
    }
    .movement-table tr:last-child td {
        border-bottom: none;
    }
    .movement-table th {
        color: #5a513f;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        background: #f7f3e8;
    }
    .movement-table td {
        color: #4d4538;
        background: #ffffff;
    }
    .movement-table tr:hover td {
        background: #fcf8ed;
    }
    .movement-row-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .movement-edit-form {
        margin-top: 12px;
        padding: 18px;
        border-radius: 18px;
        background: #fff9e5;
        border: 1px solid rgba(245, 206, 134, 0.7);
    }
    .movement-edit-form label {
        display: block;
        margin-bottom: 8px;
        color: #6b5b47;
        font-size: 0.9rem;
        font-weight: 700;
    }
    .movement-edit-form input,
    .movement-edit-form textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid rgba(34, 79, 46, 0.12);
        border-radius: 12px;
        background: #ffffff;
        color: #24372e;
        margin-bottom: 10px;
        font-size: 0.95rem;
        outline: none;
    }
    .movement-edit-form textarea {
        resize: vertical;
        min-height: 80px;
    }
    .movement-edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .movement-error {
        color: #974b2e;
        background: #fff2ef;
        border: 1px solid #f4c8bd;
        border-radius: 14px;
        padding: 14px 16px;
        margin-top: 16px;
        font-size: 0.95rem;
    }
    @keyframes modalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    .article-modal-header {
        background: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }
    .article-modal-header .modal-title-section {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .article-modal-header .modal-label {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6c757d;
    }
    .article-modal-header .modal-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin: 0;
        color: #212529;
    }
    .article-modal-header .modal-price {
        background: #e9ecef;
        color: #495057;
        border-radius: 20px;
        padding: 8px 16px;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .article-modal-close {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 50%;
        background: #f8f9fa;
        color: #6c757d;
        font-size: 1.2rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #e9ecef;
        transition: all 0.15s ease;
    }
    .article-modal-close:hover {
        background: #e9ecef;
        color: #495057;
    }
    .article-modal-body {
        padding: 28px;
        display: grid;
        gap: 16px;
    }
    .article-modal-body .modal-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding: 16px 20px;
        border-radius: 12px;
        background: #fefcf4;
        border: 1px solid #f5e6a3;
        color: #8b7355;
    }
    .article-modal-body .modal-row span {
        color: #a0855b;
        font-weight: 600;
        min-width: 110px;
        font-size: 0.9rem;
    }
    .article-modal-body .modal-row strong {
        color: #6b5b47;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .article-modal-body .modal-row p {
        margin: 0;
        max-width: 65ch;
        line-height: 1.6;
        color: #8b7355;
        font-size: 0.95rem;
    }
    .article-modal-body .modal-description {
        flex-direction: column;
        align-items: flex-start;
        padding: 20px 22px;
        background: #fefcf4;
        border-radius: 12px;
        border: 1px solid #f5e6a3;
    }
    .article-modal-body .modal-description span {
        color: #a0855b;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
        font-size: 0.9rem;
    }

</style>
{% endblock %}

{% block body %}
<div class="main-content">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
        <div>
            <h1>Produits</h1>
        </div>
        {% if currentCategory is defined and currentCategory %}
            <span style="font-size:0.95rem; color:#5e6d63;">Filtré sur : {{ currentCategory.nom }}</span>
        {% endif %}
    </div>
    <div style="margin-top: 24px; margin-bottom: 16px;">
        <div style="position: relative; max-width: 400px;">
            <input type="text" id="productSearch" placeholder="Rechercher un produit..." style="width: 100%; padding: 12px 16px 12px 40px; border: 1px solid rgba(34, 79, 46, 0.15); border-radius: 20px; background: #ffffff; color: #24372e; font-size: 0.95rem; outline: none; transition: border-color 0.2s ease;">
            <i class="fa fa-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
        </div>
    </div>
    {% if error is defined %}
        <div class="flash-success" style="background:#fff4e5; border-left-color:#ffa940; color:#6a4b0d;">{{ error }}</div>
    {% endif %}

    {% if articles is empty %}
        <p style="margin-top:24px; color:#596662;">Aucun produit trouvé pour l'agriculteur lié.</p>
    {% else %}
        <div class="cards-grid">
            {% for article in articles %}
                <article class="stock-card">
                    <div class="hover-actions">
                        <button type="button" class="hover-button view-article-btn"
                            data-name="{{ article.nom|e('html_attr') }}"
                            data-category="{{ (article.categorie ? article.categorie.nom : 'Sans catégorie')|e('html_attr') }}"
                            data-unit="{{ (article.uniteMesure ?: 'U')|e('html_attr') }}"
                            data-price="{{ (article.prixUnitaire ? article.prixUnitaire ~ ' DT' : 'Non défini')|e('html_attr') }}"
                            data-quantity="{{ article.quantiteEnStock|e('html_attr') }}"
                            data-description="{{ (article.categorie and article.categorie.description ? article.categorie.description : 'Aucune description fournie pour cette catégorie.')|e('html_attr') }}"
                        >
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>

                    <div class="card-head">
                        <div>
                            <h2 class="card-title">{{ article.nom }}</h2>
                            <div class="card-stat">
                                <span><i class="fa fa-tag"></i> {{ article.categorie ? article.categorie.nom : 'Sans catégorie' }}</span>
                                <span><i class="fa fa-scale-balanced"></i> {{ article.uniteMesure ?: 'U' }}</span>
                            </div>
                        </div>
                        <div class="card-badge">{{ article.prixUnitaire ? article.prixUnitaire ~ ' DT' : 'Prix non défini' }}</div>
                    </div>

                    <p class="card-description">Quantité en stock : <strong>{{ article.quantiteEnStock }}</strong>. Utilisez le bouton Sortie pour enregistrer un mouvement.</p>

                    <div class="card-actions">
                        <button type="button" class="card-button-outline view-article-btn"
                            data-name="{{ article.nom|e('html_attr') }}"
                            data-category="{{ (article.categorie ? article.categorie.nom : 'Sans catégorie')|e('html_attr') }}"
                            data-unit="{{ (article.uniteMesure ?: 'U')|e('html_attr') }}"
                            data-price="{{ (article.prixUnitaire ? article.prixUnitaire ~ ' DT' : 'Non défini')|e('html_attr') }}"
                            data-quantity="{{ article.quantiteEnStock|e('html_attr') }}"
                            data-description="{{ (article.categorie and article.categorie.description ? article.categorie.description : 'Aucune description fournie pour cette catégorie.')|e('html_attr') }}"
                        ><i class="fa fa-eye"></i> Voir article</button>
                        <button type="button" class="card-button-outline movement-button" data-article-id="{{ article.id }}" data-article-name="{{ article.nom|e('html_attr') }}"><i class="fa fa-history"></i> Mouvements</button>
                        <div class="stock-level"><i class="fa fa-boxes-stacked"></i> {{ article.quantiteEnStock }} en stock</div>
                    </div>

                    <form class="sortie-form" method="post" action="{{ path('ouvrier_article_sortie', {'id': article.id}) }}">
                        <input type="number" name="quantite" min="1" step="0.01" placeholder="Quantité sortie" required>
                        <button type="submit" class="card-button"><i class="fa fa-arrow-right"></i> Sortie</button>
                    </form>
                </article>
            {% endfor %}
        </div>
    {% endif %}
</div>

<div id="articleModal" class="article-modal" style="display:none;">
    <div class="article-modal-backdrop"></div>
    <div class="article-modal-content">
        <div class="article-modal-header">
            <div class="modal-title-section">
                <span class="modal-label">Détail du produit</span>
                <h2 id="modalTitle" class="modal-title"></h2>
            </div>
            <span id="modalPrice" class="modal-price"></span>
        </div>
        <button type="button" class="article-modal-close" aria-label="Fermer">×</button>
        <div class="article-modal-body">
            <div class="modal-row"><span>Catégorie</span><strong id="modalCategory"></strong></div>
            <div class="modal-row"><span>Quantité en stock</span><strong id="modalQuantity"></strong></div>
            <div class="modal-row"><span>Unité</span><strong id="modalUnit"></strong></div>
            <div class="modal-row modal-description"><span>Description</span><p id="modalDescription"></p></div>
        </div>
    </div>
</div>

    <div id="movementModal" class="movement-modal" style="display:none;">
        <div class="article-modal-backdrop"></div>
        <div class="movement-modal-content">
            <div class="article-modal-header">
                <div class="modal-title-section">
                    <span class="modal-label">Mouvements de sortie</span>
                    <h2 id="movementModalTitle" class="modal-title"></h2>
                </div>
                <span id="movementModalCount" class="modal-price"></span>
            </div>
            <button type="button" class="article-modal-close" id="movementModalClose" aria-label="Fermer">×</button>
            <div class="article-modal-body">
                <div id="movementListContainer"></div>
                <p id="movementEmpty" style="margin:0; color:#6b5b47; text-align:center; display:none;">Aucun mouvement trouvé pour ce produit.</p>
                <p id="movementError" class="movement-error" style="display:none; margin:0; text-align:center;"></p>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const openButtons = document.querySelectorAll('.view-article-btn');
            const modal = document.getElementById('articleModal');
            const closeButton = modal.querySelector('.article-modal-close');
            const title = document.getElementById('modalTitle');
            const price = document.getElementById('modalPrice');
            const category = document.getElementById('modalCategory');
            const quantity = document.getElementById('modalQuantity');
            const unit = document.getElementById('modalUnit');
            const description = document.getElementById('modalDescription');

            function openModal(data) {
                title.textContent = data.name;
                price.textContent = data.price;
                category.textContent = data.category;
                quantity.textContent = data.quantity;
                unit.textContent = data.unit;
                description.textContent = data.description;
                modal.style.display = 'grid';
            }

            function closeModal() {
                modal.style.display = 'none';
            }

            openButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    openModal(button.dataset);
                });
            });

            closeButton.addEventListener('click', closeModal);
            modal.querySelector('.article-modal-backdrop').addEventListener('click', closeModal);
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && modal.style.display === 'grid') {
                    closeModal();
                }
            });

            // Recherche de produits
            const searchInput = document.getElementById('productSearch');
            const productCards = document.querySelectorAll('.stock-card');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();
                const cardsGrid = document.querySelector('.cards-grid');

                if (searchTerm === '') {
                    productCards.forEach(card => {
                        card.style.display = 'block';
                    });
                    removeNoResultsMessage(cardsGrid);
                    return;
                }

                let visibleCount = 0;
                productCards.forEach(card => {
                    const productName = card.querySelector('.card-title').textContent.toLowerCase();
                    const categoryName = card.querySelector('.card-stat span:first-child').textContent.toLowerCase();

                    if (productName.includes(searchTerm) || categoryName.includes(searchTerm)) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (visibleCount === 0) {
                    showNoResultsMessage(cardsGrid, searchTerm);
                } else {
                    removeNoResultsMessage(cardsGrid);
                }
            });

            function showNoResultsMessage(container, term) {
                let noResultsMsg = container.querySelector('.no-results-msg');
                if (!noResultsMsg) {
                    noResultsMsg = document.createElement('p');
                    noResultsMsg.className = 'no-results-msg';
                    noResultsMsg.style.cssText = 'margin-top: 24px; color: #596662; text-align: center; font-style: italic;';
                    container.appendChild(noResultsMsg);
                }
                noResultsMsg.textContent = 'Aucun produit trouvé pour "' + term + '"';
            }

            function removeNoResultsMessage(container) {
                const noResultsMsg = container.querySelector('.no-results-msg');
                if (noResultsMsg) {
                    noResultsMsg.remove();
                }
            }

            function escapeHtml(text) {
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // Gestion du modal mouvements
            const movementsUrlTemplate = '{{ path('ouvrier_article_mouvements', {'id': 0}) }}';
            const modifierUrlTemplate = '{{ path('ouvrier_mouvement_modifier', {'id': 0}) }}';
            const movementModal = document.getElementById('movementModal');
            const movementModalClose = document.getElementById('movementModalClose');
            const movementModalTitle = document.getElementById('movementModalTitle');
            const movementModalCount = document.getElementById('movementModalCount');
            const movementListContainer = document.getElementById('movementListContainer');
            const movementEmpty = document.getElementById('movementEmpty');
            const movementError = document.getElementById('movementError');

            document.querySelectorAll('.movement-button').forEach(button => {
                button.addEventListener('click', function() {
                    openMovementModal(this.dataset.articleId, this.dataset.articleName);
                });
            });

            function openMovementModal(articleId, articleName) {
                movementModalTitle.textContent = articleName;
                movementModalCount.textContent = '';
                movementListContainer.innerHTML = '';
                movementEmpty.style.display = 'none';
                fetchMovementHistory(articleId);
                movementModal.style.display = 'grid';
            }

            function fetchMovementHistory(articleId) {
                const url = movementsUrlTemplate.replace('/0/', `/${articleId}/`);
                movementError.style.display = 'none';
                movementError.textContent = '';
                fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Statut HTTP ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (!data.success) {
                            throw new Error(data.message || 'Impossible de charger les mouvements.');
                        }
                        renderMovements(data.mouvements);
                    })
                    .catch(error => showMovementError(error.message || 'Impossible de charger les mouvements.'));
            }

            function renderMovements(mouvements) {
                movementListContainer.innerHTML = '';
                if (!mouvements.length) {
                    movementEmpty.style.display = 'block';
                    movementEmpty.textContent = 'Aucun mouvement enregistré pour ce produit.';
                    movementModalCount.textContent = '0 mouvement(s)';
                    return;
                }

                movementEmpty.style.display = 'none';
                movementModalCount.textContent = mouvements.length + ' mouvement(s)';

                const table = document.createElement('table');
                table.className = 'movement-table';
                table.innerHTML = `
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Quantité</th>
                            <th>Motif</th>
                            <th class="movement-row-actions">Actions</th>
                        </tr>
                    </thead>
                `;

                const body = document.createElement('tbody');
                mouvements.forEach(mouvement => {
                    const row = document.createElement('tr');
                    row.dataset.movementId = mouvement.id;
                    row.innerHTML = `
                        <td>${escapeHtml(mouvement.date)}</td>
                        <td>${escapeHtml(mouvement.type)}</td>
                        <td>${escapeHtml(mouvement.quantite)}</td>
                        <td>${escapeHtml(mouvement.motif)}</td>
                        <td class="movement-row-actions">
                            <button type="button" class="card-button-outline" data-movement-id="${mouvement.id}">Modifier</button>
                        </td>
                    `;
                    body.appendChild(row);
                });

                table.appendChild(body);
                movementListContainer.appendChild(table);

                movementListContainer.querySelectorAll('button[data-movement-id]').forEach(button => {
                    button.addEventListener('click', function() {
                        const movementId = this.dataset.movementId;
                        const movementData = mouvements.find(item => item.id.toString() === movementId);
                        if (movementData) {
                            openEditForm(movementData, this.closest('tr'));
                        }
                    });
                });
            }

            function openEditForm(mouvement, row) {
                const existingForm = row.nextElementSibling && row.nextElementSibling.classList.contains('movement-edit-row') ? row.nextElementSibling : null;
                if (existingForm) {
                    existingForm.remove();
                    return;
                }

                const formRow = document.createElement('tr');
                formRow.className = 'movement-edit-row';
                formRow.innerHTML = `
                    <td colspan="5">
                        <form class="movement-edit-form">
                            <label>Quantité</label>
                            <input type="number" name="quantite" min="0.01" step="0.01" value="${escapeHtml(mouvement.quantite)}" required>
                            <label>Motif</label>
                            <textarea name="motif" rows="3">${escapeHtml(mouvement.motif)}</textarea>
                            <div class="movement-edit-actions">
                                <button type="button" class="card-button-outline">Annuler</button>
                                <button type="submit" class="card-button">Enregistrer</button>
                            </div>
                        </form>
                    </td>
                `;

                const form = formRow.querySelector('form');
                const cancelBtn = form.querySelector('.card-button-outline');
                form.addEventListener('submit', function(event) {
                    event.preventDefault();
                    updateMovement(mouvement.id, new FormData(form), row, formRow);
                });
                cancelBtn.addEventListener('click', function() {
                    formRow.remove();
                });
                row.parentNode.insertBefore(formRow, row.nextSibling);
            }

            function updateMovement(movementId, formData, row, formRow) {
                const url = modifierUrlTemplate.replace('/0', `/${movementId}`);
                fetch(url, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json'
                    },
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            showMovementError(data.message || 'Impossible de modifier le mouvement.');
                            return;
                        }

                        const quantityCell = row.querySelector('td:nth-child(3)');
                        const motifCell = row.querySelector('td:nth-child(4)');
                        quantityCell.textContent = data.quantite;
                        motifCell.textContent = data.motif || motifCell.textContent;
                        formRow.remove();
                    })
                    .catch(() => showMovementError('Impossible de modifier le mouvement.'));
            }

            function showMovementError(message) {
                movementError.textContent = message;
                movementError.style.display = 'block';
                movementEmpty.style.display = 'none';
            }

            movementModalClose.addEventListener('click', function() {
                movementModal.style.display = 'none';
            });
            movementModal.querySelector('.article-modal-backdrop').addEventListener('click', function() {
                movementModal.style.display = 'none';
            });
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape' && movementModal.style.display === 'grid') {
                    movementModal.style.display = 'none';
                }
            });
        });
    </script>
{% endblock %}
