{% extends 'base_admin.html.twig' %}
{% block title %}Rotations — AgroFlow{% endblock %}
{% block page_title %}Gestion des Rotations{% endblock %}
{% block breadcrumb %}Rotations{% endblock %}

{% block stylesheets %}
.stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
.stat-card { background:var(--white); border-radius:var(--radius); box-shadow:var(--shadow); padding:20px 24px; display:flex; align-items:center; gap:16px; }
.stat-icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
.stat-icon.green { background:#D1FAE5; color:#065F46; }
.stat-icon.blue { background:#DBEAFE; color:#1D4ED8; }
.stat-icon.red { background:#FEE2E2; color:#DC2626; }
.stat-icon.yellow { background:#FEF3C7; color:#92400E; }
.stat-value { font-size:24px; font-weight:700; color:var(--navy); line-height:1; }
.stat-label { font-size:12px; color:var(--text-muted); margin-top:4px; }

.toolbar { display:flex; align-items:center; gap:12px; margin-bottom:20px; flex-wrap:wrap; }
.search-box { position:relative; flex:1; min-width:220px; }
.search-box input { width:100%; padding:10px 14px 10px 38px; border:1.5px solid var(--cream-dark); border-radius:8px; font-size:14px; font-family:'DM Sans',sans-serif; background:var(--white); color:var(--navy); }
.search-box input:focus { outline:none; border-color:var(--green-accent); }
.search-box i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:13px; }

.filter-select { padding:10px 14px; border:1.5px solid var(--cream-dark); border-radius:8px; font-size:14px; font-family:'DM Sans',sans-serif; background:var(--white); color:var(--navy); cursor:pointer; }

.btn-primary { display:inline-flex; align-items:center; gap:8px; background:var(--green-accent); color:white; padding:10px 20px; border-radius:var(--radius); font-size:14px; font-weight:600; text-decoration:none; border:none; cursor:pointer; white-space:nowrap; }
.btn-primary:hover { background:var(--green-mid); }

.btn-pdf { 
    display:inline-flex; 
    align-items:center; 
    gap:8px; 
    background:#1D4ED8; 
    color:white; 
    padding:10px 20px; 
    border-radius:var(--radius); 
    font-size:14px; 
    font-weight:600; 
    border:none; 
    cursor:pointer; 
    white-space:nowrap; 
}
.btn-pdf:hover { background:#1E40AF; }

.result-count { font-size:13px; color:var(--text-muted); }

.card { background:var(--white); border-radius:var(--radius); box-shadow:var(--shadow); overflow:hidden; }
.data-table { width:100%; border-collapse:collapse; }
.data-table thead th { background:var(--cream); padding:13px 18px; text-align:left; font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); border-bottom:1px solid var(--cream-dark); white-space:nowrap; cursor:pointer; user-select:none; }
.data-table thead th:hover { color:var(--green-accent); }
.data-table thead th .sort-icon { margin-left:5px; opacity:0.4; font-size:10px; }
.data-table thead th.sort-asc .sort-icon,
.data-table thead th.sort-desc .sort-icon { opacity:1; color:var(--green-accent); }
.data-table tbody td { padding:14px 18px; font-size:14px; border-bottom:1px solid var(--cream-dark); vertical-align:middle; }
.data-table tbody tr:last-child td { border-bottom:none; }
.data-table tbody tr:hover { background:#FAFDF8; }
.data-table tbody tr.hidden-row { display:none; }

.badge { display:inline-block; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:600; }
.badge-active { background:#D1FAE5; color:#065F46; }
.badge-inactive { background:#FEE2E2; color:#991B1B; }
.actions { display:flex; gap:8px; align-items:center; }
.btn-danger { background:#FEE2E2; color:#DC2626; border:none; padding:6px 12px; border-radius:7px; font-size:13px; cursor:pointer; }
.btn-danger:hover { background:#FECACA; }
.btn-edit { display:inline-flex; align-items:center; gap:5px; background:var(--cream-dark); color:var(--navy); border:1px solid #ddd; padding:6px 12px; border-radius:7px; font-size:13px; text-decoration:none; }
.btn-show { display:inline-flex; align-items:center; gap:5px; background:#EFF6FF; color:#2563EB; border:1px solid #BFDBFE; padding:6px 12px; border-radius:7px; font-size:13px; text-decoration:none; }

.empty-state { text-align:center; padding:60px 20px; color:var(--text-muted); }
.no-results { text-align:center; padding:40px; color:var(--text-muted); display:none; }

/* === PAGINATION === */
.pagination-wrap { 
    display:flex; 
    align-items:center; 
    justify-content:space-between; 
    padding:14px 18px; 
    border-top:1px solid var(--cream-dark); 
    font-size:13px; 
    flex-wrap:wrap; 
    gap:10px; 
}
.pagination-info { color:var(--text-muted); }
.pagination-btns { display:flex; gap:4px; }
.page-btn { 
    min-width:34px; 
    height:34px; 
    border-radius:7px; 
    border:1.5px solid var(--cream-dark); 
    background:var(--white); 
    color:var(--navy); 
    font-size:13px; 
    font-weight:600; 
    cursor:pointer; 
    display:inline-flex; 
    align-items:center; 
    justify-content:center; 
    transition:all 0.15s; 
}
.page-btn:hover { border-color:var(--green-accent); color:var(--green-accent); }
.page-btn.active { background:var(--green-accent); color:white; border-color:var(--green-accent); }
.page-btn:disabled { opacity:0.35; cursor:not-allowed; }
.per-page-select { 
    padding:6px 10px; 
    border:1.5px solid var(--cream-dark); 
    border-radius:7px; 
    font-size:13px; 
    font-family:'DM Sans',sans-serif; 
    background:var(--white); 
    color:var(--navy); 
    cursor:pointer; 
}
{% endblock %}

{% block body %}
{% for msg in app.flashes('success') %}
<div class="flash-success"><i class="fa fa-check-circle"></i> {{ msg }}</div>
{% endfor %}

{# STATS #}
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon green"><i class="fa fa-rotate"></i></div>
        <div><div class="stat-value">{{ total }}</div><div class="stat-label">Total rotations</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue"><i class="fa fa-circle-check"></i></div>
        <div><div class="stat-value">{{ actifs }}</div><div class="stat-label">Actives</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red"><i class="fa fa-circle-xmark"></i></div>
        <div><div class="stat-value">{{ inactifs }}</div><div class="stat-label">Inactives</div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow"><i class="fa fa-calendar-days"></i></div>
        <div><div class="stat-value">{{ dureeMoyenne ?? '—' }}</div><div class="stat-label">Durée moy. (jours)</div></div>
    </div>
</div>

{# TOOLBAR #}
<div class="toolbar">
    <div class="search-box">
        <i class="fa fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="Rechercher par terrain, plante…">
    </div>
    <select class="filter-select" id="filterStatus">
        <option value="">Tous les statuts</option>
        <option value="Actif">Actif</option>
        <option value="Inactif">Inactif</option>
    </select>
    <span class="result-count" id="resultCount"></span>

    <button class="btn-pdf" onclick="exportPDF()">
        <i class="fa fa-file-pdf"></i> Exporter PDF
    </button>

    <a href="{{ path('admin_rotations_new') }}" class="btn-primary">
        <i class="fa fa-plus"></i> Nouvelle rotation
    </a>
</div>

{# TABLE + PAGINATION #}
<div class="card">
    {% if rotations is empty %}
    <div class="empty-state">
        <i class="fa fa-rotate" style="font-size:48px;opacity:0.3;display:block;margin-bottom:16px"></i>
        <p>Aucune rotation enregistrée.</p>
    </div>
    {% else %}
    <table class="data-table" id="rotationTable">
        <thead>
            <tr>
                <th data-col="0">Terrain <i class="fa fa-sort sort-icon"></i></th>
                <th data-col="1">Plante <i class="fa fa-sort sort-icon"></i></th>
                <th data-col="2">Date début <i class="fa fa-sort sort-icon"></i></th>
                <th data-col="3">Date fin <i class="fa fa-sort sort-icon"></i></th>
                <th data-col="4">Statut <i class="fa fa-sort sort-icon"></i></th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="rotationBody">
        {% for rotation in rotations %}
            <tr data-terrain="{{ rotation.terrain.nomTerrain|lower }}"
                data-plante="{{ rotation.plante.nomP|lower }}"
                data-status="{{ rotation.status ? 'Actif' : 'Inactif' }}"
                data-terrain-raw="{{ rotation.terrain.nomTerrain }}"
                data-plante-raw="{{ rotation.plante.nomP }}"
                data-debut-raw="{{ rotation.dateDebut|date('d/m/Y') }}"
                data-fin-raw="{{ rotation.dateFin|date('d/m/Y') }}"
                data-status-raw="{{ rotation.status ? 'Actif' : 'Inactif' }}">
                <td><strong>{{ rotation.terrain.nomTerrain }}</strong></td>
                <td>{{ rotation.plante.nomP }}</td>
                <td>{{ rotation.dateDebut|date('d/m/Y') }}</td>
                <td>{{ rotation.dateFin|date('d/m/Y') }}</td>
                <td>
                    <span class="badge {{ rotation.status ? 'badge-active' : 'badge-inactive' }}">
                        {{ rotation.status ? 'Actif' : 'Inactif' }}
                    </span>
                </td>
                <td>
                    <div class="actions">
                        <a href="{{ path('admin_rotations_show', {id: rotation.id}) }}" class="btn-show"><i class="fa fa-eye"></i></a>
                        <a href="{{ path('admin_rotations_edit', {id: rotation.id}) }}" class="btn-edit"><i class="fa fa-pen"></i></a>
                        <form method="post" action="{{ path('admin_rotations_delete', {id: rotation.id}) }}" onsubmit="return confirm('Supprimer cette rotation ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete'~rotation.id) }}">
                            <button class="btn-danger"><i class="fa fa-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="no-results" id="noResults">
        <i class="fa fa-magnifying-glass" style="font-size:32px;opacity:0.3;display:block;margin-bottom:12px"></i>
        Aucun résultat trouvé.
    </div>

    {# PAGINATION #}
    <div class="pagination-wrap">
        <div class="pagination-info" id="paginationInfo"></div>
        <div style="display:flex;align-items:center;gap:10px;">
            <select class="per-page-select" id="perPageSelect">
                <option value="5">5 / page</option>
                <option value="10" selected>10 / page</option>
                <option value="25">25 / page</option>
                <option value="50">50 / page</option>
            </select>
            <div class="pagination-btns" id="paginationBtns"></div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<script>
// Variables globales
let allRows = [];
let filteredRows = [];
let currentPage = 1;
let perPage = 10;

const searchInput = document.getElementById('searchInput');
const filterStatus = document.getElementById('filterStatus');
const resultCount = document.getElementById('resultCount');
const noResults = document.getElementById('noResults');
const tbody = document.getElementById('rotationBody');
const perPageSelect = document.getElementById('perPageSelect');

// Initialisation
window.addEventListener('DOMContentLoaded', () => {
    if (!tbody) return;
    allRows = Array.from(tbody.querySelectorAll('tr'));
    applyFilterAndPaginate();
});

// Filtrage + Pagination
function applyFilterAndPaginate() {
    const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const status = filterStatus ? filterStatus.value : '';

    filteredRows = allRows.filter(row => {
        const terrain = (row.dataset.terrain || '').toLowerCase();
        const plante  = (row.dataset.plante || '').toLowerCase();
        const st      = row.dataset.status || '';

        const matchSearch = !q || terrain.includes(q) || plante.includes(q);
        const matchStatus = !status || st === status;

        return matchSearch && matchStatus;
    });

    currentPage = 1;
    renderPage();
}

if (searchInput) searchInput.addEventListener('input', applyFilterAndPaginate);
if (filterStatus) filterStatus.addEventListener('change', applyFilterAndPaginate);
if (perPageSelect) perPageSelect.addEventListener('change', () => {
    perPage = parseInt(perPageSelect.value);
    currentPage = 1;
    renderPage();
});

function renderPage() {
    if (!tbody) return;

    const total = filteredRows.length;
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * perPage;
    const end = Math.min(start + perPage, total);

    // Masquer toutes les lignes puis afficher seulement celles de la page
    allRows.forEach(r => r.classList.add('hidden-row'));
    filteredRows.slice(start, end).forEach(r => r.classList.remove('hidden-row'));

    // Mise à jour du compteur
    if (resultCount) resultCount.textContent = total + ' résultat' + (total > 1 ? 's' : '');
    if (noResults) noResults.style.display = total === 0 ? 'block' : 'none';

    // Info pagination
    const info = document.getElementById('paginationInfo');
    if (info) {
        info.textContent = total === 0 
            ? 'Aucun résultat' 
            : `${start + 1}–${end} sur ${total} rotation${total > 1 ? 's' : ''}`;
    }

    renderPaginationBtns(totalPages);
}

function renderPaginationBtns(totalPages) {
    const wrap = document.getElementById('paginationBtns');
    if (!wrap) return;
    wrap.innerHTML = '';

    const mkBtn = (label, page, disabled, active) => {
        const b = document.createElement('button');
        b.className = 'page-btn' + (active ? ' active' : '');
        b.innerHTML = label;
        b.disabled = disabled;
        if (!disabled) b.addEventListener('click', () => {
            currentPage = page;
            renderPage();
        });
        return b;
    };

    // Bouton Précédent
    wrap.appendChild(mkBtn('<i class="fa fa-chevron-left"></i>', currentPage - 1, currentPage === 1, false));

    // Numéros de pages
    let pages = [];
    if (totalPages <= 7) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
        pages = [1];
        if (currentPage > 3) pages.push('…');
        for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) pages.push(i);
        if (currentPage < totalPages - 2) pages.push('…');
        pages.push(totalPages);
    }

    pages.forEach(p => {
        if (p === '…') {
            const sp = document.createElement('span');
            sp.textContent = '…';
            sp.style.cssText = 'padding:0 6px;color:var(--text-muted);line-height:34px';
            wrap.appendChild(sp);
        } else {
            wrap.appendChild(mkBtn(p, p, false, p === currentPage));
        }
    });

    // Bouton Suivant
    wrap.appendChild(mkBtn('<i class="fa fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages, false));
}

// Tri par colonne
let sortCol = -1, sortAsc = true;
document.querySelectorAll('th[data-col]').forEach(th => {
    th.addEventListener('click', () => {
        const col = parseInt(th.dataset.col);

        document.querySelectorAll('th[data-col]').forEach(t => {
            t.classList.remove('sort-asc', 'sort-desc');
            const ic = t.querySelector('.sort-icon');
            if (ic) ic.className = 'fa fa-sort sort-icon';
        });

        sortAsc = (sortCol === col) ? !sortAsc : true;
        sortCol = col;
        th.classList.add(sortAsc ? 'sort-asc' : 'sort-desc');
        const thIcon = th.querySelector('.sort-icon');
        if (thIcon) thIcon.className = 'fa fa-sort-' + (sortAsc ? 'up' : 'down') + ' sort-icon';

        // Tri des lignes filtrées
        filteredRows.sort((a, b) => {
            const aVal = a.cells[col]?.textContent.trim() || '';
            const bVal = b.cells[col]?.textContent.trim() || '';
            const aNum = parseFloat(aVal.replace(/[^\d.]/g, ''));
            const bNum = parseFloat(bVal.replace(/[^\d.]/g, ''));
            if (!isNaN(aNum) && !isNaN(bNum)) return sortAsc ? aNum - bNum : bNum - aNum;
            return sortAsc ? aVal.localeCompare(bVal, 'fr') : bVal.localeCompare(aVal, 'fr');
        });

        filteredRows.forEach(r => tbody.appendChild(r));
        currentPage = 1;
        renderPage();
    });
});

// ====================== EXPORT PDF ======================
function exportPDF() {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });

    doc.setFillColor(45, 90, 39);
    doc.rect(0, 0, 297, 22, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFontSize(16);
    doc.setFont('helvetica', 'bold');
    doc.text('AgroFlow — Liste des Rotations', 14, 15);

    doc.setFontSize(10);
    doc.setFont('helvetica', 'normal');
    doc.text('Exporté le ' + new Date().toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }), 200, 15);

    const rows = filteredRows.map(tr => [
        tr.dataset.terrainRaw || '—',
        tr.dataset.planteRaw || '—',
        tr.dataset.debutRaw || '—',
        tr.dataset.finRaw || '—',
        tr.dataset.statusRaw || '—'
    ]);

    doc.autoTable({
        head: [['Terrain', 'Plante', 'Date début', 'Date fin', 'Statut']],
        body: rows,
        startY: 30,
        theme: 'striped',
        headStyles: { fillColor: [74, 140, 63], textColor: 255, fontStyle: 'bold', fontSize: 11 },
        bodyStyles: { fontSize: 10, textColor: [30, 30, 30] },
        alternateRowStyles: { fillColor: [240, 255, 240] },
        columnStyles: {
            0: { cellWidth: 70 },
            1: { cellWidth: 60 },
            2: { cellWidth: 35, halign: 'center' },
            3: { cellWidth: 35, halign: 'center' },
            4: { cellWidth: 40, halign: 'center' }
        },
        margin: { left: 14, right: 14 }
    });

    const pageCount = doc.internal.getNumberOfPages();
    for (let i = 1; i <= pageCount; i++) {
        doc.setPage(i);
        doc.setFontSize(8);
        doc.setTextColor(150);
        doc.text('AgroFlow — Confidentiel', 14, 200);
        doc.text(`Page ${i} / ${pageCount}`, 260, 200);
    }

    doc.save('rotations_agroflow_' + new Date().toISOString().slice(0, 10) + '.pdf');
}
</script>
{% endblock %}