{% extends 'base_admin.html.twig' %}
{% block title %}{{ plante.nomP }} — AgroFlow{% endblock %}
{% block page_title %}Détail de la plante{% endblock %}
{% block breadcrumb %}Plantes / {{ plante.nomP }}{% endblock %}

{% block stylesheets %}
<style>
.actions-top { display:flex; gap:10px; margin-bottom:24px; flex-wrap:wrap; }
.btn-back { display:inline-flex; align-items:center; gap:8px; background:var(--cream-dark); color:var(--navy); padding:9px 18px; border-radius:var(--radius); font-size:14px; font-weight:500; text-decoration:none; }
.btn-edit-top { display:inline-flex; align-items:center; gap:8px; background:var(--green-accent); color:white; padding:9px 18px; border-radius:var(--radius); font-size:14px; font-weight:500; text-decoration:none; }
.btn-arrosage { display:inline-flex; align-items:center; gap:8px; background:#EFF6FF; color:#1D4ED8; border:1px solid #BFDBFE; padding:9px 18px; border-radius:var(--radius); font-size:14px; font-weight:500; cursor:pointer; }
.btn-arrosage:hover { background:#DBEAFE; }

.detail-card { background:var(--white); border-radius:var(--radius); box-shadow:var(--shadow); padding:28px; max-width:600px; }
.detail-card h3 { font-size:16px; font-weight:700; color:var(--navy); margin-bottom:20px; padding-bottom:12px; border-bottom:2px solid var(--green-light); display:flex; align-items:center; gap:8px; }
.detail-row { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-bottom:1px solid var(--cream-dark); font-size:14px; }
.detail-row:last-child { border-bottom:none; }
.detail-label { color:var(--text-muted); font-weight:500; }
.detail-value { font-weight:600; color:var(--navy); }
.badge-plant { background:#DCFCE7; color:#166534; display:inline-block; padding:3px 10px; border-radius:20px; font-size:12px; font-weight:600; }

/* ── Modal ── */
.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; }
.modal-overlay.active { display:flex; }
.modal-box { background:#FFFDF5; border-radius:16px; padding:32px; width:90%; max-width:500px; box-shadow:0 20px 60px rgba(0,0,0,0.2); position:relative; font-family:'DM Sans',sans-serif; animation:modalIn 0.25s ease; }
@keyframes modalIn { from{transform:translateY(20px);opacity:0} to{transform:none;opacity:1} }
.modal-close { position:absolute; top:14px; right:16px; background:none; border:none; font-size:20px; cursor:pointer; color:#999; }
.modal-close:hover { color:#333; }
.modal-title { font-size:18px; font-weight:700; color:#1B3A20; margin-bottom:4px; display:flex; align-items:center; gap:10px; }
.modal-subtitle { font-size:13px; color:#6B7280; margin-bottom:20px; }
.modal-loading { text-align:center; padding:30px 0; color:#6B7280; font-size:14px; }
.modal-loading i { font-size:28px; display:block; margin-bottom:10px; animation:spin 1s linear infinite; }
@keyframes spin { to{transform:rotate(360deg)} }

/* ── Contenu arrosage ── */
.arrosage-hero { text-align:center; margin-bottom:20px; }
.arrosage-hero .drop { font-size:48px; }
.arrosage-hero .litres { font-size:36px; font-weight:700; color:#1D4ED8; line-height:1; margin:8px 0 4px; }
.arrosage-hero .litres-label { font-size:13px; color:#6B7280; }
.arrosage-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px; }
.arrosage-item { background:#EFF6FF; border-radius:10px; padding:12px 14px; }
.arrosage-item-label { font-size:11px; color:#6B7280; font-weight:600; text-transform:uppercase; }
.arrosage-item-val { font-size:18px; font-weight:700; color:#1E3A8A; margin-top:2px; }
.arrosage-meteo { background:#F0FDF4; border-radius:10px; padding:12px 14px; margin-bottom:12px; font-size:13px; color:#166534; }
.arrosage-meteo-label { font-size:11px; color:#6B7280; font-weight:600; text-transform:uppercase; margin-bottom:4px; }
.arrosage-conseil { border-radius:10px; padding:14px; font-size:13px; line-height:1.6; font-weight:500; }
.arrosage-conseil.ok     { background:#D1FAE5; color:#065F46; }
.arrosage-conseil.warn   { background:#FEF3C7; color:#92400E; }
.arrosage-conseil.danger { background:#FEE2E2; color:#991B1B; }
.arrosage-freq { background:#F8FAFF; border:1px solid #BFDBFE; border-radius:10px; padding:12px 14px; margin-top:12px; font-size:13px; color:#1E40AF; }
</style>
{% endblock %}

{% block body %}
<div class="actions-top">
    <a href="{{ path('admin_plantes') }}" class="btn-back">
        <i class="fa fa-arrow-left"></i> Retour
    </a>
    <a href="{{ path('admin_plantes_edit', {id: plante.id}) }}" class="btn-edit-top">
        <i class="fa fa-pen"></i> Modifier
    </a>
    <button class="btn-arrosage"
        onclick="openArrosage('{{ plante.nomP }}', {{ plante.besoinEau ?? 0 }}, {{ plante.cycleJours ?? 0 }})">
        <i class="fa fa-droplet"></i> Arrosage
    </button>
</div>

<div class="detail-card">
    <h3><i class="fa fa-seedling" style="color:var(--green-accent)"></i> Informations de la plante</h3>

    <div class="detail-row">
        <span class="detail-label">ID</span>
        <span class="detail-value" style="font-family:'DM Mono',monospace">#{{ plante.id }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Nom</span>
        <span class="detail-value">{{ plante.nomP }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Variété</span>
        <span class="detail-value">
            {% if plante.variete %}
                <span class="badge-plant">{{ plante.variete }}</span>
            {% else %}
                <span style="color:var(--text-muted)">—</span>
            {% endif %}
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Besoin en eau</span>
        <span class="detail-value">
            {% if plante.besoinEau %}
                {{ plante.besoinEau }} L/j
            {% else %}
                <span style="color:var(--text-muted)">—</span>
            {% endif %}
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Cycle de culture</span>
        <span class="detail-value">
            {% if plante.cycleJours %}
                {{ plante.cycleJours }} jours
            {% else %}
                <span style="color:var(--text-muted)">—</span>
            {% endif %}
        </span>
    </div>
</div>

{# ══ MODAL ARROSAGE ══ #}
<div class="modal-overlay" id="arrosageModal">
    <div class="modal-box">
        <button class="modal-close" onclick="closeModal('arrosageModal')">×</button>
        <div class="modal-title">
            <i class="fa fa-droplet" style="color:#2563EB"></i>
            <span id="arrosageTitle">Arrosage</span>
        </div>
        <div class="modal-subtitle" id="arrosageSubtitle"></div>
        <div id="arrosageContent">
            <div class="modal-loading"><i class="fa fa-spinner"></i> Calcul en cours…</div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
// ══════════════════════════════════════════════════════
// MODAL HELPER
// ══════════════════════════════════════════════════════
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.classList.remove('active'); });
});

// ══════════════════════════════════════════════════════
// ARROSAGE — calcul basé sur besoinEau + météo Open-Meteo
// ══════════════════════════════════════════════════════
async function openArrosage(nom, besoinEau, cycleJours) {
    document.getElementById('arrosageTitle').textContent    = 'Arrosage — ' + nom;
    document.getElementById('arrosageSubtitle').textContent = 'Recommandations personnalisées';
    document.getElementById('arrosageContent').innerHTML    = '<div class="modal-loading"><i class="fa fa-spinner"></i> Calcul en cours…</div>';
    document.getElementById('arrosageModal').classList.add('active');

    // Données météo Tunisie (centre par défaut)
    let temp = 22, humidity = 55, precip = 0, windspeed = 10;
    let meteoDesc = '—';

    try {
        const wResp = await fetch(
            `https://api.open-meteo.com/v1/forecast?latitude=33.8869&longitude=9.5375` +
            `&current_weather=true&hourly=relative_humidity_2m,precipitation&forecast_days=1&timezone=Africa/Tunis`
        );
        const wData = await wResp.json();
        const cw = wData.current_weather;
        const h  = new Date().getHours();
        temp      = cw.temperature ?? 22;
        windspeed = cw.windspeed   ?? 10;
        humidity  = wData.hourly?.relative_humidity_2m?.[h] ?? 55;
        precip    = wData.hourly?.precipitation?.[h]        ?? 0;

        const wcode = cw.weathercode ?? 0;
        if (wcode === 0)                        meteoDesc = '☀️ Ciel dégagé';
        else if (wcode >= 1  && wcode <= 3)     meteoDesc = '⛅ Partiellement nuageux';
        else if (wcode >= 51 && wcode <= 67)    meteoDesc = '🌧️ Pluie';
        else if (wcode >= 80 && wcode <= 82)    meteoDesc = '🌦️ Averses';
        else if (wcode >= 95)                   meteoDesc = '⛈️ Orage';
        else                                    meteoDesc = '🌥️ Nuageux';
    } catch (_) {
        meteoDesc = '⚠️ Météo indisponible';
    }

    // ── Calcul du besoin ajusté ──────────────────────────
    const base = besoinEau > 0 ? besoinEau : 2; // L/j par défaut si non renseigné
    let facteur = 1.0;
    if (temp > 35)      facteur += 0.4;
    else if (temp > 30) facteur += 0.2;
    if (humidity < 30)  facteur += 0.2;
    else if (humidity > 70) facteur -= 0.15;
    if (windspeed > 30) facteur += 0.1;
    if (precip > 5)     facteur -= 0.5;
    if (precip > 15)    facteur -= 0.8;
    facteur = Math.max(0, Math.min(2, facteur));

    const besoinAjuste = Math.round(base * facteur * 10) / 10;

    // ── Fréquence recommandée ────────────────────────────
    let freqLabel = '1 fois / jour';
    let freqDetail = 'Arrosage matin et soir recommandé par forte chaleur.';
    if (temp < 20 && humidity > 60) {
        freqLabel  = '1 fois tous les 2 jours';
        freqDetail = 'Conditions fraîches — réduire la fréquence.';
    } else if (precip > 5) {
        freqLabel  = 'Pas d\'arrosage aujourd\'hui';
        freqDetail = 'La pluie couvre les besoins de la plante.';
    } else if (temp > 32) {
        freqLabel  = '2 fois / jour';
        freqDetail = 'Forte chaleur — arroser tôt le matin (6h–8h) et en soirée (18h–20h).';
    }

    // ── Meilleur moment ─────────────────────────────────
    let momentLabel = '🌅 Tôt le matin (6h–8h)';
    if (temp > 32) momentLabel = '🌅 6h–8h et 🌇 18h–20h';
    if (precip > 5) momentLabel = '— (pas nécessaire)';

    // ── Conseil coloré ───────────────────────────────────
    let conseilClass = 'ok', conseilTexte = '';
    if (precip > 5) {
        conseilClass = 'ok';
        conseilTexte = '✅ Pluie détectée — Pas d\'arrosage nécessaire aujourd\'hui. Vérifiez le drainage si sol argileux.';
    } else if (temp > 35 || humidity < 30) {
        conseilClass = 'danger';
        conseilTexte = '🔥 Conditions stressantes — Augmenter la dose et arroser en dehors des heures chaudes pour éviter l\'évaporation.';
    } else if (temp > 28) {
        conseilClass = 'warn';
        conseilTexte = '⚠️ Chaleur modérée — Surveiller l\'humidité du sol et adapter selon l\'aspect des feuilles.';
    } else {
        conseilClass = 'ok';
        conseilTexte = '💧 Conditions idéales — Arrosage régulier suffisant selon le besoin de base de la plante.';
    }

    // ── Cycle restant ────────────────────────────────────
    const cycleInfo = cycleJours > 0
        ? `<div class="arrosage-freq">🌱 <strong>Cycle de culture :</strong> ${cycleJours} jours — Volume total estimé : <strong>${Math.round(base * cycleJours)} L</strong> sur le cycle complet.</div>`
        : '';

    document.getElementById('arrosageContent').innerHTML = `
        <div class="arrosage-hero">
            <div class="drop">💧</div>
            <div class="litres">${besoinAjuste} L/j</div>
            <div class="litres-label">Besoin ajusté selon météo${besoinEau > 0 ? ' (base : ' + besoinEau + ' L/j)' : ' (base estimée)'}</div>
        </div>

        <div class="arrosage-grid">
            <div class="arrosage-item">
                <div class="arrosage-item-label">🌡️ Température</div>
                <div class="arrosage-item-val">${temp} °C</div>
            </div>
            <div class="arrosage-item">
                <div class="arrosage-item-label">💧 Humidité air</div>
                <div class="arrosage-item-val">${humidity} %</div>
            </div>
            <div class="arrosage-item">
                <div class="arrosage-item-label">🌧️ Précipitations</div>
                <div class="arrosage-item-val">${precip} mm</div>
            </div>
            <div class="arrosage-item">
                <div class="arrosage-item-label">💨 Vent</div>
                <div class="arrosage-item-val">${windspeed} km/h</div>
            </div>
        </div>

        <div class="arrosage-meteo">
            <div class="arrosage-meteo-label">Conditions actuelles</div>
            ${meteoDesc}
        </div>

        <div class="arrosage-grid" style="margin-bottom:12px">
            <div class="arrosage-item">
                <div class="arrosage-item-label">📅 Fréquence</div>
                <div class="arrosage-item-val" style="font-size:13px;line-height:1.3">${freqLabel}</div>
            </div>
            <div class="arrosage-item">
                <div class="arrosage-item-label">⏰ Meilleur moment</div>
                <div class="arrosage-item-val" style="font-size:13px;line-height:1.3">${momentLabel}</div>
            </div>
        </div>

        <div class="arrosage-conseil ${conseilClass}">${conseilTexte}</div>
        <div style="font-size:12px;color:#9CA3AF;margin-top:8px">💡 ${freqDetail}</div>
        ${cycleInfo}`;
}
</script>
{% endblock %}
