{% extends 'base_agriculteur.html.twig' %}

{% block title %}AgroFlow - {{ 'animal.details_title'|trans({'%name%': animaux.nom}) }}{% endblock %}

{% block body %}
<!-- Sélecteur de langue - EN HAUT -->
<div style="width: 100%; padding: 15px 30px; background: white; display: flex; justify-content: flex-end; gap: 10px; border-bottom: 1px solid #E9ECEF;">
    <a href="{{ path('app_set_locale', {'locale': 'fr'}) }}" 
       style="display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border-radius: 6px; background: {{ app.request.locale == 'fr' ? '#2D5A27' : '#f0f0f0' }}; color: {{ app.request.locale == 'fr' ? 'white' : '#2C3E50' }}; border: 1px solid {{ app.request.locale == 'fr' ? '#2D5A27' : '#ddd' }}; font-size: 13px; text-decoration: none; font-weight: 600; cursor: pointer;">
        🇫🇷 FR
    </a>
    <a href="{{ path('app_set_locale', {'locale': 'en'}) }}" 
       style="display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border-radius: 6px; background: {{ app.request.locale == 'en' ? '#2D5A27' : '#f0f0f0' }}; color: {{ app.request.locale == 'en' ? 'white' : '#2C3E50' }}; border: 1px solid {{ app.request.locale == 'en' ? '#2D5A27' : '#ddd' }}; font-size: 13px; text-decoration: none; font-weight: 600; cursor: pointer;">
        🇬🇧 EN
    </a>
    <a href="{{ path('app_set_locale', {'locale': 'es'}) }}" 
       style="display: inline-flex; align-items: center; justify-content: center; padding: 8px 14px; border-radius: 6px; background: {{ app.request.locale == 'es' ? '#2D5A27' : '#f0f0f0' }}; color: {{ app.request.locale == 'es' ? 'white' : '#2C3E50' }}; border: 1px solid {{ app.request.locale == 'es' ? '#2D5A27' : '#ddd' }}; font-size: 13px; text-decoration: none; font-weight: 600; cursor: pointer;">
        🇪🇸 ES
    </a>
</div>

<div style="padding: 10px;">

    <!-- Header : Breadcrumb -->
    <div style="margin-bottom: 25px; color: #666; font-size: 14px;">
        <span>{{ 'breadcrumb.management'|trans }}</span> <i class="fa fa-chevron-right" style="font-size: 10px; margin: 0 5px;"></i> 
        <span>{{ 'breadcrumb.animals'|trans }}</span> <i class="fa fa-chevron-right" style="font-size: 10px; margin: 0 5px;"></i> 
        <strong style="color: #2C3E50;">{{ 'breadcrumb.profile'|trans }}</strong>
    </div>

    <div style="display: grid; grid-template-columns: 350px 1fr; gap: 30px;">
        
        <!-- Colonne Gauche : Carte Identité -->
        <div>
            <div style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); overflow: hidden; position: sticky; top: 100px;">
                <div style="background: linear-gradient(135deg, #2D5A27, #1B3A20); height: 120px; position: relative;">
                    <div style="position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); width: 100px; height: 100px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border: 4px solid white;">
                        <i class="fa fa-{{ animaux.espece|lower == 'vache' ? 'cow' : (animaux.espece|lower == 'chien' ? 'dog' : 'paw') }}" style="font-size: 40px; color: #2D5A27;"></i>
                    </div>
                </div>
                
                <div style="padding: 60px 30px 30px 30px; text-align: center;">
                    <h2 style="margin: 0; color: #2C3E50; font-size: 24px; font-weight: 800;">{{ animaux.nom }}</h2>
                    <p style="margin: 5px 0 20px 0; color: #7f8c8d; font-weight: 600; text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">{{ ('animal.species.' ~ animaux.espece)|trans }} • {{ ('animal.sex.' ~ animaux.sexe)|trans }}</p>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 25px;">
                        <div style="background: #F8F9FA; padding: 15px; border-radius: 12px;">
                            <span style="display: block; font-size: 11px; color: #999; text-transform: uppercase;">{{ 'animal.weight'|trans }}</span>
                            <strong style="font-size: 18px; color: #2D5A27;">{{ animaux.poids }} <small>{{ 'animal.weight_unit'|trans }}</small></strong>
                        </div>
                        <div style="background: #F8F9FA; padding: 15px; border-radius: 12px;">
                            <span style="display: block; font-size: 11px; color: #999; text-transform: uppercase;">{{ 'animal.age'|trans }}</span>
                            <strong style="font-size: 18px; color: #2C3E50;">
                                {{ animaux.dateNaissance ? date().diff(animaux.dateNaissance).y : '?' }} <small>{{ 'animal.age_unit'|trans }}</small>
                            </strong>
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <a href="{{ path('app_animaux_edit', {'id': animaux.id}) }}" style="background: #2D5A27; color: white; padding: 12px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 14px; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <i class="fa fa-edit"></i> {{ 'animal.edit_profile'|trans }}
                        </a>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                            <a href="{{ path('app_animaux_export_card', {'id': animaux.id}) }}" target="_blank" style="background: #EEEDFE; color: #534AB7; padding: 10px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 5px;">
                                <i class="fa fa-id-card"></i> {{ 'animal.export_id'|trans }}
                            </a>
                            <a href="{{ path('app_animaux_export_medical', {'id': animaux.id}) }}" target="_blank" style="background: #FFF5F5; color: #E74C3C; padding: 10px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 5px;">
                                <i class="fa fa-file-medical"></i> {{ 'animal.medical_file'|trans }}
                            </a>
                        </div>

                        <a href="{{ path('app_animaux_index') }}" style="background: white; color: #7f8c8d; padding: 10px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 13px; border: 1px solid #E9ECEF; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px;">
                            <i class="fa fa-arrow-left"></i> {{ 'animal.back'|trans }}
                        </a>
                    </div>
                </div>
            </div>
            
            <div style="margin-top: 25px; background: linear-gradient(135deg, #FFFDF5, #F9FDF5); border: 1px solid #A8C69F; border-radius: 20px; padding: 25px; text-align: center; box-shadow: 0 10px 20px rgba(45, 90, 39, 0.05); position: relative; overflow: hidden;">
                <div style="position: absolute; top: -10px; right: -10px; opacity: 0.1;">
                    <i class="fa fa-handshake" style="font-size: 60px; color: #2D5A27;"></i>
                </div>
                <h4 style="margin: 0 0 10px 0; color: #1B3A20; font-size: 16px; font-weight: 800;">
                    <i class="fa fa-users-viewfinder" style="color: #2D5A27;"></i> {{ 'animal.agroflow_connect'|trans }}
                </h4>
                <p style="margin: 0; font-size: 13px; color: #555; line-height: 1.5;">
                    {{ 'animal.agroflow_connect_desc'|trans }}
                </p>
                <a href="{{ path('agri_evenements') }}" style="display: inline-block; margin-top: 15px; background: #2D5A27; color: white; padding: 10px 20px; border-radius: 12px; text-decoration: none; font-weight: 700; font-size: 13px; transition: 0.3s; box-shadow: 0 4px 10px rgba(45, 90, 39, 0.2);">
                    {{ 'animal.find_partner'|trans }}
                </a>
            </div>
        </div>

        <!-- Colonne Droite : Dossier Médical (Examens) -->
        <div>
            <div style="background: white; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); padding: 35px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                    <h3 style="margin: 0; color: #2C3E50; font-size: 20px; display: flex; align-items: center; gap: 12px;">
                        <i class="fa fa-notes-medical" style="color: #e74c3c;"></i> {{ 'animal.medical_timeline'|trans }}
                    </h3>
                    <a href="{{ path('app_examens_new', {'animal': animaux.id}) }}" style="background: #2D5A27; color: white; padding: 10px 18px; border-radius: 10px; text-decoration: none; font-weight: 700; font-size: 13px; transition: 0.3s; box-shadow: 0 4px 10px rgba(45, 90, 39, 0.2);">
                        <i class="fa fa-plus-circle"></i> {{ 'animal.new_report'|trans }}
                    </a>
                </div>

                {% if animaux.examen|length > 0 %}
                    <div style="position: relative;">
                        <div style="position: absolute; left: 24px; top: 0; bottom: 0; width: 3px; background: linear-gradient(to bottom, #E74C3C, #F1F3F5); z-index: 0; border-radius: 3px;"></div>
                        
                        <div style="display: flex; flex-direction: column; gap: 25px;">
                            {% for examen in animaux.examen|sort((a, b) => b.dateExamen <=> a.dateExamen) %}
                                <div style="display: flex; gap: 25px; position: relative; z-index: 1;">
                                    <div style="width: 50px; height: 50px; background: white; border: 3px solid {{ examen.typeExamen == 'Vaccin' ? '#2ecc71' : (examen.typeExamen == 'Radio' ? '#3498db' : '#e74c3c') }}; border-radius: 15px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                        <i class="fa fa-{{ examen.typeExamen == 'Vaccin' ? 'syringe' : (examen.typeExamen == 'Radio' ? 'radiation' : 'stethoscope') }}" style="color: {{ examen.typeExamen == 'Vaccin' ? '#2ecc71' : (examen.typeExamen == 'Radio' ? '#3498db' : '#e74c3c') }}; font-size: 20px;"></i>
                                    </div>
                                    <div style="background: white; padding: 22px; border-radius: 18px; flex: 1; border: 1px solid #E9ECEF; box-shadow: 0 4px 15px rgba(0,0,0,0.02); transition: 0.3s;" onmouseover="this.style.transform='translateX(5px)'; this.style.borderColor='#2D5A27';">
                                        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; align-items: flex-start;">
                                            <div>
                                                <strong style="color: #2C3E50; font-size: 17px; display: block;">{{ ('report.exam_type.' ~ examen.typeExamen)|trans }}</strong>
                                                <span style="color: #999; font-size: 12px; font-weight: 600;"><i class="fa fa-clock"></i> {{ examen.dateExamen|date('d/m/Y') }}</span>
                                            </div>
                                            <span style="background: {{ examen.diagnostic == 'En bonne santé' ? '#E8F5E2' : '#FFF0F0' }}; color: {{ examen.diagnostic == 'En bonne santé' ? '#2D5A27' : '#E74C3C' }}; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase;">
                                                {{ ('report.diagnostic.' ~ examen.diagnostic)|trans }}
                                            </span>
                                        </div>
                                        <div style="background: #F8F9FA; padding: 12px 15px; border-radius: 12px; border-left: 4px solid #2D5A27;">
                                            <span style="display: block; font-size: 10px; color: #999; text-transform: uppercase; margin-bottom: 3px;">{{ 'animal.treatment_prescribed'|trans }}</span>
                                            <p style="margin: 0; color: #1B3A20; font-size: 14px; font-weight: 600;">{{ ('report.treatment.' ~ examen.traitement)|trans }}</p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 60px 40px; color: #999; background: #F8F9FA; border-radius: 20px; border: 2px dashed #E9ECEF;">
                        <i class="fa fa-folder-open" style="font-size: 50px; margin-bottom: 15px; opacity: 0.2;"></i>
                        <p style="margin: 0; font-weight: 600;">{{ 'animal.no_medical_record_title'|trans }}</p>
                        <p style="font-size: 14px; margin-top: 5px;">{{ 'animal.no_medical_record_desc'|trans }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
