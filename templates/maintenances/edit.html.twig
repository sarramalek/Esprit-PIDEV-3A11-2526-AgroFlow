{% extends 'agriculteur_dashboard.html.twig' %}

{% block title %}Modifier Maintenance #{{ maintenance.idMain }} — AgroFlow{% endblock %}

{% block body %}
<style>
    .me-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.75rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    .me-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
        color: #5f7a5f;
        margin-bottom: 1.5rem;
    }
    .me-breadcrumb a { color: #2d6a2d; text-decoration: none; font-weight: 500; }
    .me-breadcrumb a:hover { text-decoration: underline; }
    .me-breadcrumb__sep { color: #aac2aa; }

    .me-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .me-header__left h1 {
        margin: 0 0 0.3rem;
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a2e1a;
        letter-spacing: -0.02em;
    }
    .me-header__left p {
        margin: 0;
        font-size: 0.875rem;
        color: #6b8c6b;
    }
    .me-header__left p .req { color: #a32d2d; }

    .btn-show {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.62rem 1.2rem;
        border-radius: 10px;
        border: 1.5px solid #d0e4cc;
        color: #5f7a5f;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        background: transparent;
        transition: background 0.14s;
    }
    .btn-show:hover { background: #f2f8ee; }

    .alert-error {
        background-color: #fef2f2;
        border: 1px solid #f5c6cb;
        color: #c53030;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }
</style>

<div class="me-page">
    <nav class="me-breadcrumb">
        <a href="{{ path('agri_maintenances_index') }}">Maintenances</a>
        <span class="me-breadcrumb__sep">›</span>
        <a href="{{ path('agri_maintenances_show', {id: maintenance.idMain}) }}">#{{ maintenance.idMain }}</a>
        <span class="me-breadcrumb__sep">›</span>
        <span>Modifier</span>
    </nav>

    <div class="me-header">
        <div class="me-header__left">
            <h1>✏️ Modifier Maintenance #{{ maintenance.idMain }}</h1>
            <p>Les champs marqués d'un <span class="req">*</span> sont obligatoires</p>
        </div>
        <a href="{{ path('agri_maintenances_show', {id: maintenance.idMain}) }}" class="btn-show">
            👁 Voir la fiche
        </a>
    </div>

    {% if form.vars.submitted and not form.vars.valid %}
        <div class="alert-error">
            ⚠️ Le formulaire contient des erreurs. Veuillez les corriger avant de continuer.
        </div>
    {% endif %}

    {% include 'maintenances/form.html.twig' with {
        'form': form,
        'btn_label': '💾 Mettre à jour',
        'cancel_url': path('agri_maintenances_show', {id: maintenance.idMain})
    } only %}

</div>
{% endblock %}