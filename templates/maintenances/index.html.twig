// ══ PAGINATION ══
const pgState = {
    cards: { page: 1, perPage: 9,  filteredItems: [] },
    table: { page: 1, perPage: 10, filteredItems: [] },
};

/**
 * Applique la pagination sur un ensemble d'éléments déjà filtrés/triés.
 * @param {string} view   - 'cards' ou 'table'
 * @param {Array}  items  - éléments DOM visibles après filtrage
 */
function applyPagination(view, items) {
    const state   = pgState[view];
    state.filteredItems = items;

    // Recalage de la page si nécessaire (ex. : filtre réduit le total)
    const perPage  = parseInt(state.perPage) || 0;
    const total    = items.length;
    const totalPgs = perPage === 0 ? 1 : Math.max(1, Math.ceil(total / perPage));
    if (state.page > totalPgs) state.page = totalPgs;
    if (state.page < 1)        state.page = 1;

    const startIdx = perPage === 0 ? 0          : (state.page - 1) * perPage;
    const endIdx   = perPage === 0 ? total       : Math.min(startIdx + perPage, total);

    // Masquer / afficher selon la page courante
    items.forEach((el, idx) => {
        el.style.display = (idx >= startIdx && idx < endIdx) ? '' : 'none';
    });

    // Affichage "0 résultat" géré ici uniquement si total > 0
    const noResId = view === 'cards' ? 'noResultsCards' : 'noResultsTable';
    document.getElementById(noResId).style.display = total === 0 ? 'block' : 'none';

    renderPaginationBar(view, state.page, totalPgs, startIdx + 1, Math.min(endIdx, total), total);
}

/**
 * Génère les boutons de pagination.
 */
function renderPaginationBar(view, page, totalPgs, from, to, total) {
    const infoEl     = document.getElementById('pgInfo'     + (view === 'cards' ? 'Cards' : 'Table'));
    const controlsEl = document.getElementById('pgControls' + (view === 'cards' ? 'Cards' : 'Table'));

    // Info textuelle
    if (total === 0) {
        infoEl.innerHTML = 'Aucun résultat';
    } else {
        infoEl.innerHTML = `Affichage <strong>${from}–${to}</strong> sur <strong>${total}</strong>`;
    }

    // Boutons
    controlsEl.innerHTML = '';
    if (total === 0 || totalPgs <= 1) return;

    // Précédent
    const prev = document.createElement('button');
    prev.className = 'pg-btn pg-btn--prev';
    prev.textContent = '‹';
    prev.disabled    = page <= 1;
    prev.addEventListener('click', () => goToPage(view, page - 1));
    controlsEl.appendChild(prev);

    // Pages numérotées avec ellipses
    const pages = buildPageRange(page, totalPgs);
    pages.forEach(p => {
        if (p === '…') {
            const el = document.createElement('span');
            el.className   = 'pg-ellipsis';
            el.textContent = '…';
            controlsEl.appendChild(el);
        } else {
            const btn = document.createElement('button');
            btn.className   = 'pg-btn' + (p === page ? ' active' : '');
            btn.textContent = p;
            if (p !== page) btn.addEventListener('click', () => goToPage(view, p));
            controlsEl.appendChild(btn);
        }
    });

    // Suivant
    const next = document.createElement('button');
    next.className = 'pg-btn pg-btn--next';
    next.textContent = '›';
    next.disabled    = page >= totalPgs;
    next.addEventListener('click', () => goToPage(view, page + 1));
    controlsEl.appendChild(next);
}

/**
 * Construit le tableau de pages à afficher (avec ellipses).
 * Fenêtre glissante : toujours afficher 1, dernière, +/-2 autour de la page active.
 */
function buildPageRange(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const delta = 2;
    const range = [];
    const left  = Math.max(2, current - delta);
    const right = Math.min(total - 1, current + delta);

    range.push(1);
    if (left > 2)       range.push('…');
    for (let i = left; i <= right; i++) range.push(i);
    if (right < total - 1) range.push('…');
    range.push(total);
    return range;
}

function goToPage(view, page) {
    pgState[view].page = page;
    applyPagination(view, pgState[view].filteredItems);
    // Scroll en haut de la liste
    const container = view === 'cards' ? document.getElementById('cardsGrid') : document.getElementById('maintBody');
    if (container) container.closest('.mp').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function setPerPage(view, val) {
    pgState[view].perPage = parseInt(val) || 0;
    pgState[view].page    = 1; // retour à la page 1
    applyPagination(view, pgState[view].filteredItems);
}

// ══ MODAL IA ══
let aiActiveTab   = 'prompt';
let aiCalYear     = new Date().getFullYear();
let aiCalMonth    = new Date().getMonth();
let aiMachineData = {};
let aiEvents      = [];

function openAIPrompt(id, type, priorite, km, nom, statut, cout, description) {
    aiMachineData = { id, type: type||'—', priorite: priorite||'moyenne', km: parseInt(km)||0,
                      nom: nom||'Machine', statut: statut||'planifie', cout: parseFloat(cout)||0,
                      description: description||'' };
    document.getElementById('aiMachinePill').textContent = nom || 'Machine';
    document.getElementById('aiMachineInfo').innerHTML =
        `Panne <strong>${type}</strong> · priorité <strong>${priorite}</strong> · ${km} km`;
    aiCalYear  = new Date().getFullYear();
    aiCalMonth = new Date().getMonth();
    aiEvents   = [];
    document.getElementById('aiModal').classList.add('show');
    switchAITab('prompt');
    renderAICal();
    renderAILifeLocal();
}

function closeAIModal() {
    document.getElementById('aiModal').classList.remove('show');
}

function switchAITab(t) {
    aiActiveTab = t;
    ['prompt','cal','life'].forEach(tab => {
        document.getElementById('aitab-'  + tab)?.classList.toggle('active', tab === t);
        document.getElementById('aipanel-'+ tab).style.display = tab === t ? 'block' : 'none';
    });
}

function setAISug(chip, txt) {
    document.querySelectorAll('.modal-chip').forEach(c => c.classList.remove('sel'));
    chip.classList.add('sel');
    document.getElementById('aiPromptTxt').value = txt;
}

// ── Calendrier ──
function aiCalNav(d) {
    aiCalMonth += d;
    if (aiCalMonth > 11) { aiCalMonth = 0; aiCalYear++; }
    if (aiCalMonth <  0) { aiCalMonth = 11; aiCalYear--; }
    renderAICal();
}

function renderAICal() {
    const months = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
    document.getElementById('aiCalTitle').textContent = months[aiCalMonth] + ' ' + aiCalYear;
    const grid = document.getElementById('aiCalGrid');
    grid.innerHTML = '';
    ['Lu','Ma','Me','Je','Ve','Sa','Di'].forEach(d => {
        const c = document.createElement('div'); c.className = 'modal-cal-hdr'; c.textContent = d; grid.appendChild(c);
    });
    const first    = new Date(aiCalYear, aiCalMonth, 1);
    const startDay = (first.getDay() + 6) % 7;
    const daysInM  = new Date(aiCalYear, aiCalMonth + 1, 0).getDate();
    const daysInP  = new Date(aiCalYear, aiCalMonth, 0).getDate();
    const today    = new Date();
    for (let i = 0; i < startDay; i++) {
        const c = document.createElement('div'); c.className = 'modal-cal-cell other-month';
        c.textContent = daysInP - startDay + 1 + i; grid.appendChild(c);
    }
    for (let d = 1; d <= daysInM; d++) {
        const c   = document.createElement('div'); c.className = 'modal-cal-cell';
        c.textContent = d;
        const evs = aiEvents.filter(e => e.day === d && e.month === aiCalMonth && e.year === aiCalYear);
        if (evs.length) {
            c.classList.add('has-event');
            if (evs.some(e => e.color === 'red')) c.classList.add('urgent');
            const dot = document.createElement('div');
            dot.style.cssText = `width:5px;height:5px;border-radius:50%;margin-top:2px;background:${evs[0].color==='red'?'#A32D2D':evs[0].color==='amber'?'#854F0B':'#3B6D11'}`;
            c.appendChild(dot);
        }
        if (d === today.getDate() && aiCalMonth === today.getMonth() && aiCalYear === today.getFullYear())
            c.classList.add('today');
        grid.appendChild(c);
    }
    const rem = (7 - (startDay + daysInM) % 7) % 7;
    for (let i = 1; i <= rem; i++) {
        const c = document.createElement('div'); c.className = 'modal-cal-cell other-month'; c.textContent = i; grid.appendChild(c);
    }
    const list = document.getElementById('aiEventList');
    list.innerHTML = '';
    const visible = aiEvents.filter(e => e.month === aiCalMonth && e.year === aiCalYear).sort((a,b) => a.day - b.day);
    if (!visible.length) {
        list.innerHTML = '<div style="font-size:12px;color:#7a9a7a;padding:.3rem 0;">Aucune intervention ce mois — cliquez Générer pour planifier.</div>';
        return;
    }
    visible.forEach(e => {
        const item = document.createElement('div'); item.className = 'modal-event-item';
        const bc   = e.color === 'red' ? 'eb-red' : e.color === 'amber' ? 'eb-amber' : 'eb-green';
        const bg   = e.color === 'red' ? '#A32D2D' : e.color === 'amber' ? '#854F0B' : '#3B6D11';
        const lab  = e.prio  === 'urgente' ? 'Urgente' : e.prio === 'haute' ? 'Haute' : 'Normale';
        item.innerHTML = `<div class="modal-event-dot" style="background:${bg}"></div>
            <span class="modal-event-date">${String(e.day).padStart(2,'0')}/${String(e.month+1).padStart(2,'0')}/${e.year}</span>
            <span class="modal-event-label">${e.label}</span>
            <span class="modal-event-badge ${bc}">${lab}</span>`;
        list.appendChild(item);
    });
}

// ── Durée de vie (calcul local) ──
function renderAILifeLocal() {
    const km  = aiMachineData.km || 0;
    const maxKm = 20000;
    const penalite = {urgente:25,haute:15,moyenne:8,faible:3}[aiMachineData.priorite] || 8;
    const vie = Math.max(0, Math.min(100, Math.round(((maxKm - km) / maxKm) * 100)) - penalite);
    const ans = Math.max(0, ((maxKm - km) / 3000)).toFixed(1);
    const risque = (aiMachineData.priorite === 'urgente' || km > 15000) ? 'Élevé'
                 : (aiMachineData.priorite === 'haute'   || km > 10000) ? 'Moyen' : 'Faible';
    document.getElementById('aiLifeScore').textContent = vie + '%';
    document.getElementById('aiLifeBar').style.width   = vie + '%';
    document.getElementById('aiLifeYears').textContent  = ans + ' ans';
    document.getElementById('aiLifeRisk').textContent   = risque;
    const composants = [
        {nom:'Moteur',       usure: Math.min(100, Math.round(km/200)),  color:'#A32D2D'},
        {nom:'Transmission', usure: Math.min(100, Math.round(km/300)),  color:'#854F0B'},
        {nom:'Hydraulique',  usure: Math.min(100, Math.round(km/400)),  color:'#0C447C'},
        {nom:'Électricité',  usure: Math.min(100, Math.round(km/600)),  color:'#3B6D11'},
        {nom:'Pneumatique',  usure: Math.min(100, Math.round(km/250)),  color:'#4a1d8c'},
    ];
    const bars = document.getElementById('aiLifeBars');
    bars.innerHTML = '';
    composants.forEach(c => {
        const row = document.createElement('div'); row.className = 'modal-life-bar-row';
        row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div>
            <div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${c.color}"></div></div>
            <div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`;
        bars.appendChild(row);
    });
}

// ── Génération (appels Symfony) ──
function setAIStatus(m) { document.getElementById('aiFooterMsg').textContent = m; }
function setAILoading(on) {
    const btn = document.getElementById('aiGenBtn');
    if (on) { btn.disabled = true; btn.innerHTML = '<span class="loading-spinner"></span> Génération…'; }
    else    { btn.disabled = false; btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Générer'; }
}

async function generateAI() {
    setAILoading(true);
    try {
        if      (aiActiveTab === 'prompt') await aiRunPrompt();
        else if (aiActiveTab === 'cal')    await aiRunCal();
        else                               await aiRunLife();
    } catch(e) {
        setAIStatus('Erreur: ' + e.message);
        showNotification('❌ Erreur: ' + e.message, 'danger');
    }
    setAILoading(false);
}

async function aiRunPrompt() {
    const prompt = document.getElementById('aiPromptTxt').value.trim();
    if (!prompt) { setAIStatus('Entrez une demande'); setAILoading(false); return; }
    setAIStatus('Appel API…');
    const res  = await fetch(`/agriculteur/maintenances/api/generate-custom-prompt/${aiMachineData.id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt })
    });
    const data = await res.json();
    if (data.success) {
        document.getElementById('aiPromptResTxt').textContent = data.response;
        document.getElementById('aiPromptRes').style.display  = 'block';
        setAIStatus('Réponse générée');
    } else {
        setAIStatus('Erreur serveur');
        showNotification('❌ ' + (data.error || 'Erreur'), 'danger');
    }
}

async function aiRunCal() {
    setAIStatus('Chargement du calendrier…');
    const res  = await fetch(`/agriculteur/maintenances/api/calendar/${aiMachineData.id}`);
    const data = await res.json();
    if (data.success) {
        aiEvents = [];
        (data.suggestions || []).forEach(s => {
            const parts = s.date.split('/');
            if (parts.length === 3) {
                aiEvents.push({
                    day: parseInt(parts[0]), month: parseInt(parts[1]) - 1, year: parseInt(parts[2]),
                    label: s.intervention, prio: s.priorite, color: s.color || 'green'
                });
            }
        });
        renderAICal();
        const txt = (data.suggestions || []).map(s =>
            `📅 ${s.date} — ${s.intervention}\n   Durée: ${s.duree} · ${s.technicien}`
        ).join('\n\n');
        document.getElementById('aiCalResTxt').textContent = txt || '—';
        document.getElementById('aiCalRes').style.display  = 'block';
        setAIStatus('Calendrier généré');
    } else {
        setAIStatus('Erreur calendrier');
    }
}

async function aiRunLife() {
    setAIStatus('Analyse durée de vie…');
    const res  = await fetch(`/agriculteur/maintenances/api/lifetime/${aiMachineData.id}`);
    const data = await res.json();
    if (data.success) {
        document.getElementById('aiLifeScore').textContent = data.vieRestante + '%';
        document.getElementById('aiLifeBar').style.width   = data.vieRestante + '%';
        document.getElementById('aiLifeYears').textContent = data.anneesEstimees + ' ans';
        document.getElementById('aiLifeRisk').textContent  = data.risquePanne;
        if (data.composants?.length) {
            const colors = ['#A32D2D','#854F0B','#0C447C','#3B6D11','#4a1d8c'];
            const bars   = document.getElementById('aiLifeBars');
            bars.innerHTML = '';
            data.composants.forEach((c, i) => {
                const row = document.createElement('div'); row.className = 'modal-life-bar-row';
                row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div>
                    <div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${colors[i % colors.length]}"></div></div>
                    <div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`;
                bars.appendChild(row);
            });
        }
        const recs = (data.recommandations || []).map((r, i) => `${i+1}. ${r}`).join('\n');
        document.getElementById('aiLifeResTxt').textContent = recs;
        document.getElementById('aiLifeRes').style.display  = 'block';
        setAIStatus('Analyse terminée');
    } else {
        setAIStatus('Erreur analyse');
    }
}

function resetAITab() {
    ['aiPromptRes','aiCalRes','aiLifeRes'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    document.getElementById('aiPromptTxt').value = '';
    aiEvents = [];
    renderAICal();
    renderAILifeLocal();
    setAIStatus('Réinitialisé');
}

document.getElementById('aiModal').addEventListener('click', function(e) {
    if (e.target === this) closeAIModal();
});

// ══ FILTRES + TRI (avec pagination) ══
function filterItems() {
    const search = (document.getElementById('searchInput').value || '').toLowerCase();
    const type   = (document.getElementById('typeFilter').value   || '').toLowerCase();
    const statut = (document.getElementById('statutFilter').value || '').toLowerCase();
    const prio   = (document.getElementById('prioriteFilter').value || '').toLowerCase();
    const sort   = document.getElementById('sortFilter').value;
    const dir    = document.getElementById('dirFilter').value;
    document.getElementById('resetBtn').style.display = (search||type||statut||prio) ? 'inline-flex' : 'none';

    function matches(el) {
        return (!search || (el.dataset.type||'').toLowerCase().includes(search) || (el.dataset.desc||'').toLowerCase().includes(search) || (el.dataset.nom||'').toLowerCase().includes(search))
            && (!type   || (el.dataset.type  ||'').toLowerCase().includes(type))
            && (!statut || (el.dataset.statut||'').toLowerCase() === statut)
            && (!prio   || (el.dataset.priorite||'').toLowerCase() === prio);
    }

    // ── Vue cartes ──
    const cardsGrid = document.getElementById('cardsGrid');
    if (cardsGrid) {
        const allCards = Array.from(cardsGrid.children).filter(el => el.classList.contains('maint-card-item'));
        // Rendre tout visible d'abord (pour le filtrage)
        allCards.forEach(c => c.style.display = '');
        const matched = allCards.filter(c => matches(c));
        const sorted  = sortItemsArr(matched, sort, dir);
        // Remettre dans le DOM dans l'ordre trié
        sorted.forEach(el => cardsGrid.appendChild(el));
        // Masquer les non-correspondants
        allCards.filter(c => !matches(c)).forEach(c => c.style.display = 'none');
        // Réinitialiser la page 1 à chaque filtre/tri
        pgState.cards.page = 1;
        applyPagination('cards', sorted);
    }

    // ── Vue tableau ──
    const tbody = document.getElementById('maintBody');
    if (tbody) {
        const allRows = Array.from(tbody.querySelectorAll('tr'));
        allRows.forEach(tr => tr.style.display = '');
        const matched = allRows.filter(tr => matches(tr));
        const sorted  = sortItemsArr(matched, sort, dir);
        sorted.forEach(el => tbody.appendChild(el));
        allRows.filter(tr => !matches(tr)).forEach(tr => tr.style.display = 'none');
        pgState.table.page = 1;
        applyPagination('table', sorted);
    }
}

function sortItemsArr(items, sort, dir) {
    return [...items].sort((a, b) => {
        let va, vb;
        switch (sort) {
            case 'cout':     va = parseFloat(a.dataset.cout||0);    vb = parseFloat(b.dataset.cout||0);    break;
            case 'type':     va = a.dataset.type||'';               vb = b.dataset.type||'';               break;
            case 'statut':   va = a.dataset.statut||'';             vb = b.dataset.statut||'';             break;
            case 'priorite': va = parseInt(a.dataset.prioOrder||2); vb = parseInt(b.dataset.prioOrder||2); break;
            case 'km':       va = parseInt(a.dataset.km||0);        vb = parseInt(b.dataset.km||0);        break;
            default:         va = a.dataset.date||'';               vb = b.dataset.date||'';
        }
        if (va < vb) return dir === 'asc' ? -1 : 1;
        if (va > vb) return dir === 'asc' ?  1 : -1;
        return 0;
    });
}

function onSearchInput(input) {
    document.getElementById('clearSearch').classList.toggle('visible', input.value.length > 0);
    filterItems();
}
function clearSearch() {
    const input = document.getElementById('searchInput'); input.value = ''; input.focus();
    document.getElementById('clearSearch').classList.remove('visible');
    filterItems();
}
function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('clearSearch').classList.remove('visible');
    ['typeFilter','statutFilter','prioriteFilter','sortFilter','dirFilter'].forEach(id => {
        const el = document.getElementById(id); if (el) el.selectedIndex = 0;
    });
    filterItems();
}

// ══ NOTIFICATIONS ══
function showNotification(message, type) {
    const n = document.createElement('div');
    n.className = `alert alert--${type}`;
    n.style.cssText = 'position:fixed;top:20px;right:20px;z-index:9999;max-width:350px;';
    n.innerHTML = `<span>${message}</span><button class="alert__close" onclick="this.parentElement.remove()">✕</button>`;
    document.body.appendChild(n);
    setTimeout(() => n.remove(), 5000);
}

// ══ CHARTS ══
document.addEventListener('DOMContentLoaded', function() {
    const countByType = {{ countByType|json_encode|raw }};
    const coutByMonth = {{ coutByMonth|json_encode|raw }};
    if (document.getElementById('barChart') && countByType?.length) {
        new Chart(document.getElementById('barChart'), {
            type: 'bar',
            data: { labels: countByType.map(r => r.type), datasets: [{ label: 'Nombre', data: countByType.map(r => r.total), backgroundColor: ['#2d6a2d','#0F6E56','#854F0B','#a32d2d','#0c447c','#7b5200','#1a5276','#4a1d8c','#534AB7','#2c2c2a'] }] },
            options: { responsive:true, plugins:{ legend:{display:false} }, scales:{ y:{ beginAtZero:true, ticks:{stepSize:1} } } }
        });
    }
    if (document.getElementById('lineChart') && coutByMonth?.length) {
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: { labels: coutByMonth.map(r => r.mois), datasets: [{ label: 'Coût (DT)', data: coutByMonth.map(r => r.total), borderColor:'#2d6a2d', backgroundColor:'rgba(45,106,45,.1)', borderWidth:2, tension:.4, fill:true, pointRadius:4 }] },
            options: { responsive:true, plugins:{ legend:{display:false} }, scales:{ y:{ beginAtZero:true } } }
        });
    }

    // ── Initialisation de la pagination au chargement ──
    filterItems();
});
</script>
{% endblock %}
