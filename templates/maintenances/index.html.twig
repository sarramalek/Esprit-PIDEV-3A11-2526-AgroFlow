<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script>
// ════════════════════════════════════════
// VUE TOGGLE
// ════════════════════════════════════════
let currentView = localStorage.getItem('maintView') || 'cards';
function setView(v) {
    currentView = v;
    localStorage.setItem('maintView', v);
    document.getElementById('viewCardsContainer').style.display = v === 'cards' ? '' : 'none';
    document.getElementById('viewTableContainer').style.display = v === 'table'  ? '' : 'none';
    document.getElementById('viewCards').classList.toggle('active', v === 'cards');
    document.getElementById('viewTable').classList.toggle('active', v === 'table');
    filterItems();
}
setView(currentView);

// ════════════════════════════════════════
// CALENDRIER DES RAPPELS ANNUELS
// ════════════════════════════════════════
let calendar = null;
let calendarShown = false;

async function toggleCalendar() {
    const panel = document.getElementById('calendarPanel');
    const btn   = document.getElementById('calendarToggle');
    calendarShown = !calendarShown;
    if (calendarShown) {
        panel.classList.add('is-open');
        btn.classList.add('active');
        if (!calendar) await initCalendar();
        else calendar.render();
    } else {
        panel.classList.remove('is-open');
        btn.classList.remove('active');
        if (calendar) { calendar.destroy(); calendar = null; }
    }
}

async function initCalendar() {
    try {
        const response = await fetch('{{ path('api_maintenance_calendar_reminders') }}');
        if (!response.ok) throw new Error('HTTP ' + response.status);
        const events = await response.json();
        const calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'fr',
            headerToolbar: { left:'prev,next today', center:'title', right:'dayGridMonth,dayGridWeek' },
            events: events,
            eventClick: function(info) {
                const p = info.event.extendedProps;
                showReminderModal({ id:p.maintenanceId, machine:p.machine, type:p.type,
                    lastMaintenance:p.lastMaintenance, age:p.age, priority:p.priority });
            },
            eventDidMount: function(info) { info.el.style.cursor = 'pointer'; },
            height: 550,
            buttonText: { today:"Aujourd'hui", month:'Mois', week:'Semaine' }
        });
        calendar.render();
    } catch (error) {
        console.error('Erreur calendrier:', error);
        showNotification('❌ Erreur de chargement du calendrier', 'danger');
    }
}

// ════════════════════════════════════════
// MODALE RAPPEL
// ════════════════════════════════════════
function showReminderModal(data) {
    document.getElementById('reminderMachineName').textContent = data.machine || 'Matériel';
    document.getElementById('reminderLastDate').textContent    = data.lastMaintenance || 'Date inconnue';
    document.getElementById('reminderAge').textContent         = data.age || 'Rappel annuel';
    document.getElementById('reminderType').innerHTML = data.priority === 'urgente'
        ? '<span class="reminder-badge">🔴 URGENT - Intervention immédiate</span>'
        : (data.type || 'Maintenance préventive');
    document.getElementById('reminderViewLink').href = '/agriculteur/maintenances/' + data.id;
    document.getElementById('reminderModal').classList.add('show');
}
function closeReminderModal() {
    document.getElementById('reminderModal').classList.remove('show');
}
document.getElementById('reminderModal').addEventListener('click', function(e) {
    if (e.target === this) closeReminderModal();
});

function toggleStats() {
    document.getElementById('chartsPanel').classList.toggle('is-open');
    document.getElementById('statsToggle').classList.toggle('active');
}

// ════════════════════════════════════════
// NOTIFICATION TOAST
// ════════════════════════════════════════
function showNotification(message, type) {
    const n = document.createElement('div');
    n.className = `alert alert--${type}`;
    n.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:9999;max-width:350px;animation:slideIn .25s;';
    n.innerHTML = `<span>${message}</span><button class="alert__close" onclick="this.parentElement.remove()">✕</button>`;
    document.body.appendChild(n);
    setTimeout(() => n.remove(), 5000);
}

// ════════════════════════════════════════
// FILTRES
// ════════════════════════════════════════
function filterItems() {
    const search = (document.getElementById('searchInput').value || '').toLowerCase();
    const type   = (document.getElementById('typeFilter').value   || '').toLowerCase();
    const statut = (document.getElementById('statutFilter').value || '').toLowerCase();
    const prio   = (document.getElementById('prioriteFilter').value || '').toLowerCase();
    const sort   = document.getElementById('sortFilter').value;
    const dir    = document.getElementById('dirFilter').value;
    document.getElementById('resetBtn').style.display = (search||type||statut||prio) ? 'inline-flex' : 'none';

    function matches(el) {
        return (!search || (el.dataset.type||'').toLowerCase().includes(search) || (el.dataset.desc||'').toLowerCase().includes(search) || (el.dataset.nom||'').toLowerCase().includes(search))
            && (!type   || (el.dataset.type  ||'').toLowerCase().includes(type))
            && (!statut || (el.dataset.statut||'').toLowerCase() === statut)
            && (!prio   || (el.dataset.priorite||'').toLowerCase() === prio);
    }

    const cardsGrid = document.getElementById('cardsGrid');
    if (cardsGrid) {
        const cards = Array.from(cardsGrid.children);
        cards.forEach(c => { c.style.display = matches(c) ? '' : 'none'; });
        const vis = cards.filter(c => c.style.display !== 'none');
        sortItems(vis, sort, dir, cardsGrid);
        document.getElementById('noResultsCards').style.display = vis.length === 0 ? 'block' : 'none';
    }
    const tbody = document.getElementById('maintBody');
    if (tbody) {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.forEach(tr => { tr.style.display = matches(tr) ? '' : 'none'; });
        const vis = rows.filter(r => r.style.display !== 'none');
        sortItems(vis, sort, dir, tbody);
        document.getElementById('noResultsTable').style.display = vis.length === 0 ? 'block' : 'none';
    }
}

function sortItems(items, sort, dir, container) {
    items.sort((a, b) => {
        let va, vb;
        switch (sort) {
            case 'cout':     va = parseFloat(a.dataset.cout||0);    vb = parseFloat(b.dataset.cout||0);    break;
            case 'type':     va = a.dataset.type||'';               vb = b.dataset.type||'';               break;
            case 'statut':   va = a.dataset.statut||'';             vb = b.dataset.statut||'';             break;
            case 'priorite': va = parseInt(a.dataset.prioOrder||2); vb = parseInt(b.dataset.prioOrder||2); break;
            case 'km':       va = parseInt(a.dataset.km||0);        vb = parseInt(b.dataset.km||0);        break;
            default:         va = a.dataset.date||'';               vb = b.dataset.date||'';
        }
        if (va < vb) return dir === 'asc' ? -1 : 1;
        if (va > vb) return dir === 'asc' ?  1 : -1;
        return 0;
    });
    items.forEach(el => container.appendChild(el));
}

function onSearchInput(input) {
    document.getElementById('clearSearch').classList.toggle('visible', input.value.length > 0);
    filterItems();
}
function clearSearch() {
    const input = document.getElementById('searchInput');
    input.value = ''; input.focus();
    document.getElementById('clearSearch').classList.remove('visible');
    filterItems();
}
function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('clearSearch').classList.remove('visible');
    ['typeFilter','statutFilter','prioriteFilter','sortFilter','dirFilter'].forEach(id => {
        const el = document.getElementById(id); if (el) el.selectedIndex = 0;
    });
    filterItems();
}

// ════════════════════════════════════════
// MODAL IA
// ════════════════════════════════════════
let aiActiveTab   = 'prompt';
let aiMachineData = {};
let suggestionsLoaded = false;  // ← FIX : évite de recharger inutilement

function openAIPrompt(id, type, priorite, km, nom, statut, cout, description) {
    aiMachineData = {
        id, type: type||'—', priorite: priorite||'moyenne',
        km: parseInt(km)||0, nom: nom||'Machine',
        statut: statut||'planifie', cout: parseFloat(cout)||0,
        description: description||''
    };
    suggestionsLoaded = false;  // ← reset pour forcer rechargement à chaque ouverture
    document.getElementById('aiMachinePill').textContent = nom || 'Machine';
    document.getElementById('aiMachineInfo').innerHTML =
        `Panne <strong>${type||'—'}</strong> · priorité <strong>${priorite||'—'}</strong> · ${km||0} km`;
    document.getElementById('aiModal').classList.add('show');
    switchAITab('prompt');
    renderAILifeLocal();
    resetSuggestTab();
}

function resetSuggestTab() {
    // Remettre les scores à "—"
    document.getElementById('suggestUrgencyScore').textContent = '—';
    document.getElementById('suggestUrgencyBar').style.width   = '0%';
    document.getElementById('suggestNextDate').textContent     = '—';
    document.getElementById('suggestHealthScore').textContent  = '—';
    document.getElementById('suggestActions').innerHTML        = '';
    // Remettre le loader
    document.getElementById('suggestionsList').innerHTML = `
        <div class="modal-loader" id="suggestLoader">
            <div class="modal-loader__spinner"></div>
            <div class="modal-loader__text">Prêt — cliquez sur "Générer" ou ouvrez l'onglet pour analyser</div>
        </div>`;
}

function closeAIModal() {
    document.getElementById('aiModal').classList.remove('show');
}

function switchAITab(t) {
    aiActiveTab = t;
    ['prompt','life','suggest'].forEach(tab => {
        const btn   = document.getElementById('aitab-' + tab);
        const panel = document.getElementById('aipanel-' + tab);
        if (btn)   btn.classList.toggle('active', tab === t);
        if (panel) panel.style.display = tab === t ? 'block' : 'none';
    });
    // Auto-charger les suggestions à l'ouverture de l'onglet si pas encore chargé
    if (t === 'suggest' && aiMachineData.id && !suggestionsLoaded) {
        loadAISuggestions();
    }
}

function setAISug(chip, txt) {
    document.querySelectorAll('.modal-chip').forEach(c => c.classList.remove('sel'));
    chip.classList.add('sel');
    document.getElementById('aiPromptTxt').value = txt;
}

// ════════════════════════════════════════
// DURÉE DE VIE — CALCUL LOCAL (affichage immédiat à l'ouverture)
// ════════════════════════════════════════
function renderAILifeLocal() {
    const km = aiMachineData.km || 0;
    const maxKm = 20000;
    const penalite = {urgente:25,haute:15,moyenne:8,faible:3}[aiMachineData.priorite] || 8;
    const vie = Math.max(0, Math.min(100, Math.round(((maxKm - km) / maxKm) * 100)) - penalite);
    const ans = Math.max(0, ((maxKm - km) / 3000)).toFixed(1);
    const risque = (aiMachineData.priorite === 'urgente' || km > 15000) ? 'Élevé'
                 : (aiMachineData.priorite === 'haute'   || km > 10000) ? 'Moyen' : 'Faible';
    document.getElementById('aiLifeScore').textContent = vie + '%';
    document.getElementById('aiLifeBar').style.width   = vie + '%';
    document.getElementById('aiLifeYears').textContent = ans + ' ans';
    document.getElementById('aiLifeRisk').textContent  = risque;
    const composants = [
        {nom:'Moteur',       usure:Math.min(100, Math.round(km/200)),  color:'#A32D2D'},
        {nom:'Transmission', usure:Math.min(100, Math.round(km/300)),  color:'#854F0B'},
        {nom:'Hydraulique',  usure:Math.min(100, Math.round(km/400)),  color:'#0C447C'},
        {nom:'Électricité',  usure:Math.min(100, Math.round(km/600)),  color:'#3B6D11'},
        {nom:'Pneumatique',  usure:Math.min(100, Math.round(km/250)),  color:'#4a1d8c'},
    ];
    const bars = document.getElementById('aiLifeBars');
    bars.innerHTML = '';
    composants.forEach(c => {
        const row = document.createElement('div');
        row.className = 'modal-life-bar-row';
        row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div>
            <div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${c.color}"></div></div>
            <div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`;
        bars.appendChild(row);
    });
}

// ════════════════════════════════════════
// SUGGESTIONS IA — FIX PRINCIPAL
// ════════════════════════════════════════
async function loadAISuggestions() {
    if (!aiMachineData.id) {
        showSuggestError('Aucune maintenance sélectionnée.');
        return;
    }

    setAIStatus('Analyse en cours…');
    // Afficher le loader
    document.getElementById('suggestionsList').innerHTML = `
        <div class="modal-loader" id="suggestLoader">
            <div class="modal-loader__spinner"></div>
            <div class="modal-loader__text">Analyse de la machine en cours…</div>
        </div>`;

    try {
        // ── FIX : URL corrigée pour correspondre exactement à la route Symfony ──
        const url = `/agriculteur/maintenances/api/ai-suggest-maintenance/${aiMachineData.id}`;
        const response = await fetch(url, {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (!response.ok) {
            const errText = await response.text();
            throw new Error(`HTTP ${response.status} — ${errText.substring(0,120)}`);
        }

        const contentType = response.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) {
            const txt = await response.text();
            throw new Error('Réponse non-JSON reçue : ' + txt.substring(0, 120));
        }

        const data = await response.json();

        if (!data.success) {
            throw new Error(data.error || 'Erreur serveur inconnue');
        }

        suggestionsLoaded = true;

        // Mise à jour des scores
        document.getElementById('suggestUrgencyScore').textContent = (data.urgencyScore ?? 0) + '%';
        document.getElementById('suggestUrgencyBar').style.width   = (data.urgencyScore ?? 0) + '%';
        document.getElementById('suggestNextDate').textContent     = data.nextRecommendedDate || 'N/A';
        document.getElementById('suggestHealthScore').textContent  = (data.currentState?.healthScore ?? '—') + (data.currentState?.healthScore != null ? '/100' : '');

        // Couleur de la barre d'urgence
        const urgencyBar = document.getElementById('suggestUrgencyBar');
        const score = data.urgencyScore ?? 0;
        urgencyBar.style.background = score >= 70 ? '#e74a3b' : score >= 50 ? '#e67e22' : score >= 30 ? '#f39c12' : '#27ae60';

        // Cartes de suggestions
        const container = document.getElementById('suggestionsList');
        container.innerHTML = '';

        const priorityColors = { urgente:'#a32d2d', haute:'#e67e22', moyenne:'#f39c12', basse:'#27ae60' };

        (data.suggestions || []).forEach(sug => {
            const color = priorityColors[sug.priority] || '#7f8c8d';
            const card = document.createElement('div');
            card.className = 'suggestion-card';
            card.style.borderLeft = `4px solid ${color}`;
            card.innerHTML = `
                <div class="suggestion-card__header">
                    <span class="suggestion-card__icon">${sug.icon || '🔧'}</span>
                    <strong class="suggestion-card__title" style="color:${color};">${sug.title || ''}</strong>
                    <span class="suggestion-card__badge" style="background:${color};">${sug.priority || ''}</span>
                </div>
                <p class="suggestion-card__msg">${sug.message || ''}</p>
                <button class="btn btn--outline suggestion-card__btn"
                    onclick="applySuggestionAction('${(sug.action||'').replace(/'/g,"\\'")}', ${aiMachineData.id})">
                    ${sug.action || 'Voir'}
                </button>`;
            container.appendChild(card);
        });

        if (!data.suggestions || data.suggestions.length === 0) {
            container.innerHTML = '<div style="text-align:center;padding:1.5rem;color:#7a9a7a;">✅ Aucune suggestion urgente — machine en bonne état.</div>';
        }

        // Actions recommandées
        const actionsEl = document.getElementById('suggestActions');
        actionsEl.innerHTML = (data.recommendedActions || []).map((a, i) => `${i+1}. ${a}`).join('<br>');

        setAIStatus('Analyse terminée ✓');

    } catch (error) {
        console.error('Erreur loadAISuggestions:', error);
        showSuggestError(error.message);
    }
}

function showSuggestError(msg) {
    suggestionsLoaded = false;
    document.getElementById('suggestionsList').innerHTML = `
        <div style="background:#fcebeb;border:1px solid #f7c1c1;border-radius:10px;padding:1rem;text-align:center;color:#501313;">
            <div style="font-size:24px;margin-bottom:8px;">❌</div>
            <div style="font-weight:600;margin-bottom:4px;">Erreur d'analyse</div>
            <div style="font-size:12px;color:#7a9a7a;">${msg}</div>
            <button class="btn btn--outline" style="margin-top:10px;font-size:.8rem;" onclick="loadAISuggestions()">🔄 Réessayer</button>
        </div>`;
    setAIStatus('Erreur — ' + msg.substring(0, 60));
}

function applySuggestionAction(action, id) {
    const act = action.toLowerCase();
    if (act.includes('planifier') || act.includes('programmer')) {
        window.location.href = `/agriculteur/maintenances/${id}/edit`;
    } else if (act.includes('intervenir')) {
        window.location.href = `/agriculteur/maintenances/${id}/edit`;
    } else if (act.includes('contacter')) {
        showNotification('📞 Service technique notifié', 'info');
    } else if (act.includes('consulter') || act.includes('voir')) {
        window.location.href = `/agriculteur/maintenances/${id}`;
    } else {
        showNotification('📝 ' + action, 'info');
    }
}

// ════════════════════════════════════════
// STATUT & LOADING
// ════════════════════════════════════════
function setAIStatus(m) {
    document.getElementById('aiFooterMsg').textContent = m;
}
function setAILoading(on) {
    const btn = document.getElementById('aiGenBtn');
    if (on) {
        btn.disabled = true;
        btn.innerHTML = '<span class="loading-spinner"></span> Génération…';
    } else {
        btn.disabled = false;
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Générer';
    }
}

// ════════════════════════════════════════
// GÉNÉRER (bouton principal)
// ════════════════════════════════════════
async function generateAI() {
    setAILoading(true);
    try {
        if      (aiActiveTab === 'prompt')  await aiRunPrompt();
        else if (aiActiveTab === 'life')    await aiRunLife();
        else if (aiActiveTab === 'suggest') { suggestionsLoaded = false; await loadAISuggestions(); }
    } catch(e) {
        setAIStatus('Erreur: ' + e.message);
        showNotification('❌ Erreur: ' + e.message, 'danger');
    }
    setAILoading(false);
}

// ── Prompt libre ──
async function aiRunPrompt() {
    const prompt = document.getElementById('aiPromptTxt').value.trim();
    if (!prompt) { setAIStatus('Entrez une demande'); setAILoading(false); return; }
    setAIStatus('Appel API…');
    const res  = await fetch(`/agriculteur/maintenances/api/generate-custom-prompt/${aiMachineData.id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ prompt })
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if (data.success) {
        document.getElementById('aiPromptResTxt').textContent = data.response;
        document.getElementById('aiPromptRes').style.display  = 'block';
        setAIStatus('Réponse générée ✓');
    } else {
        setAIStatus('Erreur serveur');
        showNotification('❌ ' + (data.error || 'Erreur'), 'danger');
    }
}

// ── Durée de vie ──
async function aiRunLife() {
    setAIStatus('Analyse durée de vie…');
    const res  = await fetch(`/agriculteur/maintenances/api/lifetime/${aiMachineData.id}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if (data.success) {
        document.getElementById('aiLifeScore').textContent = data.vieRestante + '%';
        document.getElementById('aiLifeBar').style.width   = data.vieRestante + '%';
        document.getElementById('aiLifeYears').textContent = data.anneesEstimees + ' ans';
        document.getElementById('aiLifeRisk').textContent  = data.risquePanne;
        if (data.composants?.length) {
            const colors = ['#A32D2D','#854F0B','#0C447C','#3B6D11','#4a1d8c'];
            const bars   = document.getElementById('aiLifeBars');
            bars.innerHTML = '';
            data.composants.forEach((c, i) => {
                const row = document.createElement('div');
                row.className = 'modal-life-bar-row';
                row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div>
                    <div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${colors[i % colors.length]}"></div></div>
                    <div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`;
                bars.appendChild(row);
            });
        }
        const recs = (data.recommandations || []).map((r, i) => `${i+1}. ${r}`).join('\n');
        document.getElementById('aiLifeResTxt').textContent = recs;
        document.getElementById('aiLifeRes').style.display  = 'block';
        setAIStatus('Analyse terminée ✓');
    } else {
        throw new Error('Erreur analyse durée de vie');
    }
}

function resetAITab() {
    ['aiPromptRes','aiLifeRes'].forEach(id => {
        const el = document.getElementById(id); if (el) el.style.display = 'none';
    });
    document.getElementById('aiPromptTxt').value = '';
    document.querySelectorAll('.modal-chip').forEach(c => c.classList.remove('sel'));
    renderAILifeLocal();
    suggestionsLoaded = false;
    resetSuggestTab();
    setAIStatus('Réinitialisé');
}

document.getElementById('aiModal').addEventListener('click', function(e) {
    if (e.target === this) closeAIModal();
});

// ════════════════════════════════════════
// CHARTS
// ════════════════════════════════════════
document.addEventListener('DOMContentLoaded', function() {
    const countByType = {{ countByType|json_encode|raw }};
    const coutByMonth = {{ coutByMonth|json_encode|raw }};
    if (document.getElementById('barChart') && countByType?.length) {
        new Chart(document.getElementById('barChart'), {
            type: 'bar',
            data: {
                labels: countByType.map(r => r.type),
                datasets: [{ label:'Nombre', data:countByType.map(r => r.total),
                    backgroundColor:['#2d6a2d','#0F6E56','#854F0B','#a32d2d','#0c447c','#7b5200','#1a5276','#4a1d8c','#534AB7','#2c2c2a'] }]
            },
            options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{stepSize:1}}} }
        });
    }
    if (document.getElementById('lineChart') && coutByMonth?.length) {
        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: coutByMonth.map(r => r.mois),
                datasets: [{ label:'Coût (DT)', data:coutByMonth.map(r => r.total),
                    borderColor:'#2d6a2d', backgroundColor:'rgba(45,106,45,.1)',
                    borderWidth:2, tension:.4, fill:true, pointRadius:4 }]
            },
            options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}} }
        });
    }
});
</script>
{% endblock %}
