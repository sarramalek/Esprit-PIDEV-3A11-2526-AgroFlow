                    <div style="font-size:12px;color:#7a9a7a;">Dernière maintenance : ${data.dateMain||'Date inconnue'}</div>
                </div>
                <div class="reminder-detail-row"><span class="reminder-detail-label">🚜 Machine</span><span class="reminder-detail-value"><strong>${escapeHtml(data.machineName)}</strong></span></div>
                <div class="reminder-detail-row"><span class="reminder-detail-label">🔧 Type</span><span class="reminder-detail-value">${escapeHtml(data.type||'—')}</span></div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">🎯 Urgence</span>
                    <span class="reminder-detail-value">
                        <span style="background:${riskColors[data.urgenceLevel?.level]||'#2d6a2d'};color:white;padding:2px 10px;border-radius:20px;font-size:11px;">${escapeHtml(data.urgenceLevel?.label||'Normal')}</span>
                    </span>
                </div>
                <div class="reminder-detail-row"><span class="reminder-detail-label">⏰ Temps écoulé</span><span class="reminder-detail-value">${data.yearsSince>0?`${data.yearsSince} an${data.yearsSince>1?'s':''}${data.monthsSince>0?` et ${data.monthsSince} mois`:''}`:'Maintenance récente'}</span></div>
                <div class="reminder-detail-row"><span class="reminder-detail-label">💰 Coût estimé</span><span class="reminder-detail-value">${data.cout?data.cout.toLocaleString()+' DT':'—'}</span></div>
                <div class="reminder-detail-row"><span class="reminder-detail-label">📊 Kilométrage</span><span class="reminder-detail-value">${data.km?data.km.toLocaleString()+' km':'—'}</span></div>
                ${data.description?`<div class="reminder-detail-row"><span class="reminder-detail-label">📝 Description</span><span class="reminder-detail-value">${escapeHtml(data.description)}</span></div>`:''}
                <div style="background:#eaf3de;border-radius:12px;padding:12px;margin:15px 0;">
                    <div style="font-weight:700;color:#2d6a2d;margin-bottom:8px;">🤖 RECOMMANDATIONS IA</div>
                    <div style="white-space:pre-wrap;font-size:12px;line-height:1.6;">${escapeHtml(data.aiRecommendation)}</div>
                </div>
                <div style="display:flex;gap:10px;margin-top:15px;flex-wrap:wrap;">
                    <a href="/agriculteur/maintenances/${data.id}" class="btn btn--green" style="flex:1;text-align:center;">👁 Voir détails</a>
                    <a href="/agriculteur/maintenances/${data.id}/edit" class="btn btn--outline" style="flex:1;text-align:center;">✏️ Planifier</a>
                    <button class="btn btn--google" style="flex:1;text-align:center;"
                        onclick="exportSingleReminderToGoogleCalendar(${data.id},'${escapeHtml(data.machineName)}','${data.dateMain}','${escapeHtml(data.type||'')}','${data.priorite}',${data.km||0})">
                        📤 Google
                    </button>
                </div>`;
        } else {
            body.innerHTML = `<div style="color:#a32d2d;text-align:center;padding:1rem;">❌ Erreur : ${escapeHtml(data.error)}</div>`;
