    body.innerHTML = '<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Analyse globale en cours...</div></div>';
    
    try {
        // Récupérer tous les rappels
        const response = await fetch('{{ path('agri_maintenances_api_reminder_dates') }}');
        const data = await response.json();
        
        if (data.success && data.reminders.length > 0) {
            const reminders = data.reminders;
            const urgentCount = reminders.filter(r => r.priorite === 'urgente').length;
            const highCount = reminders.filter(r => r.priorite === 'haute').length;
            const totalCost = reminders.reduce((sum, r) => sum + (r.cout || 0), 0);
            const avgKm = reminders.reduce((sum, r) => sum + (r.km || 0), 0) / reminders.length;
            
            // Générer les recommandations globales
            const globalRecommendations = [];
            if (urgentCount > 0) {
                globalRecommendations.push(`🔴 ${urgentCount} intervention(s) URGENTE(s) à traiter immédiatement`);
            }
            if (highCount > 0) {
                globalRecommendations.push(`🟠 ${highCount} maintenance(s) haute priorité à planifier sous 48h`);
            }
            if (avgKm > 10000) {
                globalRecommendations.push(`📊 Kilométrage moyen élevé (${Math.round(avgKm).toLocaleString()} km) - Révisions générales recommandées`);
            }
            if (totalCost > 0) {
                globalRecommendations.push(`💰 Coût total estimé des maintenances: ${totalCost.toLocaleString()} DT`);
            }
            
            body.innerHTML = `
                <div class="reminder-message-box" style="border-left-color: #667eea">
                    <div class="reminder-message-text">🤖 Analyse IA Globale</div>
                    <div style="font-size:12px;color:#7a9a7a;">${reminders.length} rappel(s) de maintenance détecté(s)</div>
                </div>
                
                <div style="margin-bottom:15px;">
                    <div style="background:#f0faf7;border-radius:12px;padding:12px;">
                        <div class="reminder-detail-row"><span class="reminder-detail-label">📊 Total rappels</span><span class="reminder-detail-value"><strong>${reminders.length}</strong></span></div>
                        <div class="reminder-detail-row"><span class="reminder-detail-label">🔴 Urgents</span><span class="reminder-detail-value"><strong style="color:#a32d2d;">${urgentCount}</strong></span></div>
                        <div class="reminder-detail-row"><span class="reminder-detail-label">🟠 Haute priorité</span><span class="reminder-detail-value"><strong style="color:#e67e22;">${highCount}</strong></span></div>
                        <div class="reminder-detail-row"><span class="reminder-detail-label">📊 Km moyen</span><span class="reminder-detail-value">${Math.round(avgKm).toLocaleString()} km</span></div>
                        <div class="reminder-detail-row"><span class="reminder-detail-label">💰 Coût total estimé</span><span class="reminder-detail-value">${totalCost.toLocaleString()} DT</span></div>
                    </div>
                </div>
                
                <div style="margin-bottom:15px;">
                    <div style="font-weight:700;color:#2d6a2d;margin-bottom:8px;">📋 Liste des rappels</div>
                    <div style="background:#f7faf4;border-radius:12px;padding:12px;max-height:300px;overflow-y:auto;">
                        ${reminders.map(r => `
                            <div class="reminder-detail-row" style="cursor:pointer;" onclick="showReminderDetail(${r.id})">
                                <span class="reminder-detail-label">${r.machineName}</span>
                                <span class="reminder-detail-value">${r.date} - ${r.priorite === 'urgente' ? '🔴 Urgent' : '📅 Annuel'}</span>
                            </div>
                        `).join('')}
                    </div>
                </div>
                
                <div style="margin-bottom:15px;">
                    <div style="font-weight:700;color:#2d6a2d;margin-bottom:8px;">✅ Recommandations globales IA</div>
                    <div style="background:#eaf3de;border-radius:12px;padding:12px;">
                        ${globalRecommendations.map(rec => `<p style="margin:5px 0;font-size:13px;">${rec}</p>`).join('')}
                        <p style="margin:5px 0;font-size:13px;margin-top:10px;">💡 Planifier les interventions par ordre de priorité pour optimiser la disponibilité des machines.</p>
                    </div>
                </div>
                
                <div style="display:flex;gap:10px;margin-top:15px;">
                    <button class="btn btn--green" style="flex:1;text-align:center;" onclick="closeReminderDetailPopup(); openReminderCalendar();">📅 Voir calendrier</button>
                    <button class="btn btn--calendar" style="flex:1;text-align:center;" onclick="exportAllRemindersToGoogleCalendar(${JSON.stringify(reminders).replace(/"/g, '&quot;')})">📤 Exporter tous</button>
                </div>
            `;
        } else {
            body.innerHTML = `<div style="color:#a32d2d;text-align:center;">✅ Aucun rappel de maintenance à afficher</div>`;
        }
    } catch (error) {
        body.innerHTML = `<div style="color:#a32d2d;text-align:center;">❌ Erreur: ${escapeHtml(error.message)}</div>`;
    }
}

function exportAllRemindersToGoogleCalendar(reminders) {
    if (reminders.length === 0) {
        showNotification('Aucun rappel à exporter', 'warning');
        return;
    }
    // Exporter le premier rappel comme exemple
    exportReminderToGoogleCalendar(reminders[0].id, reminders[0].machineName, reminders[0].date);
    showNotification(`${reminders.length} rappel(s) - Le premier a été exporté vers Google Calendar`, 'info');
}

function closeReminderDetailPopup() {
    document.getElementById('reminderDetailPopup').style.display = 'none';
}

function exportReminderToGoogleCalendar(id, machineName, dateMain) {
    let startDate;
    if (dateMain && dateMain !== 'null' && dateMain !== 'undefined' && dateMain !== '') {
        startDate = new Date(dateMain);
        if (isNaN(startDate.getTime())) {
            startDate = new Date();
        }
    } else {
        startDate = new Date();
    }
    
    const endDate = new Date(startDate);
    endDate.setDate(startDate.getDate() + 1);
    
    const formatGoogleDate = (date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}${month}${day}`;
    };
    
    const title = encodeURIComponent(`Maintenance préventive: ${machineName}`);
    const details = encodeURIComponent(
        `🔔 RAPPEL DE MAINTENANCE\n\n` +
        `Machine: ${machineName}\n` +
        `Type: Maintenance préventive annuelle\n\n` +
        `Vérifications recommandées par l'IA:\n` +
        `• Inspection générale de la machine\n` +
        `• Vidange moteur et changement des filtres\n` +
        `• Contrôle des niveaux (huile, liquide, hydraulique)\n` +
        `• Vérification des courroies et chaînes\n` +
        `• Contrôle de la pression des pneus\n` +
        `• Test des feux et éclairages\n\n` +
        `Généré par AgroFlow IA`
    );
    
    const url = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${formatGoogleDate(startDate)}/${formatGoogleDate(endDate)}&details=${details}&sf=true&output=xml`;
    
    window.open(url, '_blank');
    showNotification(`📤 Rappel pour "${machineName}" exporté vers Google Calendar`, 'success');
}

function showNotification(message, type) {
    const n = document.createElement('div');
    n.className = `alert alert--${type}`;
    n.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:9999;max-width:350px;animation:slideIn .25s;';
    n.innerHTML = `<span>${message}</span><button class="alert__close" onclick="this.parentElement.remove()">✕</button>`;
    document.body.appendChild(n);
    setTimeout(() => n.remove(), 5000);
}

// ════════════════════════════════════════
// MODAL IA (fonctions existantes)
// ════════════════════════════════════════
let aiActiveTab = 'prompt';
let aiMachineData = {};
let suggestionsLoaded = false;

function openAIPrompt(id, type, priorite, km, nom, statut, cout, description) {
    aiMachineData = { id, type: type||'—', priorite: priorite||'moyenne', km: parseInt(km)||0, nom: nom||'Machine', statut: statut||'planifie', cout: parseFloat(cout)||0, description: description||'' };
    suggestionsLoaded = false;
    document.getElementById('aiMachinePill').textContent = nom || 'Machine';
    document.getElementById('aiMachineInfo').innerHTML = `Panne <strong>${type||'—'}</strong> · priorité <strong>${priorite||'—'}</strong> · ${km||0} km`;
    document.getElementById('aiModal').classList.add('show');
    switchAITab('prompt');
    renderAILifeLocal();
    resetSuggestTab();
}

function closeAIModal() { document.getElementById('aiModal').classList.remove('show'); }

function switchAITab(t) {
    aiActiveTab = t;
    ['prompt','life','suggest'].forEach(tab => {
        const btn = document.getElementById('aitab-' + tab);
        const panel = document.getElementById('aipanel-' + tab);
        if (btn) btn.classList.toggle('active', tab === t);
        if (panel) panel.style.display = tab === t ? 'block' : 'none';
    });
    if (t === 'suggest' && aiMachineData.id && !suggestionsLoaded) loadAISuggestions();
}

function setAISug(chip, txt) {
    document.querySelectorAll('.modal-chip').forEach(c => c.classList.remove('sel'));
    chip.classList.add('sel');
    document.getElementById('aiPromptTxt').value = txt;
}

function renderAILifeLocal() {
    const km = aiMachineData.km || 0;
    const maxKm = 20000;
    const penalite = {urgente:25,haute:15,moyenne:8,faible:3}[aiMachineData.priorite] || 8;
    const vie = Math.max(0, Math.min(100, Math.round(((maxKm - km) / maxKm) * 100)) - penalite);
    const ans = Math.max(0, ((maxKm - km) / 3000)).toFixed(1);
    const risque = (aiMachineData.priorite === 'urgente' || km > 15000) ? 'Élevé' : (aiMachineData.priorite === 'haute' || km > 10000) ? 'Moyen' : 'Faible';
    document.getElementById('aiLifeScore').textContent = vie + '%';
    document.getElementById('aiLifeBar').style.width = vie + '%';
    document.getElementById('aiLifeYears').textContent = ans + ' ans';
    document.getElementById('aiLifeRisk').textContent = risque;
    const composants = [
        {nom:'Moteur', usure:Math.min(100, Math.round(km/200)), color:'#A32D2D'},
        {nom:'Transmission', usure:Math.min(100, Math.round(km/300)), color:'#854F0B'},
        {nom:'Hydraulique', usure:Math.min(100, Math.round(km/400)), color:'#0C447C'},
        {nom:'Électricité', usure:Math.min(100, Math.round(km/600)), color:'#3B6D11'},
        {nom:'Pneumatique', usure:Math.min(100, Math.round(km/250)), color:'#4a1d8c'},
    ];
    const bars = document.getElementById('aiLifeBars');
    bars.innerHTML = '';
    composants.forEach(c => {
        const row = document.createElement('div');
        row.className = 'modal-life-bar-row';
        row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div><div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${c.color}"></div></div><div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`;
        bars.appendChild(row);
    });
}

async function loadAISuggestions() {
    if (!aiMachineData.id) { showSuggestError('Aucune maintenance sélectionnée.'); return; }
    setAIStatus('Analyse en cours…');
    document.getElementById('suggestionsList').innerHTML = `<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Analyse de la machine en cours…</div></div>`;
    try {
        const url = `/agriculteur/maintenances/api/ai-suggest-maintenance/${aiMachineData.id}`;
        const response = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        if (!data.success) throw new Error(data.error || 'Erreur serveur inconnue');
        suggestionsLoaded = true;
        document.getElementById('suggestUrgencyScore').textContent = (data.urgencyScore ?? 0) + '%';
        document.getElementById('suggestUrgencyBar').style.width = (data.urgencyScore ?? 0) + '%';
        document.getElementById('suggestNextDate').textContent = data.nextRecommendedDate || 'N/A';
        document.getElementById('suggestHealthScore').textContent = (data.currentState?.healthScore ?? '—') + (data.currentState?.healthScore != null ? '/100' : '');
        const urgencyBar = document.getElementById('suggestUrgencyBar');
        const score = data.urgencyScore ?? 0;
        urgencyBar.style.background = score >= 70 ? '#e74a3b' : score >= 50 ? '#e67e22' : score >= 30 ? '#f39c12' : '#27ae60';
        const container = document.getElementById('suggestionsList');
        container.innerHTML = '';
        const priorityColors = { urgente:'#a32d2d', haute:'#e67e22', moyenne:'#f39c12', basse:'#27ae60' };
        (data.suggestions || []).forEach(sug => {
            const color = priorityColors[sug.priority] || '#7f8c8d';
            const card = document.createElement('div');
            card.className = 'suggestion-card';
            card.style.borderLeft = `4px solid ${color}`;
            card.innerHTML = `<div class="suggestion-card__header"><span class="suggestion-card__icon">${sug.icon || '🔧'}</span><strong class="suggestion-card__title" style="color:${color};">${sug.title || ''}</strong><span class="suggestion-card__badge" style="background:${color};">${sug.priority || ''}</span></div><p class="suggestion-card__msg">${sug.message || ''}</p><button class="btn btn--outline suggestion-card__btn" onclick="applySuggestionAction('${(sug.action||'').replace(/'/g,"\\'")}', ${aiMachineData.id})">${sug.action || 'Voir'}</button>`;
            container.appendChild(card);
        });
        if (!data.suggestions || data.suggestions.length === 0) container.innerHTML = '<div style="text-align:center;padding:1.5rem;color:#7a9a7a;">✅ Aucune suggestion urgente — machine en bonne état.</div>';
        const actionsEl = document.getElementById('suggestActions');
        actionsEl.innerHTML = (data.recommendedActions || []).map((a, i) => `${i+1}. ${a}`).join('<br>');
        setAIStatus('Analyse terminée ✓');
    } catch (error) { showSuggestError(error.message); }
}

function showSuggestError(msg) {
    suggestionsLoaded = false;
    document.getElementById('suggestionsList').innerHTML = `<div style="background:#fcebeb;border:1px solid #f7c1c1;border-radius:10px;padding:1rem;text-align:center;color:#501313;"><div style="font-size:24px;margin-bottom:8px;">❌</div><div style="font-weight:600;margin-bottom:4px;">Erreur d'analyse</div><div style="font-size:12px;color:#7a9a7a;">${msg}</div><button class="btn btn--outline" style="margin-top:10px;font-size:.8rem;" onclick="loadAISuggestions()">🔄 Réessayer</button></div>`;
    setAIStatus('Erreur — ' + msg.substring(0, 60));
}

function applySuggestionAction(action, id) {
    const act = action.toLowerCase();
    if (act.includes('planifier') || act.includes('programmer')) window.location.href = `/agriculteur/maintenances/${id}/edit`;
    else if (act.includes('intervenir')) window.location.href = `/agriculteur/maintenances/${id}/edit`;
    else if (act.includes('contacter')) showNotification('📞 Service technique notifié', 'info');
    else if (act.includes('consulter') || act.includes('voir')) window.location.href = `/agriculteur/maintenances/${id}`;
    else showNotification('📝 ' + action, 'info');
}

function resetSuggestTab() {
    document.getElementById('suggestUrgencyScore').textContent = '—';
    document.getElementById('suggestUrgencyBar').style.width = '0%';
    document.getElementById('suggestNextDate').textContent = '—';
    document.getElementById('suggestHealthScore').textContent = '—';
    document.getElementById('suggestActions').innerHTML = '';
    document.getElementById('suggestionsList').innerHTML = `<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Prêt — cliquez sur "Générer" ou ouvrez l'onglet pour analyser</div></div>`;
}

function setAIStatus(m) { document.getElementById('aiFooterMsg').textContent = m; }
function setAILoading(on) {
    const btn = document.getElementById('aiGenBtn');
    if (on) { btn.disabled = true; btn.innerHTML = '<span class="loading-spinner"></span> Génération…'; }
    else { btn.disabled = false; btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Générer'; }
}
async function generateAI() {
    setAILoading(true);
    try {
        if (aiActiveTab === 'prompt') await aiRunPrompt();
        else if (aiActiveTab === 'life') await aiRunLife();
        else if (aiActiveTab === 'suggest') { suggestionsLoaded = false; await loadAISuggestions(); }
    } catch(e) { setAIStatus('Erreur: ' + e.message); showNotification('❌ Erreur: ' + e.message, 'danger'); }
    setAILoading(false);
}
async function aiRunPrompt() {
    const prompt = document.getElementById('aiPromptTxt').value.trim();
    if (!prompt) { setAIStatus('Entrez une demande'); return; }
    setAIStatus('Appel API…');
    const res = await fetch(`/agriculteur/maintenances/api/generate-custom-prompt/${aiMachineData.id}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ prompt }) });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if (data.success) { document.getElementById('aiPromptResTxt').textContent = data.response; document.getElementById('aiPromptRes').style.display = 'block'; setAIStatus('Réponse générée ✓'); }
    else { setAIStatus('Erreur serveur'); showNotification('❌ ' + (data.error || 'Erreur'), 'danger'); }
}
async function aiRunLife() {
    setAIStatus('Analyse durée de vie…');
    const res = await fetch(`/agriculteur/maintenances/api/lifetime/${aiMachineData.id}`);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if (data.success) {
        document.getElementById('aiLifeScore').textContent = data.vieRestante + '%';
        document.getElementById('aiLifeBar').style.width = data.vieRestante + '%';
        document.getElementById('aiLifeYears').textContent = data.anneesEstimees + ' ans';
        document.getElementById('aiLifeRisk').textContent = data.risquePanne;
        if (data.composants?.length) {
            const colors = ['#A32D2D','#854F0B','#0C447C','#3B6D11','#4a1d8c'];
            const bars = document.getElementById('aiLifeBars');
            bars.innerHTML = '';
            data.composants.forEach((c, i) => { const row = document.createElement('div'); row.className = 'modal-life-bar-row'; row.innerHTML = `<div class="modal-life-bar-label">${c.nom}</div><div class="modal-life-bar-track"><div class="modal-life-bar-fill" style="width:${c.usure}%;background:${colors[i % colors.length]}"></div></div><div style="font-size:11px;font-weight:600;color:#1a2e1a;">${c.usure}%</div>`; bars.appendChild(row); });
        }
        document.getElementById('aiLifeResTxt').textContent = (data.recommandations || []).map((r, i) => `${i+1}. ${r}`).join('\n');
        document.getElementById('aiLifeRes').style.display = 'block';
        setAIStatus('Analyse terminée ✓');
    } else throw new Error('Erreur analyse durée de vie');
}
function resetAITab() {
    ['aiPromptRes','aiLifeRes'].forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
    document.getElementById('aiPromptTxt').value = '';
    document.querySelectorAll('.modal-chip').forEach(c => c.classList.remove('sel'));
    renderAILifeLocal();
    suggestionsLoaded = false;
    resetSuggestTab();
    setAIStatus('Réinitialisé');
}

document.getElementById('aiModal').addEventListener('click', function(e) { if (e.target === this) closeAIModal(); });
document.getElementById('reminderCalendarModal').addEventListener('click', function(e) { if (e.target === this) closeReminderCalendar(); });
document.getElementById('reminderDetailPopup').addEventListener('click', function(e) { if (e.target === this) closeReminderDetailPopup(); });

// CHARTS
document.addEventListener('DOMContentLoaded', function() {
    const countByType = {{ countByType|json_encode|raw }};
    const coutByMonth = {{ coutByMonth|json_encode|raw }};
    if (document.getElementById('barChart') && countByType?.length) {
        new Chart(document.getElementById('barChart'), { type: 'bar', data: { labels: countByType.map(r => r.type), datasets: [{ label:'Nombre', data:countByType.map(r => r.total), backgroundColor:['#2d6a2d','#0F6E56','#854F0B','#a32d2d','#0c447c','#7b5200','#1a5276','#4a1d8c','#534AB7','#2c2c2a'] }] }, options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true,ticks:{stepSize:1}}} } });
    }
    if (document.getElementById('lineChart') && coutByMonth?.length) {
        new Chart(document.getElementById('lineChart'), { type: 'line', data: { labels: coutByMonth.map(r => r.mois), datasets: [{ label:'Coût (DT)', data:coutByMonth.map(r => r.total), borderColor:'#2d6a2d', backgroundColor:'rgba(45,106,45,.1)', borderWidth:2, tension:.4, fill:true, pointRadius:4 }] }, options: { responsive:true, plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}} } });
    }
});
</script>
