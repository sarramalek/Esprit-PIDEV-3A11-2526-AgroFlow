                    <div style="font-size:12px; color:#1a4a1a; line-height:1.4;" id="reco-card-${id}">
                        ${escapeHtml(data.recommandation.slice(0, 120))}${data.recommandation.length > 120 ? '...' : ''}
                    </div>
                    ${data.recommandation.length > 120 ? `<button onclick="toggleRecoCard(${id}, this)" style="background:none; border:none; color:#2d6a2d; font-size:10px; cursor:pointer; margin-top:4px;">▼ Voir plus</button>` : ''}
                `;
            }
            showNotification('✅ Recommandation IA générée avec succès', 'success');
        } else {
            showNotification('❌ Erreur lors de la génération', 'danger');
        }
    } catch (error) {
        console.error('Erreur:', error);
        showNotification('❌ Erreur réseau', 'danger');
        if (recoDiv) {
            recoDiv.innerHTML = `
                <div style="font-size:11px; color:#a32d2d;">
                    ⚠️ Erreur de génération. Réessayez.
