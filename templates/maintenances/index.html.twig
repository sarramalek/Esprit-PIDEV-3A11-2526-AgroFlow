function toggleRecoCard(id, btn) {
    const el = document.getElementById('reco-card-' + id);
    if (!el) return;
    const fullText = el.getAttribute('data-full') || el.innerText;
    if (!el.getAttribute('data-full')) {
        el.setAttribute('data-full', el.innerText);
    }
    const expanded = el.classList.toggle('expanded');
    if (expanded) {
        el.innerText = fullText;
        btn.innerHTML = '▲ Voir moins';
    } else {
        el.innerText = fullText.slice(0, 120) + '...';
        btn.innerHTML = '▼ Voir plus';
