                    <div style="display:flex;align-items:center;gap:5px;"><div style="width:12px;height:12px;background:#a32d2d;border-radius:50%;"></div><span style="font-size:11px;">Urgent</span></div>
                    <div style="display:flex;align-items:center;gap:5px;"><div style="width:12px;height:12px;background:#f39c12;border-radius:50%;"></div><span style="font-size:11px;">Kilométrage élevé</span></div>
                </div>
