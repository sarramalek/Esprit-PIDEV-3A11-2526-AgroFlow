<script>
// ════════════════════════════════════════
// VUE TOGGLE
// ════════════════════════════════════════
let currentView = localStorage.getItem('maintView') || 'cards';
function setView(v) {
    currentView = v;
    localStorage.setItem('maintView', v);
    document.getElementById('viewCardsContainer').style.display = v === 'cards' ? '' : 'none';
    document.getElementById('viewTableContainer').style.display = v === 'table' ? '' : 'none';
    document.getElementById('viewCards').classList.toggle('active', v === 'cards');
    document.getElementById('viewTable').classList.toggle('active', v === 'table');
    filterItems();
}
setView(currentView);

// ════════════════════════════════════════
// STATS PANEL
// ════════════════════════════════════════
function toggleStats() {
    document.getElementById('chartsPanel').classList.toggle('is-open');
    document.getElementById('statsToggle').classList.toggle('active');
}

// ════════════════════════════════════════
// FILTRES
// ════════════════════════════════════════
function filterItems() {
    const search = (document.getElementById('searchInput').value || '').toLowerCase();
    const type = (document.getElementById('typeFilter').value || '').toLowerCase();
    const statut = (document.getElementById('statutFilter').value || '').toLowerCase();
    const prio = (document.getElementById('prioriteFilter').value || '').toLowerCase();
    const sort = document.getElementById('sortFilter').value;
    const dir = document.getElementById('dirFilter').value;
    document.getElementById('resetBtn').style.display = (search||type||statut||prio) ? 'inline-flex' : 'none';

    function matches(el) {
        return (!search || (el.dataset.type||'').toLowerCase().includes(search) || (el.dataset.desc||'').toLowerCase().includes(search) || (el.dataset.nom||'').toLowerCase().includes(search))
            && (!type || (el.dataset.type||'').toLowerCase().includes(type))
            && (!statut || (el.dataset.statut||'').toLowerCase() === statut)
            && (!prio || (el.dataset.priorite||'').toLowerCase() === prio);
    }

    const cardsGrid = document.getElementById('cardsGrid');
    if (cardsGrid) {
        const cards = Array.from(cardsGrid.children);
        cards.forEach(c => { c.style.display = matches(c) ? '' : 'none'; });
        const vis = cards.filter(c => c.style.display !== 'none');
        sortItems(vis, sort, dir, cardsGrid);
        document.getElementById('noResultsCards').style.display = vis.length === 0 ? 'block' : 'none';
    }
    const tbody = document.getElementById('maintBody');
    if (tbody) {
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.forEach(tr => { tr.style.display = matches(tr) ? '' : 'none'; });
        const vis = rows.filter(r => r.style.display !== 'none');
        sortItems(vis, sort, dir, tbody);
        document.getElementById('noResultsTable').style.display = vis.length === 0 ? 'block' : 'none';
    }
}

function sortItems(items, sort, dir, container) {
    items.sort((a, b) => {
        let va, vb;
        switch (sort) {
            case 'cout': va = parseFloat(a.dataset.cout||0); vb = parseFloat(b.dataset.cout||0); break;
            case 'type': va = a.dataset.type||''; vb = b.dataset.type||''; break;
            case 'statut': va = a.dataset.statut||''; vb = b.dataset.statut||''; break;
            case 'priorite': va = parseInt(a.dataset.prioOrder||2); vb = parseInt(b.dataset.prioOrder||2); break;
            case 'km': va = parseInt(a.dataset.km||0); vb = parseInt(b.dataset.km||0); break;
            default: va = a.dataset.date||''; vb = b.dataset.date||'';
        }
        if (va < vb) return dir === 'asc' ? -1 : 1;
        if (va > vb) return dir === 'asc' ? 1 : -1;
        return 0;
    });
    items.forEach(el => container.appendChild(el));
}

function onSearchInput(input) {
    document.getElementById('clearSearch').classList.toggle('visible', input.value.length > 0);
    filterItems();
}
function clearSearch() {
    const input = document.getElementById('searchInput');
    input.value = ''; input.focus();
    document.getElementById('clearSearch').classList.remove('visible');
    filterItems();
}
function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('clearSearch').classList.remove('visible');
    ['typeFilter','statutFilter','prioriteFilter','sortFilter','dirFilter'].forEach(id => {
        const el = document.getElementById(id); if (el) el.selectedIndex = 0;
    });
    filterItems();
}

// ════════════════════════════════════════
// CALENDRIER DES RAPPELS ANNUELS (MODALE)
// ════════════════════════════════════════
let reminderCalendar = null;
let reminderEvents = [];

async function openReminderCalendar() {
    const modal = document.getElementById('reminderCalendarModal');
    modal.style.display = 'flex';
    
    if (!reminderCalendar) {
        await initReminderCalendar();
    } else {
        reminderCalendar.refetchEvents();
    }
}

function closeReminderCalendar() {
    document.getElementById('reminderCalendarModal').style.display = 'none';
}

async function initReminderCalendar() {
    const calendarEl = document.getElementById('reminderCalendar');
    
    reminderCalendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,dayGridWeek'
        },
        buttonText: {
            today: "Aujourd'hui",
            month: 'Mois',
            week: 'Semaine'
        },
        height: 500,
        events: loadReminderEvents,
        eventDidMount: function(info) {
            info.el.style.cursor = 'pointer';
            info.el.style.backgroundColor = info.event.backgroundColor;
            info.el.style.borderColor = info.event.borderColor;
            info.el.title = info.event.extendedProps.message || 'Cliquer pour voir les détails';
        },
        eventClick: function(info) {
            showReminderDetail(info.event.id);
        },
        dayCellDidMount: function(info) {
            const dateStr = info.date.toISOString().split('T')[0];
            const hasReminder = reminderEvents.some(r => r.start === dateStr);
            if (hasReminder) {
                info.el.style.background = 'linear-gradient(135deg, #fff5f5 0%, #fcebeb 100%)';
                info.el.style.borderLeft = '3px solid #e74a3b';
            }
        }
    });
    
    reminderCalendar.render();
}

async function loadReminderEvents(fetchInfo, successCallback, failureCallback) {
    try {
        const response = await fetch('{{ path('agri_maintenances_api_reminder_dates') }}');
        if (!response.ok) throw new Error('Erreur chargement');
        const data = await response.json();
        
        if (data.success) {
            reminderEvents = data.reminders.map(r => ({
                id: r.id,
                title: r.machineName,
                start: r.date,
                allDay: true,
                backgroundColor: r.priorite === 'urgente' ? '#a32d2d' : '#e74a3b',
                borderColor: r.priorite === 'urgente' ? '#8b0000' : '#c0392b',
                textColor: '#ffffff',
                extendedProps: {
                    message: r.message,
                    machineName: r.machineName,
                    type: r.type,
                    priorite: r.priorite,
                    yearsSince: r.yearsSince,
                    monthsSince: r.monthsSince,
                    ageText: r.ageText,
                    km: r.km,
                    cout: r.cout,
                    description: r.description
                }
            }));
            successCallback(reminderEvents);
        } else {
            failureCallback(data.error);
        }
    } catch (error) {
        console.error('Erreur:', error);
        failureCallback(error);
    }
}

