async function generateRecoForCard(id) {
    const card = document.querySelector(`.maint-card-item[data-id="${id}"]`);
    if (!card) return;
    
    const recoDiv = card.querySelector('.ai-reco-section');
    if (recoDiv) {
        recoDiv.innerHTML = `
            <div style="display:flex; align-items:center; gap:8px;">
                <div class="modal-loader__spinner" style="width:16px; height:16px;"></div>
                <span style="font-size:11px; color:#2d6a2d;">Génération en cours...</span>
            </div>
        `;
    }
    
    try {
        const response = await fetch(`/agriculteur/maintenances/api/generate-recommendation/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        
        if (data.success && data.recommandation) {
            if (recoDiv) {
                recoDiv.innerHTML = `
                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:4px;">
                        <span style="font-size:14px;">🧠</span>
                        <span style="font-size:11px; font-weight:700; color:#2d6a2d;">Recommandation IA</span>
