// ================================================================
// FONCTIONS POUR LES NOTES DU CALENDRIER
// ================================================================
function openNoteModal(date) {
    currentNoteDate = date;
    const modal = document.getElementById('noteModal');
    if (!modal) return;
    
    const savedNote = localStorage.getItem(`calendar_note_${date}`);
    const textarea = document.getElementById('noteContent');
    if (textarea) {
        textarea.value = savedNote || '';
    }
    
    const dateDisplay = document.getElementById('noteDateDisplay');
    if (dateDisplay) {
        const d = new Date(date);
        dateDisplay.textContent = d.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    }
    
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function closeNoteModal() {
    const modal = document.getElementById('noteModal');
    if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
    currentNoteDate = null;
}

function saveNote() {
    const textarea = document.getElementById('noteContent');
    const note = textarea?.value || '';
    
    if (currentNoteDate) {
        if (note.trim() === '') {
            localStorage.removeItem(`calendar_note_${currentNoteDate}`);
            showNotification('🗑 Note supprimée (vide)', 'info');
        } else {
            localStorage.setItem(`calendar_note_${currentNoteDate}`, note);
            showNotification('✅ Note enregistrée avec succès !', 'success');
        }
        
        if (reminderCalendar) {
            reminderCalendar.refetchEvents();
        }
        
        closeNoteModal();
    }
}

function deleteNote() {
    if (currentNoteDate && confirm('⚠️ Voulez-vous vraiment supprimer cette note ?')) {
        localStorage.removeItem(`calendar_note_${currentNoteDate}`);
        
        if (reminderCalendar) {
            reminderCalendar.refetchEvents();
        }
        
        const textarea = document.getElementById('noteContent');
        if (textarea) textarea.value = '';
        
        showNotification('🗑 Note supprimée', 'info');
        closeNoteModal();
    }
}

function exportAllNotes() {
    const notes = [];
    for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('calendar_note_')) {
            const date = key.replace('calendar_note_', '');
            const note = localStorage.getItem(key);
            if (note && note.trim()) {
                notes.push({ date, note });
            }
        }
    }
    
    if (notes.length === 0) {
        showNotification('Aucune note à exporter', 'warning');
        return;
    }
    
    notes.sort((a, b) => a.date.localeCompare(b.date));
    
    let content = "📝 NOTES DU CALENDRIER DES MAINTENANCES\n";
    content += `Exporté le : ${new Date().toLocaleString('fr-FR')}\n`;
    content += "=".repeat(60) + "\n\n";
    
    notes.forEach(({date, note}) => {
        const d = new Date(date);
        const dateFormatted = d.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        content += `📅 DATE : ${date} (${dateFormatted})\n`;
        content += `📝 NOTE :\n${note}\n`;
        content += "-".repeat(50) + "\n\n";
    });
    
    const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
    const link = document.createElement('a');
    const url = URL.createObjectURL(blob);
    link.href = url;
    link.download = `notes_calendrier_${new Date().toISOString().split('T')[0]}.txt`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    
    showNotification(`📥 ${notes.length} note(s) exportée(s)`, 'success');
}

// ================================================================
// CALENDRIER RAPPELS ANNUELS
// ================================================================
function openReminderCalendar() {
    const modal = document.getElementById('reminderCalendarModal');
    if (!modal) return;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if (!reminderCalendar) {
        setTimeout(initReminderCalendar, 50);
    } else {
        reminderCalendar.refetchEvents();
    }
}

function closeReminderCalendar() {
    const modal = document.getElementById('reminderCalendarModal');
    if (modal) modal.style.display = 'none';
    document.body.style.overflow = '';
}

async function initReminderCalendar() {
    const calendarEl = document.getElementById('reminderCalendar');
    if (!calendarEl) return;
    if (typeof FullCalendar === 'undefined') { setTimeout(initReminderCalendar, 300); return; }

    reminderCalendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,dayGridWeek'
        },
        buttonText: { today: "Aujourd'hui", month: 'Mois', week: 'Semaine' },
        height: 500,
        selectable: true,
        select: function(info) {
            openNoteModal(info.startStr);
        },
        dateClick: function(info) {
            openNoteModal(info.dateStr);
        },
        events: loadReminderEvents,
        eventDidMount: function(info) {
            info.el.style.cursor = 'pointer';
            info.el.style.borderRadius = '6px';
            info.el.style.padding = '2px 4px';
            info.el.title = info.event.extendedProps?.message || 'Cliquer pour voir les détails';
        },
        eventClick: function(info) {
            showReminderDetail(info.event.id);
        },
        dayCellDidMount: function(info) {
            const dateStr = info.date.toISOString().split('T')[0];
            const hasReminder = reminderEvents.some(r => r.start === dateStr);
            
            if (hasReminder) {
                info.el.style.background = 'linear-gradient(135deg, #fff5f5 0%, #fcebeb 100%)';
                info.el.style.borderLeft = '3px solid #e74a3b';
            }
            
            const savedNote = localStorage.getItem(`calendar_note_${dateStr}`);
            if (savedNote && savedNote.trim().length > 0) {
                const noteIndicator = document.createElement('div');
                noteIndicator.innerHTML = '📝';
                noteIndicator.className = 'note-indicator';
                noteIndicator.title = 'Note existante - Cliquer pour modifier';
                noteIndicator.onclick = (e) => {
                    e.stopPropagation();
                    openNoteModal(dateStr);
                };
                
                if (!info.el.querySelector('.note-indicator')) {
                    info.el.style.position = 'relative';
                    info.el.appendChild(noteIndicator);
                }
            }
            
            info.el.addEventListener('mouseenter', function() {
                if (!info.el.querySelector('.add-note-btn')) {
                    const addBtn = document.createElement('button');
                    addBtn.innerHTML = '📝 +';
                    addBtn.className = 'add-note-btn';
                    addBtn.title = 'Ajouter/Modifier une note';
                    addBtn.onclick = (e) => {
                        e.stopPropagation();
                        openNoteModal(dateStr);
                    };
                    info.el.style.position = 'relative';
                    info.el.appendChild(addBtn);
                    
                    addBtn.addEventListener('mouseleave', function() {
                        setTimeout(() => {
                            if (addBtn && addBtn.parentNode && !info.el.matches(':hover')) {
                                addBtn.remove();
                            }
                        }, 100);
                    });
                }
            });
            
            info.el.addEventListener('mouseleave', function() {
                const btn = info.el.querySelector('.add-note-btn');
                if (btn) btn.remove();
            });
        }
    });

    reminderCalendar.render();
}

async function loadReminderEvents(fetchInfo, successCallback, failureCallback) {
    try {
        const response = await fetch('{{ path('agri_maintenances_api_reminder_dates') }}');
        if (!response.ok) throw new Error('Erreur ' + response.status);
        const data = await response.json();
        if (data.success) {
            allRemindersData = data.reminders;
            reminderEvents = data.reminders.map(r => ({
                id: r.id,
                title: r.machineName,
                start: r.date,
                allDay: true,
                backgroundColor: r.priorite === 'urgente' ? '#a32d2d' : '#e74a3b',
                borderColor: r.priorite === 'urgente' ? '#8b0000' : '#c0392b',
                textColor: '#ffffff',
                extendedProps: {
                    message: r.message,
                    machineName: r.machineName,
                    type: r.type,
                    priorite: r.priorite,
                    yearsSince: r.yearsSince,
                    monthsSince: r.monthsSince,
                    ageText: r.ageText,
                    km: r.km,
                    cout: r.cout,
                    description: r.description,
                    dateMain: r.date
                }
            }));
            successCallback(reminderEvents);
        } else {
            failureCallback(data.error || 'Erreur inconnue');
        }
    } catch (error) {
        console.error('Erreur chargement rappels:', error);
        failureCallback(error);
    }
}

async function showReminderDetail(maintenanceId) {
    const modal = document.getElementById('reminderDetailPopup');
    const body = document.getElementById('reminderDetailBody');
    if (!modal || !body) return;
    modal.style.display = 'flex';
    body.innerHTML = '<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Chargement des détails...</div></div>';

    try {
        const response = await fetch('/agriculteur/maintenances/api/calendar/reminder-detail/' + maintenanceId);
        const data = await response.json();

        if (data.success) {
            const riskColors = { critique: '#a32d2d', élevé: '#e67e22', moyen: '#f39c12', faible: '#2d6a2d' };
            body.innerHTML = `
                <div class="reminder-message-box">
                    <div class="reminder-message-text">${escapeHtml(data.message)}</div>
                    <div style="font-size:12px;color:#7a9a7a;">Dernière maintenance : ${data.dateMain || 'Date inconnue'}</div>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">🚜 Machine</span>
                    <span class="reminder-detail-value"><strong>${escapeHtml(data.machineName)}</strong></span>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">🔧 Type</span>
                    <span class="reminder-detail-value">${escapeHtml(data.type || '—')}</span>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">⚠️ Priorité</span>
                    <span class="reminder-detail-value">
                        <span style="background:${riskColors[data.urgenceLevel?.level] || '#2d6a2d'};color:white;padding:2px 10px;border-radius:20px;font-size:11px;">
                            ${escapeHtml(data.urgenceLevel?.label || 'Normal')}
                        </span>
                    </span>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">⏰ Temps écoulé</span>
                    <span class="reminder-detail-value">${data.yearsSince > 0 ? `${data.yearsSince} an${data.yearsSince > 1 ? 's' : ''}${data.monthsSince > 0 ? ` et ${data.monthsSince} mois` : ''}` : 'Maintenance récente'}</span>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">💰 Coût estimé</span>
                    <span class="reminder-detail-value">${data.cout ? data.cout.toLocaleString() + ' DT' : '—'}</span>
                </div>
                <div class="reminder-detail-row">
                    <span class="reminder-detail-label">📊 Kilométrage</span>
                    <span class="reminder-detail-value">${data.km ? data.km.toLocaleString() + ' km' : '—'}</span>
                </div>
                ${data.description ? `<div class="reminder-detail-row"><span class="reminder-detail-label">📝 Description</span><span class="reminder-detail-value">${escapeHtml(data.description)}</span></div>` : ''}
                <div style="background:#eaf3de;border-radius:12px;padding:12px;margin:15px 0;">
                    <div style="font-weight:700;color:#2d6a2d;margin-bottom:8px;">🤖 RECOMMANDATIONS IA</div>
                    <div style="white-space:pre-wrap;font-size:12px;line-height:1.6;">${escapeHtml(data.aiRecommendation)}</div>
                </div>
                <div style="display:flex;gap:10px;margin-top:15px;flex-wrap:wrap;">
                    <a href="/agriculteur/maintenances/${data.id}" class="btn btn--green" style="flex:1;text-align:center;">👁 Voir détails</a>
                    <a href="/agriculteur/maintenances/${data.id}/edit" class="btn btn--outline" style="flex:1;text-align:center;">✏️ Planifier</a>
                    <button class="btn btn--google" style="flex:1;text-align:center;" onclick="exportSingleReminderToGoogleCalendar(${data.id}, '${escapeHtml(data.machineName)}', '${data.dateMain}', '${escapeHtml(data.type || '')}', '${data.priorite}', ${data.km || 0})">
                        📤 Exporter Google
                    </button>
                </div>
            `;
        } else {
            body.innerHTML = `<div style="color:#a32d2d;text-align:center;padding:1rem;">❌ Erreur : ${escapeHtml(data.error)}</div>`;
        }
    } catch (error) {
        body.innerHTML = `<div style="color:#a32d2d;text-align:center;padding:1rem;">❌ Erreur réseau : ${escapeHtml(error.message)}</div>`;
    }
}

function closeReminderDetailPopup() {
    const modal = document.getElementById('reminderDetailPopup');
    if (modal) modal.style.display = 'none';
}

function exportToGoogleCalendar(title, startDate, endDate, description) {
    const fmt = d => `${d.getFullYear()}${String(d.getMonth()+1).padStart(2,'0')}${String(d.getDate()).padStart(2,'0')}`;
    const url = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(title)}&dates=${fmt(startDate)}/${fmt(endDate)}&details=${encodeURIComponent(description)}&sf=true&output=xml`;
    window.open(url, '_blank');
    showNotification('📤 Événement exporté vers Google Calendar', 'success');
}

function exportSingleReminderToGoogleCalendar(id, machineName, dateMain, type, priorite, km) {
    let startDate = new Date(dateMain);
    if (isNaN(startDate.getTime())) startDate = new Date();
    const endDate = new Date(startDate);
    endDate.setDate(startDate.getDate() + 1);
    const desc = `🔔 RAPPEL DE MAINTENANCE\nMachine: ${machineName}\nType: ${type || 'Maintenance préventive'}\nPriorité: ${priorite}\nKilométrage: ${km ? km.toLocaleString() + ' km' : 'Non renseigné'}\n\n✅ Vérifications recommandées:\n• Inspection générale\n• Vidange moteur et filtres\n• Contrôle des niveaux\n• Vérification courroies\n• Pression des pneus\n\nGénéré par AgroFlow`;
    exportToGoogleCalendar('Maintenance préventive: ' + machineName, startDate, endDate, desc);
}

function exportAllRemindersToGoogleCalendar() {
    if (!allRemindersData || allRemindersData.length === 0) {
        showNotification('Aucun rappel à exporter', 'warning');
        return;
    }
    exportSingleReminderToGoogleCalendar(
        allRemindersData[0].id,
        allRemindersData[0].machineName,
        allRemindersData[0].date,
        allRemindersData[0].type,
        allRemindersData[0].priorite,
        allRemindersData[0].km || 0
    );
    showNotification(`📤 ${allRemindersData.length} rappel(s) — Le premier exporté vers Google Calendar`, 'info');
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function showModal(title, content) {
    document.querySelectorAll('.modal-overlay').forEach(m => m.remove());
    
    const modal = document.createElement('div');
    modal.className = 'modal-overlay';
    modal.style.cssText = 'position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 100000; display: flex; align-items: center; justify-content: center;';
    modal.innerHTML = `
        <div style="background: white; border-radius: 24px; max-width: 600px; width: 90%; max-height: 85vh; overflow: auto; animation: popupSlideIn 0.2s ease;">
            <div style="background: linear-gradient(135deg, #2d6a2d, #1a451a); padding: 1rem 1.5rem; color: white; border-radius: 24px 24px 0 0; display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0;">${escapeHtml(title)}</h3>
                <button onclick="this.closest('.modal-overlay').remove()" 
                    style="background: rgba(255,255,255,0.2); border: none; color: white; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 18px;">✕</button>
            </div>
            <div style="padding: 1.5rem;">${content}</div>
        </div>
    `;
    document.body.appendChild(modal);
    modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
}

function showAlertAction(action, title) {
    showModal(title, `
        <div style="text-align: center; padding: 20px;">
            <div style="font-size: 48px; margin-bottom: 15px;">🔧</div>
            <p style="margin-bottom: 20px; font-size: 16px;">Action recommandée :</p>
            <strong style="display: block; background: #f0f0f0; padding: 15px; border-radius: 10px; margin-bottom: 20px; font-size: 14px;">${escapeHtml(action)}</strong>
            <button onclick="this.closest('.modal-overlay').remove()" 
                style="background: #2d6a2d; color: white; border: none; border-radius: 8px; padding: 10px 24px; cursor: pointer; font-weight: 600;">
                J'ai compris
            </button>
        </div>
    `);
}

async function showAllAlerts(maintenanceId) {
    try {
        const response = await fetch(`/agriculteur/maintenances/api/alerts/${maintenanceId}`);
        const data = await response.json();
        
        if (data.success && data.alerts) {
            let html = '<div style="max-height: 500px; overflow-y: auto;">';
            data.alerts.forEach(alert => {
                const priorityClass = alert.priority === 'urgente' ? '#a32d2d' : (alert.priority === 'haute' ? '#e67e22' : (alert.priority === 'moyenne' ? '#f39c12' : '#2d6a2d'));
                html += `
                    <div style="border-left: 4px solid ${alert.color}; background: ${alert.color}10; padding: 14px; margin-bottom: 12px; border-radius: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <span style="font-size: 28px;">${escapeHtml(alert.icon)}</span>
                            <strong style="color: ${alert.color};">${escapeHtml(alert.title)}</strong>
                            <span style="margin-left: auto; background: ${priorityClass}; color: white; padding: 2px 10px; border-radius: 20px; font-size: 11px; font-weight: 600;">${alert.priority}</span>
                        </div>
                        <div style="font-size: 14px; margin-bottom: 10px; line-height: 1.5;">${escapeHtml(alert.message)}</div>
                        <button onclick="alert('${escapeHtml(alert.action)}')" 
                            style="background: ${alert.color}; color: white; border: none; border-radius: 8px; padding: 6px 16px; cursor: pointer; font-weight: 600;">
                            ${escapeHtml(alert.action)}
                        </button>
                    </div>
                `;
            });
            html += '</div>';
            showModal('Prévention - Analyse détaillée', html);
        }
    } catch (error) {
        console.error('Erreur:', error);
        showNotification('Erreur chargement des alertes', 'danger');
    }
}

function showNotification(message, type) {
    const n = document.createElement('div');
    const bgColor = type === 'danger' ? '#a32d2d' : (type === 'warning' ? '#e67e22' : '#2d6a2d');
    n.style.cssText = `position: fixed; bottom: 20px; right: 20px; z-index: 99999; max-width: 380px; background: ${bgColor}; color: white; padding: 12px 20px; border-radius: 10px; box-shadow: 0 4px 18px rgba(0,0,0,.15); animation: fadeIn .2s ease; font-size: 14px;`;
    n.innerHTML = `<span>${escapeHtml(message)}</span><button onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer;">✕</button>`;
    document.body.appendChild(n);
    setTimeout(() => n?.remove(), 5000);
}

