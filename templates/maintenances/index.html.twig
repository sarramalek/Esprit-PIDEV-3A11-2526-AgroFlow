<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script>
// ================================================================
// VARIABLES GLOBALES
// ================================================================
let currentView = localStorage.getItem('maintView') || 'cards';
let reminderCalendar = null;
let reminderEvents = [];
let allRemindersData = [];
let currentNoteDate = null;

// Pagination
let pgCards = { page:1, perPage:6, items:[] };
let pgTable = { page:1, perPage:10, items:[] };

// ================================================================
// VUE TOGGLE
// ================================================================
function setView(v) {
    currentView = v;
    localStorage.setItem('maintView', v);
    document.getElementById('viewCardsContainer').style.display = v === 'cards' ? 'block' : 'none';
    document.getElementById('viewTableContainer').style.display = v === 'table' ? 'block' : 'none';
    document.getElementById('viewCards')?.classList.toggle('active', v === 'cards');
    document.getElementById('viewTable')?.classList.toggle('active', v === 'table');
    filterItems();
}

// ================================================================
// STATS PANEL
// ================================================================
function toggleStats() {
    document.getElementById('chartsPanel')?.classList.toggle('is-open');
    document.getElementById('statsToggle')?.classList.toggle('active');
}

// ================================================================
// FILTRES
// ================================================================
function filterItems() {
    const search = (document.getElementById('searchInput')?.value || '').toLowerCase();
    const type   = (document.getElementById('typeFilter')?.value || '').toLowerCase();
    const statut = (document.getElementById('statutFilter')?.value || '').toLowerCase();
    const prio   = (document.getElementById('prioriteFilter')?.value || '').toLowerCase();
    const sort   = document.getElementById('sortFilter')?.value || 'date';
    const dir    = document.getElementById('dirFilter')?.value || 'desc';

    const resetBtn = document.getElementById('resetBtn');
    if (resetBtn) resetBtn.style.display = (search || type || statut || prio) ? 'inline-flex' : 'none';

    function matches(el) {
        if (!el || !el.dataset) return false;
        return (!search || (el.dataset.type||'').includes(search) || (el.dataset.desc||'').includes(search) || (el.dataset.nom||'').includes(search))
            && (!type   || (el.dataset.type||'').includes(type))
            && (!statut || (el.dataset.statut||'') === statut)
            && (!prio   || (el.dataset.priorite||'') === prio);
    }

    const cardsGrid = document.getElementById('cardsGrid');
    if (cardsGrid) {
        const allCards = Array.from(cardsGrid.children).filter(c => !c.id);
        const matched  = allCards.filter(c => matches(c));
        sortItems(matched, sort, dir);
        pgCards.items = matched;
        pgCards.page  = 1;
        renderPaginatedCards();
    }

    const tbody = document.getElementById('maintBody');
    if (tbody) {
        const allRows = Array.from(tbody.querySelectorAll('tr'));
        const matched  = allRows.filter(r => matches(r));
        sortItems(matched, sort, dir);
        pgTable.items = matched;
        pgTable.page  = 1;
        renderPaginatedTable();
    }
}

function sortItems(items, sort, dir) {
    items.sort((a, b) => {
        let va, vb;
        switch (sort) {
            case 'cout':     va = parseFloat(a.dataset.cout||0);    vb = parseFloat(b.dataset.cout||0);    break;
            case 'type':     va = a.dataset.type||'';               vb = b.dataset.type||'';               break;
            case 'statut':   va = a.dataset.statut||'';             vb = b.dataset.statut||'';             break;
            case 'priorite': va = parseInt(a.dataset.prioOrder||2); vb = parseInt(b.dataset.prioOrder||2); break;
            case 'km':       va = parseInt(a.dataset.km||0);        vb = parseInt(b.dataset.km||0);        break;
            default:         va = a.dataset.date||'';               vb = b.dataset.date||'';
        }
        if (va < vb) return dir === 'asc' ? -1 : 1;
        if (va > vb) return dir === 'asc' ?  1 : -1;
        return 0;
    });
}

function onSearchInput(input) {
    document.getElementById('clearSearch')?.classList.toggle('visible', input.value.length > 0);
    filterItems();
}

function clearSearch() {
    const input = document.getElementById('searchInput');
    if (input) { input.value = ''; input.focus(); }
    document.getElementById('clearSearch')?.classList.remove('visible');
    filterItems();
}

function resetFilters() {
    const si = document.getElementById('searchInput');
    if (si) si.value = '';
    document.getElementById('clearSearch')?.classList.remove('visible');
    ['typeFilter','statutFilter','prioriteFilter','sortFilter','dirFilter'].forEach(id => {
        const el = document.getElementById(id); if (el) el.selectedIndex = 0;
    });
    filterItems();
}

// ================================================================
// PAGINATION
// ================================================================
function renderPaginatedCards() {
    const grid   = document.getElementById('cardsGrid');
    const noRes  = document.getElementById('noResultsCards');
    const pgWrap = document.getElementById('paginationCards');
    if (!grid) return;

    const allOriginal = Array.from(grid.children).filter(c => !c.id);
    allOriginal.forEach(c => c.style.display = 'none');

    const items   = pgCards.items;
    const total   = items.length;
    const perPage = pgCards.perPage;
    const pages   = Math.ceil(total / perPage);
    pgCards.page  = Math.min(pgCards.page, pages || 1);
    const start   = (pgCards.page - 1) * perPage;
    const end     = start + perPage;

    if (total === 0) {
        if (noRes) noRes.style.display = 'block';
        if (pgWrap) pgWrap.innerHTML = '';
        return;
    }
    if (noRes) noRes.style.display = 'none';

    items.slice(start, end).forEach(c => c.style.display = '');

    renderPaginationBar(pgWrap, pgCards.page, pages, perPage, total, (p) => {
        pgCards.page = p; renderPaginatedCards();
    }, (pp) => {
        pgCards.perPage = pp; pgCards.page = 1; renderPaginatedCards();
    });
}

function renderPaginatedTable() {
    const tbody  = document.getElementById('maintBody');
    const noRes  = document.getElementById('noResultsTable');
    const pgWrap = document.getElementById('paginationTable');
    if (!tbody) return;

    Array.from(tbody.querySelectorAll('tr')).forEach(r => r.style.display = 'none');

    const items   = pgTable.items;
    const total   = items.length;
    const perPage = pgTable.perPage;
    const pages   = Math.ceil(total / perPage);
    pgTable.page  = Math.min(pgTable.page, pages || 1);
    const start   = (pgTable.page - 1) * perPage;
    const end     = start + perPage;

    if (total === 0) {
        if (noRes) noRes.style.display = 'block';
        if (pgWrap) pgWrap.innerHTML = '';
        return;
    }
    if (noRes) noRes.style.display = 'none';

    items.slice(start, end).forEach(r => r.style.display = '');

    renderPaginationBar(pgWrap, pgTable.page, pages, perPage, total, (p) => {
        pgTable.page = p; renderPaginatedTable();
    }, (pp) => {
        pgTable.perPage = pp; pgTable.page = 1; renderPaginatedTable();
    });
}

function renderPaginationBar(wrap, page, pages, perPage, total, onPage, onPerPage) {
    if (!wrap) return;
    if (pages <= 1) {
        wrap.innerHTML = '';
        return;
    }

    wrap.innerHTML = `
        <button type="button" class="pg-btn ${page > 1 ? '' : 'disabled'}" ${page <= 1 ? 'disabled' : ''} onclick="onPage(${page - 1})">‹ Précédent</button>
        <span class="pg-info">Page ${page} / ${pages}</span>
        <button type="button" class="pg-btn ${page < pages ? '' : 'disabled'}" ${page >= pages ? 'disabled' : ''} onclick="onPage(${page + 1})">Suivant ›</button>
        <select class="pg-size-select" onchange="onPerPage(parseInt(this.value))">
            <option value="6" ${perPage === 6 ? 'selected' : ''}>6 / page</option>
            <option value="10" ${perPage === 10 ? 'selected' : ''}>10 / page</option>
            <option value="20" ${perPage === 20 ? 'selected' : ''}>20 / page</option>
            <option value="50" ${perPage === 50 ? 'selected' : ''}>50 / page</option>
        </select>
    `;
    
    window.onPage = onPage;
    window.onPerPage = onPerPage;
}

