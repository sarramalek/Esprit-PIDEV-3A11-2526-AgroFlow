    body.innerHTML = '<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Chargement des détails...</div></div>';

    try {
        const response = await fetch('/agriculteur/maintenances/api/calendar/reminder-detail/' + maintenanceId);
        const data = await response.json();
        if (data.success) {
            if (!data.aiRecommendation) {
                data.aiRecommendation = generateLocalAIRecommendation({
                    id: data.id, machineName: data.machineName, type: data.type,
                    priorite: data.priorite, km: data.km || 0, statut: data.statut,
                    date: data.dateMain, yearsSince: data.yearsSince || 0
