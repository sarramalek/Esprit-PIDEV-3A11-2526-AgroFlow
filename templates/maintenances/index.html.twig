function closeReminderDetailPopup() {
    const modal = document.getElementById('reminderDetailPopup');
    if (modal) modal.style.display = 'none';
}

async function analyzeAllRemindersWithAI() {
    const modal = document.getElementById('reminderDetailPopup');
    const body  = document.getElementById('reminderDetailBody');
    if (!modal || !body) return;
    modal.style.display = 'flex';
    body.innerHTML = '<div class="modal-loader"><div class="modal-loader__spinner"></div><div class="modal-loader__text">Analyse globale en cours...</div></div>';

    try {
        const response = await fetch('{{ path('agri_maintenances_api_reminder_dates') }}');
        const data = await response.json();

        if (data.success && data.reminders && data.reminders.length > 0) {
            const reminders   = data.reminders;
            const urgentCount = reminders.filter(r => r.priorite === 'urgente').length;
            const highCount   = reminders.filter(r => r.priorite === 'haute').length;
            const totalCost   = reminders.reduce((s, r) => s + (parseFloat(r.cout)||0), 0);
            const avgKm       = reminders.reduce((s, r) => s + (parseFloat(r.km)||0), 0) / reminders.length;

            let ga = "📊 ANALYSE IA GLOBALE\n\n🔍 Synthèse de la flotte :\n";
            ga += `• ${reminders.length} machine(s) nécessitent une attention\n`;
            if (urgentCount > 0) ga += `• 🔴 ${urgentCount} intervention(s) URGENTE(s) immédiate(s)\n`;
            if (highCount > 0)   ga += `• 🟠 ${highCount} maintenance(s) haute priorité sous 48h\n`;
            ga += `• 📊 Kilométrage moyen : ${Math.round(avgKm).toLocaleString()} km\n`;
            ga += `• 💰 Coût total estimé : ${Math.round(totalCost).toLocaleString()} DT\n\n`;
            ga += "💡 RECOMMANDATIONS STRATÉGIQUES :\n";
            if (urgentCount > 0) ga += "1. Priorité ABSOLUE aux interventions urgentes\n";
            if (avgKm > 10000)   ga += "2. Révisions générales pour machines à haut kilométrage\n";
            ga += "3. Établir un calendrier de maintenance préventive\n";
            ga += "4. Former les opérateurs aux inspections quotidiennes\n";

            body.innerHTML = `
                <div class="reminder-message-box" style="border-left-color:#667eea">
                    <div class="reminder-message-text">🤖 ANALYSE IA — Synthèse globale</div>
                    <div style="font-size:12px;color:#7a9a7a;">${reminders.length} machine(s) avec rappel(s)</div>
                </div>
                <div style="background:#eaf3de;border-radius:12px;padding:15px;margin-bottom:15px;">
                    <div style="white-space:pre-wrap;font-size:13px;line-height:1.6;">${escapeHtml(ga)}</div>
                </div>
                <div style="margin-bottom:15px;">
                    <div style="font-weight:700;color:#2d6a2d;margin-bottom:8px;">📋 Machines concernées</div>
                    <div style="background:#f7faf4;border-radius:12px;padding:12px;max-height:280px;overflow-y:auto;">
                        ${reminders.map(r => `
                            <div class="reminder-detail-row" style="cursor:pointer;" onclick="showReminderDetail(${r.id})">
                                <span class="reminder-detail-label">${escapeHtml(r.machineName)}</span>
                                <span class="reminder-detail-value">${r.date} — ${r.priorite==='urgente'?'🔴 Urgent':'📅 Rappel annuel'}</span>
                            </div>`).join('')}
                    </div>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                    <button class="btn btn--green" style="flex:1;text-align:center;" onclick="closeReminderDetailPopup();openReminderCalendar();">📅 Voir calendrier</button>
                    <button class="btn btn--google" style="flex:1;text-align:center;" onclick="exportAllRemindersToGoogleCalendar()">📤 Exporter Google</button>
                </div>`;
        } else {
            body.innerHTML = `<div style="color:#27500a;text-align:center;padding:1rem;">✅ Aucun rappel de maintenance à afficher</div>`;
        }
    } catch (error) {
        body.innerHTML = `<div style="color:#a32d2d;text-align:center;padding:1rem;">❌ Erreur : ${escapeHtml(error.message)}</div>`;
    }
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function showNotification(message, type) {
    const n = document.createElement('div');
    n.className = `alert alert--${type}`;
    n.style.cssText = 'position:fixed;bottom:20px;right:20px;z-index:99999;max-width:380px;box-shadow:0 4px 18px rgba(0,0,0,.15);animation:fadeIn .2s ease;';
    n.innerHTML = `<span>${escapeHtml(message)}</span><button class="alert__close" onclick="this.parentElement.remove()">✕</button>`;
    document.body.appendChild(n);
    setTimeout(() => n?.remove(), 5000);
}

document.addEventListener('DOMContentLoaded', function() {
    setView(currentView);

    document.getElementById('openCalendarBtn')?.addEventListener('click', function(e) {
        e.preventDefault();
        openReminderCalendar();
    });

    document.getElementById('reminderCalendarModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeReminderCalendar();
    });
    document.getElementById('reminderDetailPopup')?.addEventListener('click', function(e) {
        if (e.target === this) closeReminderDetailPopup();
    });
    document.getElementById('dayNoteModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeDayNoteModal();
    });

    const countByType = {{ countByType|json_encode|raw }};
    const coutByMonth = {{ coutByMonth|json_encode|raw }};

    const barCanvas = document.getElementById('barChart');
    if (barCanvas && countByType && countByType.length) {
        new Chart(barCanvas, {
            type: 'bar',
            data: {
                labels: countByType.map(r => r.type),
                datasets: [{ label:'Nombre', data:countByType.map(r => r.total),
                    backgroundColor:['#2d6a2d','#0F6E56','#854F0B','#a32d2d','#0c447c','#7b5200','#1a5276','#4a1d8c','#534AB7','#2c2c2a'] }]
            },
            options: { responsive:true, plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true, ticks:{ stepSize:1 } } } }
        });
    }

    const lineCanvas = document.getElementById('lineChart');
    if (lineCanvas && coutByMonth && coutByMonth.length) {
        new Chart(lineCanvas, {
            type: 'line',
            data: {
                labels: coutByMonth.map(r => r.mois),
                datasets: [{ label:'Coût (DT)', data:coutByMonth.map(r => r.total),
                    borderColor:'#2d6a2d', backgroundColor:'rgba(45,106,45,.1)', borderWidth:2, tension:.4, fill:true, pointRadius:4 }]
            },
            options: { responsive:true, plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } }
        });
    }
});
</script>
