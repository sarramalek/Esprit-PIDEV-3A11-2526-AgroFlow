// ─────────────────────────────────────────────────────────────────
// Conversion Markdown vers HTML
// ─────────────────────────────────────────────────────────────────
function markdownToHtml(md) {
    if (!md) return '';
    
    let html = md;
    
    // Échapper les caractères HTML (sauf les balises qu'on va créer)
    html = html.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
    
    // Titres
    html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
    html = html.replace(/^## (.+)$/gm, '<h3>$1</h3>');
    html = html.replace(/^# (.+)$/gm, '<h3>$1</h3>');
    
    // Titres de niveau 4 pour les sous-sections
    html = html.replace(/^#### (.+)$/gm, '<h4>$1</h4>');
    
    // Gras
    html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    
    // Italique
    html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
    
    // Listes non ordonnées
    html = html.replace(/^[-*] (.+)$/gm, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>\n?)+/g, function(s) {
        return '<ul>' + s + '</ul>';
    });
    
    // Listes ordonnées
    html = html.replace(/^\d+\. (.+)$/gm, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>\n?)+(?=<li>|$)/g, function(s) {
        if (s.indexOf('</li>') > 0) {
            return '<ol>' + s + '</ol>';
        }
        return s;
    });
    
    // Paragraphes
    html = html.replace(/\n\n/g, '</p><p>');
    
    // Sauts de ligne simples
    html = html.replace(/\n/g, '<br>');
    
    // Encapsuler dans un paragraphe si nécessaire
    if (!html.startsWith('<')) {
        html = '<p>' + html + '</p>';
    }
    
    return html;
}

