{% extends 'agriculteur_dashboard.html.twig' %}

{% block title %}Maintenance #{{ maintenance.idMain }} — AgroFlow{% endblock %}

{% block body %}
<style>
    .ms-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1.75rem;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    .ms-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
        color: #5f7a5f;
        margin-bottom: 1.5rem;
    }
    .ms-breadcrumb a { color: #2d6a2d; text-decoration: none; font-weight: 500; }
    .ms-breadcrumb a:hover { text-decoration: underline; }
    .ms-breadcrumb__sep { color: #aac2aa; }

    .ms-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .ms-header h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a2e1a;
        letter-spacing: -0.02em;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.62rem 1.2rem;
        border-radius: 10px;
        border: 1.5px solid #d0e4cc;
        color: #5f7a5f;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        background: transparent;
        transition: background 0.14s;
    }
    .btn-back:hover { background: #f2f8ee; }

    .ms-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 18px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .ms-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .ms-info-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.75rem;
        border-right: 1px solid #f1f5ee;
        border-bottom: 1px solid #f1f5ee;
    }
    
    .ms-info-item:last-child { border-right: none; }

    .ms-info-item.full-width {
        grid-column: 1 / -1;
        border-right: none;
    }

    .ms-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: #7a9a7a;
    }

    .ms-value {
        font-size: 1.05rem;
        color: #1a2e1a;
        font-weight: 500;
    }
    .ms-value--id { font-size: 1.25rem; font-weight: 700; color: #2d6a2d; }
    .ms-value--cost { font-size: 1.2rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .ms-value--desc { font-size: 0.95rem; color: #4a5e4a; line-height: 1.7; font-weight: 400; }

    .panne-badge {
        display: inline-block;
        padding: 0.35rem 1rem;
        border-radius: 50px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .badge--mecanique   { background: #e1f5ee; color: #085041; }
    .badge--electrique  { background: #faeeda; color: #633806; }
    .badge--hydraulique { background: #eaf3de; color: #27500a; }
    .badge--logicielle  { background: #e6f1fb; color: #0c447c; }
    .badge--autre       { background: #f1efe8; color: #2c2c2a; }
    .badge--default     { background: #f1efe8; color: #2c2c2a; }

    .ms-actions {
        padding: 1.4rem 1.75rem;
        background: #f7faf4;
        border-top: 1px solid #e4edde;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.4rem;
        border-radius: 10px;
        background: #2d6a2d;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.16s;
    }
    .btn-edit:hover { background: #235223; color: #fff; }

    .btn-delete {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.65rem 1.4rem;
        border-radius: 10px;
        background: transparent;
        color: #a32d2d;
        font-size: 0.9rem;
        font-weight: 600;
        border: 1.5px solid #f7c1c1;
        cursor: pointer;
        transition: all 0.14s;
    }
    .btn-delete:hover { background: #fcebeb; border-color: #a32d2d; }
</style>

<div class="ms-page">
    <nav class="ms-breadcrumb">
        <a href="{{ path('agri_maintenances_index') }}">Maintenances</a>
        <span class="ms-breadcrumb__sep">›</span>
        <span>#{{ maintenance.idMain }}</span>
    </nav>

    <div class="ms-header">
        <h1>🔧 Maintenance #{{ maintenance.idMain }}</h1>
        <a href="{{ path('agri_maintenances_index') }}" class="btn-back">← Retour à la liste</a>
    </div>

    <div class="ms-card">
        <div class="ms-info-grid">
            <div class="ms-info-item">
                <span class="ms-label">ID Maintenance</span>
                <span class="ms-value ms-value--id">#{{ maintenance.idMain }}</span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Type de Panne</span>
                {% set typeClean = maintenance.typePanne|default('autre')|lower|replace({'é': 'e'}) %}
                {% set badgeClass = typeClean in ['mecanique', 'electrique', 'hydraulique', 'logicielle', 'autre'] ? typeClean : 'default' %}
                <span class="panne-badge badge--{{ badgeClass }}">
                    {{ maintenance.typePanne|default('Non renseigné')|capitalize }}
                </span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Coût</span>
                <span class="ms-value ms-value--cost">
                    {{ maintenance.cout|number_format(2, ',', ' ') }} DT
                </span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Date de Maintenance</span>
                <span class="ms-value">
                    {{ maintenance.dateMain ? maintenance.dateMain|date('d/m/Y') : '—' }}
                </span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Matériel concerné</span>
                <span class="ms-value">
                    {{ maintenance.idM ? '#' ~ maintenance.idM : '—' }}
                </span>
            </div>

            {% if maintenance.description %}
                <div class="ms-info-item full-width">
                    <span class="ms-label">Description</span>
                    <span class="ms-value ms-value--desc">{{ maintenance.description|nl2br }}</span>
                </div>
            {% endif %}
        </div>

        <div class="ms-actions">
            {# Modifier #}
            <a href="{{ path('agri_maintenances_edit', {id: maintenance.idMain}) }}" class="btn-edit">
                ✏️ Modifier
            </a>

            {# Supprimer #}
            <form method="post" 
                  action="{{ path('agri_maintenances_delete', {id: maintenance.idMain}) }}" 
                  onsubmit="return confirm('⚠️ Voulez-vous vraiment supprimer cette maintenance ?')" 
                  style="display: inline-block;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ maintenance.idMain) }}">
                <button type="submit" class="btn-delete">
                    🗑️ Supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}