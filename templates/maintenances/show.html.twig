{% extends 'agriculteur_dashboard.html.twig' %}
{% block title %}Maintenance #{{ maintenance.idMain }} — AgroFlow{% endblock %}
{% block body %}
<style>
.ms-page { max-width: 1000px; margin: 0 auto; padding: 2rem 1.75rem; font-family: 'Segoe UI', system-ui, sans-serif; }
.ms-breadcrumb { display: flex; align-items: center; gap: .4rem; font-size: .82rem; color: #5f7a5f; margin-bottom: 1.5rem; }
.ms-breadcrumb a { color: #2d6a2d; text-decoration: none; font-weight: 500; }
.ms-breadcrumb a:hover { text-decoration: underline; }
.ms-breadcrumb__sep { color: #aac2aa; }
.ms-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
.ms-header h1 { margin: 0; font-size: 1.75rem; font-weight: 700; color: #1a2e1a; }
.btn-back { display: inline-flex; align-items: center; gap: .4rem; padding: .62rem 1.2rem; border-radius: 10px; border: 1.5px solid #d0e4cc; color: #5f7a5f; font-size: .88rem; font-weight: 600; text-decoration: none; background: transparent; transition: background .14s; }
.btn-back:hover { background: #f2f8ee; }
.ms-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 18px rgba(0,0,0,.07); overflow: hidden; }
.ms-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
.ms-info-item { display: flex; flex-direction: column; gap: .5rem; padding: 1.75rem; border-right: 1px solid #f1f5ee; border-bottom: 1px solid #f1f5ee; }
.ms-info-item:last-child { border-right: none; }
.ms-info-item.full-width { grid-column: 1 / -1; border-right: none; }
.ms-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: #7a9a7a; }
.ms-value { font-size: 1.05rem; color: #1a2e1a; font-weight: 500; }
.ms-value--id   { font-size: 1.25rem; font-weight: 700; color: #2d6a2d; }
.ms-value--cost { font-size: 1.2rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.ms-value--desc { font-size: .95rem; color: #4a5e4a; line-height: 1.7; font-weight: 400; }
/* panne badges */
.panne-badge { display: inline-block; padding: .35rem 1rem; border-radius: 50px; font-size: .82rem; font-weight: 600; }
.badge--mecanique    { background: #e1f5ee; color: #085041; }
.badge--electrique   { background: #faeeda; color: #633806; }
.badge--hydraulique  { background: #eaf3de; color: #27500a; }
.badge--logicielle   { background: #e6f1fb; color: #0c447c; }
.badge--transmission { background: #ede8fa; color: #4a1d8c; }
.badge--moteur       { background: #fde8e8; color: #a32d2d; }
.badge--vidange      { background: #fff8e1; color: #7b5200; }
.badge--revision     { background: #e8f4fd; color: #1a5276; }
.badge--pneumatique  { background: #ddeeff; color: #0a3d6b; }
.badge--autre, .badge--default { background: #f1efe8; color: #2c2c2a; }
/* statut */
.statut-badge { display: inline-flex; align-items: center; gap: 5px; padding: .3rem .9rem; border-radius: 50px; font-size: .82rem; font-weight: 600; }
.statut--planifie  { background: #e6f1fb; color: #0c447c; }
.statut--en_cours  { background: #fff8e1; color: #7b5200; }
.statut--termine   { background: #e1f5ee; color: #085041; }
/* priorité */
.prio-badge { display: inline-flex; align-items: center; gap: 5px; padding: .3rem .9rem; border-radius: 50px; font-size: .82rem; font-weight: 700; }
.prio--faible   { background: #e6f1fb; color: #0c447c; }
.prio--moyenne  { background: #eaf3de; color: #27500a; }
.prio--haute    { background: #faeeda; color: #854F0B; }
.prio--urgente  { background: #fde8e8; color: #a32d2d; }
.machine-badge { display: inline-flex; align-items: center; gap: 6px; background: #2d6a2d; color: #fff; border-radius: 20px; padding: .3rem .9rem; font-size: .85rem; font-weight: 600; }
.machine-badge--none { background: #e4edde; color: #7a9a7a; }
.ms-actions { padding: 1.4rem 1.75rem; background: #f7faf4; border-top: 1px solid #e4edde; display: flex; gap: .75rem; flex-wrap: wrap; align-items: center; }
.btn-edit { display: inline-flex; align-items: center; gap: .4rem; padding: .65rem 1.4rem; border-radius: 10px; background: #2d6a2d; color: #fff; font-size: .9rem; font-weight: 600; text-decoration: none; transition: background .16s; }
.btn-edit:hover { background: #235223; }
.btn-delete { display: inline-flex; align-items: center; gap: .4rem; padding: .65rem 1.4rem; border-radius: 10px; background: transparent; color: #a32d2d; font-size: .9rem; font-weight: 600; border: 1.5px solid #f7c1c1; cursor: pointer; transition: all .14s; }
.btn-delete:hover { background: #fcebeb; border-color: #a32d2d; }
/* API buttons */
.btn-api-plan { display: inline-flex; align-items: center; gap: .4rem; padding: .65rem 1.4rem; border-radius: 10px; background: #534AB7; color: #fff; font-size: .9rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: background .15s; }
.btn-api-plan:hover { background: #3C3489; }
.btn-api-diag { display: inline-flex; align-items: center; gap: .4rem; padding: .65rem 1.4rem; border-radius: 10px; background: #0F6E56; color: #fff; font-size: .9rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; transition: background .15s; }
.btn-api-diag:hover { background: #085041; }
</style>

<div class="ms-page">

    <nav class="ms-breadcrumb">
        <a href="{{ path('agri_maintenances_index') }}">Maintenances</a>
        <span class="ms-breadcrumb__sep">›</span>
        <span>#{{ maintenance.idMain }}</span>
    </nav>

    <div class="ms-header">
        <h1>🔧 Maintenance #{{ maintenance.idMain }}</h1>
        <a href="{{ path('agri_maintenances_index') }}" class="btn-back">← Retour à la liste</a>
    </div>

    <div class="ms-card">
        <div class="ms-info-grid">

            <div class="ms-info-item">
                <span class="ms-label">ID Maintenance</span>
                <span class="ms-value ms-value--id">#{{ maintenance.idMain }}</span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Type de Panne</span>
                {% set typeMap = {
                    'Mécanique':'mecanique','Électricité':'electrique','Hydraulique':'hydraulique',
                    'Logicielle':'logicielle','Transmission':'transmission','Moteur':'moteur',
                    'Vidange & filtres':'vidange','Révision générale':'revision',
                    'Pneumatique':'pneumatique','Autre':'autre'
                } %}
                <span class="panne-badge badge--{{ typeMap[maintenance.typePanne]|default('default') }}">
                    {{ maintenance.typePanne|default('Non renseigné') }}
                </span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Coût</span>
                <span class="ms-value ms-value--cost">{{ maintenance.cout|number_format(2, ',', ' ') }} DT</span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Date de Maintenance</span>
                <span class="ms-value">{{ maintenance.dateMain ? maintenance.dateMain|date('d/m/Y') : '—' }}</span>
            </div>

            {# Statut #}
            <div class="ms-info-item">
                <span class="ms-label">Statut</span>
                {% set statutLabels = {'planifie':'📅 Planifié','en_cours':'⚙️ En cours','termine':'✅ Terminé'} %}
                <span class="statut-badge statut--{{ maintenance.statut|default('planifie') }}">
                    {{ statutLabels[maintenance.statut]|default('—') }}
                </span>
            </div>

            {# Priorité #}
            <div class="ms-info-item">
                <span class="ms-label">Priorité</span>
                {% set prioLabels = {'faible':'🔵 Faible','moyenne':'🟢 Moyenne','haute':'🟠 Haute','urgente':'🔴 Urgente'} %}
                <span class="prio-badge prio--{{ maintenance.priorite|default('moyenne') }}">
                    {{ prioLabels[maintenance.priorite]|default('—') }}
                </span>
            </div>

            {# Kilométrage #}
            <div class="ms-info-item">
                <span class="ms-label">Kilométrage</span>
                <span class="ms-value">
                    {% if maintenance.kilometrage is not null %}
                        🛣️ {{ maintenance.kilometrage|number_format(0, ',', ' ') }} km
                    {% else %}
                        <span style="color:#aac2aa">—</span>
                    {% endif %}
                </span>
            </div>

            <div class="ms-info-item">
                <span class="ms-label">ID Machine</span>
                {% if maintenance.idM %}
                    <span class="machine-badge">🚜 #{{ maintenance.idM }}</span>
                {% else %}
                    <span class="machine-badge machine-badge--none">Non assigné</span>
                {% endif %}
            </div>

            <div class="ms-info-item">
                <span class="ms-label">Nom Machine</span>
                <span class="ms-value">
                    {{ maintenance.nom ?? '<span style="color:#aac2aa">—</span>'|raw }}
                </span>
            </div>

            {% if maintenance.description %}
            <div class="ms-info-item full-width">
                <span class="ms-label">Description</span>
                <span class="ms-value ms-value--desc">{{ maintenance.description|nl2br }}</span>
            </div>
            {% endif %}

            {% if maintenance.recommandation %}
            <div class="ms-info-item full-width">
                <span class="ms-label">💡 Recommandation</span>
                <span class="ms-value ms-value--desc">{{ maintenance.recommandation|nl2br }}</span>
            </div>
            {% endif %}

        </div>

        <div class="ms-actions">
            <a href="{{ path('agri_maintenances_edit', {id: maintenance.idMain}) }}" class="btn-edit">✏️ Modifier</a>

            {# ── API Buttons ── #}
            <a href="{{ path('agri_maintenances_api_schedule', {id: maintenance.idMain}) }}" class="btn-api-plan" target="_blank">
                🤖 Plan de maintenance IA
            </a>
            <a href="{{ path('agri_maintenances_api_diagnostics', {id: maintenance.idMain}) }}" class="btn-api-diag" target="_blank">
                🔍 Diagnostics IA
            </a>

            <form method="post"
                  action="{{ path('agri_maintenances_delete', {id: maintenance.idMain}) }}"
                  onsubmit="return confirm('⚠️ Voulez-vous vraiment supprimer cette maintenance ?')"
                  style="display:inline-block; margin-left:auto;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_maintenance_' ~ maintenance.idMain) }}">
                <button type="submit" class="btn-delete">🗑️ Supprimer</button>
            </form>
        </div>
    </div>

</div>
{% endblock %}
